-static struct IgnoredErrors {
-    SwrErrorIgnored *handle = nullptr;
-    ~IgnoredErrors() { swr_v1_error_ignored_release(handle); }
-} ignored_errors;
-
-namespace swoole {
-Exception::Exception(const int code) noexcept : code(code) {
-    msg = swoole_strerror(code);
-}
-}  // namespace swoole
-
-static const char *swr_system_error(int32_t code) {
-    return strerror(code);
-}
-
-const char *swoole_strerror(int code) {
-    return swr_v1_error_strerror(code, swr_system_error);
-}
-
-void swoole_throw_error(int code) {
-    throw swoole::Exception(code);
-}
-
-void swoole_ignore_error(int code) {
-    if (swr_v1_error_ignore(&ignored_errors.handle, code) != 0) {
-        throw std::bad_alloc();
-    }
-}
-
-bool swoole_is_ignored_error(const int code) {
-    return swr_v1_error_is_ignored(ignored_errors.handle, code) != 0;
-}
-
-void swoole_clear_last_error_msg() {
-    sw_error[0] = '\0';
-}
-
-const char *swoole_get_last_error_msg() {
-    return sw_error;
