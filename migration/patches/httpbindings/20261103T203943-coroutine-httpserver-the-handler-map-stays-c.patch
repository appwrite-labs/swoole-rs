diff --git a/ext-src/swoole_http_server_coro.cc b/ext-src/swoole_http_server_coro.cc
index 501b00c..091b2cd 100644
--- a/ext-src/swoole_http_server_coro.cc
+++ b/ext-src/swoole_http_server_coro.cc
@@ -46,5 +46,8 @@ namespace swoole {
 namespace coroutine {
-// What the contexts copy that stays C++: the compression types, the WebSocket
-// settings and upload_tmp_dir. The rest of upstream's HttpServer is Rust's.
+// What stays C++ of upstream's HttpServer: the handler map (its lookup order is
+// std::unordered_map's), and what the contexts copy into C++ fields: the
+// compression types, the WebSocket settings and upload_tmp_dir. The rest is Rust's.
 struct HttpServerSettings {
+    zend::Callable *default_handler = nullptr;
+    std::unordered_map<std::string, zend::Callable *> handlers;
     WebSocketSettings websocket_settings;
@@ -60,2 +63,33 @@ struct HttpServerSettings {
     }
+
+    ~HttpServerSettings() {
+        for (const auto &handler : handlers) {
+            sw_callable_free(handler.second);
+        }
+    }
+
+    bool set_handler(const std::string &pattern, zval *zfn) {
+        auto cb = sw_callable_create(zfn);
+        if (!cb) {
+            return false;
+        }
+        if (handlers.find(pattern) != handlers.end()) {
+            sw_callable_free(handlers[pattern]);
+        }
+        handlers[pattern] = cb;
+        if (pattern == "/") {
+            default_handler = cb;
+        }
+        return true;
+    }
+
+    zend::Callable *get_handler(const HttpContext *ctx) const {
+        for (auto &handler : handlers) {
+            if (handler.second == default_handler) continue;
+            if (swr_v1_httpbindings_handler(
+                    {reinterpret_cast<const uint8_t *>(ctx->request.path), ctx->request.path_len},
+                    {reinterpret_cast<const uint8_t *>(handler.first.data()), handler.first.size()}) == 1) return handler.second;
+        }
+        return default_handler;
+    }
 };
@@ -104,10 +138,12 @@ void swr_hsc_delete(void *socket, void *settings) {
 
-void *swr_hsc_callable(zval *callable, bool *bailed) {
-    zend::Callable *cb = nullptr;
-    *bailed = swr_http_host_try([&] { cb = sw_callable_create(callable); });
-    return cb;
+// `handle()`: 1 set, 0 not callable, -1 bailed out.
+int swr_hsc_set_handler(void *settings, const char *pattern, size_t length, zval *callable) {
+    bool set = false;
+    bool bailed =
+        swr_http_host_try([&] { set = settings_of(settings)->set_handler(std::string(pattern, length), callable); });
+    return bailed ? -1 : set;
 }
 
-void swr_hsc_callable_free(void *callable) {
-    sw_callable_free(callable);
+void *swr_hsc_handler(void *settings, void *ctx) {
+    return settings_of(settings)->get_handler(static_cast<HttpContext *>(ctx));
 }
