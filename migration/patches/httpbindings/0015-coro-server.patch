+ssize_t swr_hsc_recv(void *sock, void *buf) {
+    auto *buffer = static_cast<String *>(buf);
+    sock_of(sock)->get_socket()->recv_wait = 1;
+    ssize_t retval = sock_of(sock)->recv(buffer->str + buffer->length, buffer->size - buffer->length);
+    if (retval > 0) {
+        buffer->length += retval;
+    }
