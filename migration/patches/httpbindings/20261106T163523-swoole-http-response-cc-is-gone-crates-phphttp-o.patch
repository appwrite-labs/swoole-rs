-// What crates/phphttp/src/header.rs asks of the context to build the header
-// and compress the body. zlib is Rust's; brotli and zstd, which every pinned
-// build disables, stay here: 1 compressed, 0 failed, -1 not built.
-int swr_http_host_compress_other(void *context, int method, const char *data, size_t length) {
-    char message[SW_ERROR_MSG_SIZE];
-    auto *ctx = static_cast<HttpContext *>(context);
-    (void) ctx;
-    (void) message;
-#ifdef SW_HAVE_BROTLI
-    if (method == HTTP_COMPRESS_BR) {
-        ctx->compression_level =
-            swr_v1_httpbindings_codec_level(method, ctx->compression_level, BROTLI_MIN_QUALITY, BROTLI_MAX_QUALITY);
-
-        size_t memory_size = BrotliEncoderMaxCompressedSize(length);
-        String buffer(memory_size);
-
-        size_t encoded_size = buffer.size;
-        if (BROTLI_TRUE != BrotliEncoderCompress(ctx->compression_level,
-                                                 BROTLI_DEFAULT_WINDOW,
-                                                 BROTLI_DEFAULT_MODE,
-                                                 length,
-                                                 reinterpret_cast<const uint8_t *>(data),
-                                                 &encoded_size,
-                                                 reinterpret_cast<uint8_t *>(buffer.str))) {
-            swr_http_host_log(SW_LOG_WARNING, 0, "Context::compress", "BrotliEncoderCompress() failed");
-            return 0;
-        }
-        swr_v1_phphttp_set_compressed(ctx, buffer.str, encoded_size);
-        return 1;
-    }
-#endif
-#ifdef SW_HAVE_ZSTD
-    if (method == HTTP_COMPRESS_ZSTD) {
-        int zstd_compress_level = swr_v1_httpbindings_codec_level(
-            method, ctx->compression_level, ZSTD_minCLevel(), ZSTD_maxCLevel());
-
-        size_t compress_size = ZSTD_compressBound(length);
-        String buffer(compress_size);
-        size_t result = ZSTD_compress((void *) buffer.str, compress_size, (void *) data, length, zstd_compress_level);
-        if (ZSTD_isError(result)) {
-            sw_snprintf(message, sizeof(message), "ZSTD_compress() failed, Error: [%s]", ZSTD_getErrorName(result));
-            swr_http_host_log(SW_LOG_WARNING, 0, "Context::compress", message);
-            return 0;
-        }
-        swr_v1_phphttp_set_compressed(ctx, buffer.str, result);
-        return 1;
-    }
-#endif
-    (void) method;
-    (void) data;
-    (void) length;
-    return -1;
-}
