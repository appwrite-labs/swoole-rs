-#include "swoole.h"
-#include "swoole_buffer.h"
-
-#include <memory>
-#include <stdexcept>
-#include "swoole_rs_buffer_posix.h"
-
-namespace swoole {
-
-BufferChunk::BufferChunk(Type type, uint32_t size) : type(type), size(size) {
-    if (type == TYPE_DATA && size > 0) {
-        value.str = new char[size];
-    }
-}
-
-BufferChunk::~BufferChunk() {
-    if (type == TYPE_DATA && !rs_borrowed_) {
-        delete[] value.str;
-    }
-    if (destroy) {
-        destroy(this);
-    }
-}
-
-static void check_buffer_status(int32_t status) {
-    switch (status) {
-    case SWR_BUFFER_OK:
-        return;
-    case SWR_BUFFER_NOMEM:
-        throw std::bad_alloc();
-    case SWR_BUFFER_OVERFLOW:
-        throw std::length_error("Rust buffer size overflow");
-    default:
-        throw std::invalid_argument("Rust buffer rejected operation");
-    }
-}
-
-Buffer::Buffer(uint32_t _chunk_size) {
-    check_buffer_status(swr_v1_buffer_typed_create(_chunk_size, &rs_buffer_));
-    front_.rs_borrowed_ = true;
-}
-
-Buffer::~Buffer() {
-    advance(true);
-    check_buffer_status(swr_v1_buffer_release(rs_buffer_));
-}
-
-extern "C" void swr_buffer_dispose_legacy_close(void *token) {
-    delete static_cast<BufferChunk *>(token);
-}
-
-BufferChunk *Buffer::alloc(BufferChunk::Type type, uint32_t size) {
-    if (type != BufferChunk::TYPE_CLOSE || size != 0) {
-        throw std::invalid_argument("Typed buffer rejects mutable legacy DATA/sendfile chunks");
-    }
-    std::unique_ptr<BufferChunk> chunk(new BufferChunk(type, size));
-    check_buffer_status(swr_v1_buffer_typed_push(rs_buffer_, 2, chunk.get(), swr_buffer_dispose_legacy_close));
-    return chunk.release();
-}
-
-BufferChunk *Buffer::front() const {
-    TypedFront view{};
-    int32_t status = swr_v1_buffer_typed_front(rs_buffer_, &view);
-    if (status == SWR_BUFFER_EMPTY) return nullptr;
-    check_buffer_status(status);
-    if (view.kind == BufferChunk::TYPE_CLOSE && view.token) {
-        return static_cast<BufferChunk *>(view.token);  // alloc()'s own chunk
-    }
-    front_.type = static_cast<BufferChunk::Type>(view.kind);
-    front_.value.ptr = view.kind == BufferChunk::TYPE_DATA ? static_cast<void *>(view.data) : view.token;
-    front_.length = front_.size = view.length;
-    front_.offset = view.offset;
-    return &front_;
-}
-
-Buffer::TypedFront Buffer::typed_front() const {
-    TypedFront view{};
-    check_buffer_status(swr_v1_buffer_typed_front(rs_buffer_, &view));
-    return view;
-}
-
-void Buffer::typed_consume(const TypedFront &front, uint32_t count) {
-    check_buffer_status(swr_v1_buffer_typed_consume(rs_buffer_, front.generation, front.offset, count));
-}
-
-void Buffer::typed_close() {
-    check_buffer_status(swr_v1_buffer_typed_push(rs_buffer_, 2, nullptr, nullptr));
-}
-
-void Buffer::typed_sendfile(void *token, swr_v1_buffer_dispose dispose) {
-    check_buffer_status(swr_v1_buffer_typed_push(rs_buffer_, 1, token, dispose));
-}
-
-void Buffer::advance(bool drain) {
-    for (;;) {
-        // A destroy set on front()'s view runs as upstream's chunk destructor would.
-        if (auto destroy = front_.destroy) {
-            front_.destroy = nullptr;
-            [&]() noexcept { destroy(&front_); }();
-        }
-        swr_v1_buffer_typed_detached effect{};
-        int32_t status = swr_v1_buffer_typed_pop(rs_buffer_, &effect);
-        if (status == SWR_BUFFER_EMPTY) return;
-        check_buffer_status(status);
-        if (effect.dispose) effect.dispose(effect.token);
-        if (!drain) return;
-    }
-}
-
-void Buffer::pop() {
-    advance(false);
-}
-
-void Buffer::append(const char *data, uint32_t size) {
-    check_buffer_status(swr_v1_buffer_append(rs_buffer_, reinterpret_cast<const uint8_t *>(data), size));
-}
-
-void Buffer::append(const iovec *iov, size_t iovcnt, off_t offset) {
-    check_buffer_status(swr_v1_buffer_append_iovec(rs_buffer_, iov, iovcnt, offset));
-}
-
-void Buffer::check(int32_t status) {
-    check_buffer_status(status);
-}
-
-uint32_t Buffer::length() const {
-    uint32_t length;
-    size_t count;
-    check_buffer_status(swr_v1_buffer_stats(rs_buffer_, &length, &count));
-    return length;
-}
-
-size_t Buffer::count() const {
-    uint32_t length;
-    size_t count;
-    check_buffer_status(swr_v1_buffer_stats(rs_buffer_, &length, &count));
-    return count;
-}
-
-bool Buffer::empty() const {
-    return count() == 0;
-}
