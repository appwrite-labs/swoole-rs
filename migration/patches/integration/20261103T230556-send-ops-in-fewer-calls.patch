+// OP_SC_FLAGS: the connection's flags, then its socket's and the server's buffer callbacks.
+static uint64_t send_flags(const Server *serv, const Connection *conn, const Socket *sock) {
+    return (conn->overflow ? SWR_SC_OVERFLOW : 0) | (conn->close_reset ? SWR_SC_CLOSE_RESET : 0) |
+               (conn->close_force ? SWR_SC_CLOSE_FORCE : 0) | (conn->peer_closed ? SWR_SC_PEER_CLOSED : 0) |
+               (conn->closed ? SWR_SC_CLOSED : 0) | (conn->close_queued ? SWR_SC_CLOSE_QUEUED : 0) |
+               (conn->high_watermark ? SWR_SC_HIGH_WATERMARK : 0) | (sock->removed ? SWR_SC_REMOVED : 0) |
+#ifdef SW_HALFCLOSE_DRAIN
+               (sock->close_notified ? SWR_SC_CLOSE_NOTIFIED : 0) |
+#endif
+               ((sock->events & SW_EVENT_READ) ? SWR_SC_EVENT_READ : 0) |
+               ((sock->events & SW_EVENT_WRITE) ? SWR_SC_EVENT_WRITE : 0) |
+               (serv->onBufferFull ? SWR_SC_ON_BUFFER_FULL : 0) | (serv->onBufferEmpty ? SWR_SC_ON_BUFFER_EMPTY : 0);
+}
