diff --git a/config.m4 b/config.m4
index 230b1c0..7bab110 100644
--- a/config.m4
+++ b/config.m4
@@ -38,2 +38,7 @@ PHP_ARG_ENABLE([swoole],
 
+PHP_ARG_WITH([swoole-rs],
+  [Rust migration bridge prefix],
+  [AS_HELP_STRING([--with-swoole-rs=DIR],
+    [Link the optional Rust migration bridge from DIR])], [no], [no])
+
 PHP_ARG_ENABLE([mysqlnd],
@@ -1301,2 +1306,25 @@ EOF
 
+    if test "$PHP_SWOOLE_RS" != "no"; then
+        if test "$PHP_SWOOLE_RS" = "yes"; then
+            AC_MSG_ERROR([--with-swoole-rs requires a prefix directory])
+        fi
+        if test ! -f "$PHP_SWOOLE_RS/include/swoole_rs.h"; then
+            AC_MSG_ERROR([Rust bridge header missing: $PHP_SWOOLE_RS/include/swoole_rs.h])
+        fi
+        if test ! -f "$PHP_SWOOLE_RS/lib/libswoole_rs_ffi.a"; then
+            AC_MSG_ERROR([Rust bridge archive missing: $PHP_SWOOLE_RS/lib/libswoole_rs_ffi.a])
+        fi
+        AC_DEFINE(SWOOLE_RS_BUFFER_TYPED, 1, [Server callers use the typed Rust Buffer queue])
+        PHP_ADD_INCLUDE([$PHP_SWOOLE_RS/include])
+        dnl Rust's static archive needs the target's native system libraries.
+        PHP_ADD_LIBRARY(m, 1, SWOOLE_SHARED_LIBADD)
+        AS_CASE([$host_os], [linux*], [PHP_ADD_LIBRARY(dl, 1, SWOOLE_SHARED_LIBADD)])
+        PHP_ADD_LIBRARY_WITH_PATH(swoole_rs_ffi, [$PHP_SWOOLE_RS/lib], SWOOLE_SHARED_LIBADD)
+        dnl The archive's io_uring engine calls liburing: link it after the archive.
+        if test "$HAVE_CONFIG_IOURING_X" = "yes"; then
+            PHP_ADD_LIBRARY(uring, , SWOOLE_SHARED_LIBADD)
+        fi
+        AC_DEFINE(SWOOLE_RS_BRIDGE, 1, [Link the Rust migration bridge])
+    fi
+
     if test "$PHP_MYSQLND" = "yes"; then
diff --git a/ext-src/php_swoole.cc b/ext-src/php_swoole.cc
index 66f2386..561d7aa 100644
--- a/ext-src/php_swoole.cc
+++ b/ext-src/php_swoole.cc
@@ -21,2 +21,7 @@
 
+#ifdef SWOOLE_RS_BRIDGE
+#include "swoole_rs.h"
+static_assert(SWR_ABI_VERSION == 1, "unsupported Rust bridge ABI header");
+#endif
+
 BEGIN_EXTERN_C()
@@ -614,2 +619,13 @@ static void sw_after_fork(void *args) {
 PHP_MINIT_FUNCTION(swoole) {
+#ifdef SWOOLE_RS_BRIDGE
+    const uint32_t rust_abi = swr_v1_abi_version();
+    if (rust_abi != SWR_ABI_VERSION) {
+        php_error_docref(nullptr, E_WARNING, "Rust bridge ABI mismatch: expected %u, got %u",
+                         static_cast<unsigned>(SWR_ABI_VERSION), static_cast<unsigned>(rust_abi));
+        return FAILURE;
+    }
+    const uint64_t rust_features = swr_v1_feature_bits();
+    SW_REGISTER_LONG_CONSTANT("SWOOLE_RS_ABI_VERSION", rust_abi);
+    SW_REGISTER_LONG_CONSTANT("SWOOLE_RS_FEATURE_BITS", rust_features);
+#endif
     ZEND_INIT_MODULE_GLOBALS(swoole, php_swoole_init_globals, nullptr);
@@ -1106,2 +1122,7 @@ PHP_MINFO_FUNCTION(swoole) {
     php_info_print_table_row(2, "Version", SWOOLE_VERSION);
+#ifdef SWOOLE_RS_BRIDGE
+    snprintf(buf, sizeof(buf), "ABI %u, features %llu", static_cast<unsigned>(swr_v1_abi_version()),
+             static_cast<unsigned long long>(swr_v1_feature_bits()));
+    php_info_print_table_row(2, "Rust migration bridge", buf);
+#endif
     snprintf(buf, sizeof(buf), "%s %s", __DATE__, __TIME__);
