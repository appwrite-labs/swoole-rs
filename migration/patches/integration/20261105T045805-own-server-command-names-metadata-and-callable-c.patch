diff --git a/include/swoole_server.h b/include/swoole_server.h
index 5565195..33d8192 100644
--- a/include/swoole_server.h
+++ b/include/swoole_server.h
@@ -684,6 +684,30 @@ class Server : public detail::ServerFields {
 
-    std::unordered_map<std::string, Command> commands;
-    std::unordered_map<int, Command::Handler> command_handlers;
-    std::unordered_map<int64_t, Command::Callback> command_callbacks;
-    int64_t command_current_request_id = 1;
+    // Native callable destruction stays outside Rust frames, at the original
+    // container destruction point. The Rust base outlives this guard.
+    struct CommandStorage {
+        swr_v1_server_state *state;
+        ~CommandStorage() {
+            while (auto *p = swr_v1_server_command_drain(state, true)) delete static_cast<Command::Callback *>(p);
+            while (auto *p = swr_v1_server_command_drain(state, false)) delete static_cast<Command::Handler *>(p);
+        }
+    } command_storage{state_};
+
+    bool find_command(const std::string &name, swr_v1_server_command_info *out) const {
+        return swr_v1_server_command_find(state_, reinterpret_cast<const uint8_t *>(name.data()), name.length(), out);
+    }
+    Command::Handler *get_command_handler(int id) const {
+        return static_cast<Command::Handler *>(swr_v1_server_command_handler(state_, id));
+    }
+    int64_t store_command_callback(const Command::Callback &callback) {
+        std::unique_ptr<Command::Callback> copy(new Command::Callback(callback));
+        auto id = swr_v1_server_command_request(state_, copy.get());
+        copy.release();
+        return id;
+    }
+    void release_command_callback(int64_t id) {
+        delete static_cast<Command::Callback *>(swr_v1_server_command_callback(state_, id, true));
+    }
+    bool command_at(size_t index, swr_v1_server_command_info *out) const {
+        return swr_v1_server_command_at(state_, index, out);
+    }
 
