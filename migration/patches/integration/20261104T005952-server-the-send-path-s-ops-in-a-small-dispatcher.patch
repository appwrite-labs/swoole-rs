+// The ops each send makes, in a small frame of their own: the rest of rust_call
+// needs a large, stack-protected one.
+static uint64_t server_call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<ServerRustContext *>(context);
+    Server *serv = ctx->serv;
+    Socket *sock = ctx->sock;
+    Connection *conn = ctx->conn;
+    switch (op) {
+    case SWR_SERVER_OP_SC_VERIFY:
+        conn = ctx->conn = ctx->send->info.type != SW_SERVER_EVENT_CLOSE
+                               ? serv->get_connection_verify(ctx->session_id)
+                               : serv->get_connection_verify_no_ssl(ctx->session_id);
+        if (!conn) {
+            return 0;
+        }
+        ctx->reactor = SwooleTG.reactor;
+        ctx->port = serv->get_port_by_server_fd(conn->server_fd);
+        sock = ctx->sock = conn->socket;
+        if (!serv->single_thread) {
+            assert(conn->fd % serv->reactor_num == ctx->reactor->id);
+            assert(conn->fd % serv->reactor_num == SwooleTG.id);
+        }
+        return send_flags(serv, conn, sock) | SWR_SC_FOUND | (serv->send_yield ? SWR_SC_SEND_YIELD : 0) |
+#ifdef SW_HALFCLOSE_DRAIN
+               SWR_SC_HALFCLOSE |
+#endif
+               (Buffer::empty(sock->out_buffer) ? SWR_SC_OUT_EMPTY : 0) | (sock->direct_send ? SWR_SC_DIRECT_SEND : 0) |
+               ((uint64_t) ctx->length << 32);
+    case SWR_SERVER_OP_SC_SEND:
+        return (int64_t) sock->send(ctx->data, ctx->length, 0);
+    case SWR_SERVER_OP_SC_TOUCH_SEND:
+        conn->last_send_time = microtime();
+        return 0;
+    case SWR_SERVER_OP_ST_COUNT_SEND: {
+        sw_atomic_fetch_add(&serv->gs->response_count, 1);
+        sw_atomic_fetch_add(&serv->gs->total_send_bytes, ctx->length);
+        ListenPort *session_port = serv->get_port_by_session_id(ctx->session_id);
+        if (session_port) {
+            sw_atomic_fetch_add(&session_port->gs->response_count, 1);
+            sw_atomic_fetch_add(&session_port->gs->total_send_bytes, ctx->length);
+        }
+        if (sw_worker()) {
+            sw_worker()->response_count++;
+        }
+        return 0;
+    }
+    default:
+        return Server::rust_call(context, op, arg);
+    }
+}
+
 }  // namespace swoole
