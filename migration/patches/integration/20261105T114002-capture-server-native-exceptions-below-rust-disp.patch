 #include "swoole_rs_process.h"
@@ -82,4 +83,16 @@ static uint64_t server_call(void *context, uint32_t op, uint64_t arg);
 
+// Per-invocation custody permits nested operations to rethrow into their native
+// caller. No C++ exception crosses the Rust algorithm which requested the effect.
+struct ServerInvocation {
+    ServerRustContext *context;
+    swoole_rs::NativeException exception;
+};
+static ServerReply server_guarded_call(void *context, uint32_t op, uint64_t arg) {
+    auto *invocation = static_cast<ServerInvocation *>(context);
+    return invocation->exception.capture([&]() { return server_call(invocation->context, op, arg); });
+}
 static int64_t server_run(uint32_t operation, uint64_t arg, ServerRustContext *ctx) {
-    return swr_v1_server_run_state(operation, arg, ctx, server_call, ctx->serv ? ctx->serv->state_handle() : nullptr);
+    ServerInvocation invocation{ctx, {}};
+    return invocation.exception.finish(swr_v1_server_run_guarded(operation, arg, &invocation, server_guarded_call,
+                                        ctx->serv ? ctx->serv->state_handle() : nullptr));
 }
