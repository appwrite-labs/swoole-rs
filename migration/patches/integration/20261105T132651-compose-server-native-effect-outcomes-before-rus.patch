+// Ordinary C++ custody is inside the optional Zend/thread effect scope: no
+// exception may escape through its C/Rust transport frames.
+static void server_capture_call(void *context) {
+    auto *invocation = static_cast<ServerInvocation *>(context);
+    invocation->reply = invocation->exception.capture([&]() {
+        return server_call(invocation->context, invocation->op, invocation->arg);
+    });
+}
 static ServerReply server_guarded_call(void *context, uint32_t op, uint64_t arg) {
     auto *invocation = static_cast<ServerInvocation *>(context);
-    return invocation->exception.capture([&]() { return server_call(invocation->context, op, arg); });
+    invocation->op = op;
+    invocation->arg = arg;
+    invocation->reply = {0, 0};
+    if (invocation->provider) {
+        const int outcome = invocation->provider->invoke(server_capture_call, invocation);
+        if (outcome == 1 || outcome == 2) {
+            return {0, static_cast<uint32_t>(outcome + 1)};
+        }
+        if (outcome != 0) std::abort();
+    } else {
+        server_capture_call(invocation);
+    }
+    return invocation->reply;
 }
