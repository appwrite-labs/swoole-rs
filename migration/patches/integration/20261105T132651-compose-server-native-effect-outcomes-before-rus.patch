-                                        ctx->serv ? ctx->serv->state_handle() : nullptr));
+    const auto *provider = swoole_rs::native_effect_provider();
+    ServerReply reply;
+    {
+        ServerInvocation invocation{ctx, {}, provider, {}, 0, 0};
+        reply = swr_v1_server_run_guarded(operation, arg, &invocation, server_guarded_call,
+                                       ctx->serv ? ctx->serv->state_handle() : nullptr);
+        // C++ rethrow naturally unwinds invocation; nonlocal resume does not.
+        if (reply.fault <= 1) return invocation.exception.finish(reply);
+    }
+    // Both Rust state and native exception_ptr custody are gone before a Zend
+    // bailout or sticky whole-thread exit resumes at the native request boundary.
+    if (!provider || (reply.fault != 2 && reply.fault != 3)) std::abort();
+    provider->resume();
+    std::abort();
 }
