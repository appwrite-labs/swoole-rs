-
-#include "swoole_coroutine_context.h"
-#include "swoole_rs_coroutine.h"
-
-#ifndef SW_USE_THREAD_CONTEXT
-
-namespace swoole {
-namespace coroutine {
-
-// crates/coroutine/src/stack.rs allocates, marks, protects and frees the stack.
-static constexpr uint32_t STACK_FLAGS = 0
-#ifdef SW_CONTEXT_PROTECT_STACK_PAGE
-                                        | SWR_CTX_STACK_PROTECT
-#endif
-#ifdef SW_CONTEXT_DETECT_STACK_USAGE
-                                        | SWR_CTX_STACK_MARK
-#endif
-    ;
-
-Context::Context(size_t stack_size, CoroutineFunc fn, void *private_data)
-    : fn_(std::move(fn)), stack_size_(stack_size), private_data_(private_data) {
-    end_ = false;
-
-    stack_ = static_cast<char *>(swr_v1_context_stack_alloc(stack_size_, STACK_FLAGS));
-    if (!stack_) {
-        swoole_fatal_error(SW_ERROR_MALLOC_FAIL, "failed to malloc stack memory.");
-        exit(254);
-    }
-    swoole_trace_log(SW_TRACE_COROUTINE, "alloc stack: size=%u, ptr=%p", stack_size_, stack_);
-
-    void *sp = (void *) ((char *) stack_ + stack_size_);
-#ifdef USE_VALGRIND
-    valgrind_stack_id = VALGRIND_STACK_REGISTER(sp, stack_);
-#endif
-
-#ifdef USE_UCONTEXT
-    if (-1 == getcontext(&ctx_)) {
-        swoole_throw_error(SW_ERROR_CO_GETCONTEXT_FAILED);
-        swr_v1_context_stack_free(stack_, stack_size_, STACK_FLAGS);
-        return;
-    }
-    ctx_.uc_stack.ss_sp = stack_;
-    ctx_.uc_stack.ss_size = stack_size;
-    ctx_.uc_link = nullptr;
-    makecontext(&ctx_, (void (*)(void)) & context_func, 1, this);
-#else
-    ctx_ = swoole_make_fcontext(sp, stack_size_, (void (*)(transfer_t)) & context_func);
-    swap_ctx_ = nullptr;
-#endif
-}
-
-Context::~Context() {
-    if (stack_) {
-        swoole_trace_log(SW_TRACE_COROUTINE, "free stack: ptr=%p", stack_);
-#ifdef USE_VALGRIND
-        VALGRIND_STACK_DEREGISTER(valgrind_stack_id);
-#endif
-        swr_v1_context_stack_free(stack_, stack_size_, STACK_FLAGS);
-        stack_ = nullptr;
-    }
-}
-
-#ifdef SW_CONTEXT_DETECT_STACK_USAGE
-ssize_t Context::get_stack_usage() {
-    return swr_v1_context_stack_usage(reinterpret_cast<const uint8_t *>(stack_), stack_size_);
-}
-#endif
-
-bool Context::swap_in() {
-#ifdef SWR_ASAN_FIBERS
-    void *fake_stack = nullptr;
-    __sanitizer_start_switch_fiber(&fake_stack, get_stack(), get_stack_size());
-#endif
-#ifdef USE_UCONTEXT
-    bool swapped = 0 == swapcontext(&swap_ctx_, &ctx_);
-#else
-    coroutine_transfer_t transfer_data = swoole_jump_fcontext(ctx_, (void *) this);
-    ctx_ = transfer_data.fctx;
-    bool swapped = true;
-#endif
-#ifdef SWR_ASAN_FIBERS
-    __sanitizer_finish_switch_fiber(fake_stack, nullptr, nullptr);
-#endif
-    return swapped;
-}
-
-bool Context::swap_out() {
-#ifdef SWR_ASAN_FIBERS
-    // A finished context never resumes, so ASan may free its fake stack now.
-    void *fake_stack = nullptr;
-    __sanitizer_start_switch_fiber(is_end() ? nullptr : &fake_stack, asan_caller_bottom_, asan_caller_size_);
-#endif
-#ifdef USE_UCONTEXT
-    bool swapped = 0 == swapcontext(&ctx_, &swap_ctx_);
-#else
-    coroutine_transfer_t transfer_data = swoole_jump_fcontext(swap_ctx_, (void *) this);
-    swap_ctx_ = transfer_data.fctx;
-    bool swapped = true;
-#endif
-#ifdef SWR_ASAN_FIBERS
-    __sanitizer_finish_switch_fiber(fake_stack, &asan_caller_bottom_, &asan_caller_size_);
-#endif
-    return swapped;
-}
-
-void Context::context_func(coroutine_transfer_t arg) {
-#if defined(USE_UCONTEXT) || defined(SW_USE_THREAD_CONTEXT)
-    auto *_this = (Context *) arg;
-#else
-    auto *_this = (Context *) arg.data;
-    _this->swap_ctx_ = arg.fctx;
-#endif
-#ifdef SWR_ASAN_FIBERS
-    __sanitizer_finish_switch_fiber(nullptr, &_this->asan_caller_bottom_, &_this->asan_caller_size_);
-#endif
-    _this->fn_(_this->private_data_);
-    _this->end_ = true;
-    _this->swap_out();
-}
-}  // namespace coroutine
-}  // namespace swoole
-#endif
