@@ -150,3 +150,25 @@ class Coroutine {
 
-    static SW_THREAD_LOCAL std::unordered_map<long, Coroutine *> coroutines;
+    // Upstream's range-for over the live coroutines (`co.second` is each one),
+    // newest first; Rust keeps them.
+    static struct Live {
+        struct iterator {
+            std::pair<long, Coroutine *> entry;
+            std::pair<long, Coroutine *> &operator*() {
+                return entry;
+            }
+            iterator &operator++() {
+                entry.second = static_cast<Coroutine *>(swr_v1_coroutine_older(entry.first, &entry.first));
+                return *this;
+            }
+            bool operator!=(const iterator &other) const {
+                return entry.second != other.entry.second;
+            }
+        };
+        iterator begin() const {
+            return ++iterator{{LONG_MAX, nullptr}};
+        }
+        iterator end() const {
+            return {{0, nullptr}};
+        }
+    } coroutines;
 
