-// The current coroutine and its inline members, for Rust's coroutine waitpid
-// (crates/reactor/src/wait_upstream.rs).
-extern "C" {
-void *swr_v1_coroutine_current() {
-    return swoole::Coroutine::get_current();
-}
-void swr_v1_coroutine_native_resume(void *co) {
-    static_cast<swoole::Coroutine *>(co)->resume();
-}
-bool swr_v1_coroutine_timed_out(void *co) {
-    return static_cast<swoole::Coroutine *>(co)->is_timedout();
-}
-}
-
-long swoole_coroutine_create(void (*routine)(void *), void *arg) {
-    if (sw_likely(swoole_event_is_available())) {
-        return swoole::Coroutine::create(routine, arg);
-    } else {
-        if (swoole_event_init(SW_EVENTLOOP_WAIT_EXIT) < 0) {
-            return -1;
-        }
-        swoole::Coroutine::activate();
-        long cid = swoole::Coroutine::create(routine, arg);
-        swoole_event_wait();
-        swoole::Coroutine::deactivate();
-        return cid;
-    }
-}
