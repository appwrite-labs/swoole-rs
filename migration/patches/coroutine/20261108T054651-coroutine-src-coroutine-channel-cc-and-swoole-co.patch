-// A facade over the Rust-owned channel (crates/coroutine/src/channel.rs): its
-// state and pop/push/close live there; C++ supplies timers, yield and resume.
-class Channel {
-  public:
-    enum Opcode {
-        PRODUCER = 1,
-        CONSUMER = 2,
-    };
-
-    enum ErrorCode {
-        ERROR_OK = 0,
-        ERROR_TIMEOUT = -1,
-        ERROR_CLOSED = -2,
-        ERROR_CANCELED = -3,
-    };
-
-    struct TimeoutMessage {
-        Channel *chan;
-        Opcode type;
-        Coroutine *co;
-        bool error;
-        TimerNode *timer;
-    };
-
-    void *pop(double timeout = -1);
-    bool push(void *data, double timeout = -1);
-    bool close();
-
-    explicit Channel(size_t _capacity = 1) : rs_(swr_v1_channel_new(_capacity)) {
-        if (!rs_) {
-            throw std::bad_alloc();
-        }
-    }
-    Channel(const Channel &) = delete;
-    Channel &operator=(const Channel &) = delete;
-
-    ~Channel() {
-        if (producer_num()) {
-            swoole_error_log(SW_LOG_WARNING,
-                             SW_ERROR_CO_HAS_BEEN_DISCARDED,
-                             "channel is destroyed, %zu producers will be discarded",
-                             producer_num());
-        }
-        if (consumer_num()) {
-            swoole_error_log(SW_LOG_WARNING,
-                             SW_ERROR_CO_HAS_BEEN_DISCARDED,
-                             "channel is destroyed, %zu consumers will be discarded",
-                             consumer_num());
-        }
-        swr_v1_channel_free(rs_);
-    }
-
-    bool is_closed() const {
-        return swr_v1_channel_read(rs_).closed;
-    }
-
-    bool is_empty() const {
-        return swr_v1_channel_read(rs_).empty;
-    }
-
-    bool is_full() const {
-        return swr_v1_channel_read(rs_).full;
-    }
-
-    size_t length() const {
-        return swr_v1_channel_read(rs_).length;
-    }
-
-    size_t consumer_num() const {
-        return swr_v1_channel_read(rs_).consumers;
-    }
-
-    size_t producer_num() const {
-        return swr_v1_channel_read(rs_).producers;
-    }
-
-    void *pop_data() {
-        return swr_v1_channel_pop_data(rs_);
-    }
-
-    int get_error() const {
-        return swr_v1_channel_read(rs_).error;
-    }
-
-  protected:
-    swr_v1_channel *rs_;
-
-    friend struct ChannelCall;
-    static void timer_callback(Timer *timer, TimerNode *tnode);
-};
-//-------------------------------------------------------------------------------
-}  // namespace coroutine
-}  // namespace swoole
