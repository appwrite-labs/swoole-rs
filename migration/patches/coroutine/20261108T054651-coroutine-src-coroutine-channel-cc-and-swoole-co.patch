-  +----------------------------------------------------------------------+
-  | Author: Tianfeng Han  <rango@swoole.com>                             |
-  +----------------------------------------------------------------------+
-*/
-
-#include "swoole_coroutine_channel.h"
-
-
-namespace swoole {
-namespace coroutine {
-
-void Channel::timer_callback(Timer *timer, TimerNode *tnode) {
-    auto *msg = static_cast<TimeoutMessage *>(tnode->data);
-    msg->error = true;
-    msg->timer = nullptr;
-    swr_v1_channel_remove(msg->chan->rs_, msg->type, msg->co);
-    msg->co->resume();
-}
-
-// One pop/push/close: the effects Rust calls back into.
-struct ChannelCall {
-    Channel::TimeoutMessage msg;
-    swr_v1_channel *rs;
-    double timeout;
-
-    static void arm_timer(void *ctx) {
-        auto *call = static_cast<ChannelCall *>(ctx);
-        call->msg.timer = swoole_timer_add(call->timeout, false, Channel::timer_callback, &call->msg);
-    }
-
-    static void delete_timer(void *ctx) {
-        auto *call = static_cast<ChannelCall *>(ctx);
-        if (call->msg.timer) {
-            swoole_timer_del(call->msg.timer);
-        }
-    }
-
-    static uint32_t suspend(void *ctx, uint32_t type) {
-        auto *call = static_cast<ChannelCall *>(ctx);
-        Coroutine *co = call->msg.co;
-        if (type == Channel::PRODUCER) {
-            swoole_trace_log(SW_TRACE_CHANNEL, "producer cid=%ld", co->get_cid());
-        } else {
-            swoole_trace_log(SW_TRACE_CHANNEL, "consumer cid=%ld", co->get_cid());
-        }
-        swr_v1_channel *rs = call->rs;
-        Coroutine::CancelFunc cancel_fn = [rs, type](Coroutine *co) {
-            swr_v1_channel_remove(rs, type, co);
-            co->resume();
-            return true;
-        };
-        co->yield(&cancel_fn);
-        return (co->is_canceled() ? SWR_CH_CANCELED : 0u) | (call->msg.error ? SWR_CH_TIMEDOUT : 0u);
-    }
-
-    static void resume(void *ctx, uint32_t type, void *token) {
-        auto *co = static_cast<Coroutine *>(token);
-        if (type == Channel::PRODUCER) {
-            swoole_trace_log(SW_TRACE_CHANNEL, "resume producer cid=%ld", co->get_cid());
-        } else {
-            swoole_trace_log(SW_TRACE_CHANNEL, "resume consumer cid=%ld", co->get_cid());
-        }
-        co->resume();
-    }
-
-    static void trace(void *ctx, uint32_t what, size_t length) {
-        if (what == SWR_CH_TRACE_PUSHED) {
-            swoole_trace_log(SW_TRACE_CHANNEL, "push data to channel, count=%ld", (long) length);
-        } else {
-            swoole_trace_log(SW_TRACE_CHANNEL, "channel closed");
-        }
-    }
-
-    swr_v1_channel_effects effects() {
-        return {this, msg.co, arm_timer, delete_timer, suspend, resume, trace};
-    }
-};
-
-void *Channel::pop(double timeout) {
-    Coroutine *current_co = Coroutine::get_current_safe();
-    ChannelCall call{{this, CONSUMER, current_co, false, nullptr}, rs_, timeout};
-    const auto effects = call.effects();
-    const auto out = swr_v1_channel_pop(rs_, timeout > 0, &effects);
-    if (out.status == SWR_CH_ALLOCATION_REFUSED) {
-        throw std::bad_alloc();
-    }
-    return out.data;
-}
-
-bool Channel::push(void *data, double timeout) {
-    Coroutine *current_co = Coroutine::get_current_safe();
-    ChannelCall call{{this, PRODUCER, current_co, false, nullptr}, rs_, timeout};
-    const auto effects = call.effects();
-    const int32_t status = swr_v1_channel_push(rs_, timeout > 0, data, &effects);
-    if (status == SWR_CH_ALLOCATION_REFUSED) {
-        throw std::bad_alloc();
-    }
-    return status == ERROR_OK;
-}
-
-bool Channel::close() {
-    ChannelCall call{{this, PRODUCER, nullptr, false, nullptr}, rs_, 0};
-    const auto effects = call.effects();
-    return swr_v1_channel_close(rs_, &effects);
-}
-
-}  // namespace coroutine
-}  // namespace swoole
