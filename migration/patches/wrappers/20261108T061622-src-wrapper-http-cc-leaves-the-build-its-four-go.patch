-// crates/wrappers/src/http.rs runs the llhttp and multipart callbacks; these are the
-// effects on the Context it asks for.
-static_assert(HTTP_DELETE == 0 && HTTP_POST == 3 && HTTP_PUT == 4 && HTTP_PATCH == 28 && HPE_PAUSED == 21,
-              "wrapper method ABI");
-static_assert(offsetof(llhttp_t, data) == 48 && offsetof(llhttp_t, method) == 73 &&
-                  sizeof(llhttp_settings_t) == 25 * sizeof(void *),
-              "crates/wrappers/src/http.rs: Llhttp is llhttp_t's head");
-static_assert(offsetof(multipart_parser, fp) == 32 && offsetof(multipart_parser, data) == 40 &&
-                  sizeof(multipart_parser_settings) == 7 * sizeof(void *),
-              "crates/wrappers/src/http.rs: Multipart is multipart_parser's head");
-
-static uint64_t wrapper_native(
-    void *context, uint32_t op, void *object, const uint8_t *a, size_t an, const uint8_t *b, size_t bn) {
-    auto *ctx = static_cast<Context *>(context);
-    std::string first(reinterpret_cast<const char *>(a), a ? an : 0);
-    auto *fp = static_cast<FILE *>(object);
-    switch (op) {
-    case SWR_WRAPPER_HTTP_PATH: ctx->request_path = first; return 0;
-    case SWR_WRAPPER_HTTP_QUERY: ctx->query_string = first; return 0;
-    case SWR_WRAPPER_HTTP_HEADER: ctx->headers[first] = std::string(reinterpret_cast<const char *>(b), bn); return 0;
-    case SWR_WRAPPER_HTTP_FORM_URLENCODED: ctx->post_form_urlencoded = true; return 0;
-    case SWR_WRAPPER_HTTP_HEADERS_COMPLETE: {
-        auto *parser = static_cast<llhttp_t *>(object);
-        ctx->version = parser->http_major * 100 + parser->http_minor;
-        ctx->server_protocol = std::string(ctx->version == 101 ? "HTTP/1.1" : "HTTP/1.0");
-        ctx->keepalive = llhttp_should_keep_alive(parser);
-        return 0;
-    }
-    case SWR_WRAPPER_HTTP_BODY: ctx->body.append(first); return 0;
-    case SWR_WRAPPER_HTTP_MULTIPART_NEW: {
-        char *boundary_str;
-        int boundary_len;
-        if (!parse_multipart_boundary(first.data(), first.size(), sizeof("multipart/form-data") - 1, &boundary_str, &boundary_len)) { return 0; }
-        auto *mt_parser = multipart_parser_init(boundary_str, boundary_len, static_cast<const multipart_parser_settings *>(object));
-        if (mt_parser) {
-            swoole_log_as("http_server::http_request_on_header_value",
-                          swoole_trace_log(SW_TRACE_HTTP, "form_data, boundary_str=%s", boundary_str));
-        }
-        return reinterpret_cast<uintptr_t>(mt_parser);
-    }
-    case SWR_WRAPPER_HTTP_MULTIPART_FREE: {
-        auto *mt_parser = static_cast<multipart_parser *>(object);
-        if (mt_parser->fp) { fclose(mt_parser->fp); }
-        multipart_parser_free(mt_parser);
-        return 0;
-    }
-    case SWR_WRAPPER_HTTP_MULTIPART_EXECUTE:
-        return multipart_parser_execute(static_cast<multipart_parser *>(object), reinterpret_cast<const char *>(a), an);
-    case SWR_WRAPPER_HTTP_LOG_PARSE:
-        swoole_log_as("http_server::http_request_on_body",
-                      swoole_error_log(SW_LOG_WARNING, SW_ERROR_SERVER_INVALID_REQUEST, "parse multipart body failed, %zu/%zu bytes processed", an, bn));
-        return 0;
-    case SWR_WRAPPER_HTTP_FILE: ctx->files[first] = std::string(reinterpret_cast<const char *>(b), bn); return 0;
-    case SWR_WRAPPER_HTTP_HAS_FILE: return ctx->files.find(first) != ctx->files.end();
-    case SWR_WRAPPER_HTTP_WRITE: {
-        ssize_t n = fwrite(a, sizeof(char), an, fp);
-        if (n == (off_t) an) { return 0; }
-        int error = errno;
-        fclose(fp);
-        std::string form(reinterpret_cast<const char *>(b), bn);
-        auto file = ctx->files.find(form);
-        if (file != ctx->files.end()) { unlink(file->second.c_str()); }
-        ctx->files[form] = "ERROR(1)";
-        errno = error;
-        swoole_log_as("http_server::multipart_body_on_data", swoole_sys_warning("write upload file failed"));
-        return 1;
-    }
-    case SWR_WRAPPER_HTTP_OPEN: {
-        char file_path[SW_HTTP_UPLOAD_TMPDIR_SIZE] = "/tmp/swoole.upfile.XXXXXX";
-        int tmpfile = swoole_tmpfile(file_path);
-        if (tmpfile < 0) { return 0; }
-        FILE *opened = fdopen(tmpfile, "wb+");
-        if (!opened) {
-            int error = errno; close(tmpfile); unlink(file_path); errno = error;
-            swoole_log_as("http_server::multipart_body_on_header_complete", swoole_sys_warning("fopen(%s) failed", file_path));
-            return 0;
-        }
-        // No exception may cross the Rust frames above.
-        try { ctx->files.emplace(first, file_path); }
-        catch (...) { int error = errno; fclose(opened); unlink(file_path); errno = error; std::terminate(); }
-        return reinterpret_cast<uintptr_t>(opened);
-    }
-    case SWR_WRAPPER_HTTP_FORM_DATA: ctx->form_data[first] = std::string(reinterpret_cast<const char *>(b), bn); return 0;
-    case SWR_WRAPPER_HTTP_FCLOSE: fclose(fp); return 0;
-    case SWR_WRAPPER_HTTP_BOUNDARY: {
-        char *boundary_str;
-        int boundary_len;
-        return parse_multipart_boundary(first.data(), first.size(), sizeof("multipart/form-data") - 1, &boundary_str, &boundary_len);
-    }
-    default: abort();
-    }
-}
-
-struct ContextImpl {
-    llhttp_t parser{};
-    SwrWrapperRequest *state = swr_v1_wrappers_request_new();
-    ContextImpl() = default;
-    ContextImpl(const ContextImpl &) = delete;
-    ContextImpl &operator=(const ContextImpl &) = delete;
-    ~ContextImpl() { swr_v1_wrappers_request_free(state); }
-    bool parse(Context &ctx, const char *at, size_t length) {
-        if (!state) { return false; }
-        swr_v1_wrappers_request_bind(state, &ctx, wrapper_native);
-        swoole_llhttp_parser_init(&parser, HTTP_REQUEST, state);
-        swoole_llhttp_parser_execute(&parser, static_cast<const llhttp_settings_t *>(swr_v1_wrappers_http_settings()), at, length);
-        SwrWrapperView v{};
-        swr_v1_wrappers_request_view(state, &v);
-        return parser.error == HPE_OK && (v.flags & 1);
-    }
-};
-
-bool Context::end(const char *data, size_t length) {
-    char buf[1024];
-    sw_tg_buffer()->clear();
-    sw_tg_buffer()->append(SW_STRL("HTTP/1.1 "));
-    sw_tg_buffer()->append(get_status_message(response.code));
-    sw_tg_buffer()->append(SW_STRL("\r\n"));
-    if (length > 0) {
-        static_assert(sizeof(buf) >= sizeof(size_t) * 8, "decimal length capacity");
-        size_t digits = swr_v1_wrappers_content_length(length, (uint8_t *) buf, sizeof(buf));
-        response.headers["Content-Length"] = std::string(buf, digits);
-    }
-    for (auto &iter : response.headers) {
-        size_t n = swr_v1_wrappers_header_wire((const uint8_t *) iter.first.data(), iter.first.size(), (const uint8_t *) iter.second.data(), iter.second.size(), (uint8_t *) buf, sizeof(buf));
-        sw_tg_buffer()->append(buf, n);
-    }
-    sw_tg_buffer()->append(SW_STRL("\r\n"));
-    uint32_t action = SWR_WRAPPER_RESPONSE_START;
-    bool succeeded = true, keepalive_snapshot = false;
-    for (;;) {
-        action = swr_v1_wrappers_response_next(action, length, succeeded, keepalive_snapshot);
-        switch (action) {
-        case SWR_WRAPPER_RESPONSE_HEADER:
-            succeeded = server_->send(session_id_, sw_tg_buffer()->str, sw_tg_buffer()->length);
-            if (!succeeded) swoole_warning("failed to send HTTP header");
-            break;
-        case SWR_WRAPPER_RESPONSE_BODY:
-            succeeded = server_->send(session_id_, data, length);
-            if (!succeeded) swoole_warning("failed to send HTTP body");
-            break;
-        case SWR_WRAPPER_RESPONSE_OBSERVE:
-            keepalive_snapshot = keepalive;
-            break;
-        case SWR_WRAPPER_RESPONSE_CLOSE:
-            server_->close(session_id_, false);
-            break;
-        case SWR_WRAPPER_RESPONSE_DONE:
-            return true;
-        default:
-            return false;
-        }
-    }
-}
-
-Context::~Context() {
-    for (auto &kv : files) {
-        if (file_exists(kv.second)) {
-            unlink(kv.second.c_str());
-        }
-    }
-}
-
-static std::function<void(Context &ctx)> http_server_on_request;
-
-std::shared_ptr<Server> listen(const std::string &addr, const std::function<void(Context &ctx)> &cb, int mode) {
-    auto server = std::make_shared<Server>(static_cast<Server::Mode>(mode));
-    auto address = swr_v1_wrappers_listener_plan((const uint8_t *) addr.data(), addr.size());
-    auto index = address.separator;
-    if (!address.valid) {
-        swoole_warning("incorrect server listening address");
-        return nullptr;
-    }
-
-    std::string host = addr.substr(0, index);
-    if (address.default_host) {
-        host = "0.0.0.0";
-    }
-
-    int port = sw_atoi(addr.substr(index + 1).c_str());
-    auto port_object = server->add_port(SW_SOCK_TCP, host.c_str(), port);
-    if (!port_object) {
-        return nullptr;
-    }
-
-    http_server_on_request = cb;
-
-    server->onReceive = [](Server *server, RecvData *req) {
-        SessionId session_id = req->info.fd;
-        Connection *conn = server->get_connection_verify_no_ssl(session_id);
-        if (!conn) {
-            swoole_error_log(SW_LOG_TRACE, SW_ERROR_SESSION_NOT_EXIST, "session[%ld] is closed", session_id);
-            return SW_OK;
-        }
-        ContextImpl impl;
-        Context ctx(server, session_id, &impl);
-        if (impl.parse(ctx, req->data, req->info.len)) {
-            http_server_on_request(ctx);
-        } else {
-            server->send(req->session_id(), SW_STRL(SW_HTTP_BAD_REQUEST_PACKET));
-        }
-        return SW_OK;
-    };
-
-    port_object->open_http_protocol = true;
-
-    if (server->create() == SW_ERR) {
-        return nullptr;
-    }
-
-    return server;
-}
-}  // namespace http_server
-}  // namespace swoole
