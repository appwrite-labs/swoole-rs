-
-#include "swoole_reactor.h"
-#include "swoole_timer.h"
-#include "swoole_signal.h"
-
-#include <exception>
-#include <memory>
-#include <stdexcept>
-
-namespace swoole {
-TimerNode *Timer::apply(const swr_v1_timer_view &view) {
-#pragma GCC diagnostic push
-#pragma GCC diagnostic ignored "-Winvalid-offsetof"
-    // crates/timer/src/wrapper.rs (the swoole_timer_* API) reads these.
-    static_assert(sizeof(Timer) == 112 && offsetof(Timer, queue_) == 8 && offsetof(Timer, base_time) == 32 &&
-                      offsetof(Timer, next_msec_) == 40 && offsetof(TimerNode, exec_msec) == 16 &&
-                      offsetof(TimerNode, removed) == 48,
-                  "swoole::Timer and TimerNode layout");
-#pragma GCC diagnostic pop
-    auto *node = static_cast<TimerNode *>(view.token);
-    node->id = view.id;
-    node->exec_msec = view.deadline;
-    node->interval = view.interval;
-    node->exec_count = view.exec_count;
-    node->round = view.birth_round;
-    node->removed = view.removed != 0;
-    return node;
-}
-
-Timer::Timer(bool manually_trigger) {
-    const int32_t status = swr_v1_timer_create(&queue_);
-    if (status == SWR_TIMER_NOMEM) {
-        throw std::bad_alloc();
-    }
-    check(status);
-    next_msec_ = -1;
-    base_time = get_absolute_msec();
-    try {
-        init(manually_trigger);
-    } catch (...) {
-        swr_v1_timer_release(queue_);
-        throw;
-    }
-}
-
-void Timer::init(bool manually_trigger) {
-    const auto backend = swr_v1_timer_backend(manually_trigger, SwooleTG.reactor != nullptr);
-    if (backend == 0) {
-        set = [](Timer *, long) -> int { return SW_OK; };
-        close = [](Timer *) {};
-        return;
-    }
-    if (backend == 1) {
-        init_with_reactor(SwooleTG.reactor);
-    } else {
-        set = [](Timer *, long next_msec) { return swr_v1_timer_system_set(next_msec); };
-        close = [](Timer *) { swr_v1_timer_system_set(-1); };
-        swoole_signal_set(SIGALRM, [](int sig) { SwooleG.signal_alarm = true; });
-    }
-}
-
-void Timer::release_node(TimerNode *tnode) {
-    {
-        std::unique_ptr<TimerNode> owner(tnode);
-        if (tnode->destructor) {
-            tnode->destructor(tnode);
-        }
-    }
-    // Finish detached native ownership before a PHP destructor propagates bailout.
-    const auto bailout = pending_bailout_;
-    pending_bailout_ = nullptr;
-    if (bailout) bailout();
-}
-
-void Timer::init_with_reactor(Reactor *reactor) {
-    reactor_ = reactor;
-    set = [](Timer *timer, long exec_msec) -> int {
-        timer->reactor_->timeout_msec = exec_msec;
-        return SW_OK;
-    };
-    close = [](Timer *timer) { timer->set(timer, -1); };
-
-    reactor->set_end_callback(Reactor::PRIORITY_TIMER, [this](Reactor *) { select(); });
-
-    reactor->set_exit_condition(Reactor::EXIT_CONDITION_TIMER,
-                                [this](Reactor *reactor, size_t &event_num) -> bool { return count() == 0; });
-
-    reactor->add_destroy_callback(
-        [](void *data) {
-            if (swoole_timer_is_available()) {
-                // A coroutine bailout longjmps out of the timer callback that resumed it.
-                if (static_cast<Reactor *>(data)->bailout) {
-                    sw_timer()->abandon_selection();
-                }
-                swoole_timer_free();
-            }
-        },
-        reactor);
-}
-
-void Timer::reinit(bool manually_trigger) {
-    close(this);
-    init(manually_trigger);
-    set(this, next_msec_);
-}
-
-Timer::~Timer() {
-    check(swr_v1_timer_close(queue_));
-    if (close) {
-        close(this);
-    }
-    swr_v1_timer_view view{};
-    // A forked child or terminal Zend bailout will never resume this selection.
-    // Ordinary same-process deletion during a live callback remains forbidden.
-    if (abandoned_selection_ || getpid() != owner_pid_) {
-        swr_v1_timer_stats stats{};
-        check(swr_v1_timer_stats_get(queue_, &stats));
-        if (stats.active_id != 0) {
-            if (swr_v1_timer_complete(queue_, stats.active_id, &view) != SWR_TIMER_RELEASE) {
-                std::terminate();
-            }
-        }
-        if (stats.selecting) {
-            int64_t delay;
-            check(swr_v1_timer_end(queue_, &delay));
-        }
-        if (stats.active_id != 0) {
-            release_node(apply(view));
-        }
-    }
-    int32_t status;
-    while ((status = swr_v1_timer_drain(queue_, &view)) == SWR_TIMER_RELEASE) {
-        release_node(apply(view));
-    }
-    // Native deletion during an active callback is outside the frozen contract.
-    if (status != SWR_TIMER_EMPTY || swr_v1_timer_release(queue_) != SWR_TIMER_OK) {
-        std::terminate();
-    }
-}
-
-TimerNode *Timer::add(long _msec, bool persistent, void *data, const TimerCallback &callback) {
-    if (sw_unlikely(_msec <= 0)) {
-        swoole_error_log(SW_LOG_WARNING, SW_ERROR_INVALID_PARAMS, "msec value[%ld] is invalid", _msec);
-        return nullptr;
-    }
-    std::unique_ptr<TimerNode> node(new TimerNode{});
-    node->data = data;
-    node->type = TimerNode::TYPE_KERNEL;
-    node->callback = callback;
-    swr_v1_timer_view view{};
-    const int32_t status = swr_v1_timer_add(queue_, get_relative_msec(), _msec, persistent, node.get(), &view);
-    if (status != SWR_TIMER_OK) {
-        swoole_error_log(SW_LOG_WARNING, SW_ERROR_INVALID_PARAMS, "Rust timer add failed: status=%d", status);
-        return nullptr;
-    }
-    node.release();
-    auto *result = apply(view);
-    const auto next = swr_v1_timer_rearm_after_add(next_msec_, _msec);
-    if (next != next_msec_) {
-        set(this, next);
-        next_msec_ = next;
-    }
-    return result;
-}
-
-bool Timer::remove(long id) {
-    swr_v1_timer_view view{};
-    const int32_t status = swr_v1_timer_remove(queue_, id, &view);
-    if (status == SWR_TIMER_DEFERRED) {
-        apply(view);
-        return true;
-    }
-    if (status != SWR_TIMER_RELEASE) {
-        return false;
-    }
-    release_node(apply(view));
-    return true;
-}
-
-void Timer::select() {
-    const int32_t begin = swr_v1_timer_begin(queue_, get_relative_msec());
-    if (begin == SWR_TIMER_BUSY || begin == SWR_TIMER_CLOSING) {
-        return;
-    }
-    check(begin);
-    auto complete = [this](int64_t id) {
-        swr_v1_timer_view view{};
-        const int32_t status = swr_v1_timer_complete(queue_, id, &view);
-        if (status == SWR_TIMER_OK) {
-            apply(view);
-        } else if (status == SWR_TIMER_RELEASE || status == SWR_TIMER_RELEASE_OVERFLOW) {
-            release_node(apply(view));
-            if (status == SWR_TIMER_RELEASE_OVERFLOW) {
-                swoole_error_log(SW_LOG_WARNING, SW_ERROR_INVALID_PARAMS, "Rust timer repeat limit exceeded");
-            }
-        } else {
-            check(status);
-        }
-    };
-    auto end = [this]() {
-        int64_t delay = -1;
-        check(swr_v1_timer_end(queue_, &delay));
-        next_msec_ = delay;
-        set(this, next_msec_);
-    };
-    try {
-        while (true) {
-            swr_v1_timer_view view{};
-            const int32_t status = swr_v1_timer_next(queue_, &view);
-            if (status == SWR_TIMER_EMPTY || status == SWR_TIMER_CLOSING) {
-                break;
-            }
-            check(status);
-            auto *node = apply(view);
-            if (!node->removed) {
-                node->callback(this, node);
-            }
-            complete(view.id);
-        }
-    } catch (...) {
-        const auto failure = std::current_exception();
-        swr_v1_timer_stats stats{};
-        if (swr_v1_timer_stats_get(queue_, &stats) == SWR_TIMER_OK && stats.active_id != 0) {
-            try {
-                complete(stats.active_id);
-            } catch (...) {
-                // Preserve the original callback failure after ownership detaches.
-            }
-        }
-        try {
-            end();
-        } catch (...) {
-            // The primary failure is rethrown after selection cleanup.
-        }
-        std::rethrow_exception(failure);
-    }
-    end();
-}
-}  // namespace swoole
