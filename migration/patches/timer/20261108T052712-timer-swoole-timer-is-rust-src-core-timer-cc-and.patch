-
-#define SW_TIMER_MIN_MS 1
-#define SW_TIMER_MIN_SEC 0.001
-#define SW_TIMER_MAX_MS LONG_MAX
-#define SW_TIMER_MAX_SEC ((double) LONG_MAX / 1000)
-
-namespace swoole {
-static_assert(sizeof(long) == 8, "Timer ABI v1 requires a 64-bit native long");
-typedef std::function<void(TimerNode *)> TimerDestructor;
-
-struct TimerNode {
-    enum Type {
-        TYPE_KERNEL,
-        TYPE_PHP,
-    };
-    long id;
-    Type type;
-    int64_t exec_msec;
-    int64_t interval;
-    uint64_t exec_count;
-    uint64_t round;
-    bool removed;
-    TimerCallback callback;
-    void *data;
-    TimerDestructor destructor;
-};
-
-class Timer {
-    /*--------------signal timer--------------*/
-    Reactor *reactor_ = nullptr;
-    swr_v1_timer *queue_ = nullptr;
-    const pid_t owner_pid_ = getpid();
-    bool abandoned_selection_ = false;
-    void (*pending_bailout_)() = nullptr;
-    static TimerNode *apply(const swr_v1_timer_view &view);
-    static void check(int32_t status) {
-        if (status != SWR_TIMER_OK) throw std::runtime_error("Rust timer queue operation failed");
-    }
-    /*---------------event timer--------------*/
-    int64_t base_time;
-    /**
-     * The time when the next timer will trigger, in milliseconds.
-     * This event will serve as the timeout for the event loop's epoll/poll/kqueue,
-     * or be set as the trigger time for the system clock.
-     */
-    int64_t next_msec_;
-    /*----------------------------------------*/
-    std::function<int(Timer *timer, long exec_msec)> set;
-    std::function<void(Timer *timer)> close;
-
-    void init(bool manually_trigger);
-    void init_with_reactor(Reactor *reactor);
-    void release_node(TimerNode *tnode);
-
-  public:
-    explicit Timer(bool manually_trigger);
-    ~Timer();
-
-    int64_t get_relative_msec() const {
-        return swr_v1_timer_relative_msec(get_absolute_msec(), base_time);
-    }
-
-    int64_t get_next_msec() const {
-        return next_msec_;
-    }
-
-    static int64_t get_absolute_msec() {
-        return time<std::chrono::milliseconds>(true);
-    }
-
-    Reactor *get_reactor() const {
-        return reactor_;
-    }
-
-    TimerNode *add(long _msec, bool persistent, void *data, const TimerCallback &callback);
-    bool remove(TimerNode *tnode) { return tnode && remove(tnode->id); }
-    void update(const TimerNode *tnode) const {
-        if (!tnode) return;
-        swr_v1_timer_view view{};
-        auto status = swr_v1_timer_update(queue_, tnode->id, tnode->exec_msec, &view);
-        if (status == SWR_TIMER_OK) apply(view);
-        else if (swr_v1_timer_get(queue_, tnode->id, &view) == SWR_TIMER_OK) apply(view);
-    }
-    void delay(TimerNode *tnode, long delay_ms) const {
-        if (!tnode) return;
-        const auto now = get_relative_msec();
-        int64_t deadline;
-        if (!swr_v1_timer_delay_deadline(now, tnode->exec_msec, delay_ms, &deadline)) return;
-        swr_v1_timer_view view{};
-        if (swr_v1_timer_update(queue_, tnode->id, deadline, &view) == SWR_TIMER_OK) apply(view);
-    }
-    void reinit(bool manually_trigger = false);
-    void select();
-    // Only after a caught Zend bailout whose native selection will never resume.
-    void abandon_selection(void (*bailout)() = nullptr) {
-        abandoned_selection_ = true;
-        pending_bailout_ = bailout;
-    }
-
-    // Every view Rust hands back is applied to its node, so the node is current.
-    TimerNode *get(long id) const {
-        return static_cast<TimerNode *>(swr_v1_timer_token(queue_, id));
-    }
-
-    TimerNode *get(long id, const TimerNode::Type type) {
-        TimerNode *tnode = get(id);
-        return (tnode && tnode->type == type) ? tnode : nullptr;
-    }
-
-    size_t count() const {
-        swr_v1_timer_stats stats{};
-        check(swr_v1_timer_stats_get(queue_, &stats));
-        return stats.count;
-    }
-
-    uint64_t get_round() const {
-        swr_v1_timer_stats stats{};
-        check(swr_v1_timer_stats_get(queue_, &stats));
-        return stats.round;
-    }
-
-    bool remove(long id);
-
-    std::vector<int64_t> get_ids() const {
-        std::vector<int64_t> ids(count());
-        size_t copied = 0;
-        check(swr_v1_timer_ids(queue_, ids.data(), ids.size(), &copied));
-        ids.resize(copied);
-        return ids;
-    }
-};
-
-static inline long sec2msec(const long sec) {
-    return sec * 1000;
-}
-
-static inline long sec2msec(const int sec) {
-    return sec * 1000;
-}
-
-static inline long sec2msec(const double sec) {
-    return static_cast<long>(sec * 1000);
-}
-
-static inline double msec2sec(const int msec) {
-    return static_cast<double>(msec) / 1000.0;
-}
-}  // namespace swoole
