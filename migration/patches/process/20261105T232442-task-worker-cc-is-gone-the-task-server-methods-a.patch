--- a/src/server/process.cc
+++ b/src/server/process.cc
@@ -1301,2 +1301,424 @@ static void ReactorProcess_onTimeout(Timer *timer, TimerNode *tnode) {
 }
+static SW_THREAD_LOCAL EventData *latest_task = nullptr;
+
+// What a crates/process/src/workers/task_worker.rs operation acts on.
+template <>
+struct WorkersNative<2> {
+    Server *serv;
+    ProcessPool *pool;
+    Worker *worker;
+    // The task being run, or the one being finished.
+    const EventData *task;
+    Socket *socket;
+    Server::Command::Handler *handler;
+    PacketPtr packet;
+    // Server::finish's result, its packed form and its file.
+    const char *data;
+    size_t data_len;
+    EventData *packed;
+    std::unique_ptr<File> file;
+    EventData *buf;
+
+    static uint64_t call(void *context, uint32_t op, uint64_t arg);
+
+    int64_t run(uint32_t operation, uint64_t arg = 0) {
+        return swr_v1_workers_run(operation, arg, this, call);
+    }
+};
+using TaskWorkerContext = WorkersNative<2>;
+
+static int TaskWorker_onPipeReceive(Reactor *reactor, Event *event);
+
+static int TaskWorker_onTask(ProcessPool *pool, Worker *worker, EventData *task) {
+    TaskWorkerContext ctx{static_cast<Server *>(pool->ptr), pool, worker, task};
+    return ctx.run(SWR_WORKERS_RUN_TASK_ON_TASK);
+}
+
+static void TaskWorker_onStart(ProcessPool *pool, Worker *worker) {
+    TaskWorkerContext ctx{static_cast<Server *>(pool->ptr), pool, worker};
+    ctx.run(SWR_WORKERS_RUN_TASK_ON_START);
+}
+
+static void TaskWorker_onStop(ProcessPool *pool, Worker *worker) {
+    TaskWorkerContext ctx{static_cast<Server *>(pool->ptr), pool, worker};
+    ctx.run(SWR_WORKERS_RUN_TASK_ON_STOP);
+}
+
+static int TaskWorker_loop_async(ProcessPool *pool, Worker *worker) {
+    TaskWorkerContext ctx{static_cast<Server *>(pool->ptr), pool, worker};
+    return ctx.run(SWR_WORKERS_RUN_TASK_LOOP_ASYNC);
+}
+
+uint64_t TaskWorkerContext::call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<TaskWorkerContext *>(context);
+    Server *serv = ctx->serv;
+    ProcessPool *pool = ctx->pool;
+    Worker *worker = ctx->worker;
+    switch (op) {
+    case SWR_WORKERS_OP_POOL_INIT:
+        pool->ptr = serv;
+        pool->onTask = TaskWorker_onTask;
+        pool->onWorkerStart = TaskWorker_onStart;
+        pool->onWorkerStop = TaskWorker_onStop;
+        return 0;
+    case SWR_WORKERS_OP_TASK_IPC_MODE:
+        return serv->task_ipc_mode;
+    case SWR_WORKERS_OP_TASK_ENABLE_COROUTINE:
+        return serv->task_enable_coroutine;
+    case SWR_WORKERS_LOG_COROUTINE_MSGQUEUE:
+        swoole_log_as("Server::init_task_workers",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_WRONG_OPERATION,
+                                       "cannot use msgqueue when task_enable_coroutine is enable"));
+        return 0;
+    case SWR_WORKERS_OP_SET_ASYNC_LOOP:
+        pool->main_loop = TaskWorker_loop_async;
+        return 0;
+    case SWR_WORKERS_OP_SET_SYSVMSG:
+        pool->schedule_by_sysvmsg = true;
+        return 0;
+    case SWR_WORKERS_OP_TASK_WORKER_NUM:
+        return serv->task_worker_num;
+    case SWR_WORKERS_OP_CREATE_TASK_WORKER:
+        serv->create_worker(&pool->workers[arg]);
+        return 0;
+
+    case SWR_WORKERS_OP_HAS_COMMAND: {
+        ctx->handler = serv->get_command_handler(serv->get_command_id(ctx->task));
+        return ctx->handler != nullptr;
+    }
+    case SWR_WORKERS_LOG_UNKNOWN_COMMAND:
+        swoole_log_as("TaskWorker_call_command_handler",
+                      swoole_error_log(SW_LOG_ERROR,
+                                       SW_ERROR_SERVER_INVALID_COMMAND,
+                                       "Unknown command[%d]",
+                                       (int) serv->get_command_id(ctx->task)));
+        return 0;
+    case SWR_WORKERS_OP_UNPACK_COMMAND:
+        return Server::task_unpack(const_cast<EventData *>(ctx->task), sw_tg_buffer(), &ctx->packet);
+    case SWR_WORKERS_OP_COMMAND_REPLY: {
+        auto result = (*ctx->handler)(serv, std::string(ctx->packet.data, ctx->packet.length));
+        SendData task{};
+        task.info.fd = serv->get_task_id(ctx->task);
+        task.info.reactor_id = worker->get_id();
+        task.info.server_fd = -1;
+        task.info.type = SW_SERVER_EVENT_COMMAND_RESPONSE;
+        task.info.len = result.length();
+        task.data = result.c_str();
+        return serv->message_bus.write(serv->get_command_reply_socket(), &task);
+    }
+
+    case SWR_WORKERS_OP_SET_LATEST_TASK:
+        latest_task = const_cast<EventData *>(ctx->task);
+        return 0;
+    case SWR_WORKERS_OP_WORKER_STATUS:
+        if (arg) {
+            worker->set_status_to_busy();
+        } else {
+            worker->set_status_to_idle();
+        }
+        return 0;
+    case SWR_WORKERS_OP_INFO_TYPE:
+        return ctx->task->info.type;
+    case SWR_WORKERS_OP_ON_PIPE_MESSAGE:
+        serv->onPipeMessage(serv, const_cast<EventData *>(ctx->task));
+        return 0;
+    case SWR_WORKERS_OP_WORKER_SHUTDOWN:
+        worker->shutdown();
+        return 0;
+    case SWR_WORKERS_OP_EVENT_AVAILABLE:
+        return swoole_event_is_available();
+    case SWR_WORKERS_OP_STOP_ASYNC:
+        serv->stop_async_worker(worker);
+        return 0;
+    case SWR_WORKERS_OP_ON_TASK:
+        return (int64_t) serv->onTask(serv, const_cast<EventData *>(ctx->task));
+    case SWR_WORKERS_OP_ADD_REQUEST_COUNT:
+        worker->add_request_count();
+        return 0;
+
+    case SWR_WORKERS_OP_WORKER_ENTER:
+        swoole_set_worker_id(worker->get_id());
+        swoole_set_worker_type(SW_TASK_WORKER);
+        return 0;
+    case SWR_WORKERS_OP_EVENT_INIT:
+        return (int64_t) swoole_event_init(0);
+    case SWR_WORKERS_OP_FAIL_REACTOR:
+        swoole_log_as("TaskWorker_onStart", swoole_error("[TaskWorker] create reactor failed"));
+        return 0;
+    case SWR_WORKERS_OP_ENABLE_SIGNALFD:
+        SwooleG.enable_signalfd = arg;
+        if (!arg) {
+            SwooleTG.reactor = nullptr;
+        }
+        return 0;
+    case SWR_WORKERS_OP_MODE:
+        return serv->is_base_mode() ? 1 : (serv->is_process_mode() ? 2 : 3);
+    case SWR_WORKERS_OP_SIGNAL_SET:
+        swr_workers_signal_set(arg, Server::worker_signal_handler);
+        return 0;
+    case SWR_WORKERS_OP_WORKER_START_CALLBACK:
+        serv->worker_start_callback(worker);
+        return 0;
+    case SWR_WORKERS_OP_WORKER_INIT:
+        worker->init();
+        worker->set_max_request(pool->max_request, pool->max_request_grace);
+        return 0;
+    case SWR_WORKERS_OP_EVENT_FREE:
+        swoole_event_free();
+        return 0;
+    case SWR_WORKERS_OP_WORKER_STOP_CALLBACK:
+        serv->worker_stop_callback(worker);
+        return 0;
+
+    case SWR_WORKERS_OP_READ_TASK:
+        return (int64_t) ctx->socket->read(ctx->buf, sizeof(*ctx->buf));
+    case SWR_WORKERS_LOG_READ_TASK:
+        swoole_log_as("TaskWorker_onPipeReceive",
+                      swoole_sys_warning("read(%d, %ld) failed", ctx->socket->fd, sizeof(*ctx->buf)));
+        return 0;
+    case SWR_WORKERS_OP_ON_TASK_POOL:
+        return (int64_t) pool->onTask(pool, worker, ctx->buf);
+    case SWR_WORKERS_OP_EXCEEDED_MAX_REQUEST:
+        return worker->has_exceeded_max_request();
+
+    case SWR_WORKERS_OP_LISTEN_TASK_PIPE: {
+        Socket *socket = serv->get_worker_pipe_worker_in_message_bus(worker);
+        socket->set_nonblock();
+        sw_reactor()->ptr = pool;
+        swoole_event_add(socket, SW_EVENT_READ);
+        swoole_event_set_handler(SW_FD_PIPE, SW_EVENT_READ, TaskWorker_onPipeReceive);
+        return 0;
+    }
+    case SWR_WORKERS_OP_ALL_CORE_WORKER_NUM:
+        return serv->worker_num + serv->task_worker_num;
+    case SWR_WORKERS_OP_UNLIMIT_BUS_PIPES: {
+        Worker *_worker = serv->get_worker(arg);
+        serv->get_worker_pipe_worker_in_message_bus(_worker)->buffer_size = UINT_MAX;
+        serv->get_worker_pipe_master_in_message_bus(_worker)->buffer_size = UINT_MAX;
+        return 0;
+    }
+    case SWR_WORKERS_OP_EVENT_WAIT:
+        return (int64_t) swoole_event_wait();
+
+    case SWR_WORKERS_LOG_NO_TASK_WORKERS:
+        swoole_log_as("Server::finish",
+                      swoole_warning("cannot use Server::task()/Server::finish() method, because no set [task_worker_num]"));
+        return 0;
+    case SWR_WORKERS_OP_SELECT_TASK:
+        if (ctx->task == nullptr) {
+            ctx->task = latest_task;
+        }
+        return 0;
+    case SWR_WORKERS_LOG_FINISH_IN_PIPE:
+        swoole_log_as("Server::finish",
+                      swoole_warning("Server::task()/Server::finish() is not supported in onPipeMessage callback"));
+        return 0;
+    case SWR_WORKERS_OP_TASK_EXT_FLAGS:
+        return ctx->task->info.ext_flags;
+    case SWR_WORKERS_LOG_FINISH_NOREPLY:
+        swoole_log_as("Server::finish", swoole_warning("Server::finish() can only be used in the worker process"));
+        return 0;
+    case SWR_WORKERS_OP_SOURCE_WORKER:
+        ctx->worker = serv->get_worker((uint16_t) ctx->task->info.reactor_id);
+        return ctx->worker != nullptr;
+    case SWR_WORKERS_LOG_INVALID_SOURCE:
+        swoole_log_as("Server::finish", swoole_warning("invalid worker_id[%d]", (uint16_t) ctx->task->info.reactor_id));
+        return 0;
+    case SWR_WORKERS_OP_PACK_RESULT:
+        ctx->packed = ctx->buf;
+        return serv->task_pack(ctx->buf, ctx->data, ctx->data_len);
+    case SWR_WORKERS_OP_RESULT_IN_SHM:
+        ctx->packed = &serv->task_results[(uint16_t) ctx->task->info.reactor_id];
+        return serv->task_pack(ctx->packed, ctx->data, ctx->data_len);
+    case SWR_WORKERS_LOG_LARGE_PACK:
+        swoole_log_as("Server::finish", swoole_warning("large task pack failed()"));
+        return 0;
+    case SWR_WORKERS_OP_ZERO_RESULT:
+        ctx->packed->info.len = 0;
+        return 0;
+    case SWR_WORKERS_OP_FINISH_HEADER:
+        ctx->packed->info.ext_flags |= arg;
+        ctx->packed->info.type = SW_SERVER_EVENT_FINISH;
+        ctx->packed->info.fd = serv->get_task_id(ctx->task);
+        return 0;
+    case SWR_WORKERS_OP_STREAM_CONNECTION:
+        // Only a stream pool has IPC state: an event worker's pool has none.
+        ctx->socket = worker->pool->use_socket
+                          ? static_cast<Socket *>(swr_v1_process_pool_ipc_connection(worker->pool->ipc_))
+                          : nullptr;
+        return ctx->socket != nullptr;
+    case SWR_WORKERS_OP_SEND_STREAM: {
+        uint32_t _len = htonl(ctx->data_len);
+        ssize_t retval = ctx->socket->send_sync((void *) &_len, sizeof(_len));
+        if (retval > 0) {
+            retval = ctx->socket->send_sync(ctx->data, ctx->data_len);
+        }
+        return (int64_t) retval;
+    }
+    case SWR_WORKERS_OP_SEND_PIPE:
+        return (int64_t) serv->send_to_worker_from_worker(worker, ctx->buf, ctx->buf->size(), SW_PIPE_MASTER);
+    case SWR_WORKERS_OP_LOCK_WORKER:
+        worker->lock->lock();
+        return 0;
+    case SWR_WORKERS_OP_UNLOCK_WORKER:
+        worker->lock->unlock();
+        return 0;
+    case SWR_WORKERS_OP_OPEN_RESULT_FILE:
+        ctx->file.reset(new File(serv->task_results[(uint16_t) ctx->task->info.reactor_id].data + 4, O_APPEND | O_WRONLY));
+        return ctx->file->ready();
+    case SWR_WORKERS_OP_WRITE_RESULT_FILE: {
+        size_t bytes = ctx->buf->size();
+        swoole_log_as("Server::finish",
+                      swoole_trace_log(SW_TRACE_SERVER,
+                                       "write %zu bytes to tmp file '%s'",
+                                       bytes,
+                                       ctx->file->get_path().c_str()));
+        return ctx->file->write_all(ctx->buf, bytes) == bytes;
+    }
+    case SWR_WORKERS_LOG_RESULT_WRITE:
+        swoole_log_as("Server::finish",
+                      swoole_sys_warning("write(%s, %ld) failed", ctx->file->get_path().c_str(), ctx->buf->size()));
+        return 0;
+    case SWR_WORKERS_OP_FINISH_COUNT:
+        sw_atomic_fetch_add(reinterpret_cast<sw_atomic_t *>(serv->task_results[(uint16_t) ctx->task->info.reactor_id].data), 1);
+        ctx->file.reset();
+        return 0;
+    case SWR_WORKERS_OP_NOTIFY_RESULT: {
+        uint64_t flag = 1;
+        return (int64_t) serv->task_notify_pipes.at((uint16_t) ctx->task->info.reactor_id)->write(&flag, sizeof(flag));
+    }
+    case SWR_WORKERS_OP_NOTIFY_WOULD_BLOCK:
+        return serv->task_notify_pipes.at((uint16_t) ctx->task->info.reactor_id)->get_socket(true)->catch_write_error(errno) ==
+               SW_WAIT;
+    case SWR_WORKERS_OP_WAIT_NOTIFY_WRITABLE:
+        return (int64_t) serv->task_notify_pipes.at((uint16_t) ctx->task->info.reactor_id)
+            ->get_socket(true)
+            ->wait_event(-1, SW_EVENT_WRITE);
+    case SWR_WORKERS_OP_SEND_TIMED_OUT:
+        return errno == EAGAIN || errno == ETIMEDOUT || swoole_get_last_error() == SW_ERROR_SOCKET_POLL_TIMEOUT;
+    case SWR_WORKERS_LOG_SEND_RESULT:
+        if (arg) {
+            swoole_log_as("Server::finish",
+                          swoole_error_log(SW_LOG_WARNING,
+                                           SW_ERROR_SERVER_SEND_TO_WOKER_TIMEOUT,
+                                           "send result to worker timed out"));
+        } else {
+            swoole_log_as("Server::finish", swoole_sys_warning("send result to worker failed"));
+        }
+        return 0;
+    default:
+        abort();
+    }
+}
+
+// Server::task_pack, task_unpack and task_dump are Rust's (crates/process/src/task_file.rs).
+static_assert(sizeof(DataHead) == 40 && offsetof(EventData, data) == sizeof(DataHead) && sizeof(String) == 40 &&
+                  sizeof(PacketTask) == sizeof(size_t) + SW_TASK_TMP_PATH_SIZE,
+              "crates/process/src/task_file.rs layouts");
+
+// The task calls run in Rust (crates/process/src/task_sync.rs) over these hooks;
+// a PHP bailout inside one (MultiTask's pack/unpack, a signal handler while the
+// pipe waits) returns here first and is raised again.
+static swr_v1_pool_call *task_call(void *arg) {
+    return static_cast<swr_v1_pool_call *>(arg);
+}
+
+static Server *task_server_of(void *arg) {
+    return static_cast<Server *>(task_call(arg)->pool);
+}
+
+static Server::MultiTask *task_mtask(void *arg) {
+    return static_cast<Server::MultiTask *>(task_call(arg)->worker);
+}
+
+static Pipe *task_pipe(void *arg) {
+    return task_server_of(arg)->task_notify_pipes.at(swoole_get_worker_id()).get();
+}
+
+static const swr_v1_task_hooks task_hooks = {
+    [](void *arg) {
+        auto c = task_call(arg);
+        auto pool = task_server_of(arg)->get_task_worker_pool();
+        auto task = static_cast<EventData *>(c->data);
+        auto dst_worker_id = static_cast<int *>(c->socket);
+        c->result = (c->flags ? pool->dispatch_sync(task, dst_worker_id) : pool->dispatch(task, dst_worker_id)) == SW_OK;
+    },
+    [](void *arg) { task_pipe(arg)->clean(); },
+    [](void *arg) { task_pipe(arg)->set_timeout(*static_cast<double *>(task_call(arg)->data)); },
+    [](void *arg) { task_call(arg)->result = task_pipe(arg)->read(task_call(arg)->data, task_call(arg)->length); },
+    [](void *arg) {
+        auto worker = task_server_of(arg)->get_worker(swoole_get_worker_id());
+        if (task_call(arg)->flags) {
+            worker->lock->lock();
+        } else {
+            worker->lock->unlock();
+        }
+    },
+    [](void *arg) {
+        auto c = task_call(arg);
+        c->result = task_mtask(arg)->pack(c->flags, static_cast<EventData *>(c->data));
+    },
+    [](void *arg) { task_mtask(arg)->unpack(task_call(arg)->flags, static_cast<EventData *>(task_call(arg)->data)); },
+    [](void *arg) { task_mtask(arg)->fail(task_call(arg)->flags); },
+    [](void *arg) {
+        auto c = task_call(arg);
+        auto content = file_get_contents(static_cast<const char *>(c->data));
+        c->data = content ? content->str : nullptr;
+        c->length = content ? content->length : 0;
+        c->socket = content ? new std::shared_ptr<String>(content) : nullptr;
+    },
+    [](void *arg) { delete static_cast<std::shared_ptr<String> *>(task_call(arg)->socket); },
+    [](int kind) {
+        if (kind == SWR_TASK_WARN_PACK) {
+            swoole_warning("task pack failed");
+        } else {
+            swoole_warning("failed to dispatch task");
+        }
+    },
+};
+
+static swr_v1_task_server task_server(Server *serv, EventData *result, Server::MultiTask *mtask = nullptr) {
+    return {&task_hooks,
+            serv,
+            mtask,
+            const_cast<uint32_t *>(&serv->gs->tasking_num),
+            const_cast<int64_t *>(reinterpret_cast<volatile int64_t *>(&serv->gs->task_count)),
+            reinterpret_cast<uint8_t *>(result),
+            sizeof(EventData)};
+}
+
+static_assert(SW_ERROR_TASK_DISPATCH_FAIL == 2002, "crates/process/src/task_sync.rs ERROR_TASK_DISPATCH_FAIL");
+static const swr_v1_task_native task_native = {
+    []() { return SwooleG.task_tmpfile.c_str(); },
+    [](void *string, size_t size) { static_cast<String *>(string)->extend(size); },
+    [](void *serv, void *mtask, bool with_result, swr_v1_task_server *out) -> uint16_t {
+        auto *server = static_cast<Server *>(serv);
+        auto *multi = static_cast<Server::MultiTask *>(mtask);
+        *out = task_server(server, with_result ? server->get_task_result() : nullptr, multi);
+        return multi ? multi->count : 0;
+    },
+    [](char *path) {
+        File fp = make_tmpfile();
+        if (!fp.ready()) {
+            return false;
+        }
+        swoole_strlcpy(path, fp.get_path().c_str(), SW_TASK_TMP_PATH_SIZE);
+        return true;
+    },
+};
+[[maybe_unused]] static const bool task_native_set = (swr_v1_process_task_set_native(&task_native), true);
+
+/**
+ * receive data from worker process
+ */
+static int TaskWorker_onPipeReceive(Reactor *reactor, Event *event) {
+    auto *pool = static_cast<ProcessPool *>(reactor->ptr);
+    EventData task;
+    TaskWorkerContext ctx{static_cast<Server *>(pool->ptr), pool, sw_worker()};
+    ctx.socket = event->socket;
+    ctx.buf = &task;
+    return ctx.run(SWR_WORKERS_RUN_TASK_ON_PIPE);
+}
+
 // What a crates/process/src/workers/manager.rs operation acts on.
@@ -1698,2 +2120,13 @@ static int64_t workers_enter(uint32_t operation, void *object, void *other, void
         return Worker_context(serv, worker).run(operation, arg);
+    case SWR_WORKERS_RUN_INIT_TASK_WORKERS:
+        return TaskWorkerContext{serv, serv->get_task_worker_pool()}.run(operation, arg);
+    case SWR_WORKERS_RUN_FINISH: {
+        const auto *bytes = static_cast<const swr_v1_workers_bytes *>(extra);
+        EventData buf;
+        TaskWorkerContext ctx{serv, nullptr, nullptr, static_cast<const EventData *>(other)};
+        ctx.buf = &buf;
+        ctx.data = bytes->data;
+        ctx.data_len = bytes->length;
+        return ctx.run(operation, arg);
+    }
     case SWR_WORKERS_RUN_REACTOR_PROCESS_START:
