+bool SocketPair::control(uint32_t operation, uint64_t argument) {
+    auto effect = [](void *, void *pointer, uint32_t op, uint64_t arg) -> int {
+        auto *socket = static_cast<Socket *>(pointer);
+        if (op == 2) return socket->set_buffer_size(static_cast<uint32_t>(arg));
+        double timeout;
+        memcpy(&timeout, &arg, sizeof(timeout));
+        socket->set_timeout(timeout);
+        return 1;
+    };
+    return swr_v1_process_socket_pair_control(record(), operation, argument, nullptr, effect) > 0;
+}
