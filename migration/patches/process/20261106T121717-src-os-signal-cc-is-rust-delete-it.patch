-
-#include <csignal>
-
-
-#include "swoole_rs_signal_loop.h"
-
-using swoole::Event;
-using swoole::Reactor;
-using swoole::SignalHandler;
-using swoole::network::Socket;
-
-static const swr_v1_signal_loop_ops &signal_ops();
-
-#ifdef HAVE_SIGNALFD
-static const swr_v1_signal_descriptor_ops descriptor_ops = {
-    [](int32_t fd) -> void * { return swoole::make_socket(fd, SW_FD_SIGNAL); },
-    [](void *data) { auto *socket = static_cast<Socket *>(data); socket->fd = -1; socket->free(); },
-    [](void *data) -> int32_t { return static_cast<Socket *>(data)->events; },
-    [](void *data, int32_t events) -> int32_t { return swoole_event_add(static_cast<Socket *>(data), events); },
-    [](void *data) { swoole_event_del(static_cast<Socket *>(data)); },
-    [] { return swoole_event_isset_handler(SW_FD_SIGNAL, SW_EVENT_READ); },
-    [] {
-        swoole_event_set_handler(SW_FD_SIGNAL, SW_EVENT_READ, [](Reactor *, Event *event) -> int {
-            return swr_v1_signal_loop_read(event->fd, &signal_ops());
-        });
-        sw_reactor()->set_exit_condition(Reactor::EXIT_CONDITION_SIGNALFD, [](Reactor *, size_t &event_num) -> bool {
-            return swr_v1_signal_loop_exit(&event_num);
-        });
-        sw_reactor()->add_destroy_callback([](void *) { swr_v1_signal_loop_destroyed(&signal_ops()); });
-    },
-    [] { sw_reactor()->erase_end_callback(Reactor::PRIORITY_SIGNAL_CALLBACK); },
-};
-#endif
-
-static const swr_v1_signal_loop_ops &signal_ops() {
-    static const swr_v1_signal_loop_ops ops = {
-        []() -> uint8_t {
-            uint8_t caps = 0;
-#ifdef HAVE_SIGNALFD
-            caps |= 1;
-#endif
-#ifdef HAVE_KQUEUE
-            caps |= 2;
-#endif
-            return caps;
-        },
-        [] { return swoole_event_is_available(); },
-        [] { return sw_reactor() != nullptr; },
-        []() -> int32_t { return sw_reactor()->native_handle; },
-        swoole_signal_callback,
-#ifdef HAVE_SIGNALFD
-        &descriptor_ops,
-#else
-        nullptr,
-#endif
-        [](uintptr_t handler, int32_t signo) { reinterpret_cast<SignalHandler>(handler)(signo); },
-        [](uint8_t kind, int32_t signo, int32_t error) {
-            if ((kind >= 3 && kind <= 6) || kind == 9) { errno = error; }
-            switch (kind) {
-            case 0:
-                swoole_log_as("swoole_signal_callback", swoole_warning("signal[%d] numberis invalid", signo)); break;
-            case 1:
-                swoole_log_as("swoole_signal_get_handler", swoole_warning("signal[%d] numberis invalid", signo)); break;
-            case 2:
-                swoole_log_as("swoole_signal_callback", swoole_error_log(SW_LOG_WARNING, SW_ERROR_UNREGISTERED_SIGNAL,
-                    SW_UNREGISTERED_SIGNAL_FMT, swoole_signal_to_str(signo))); break;
-            case 3:
-                swoole_log_as("swoole_signalfd_create", swoole_sys_warning("signalfd() failed")); break;
-            case 4:
-                swoole_log_as("swoole_signalfd_create", swoole_sys_warning("sigprocmask() failed")); break;
-            case 5:
-                swoole_log_as("swoole_signalfd_clear", swoole_sys_warning("sigprocmask(SIG_UNBLOCK) failed")); break;
-            case 6:
-                swoole_log_as("swoole_signalfd_event_callback", swoole_sys_warning("read from signalfd failed")); break;
-            case 7:
-                swoole_log_as("swoole_signalfd_event_callback", swoole_warning("unknown signal[%d]", signo)); break;
-            case 8:
-                swoole_log_as("swoole_signalfd_event_callback", swoole_error_log(SW_LOG_WARNING, SW_ERROR_UNREGISTERED_SIGNAL,
-                    SW_UNREGISTERED_SIGNAL_FMT, swoole_signal_to_str(signo))); break;
-            case 9:
-                swoole_log_as("swoole_signal_kqueue_set", swoole_sys_warning("kevent set signal[%d] error", signo)); break;
-            }
-        },
-    };
-    return ops;
-}
-
-// The backend choice, descriptor wrapper lifetime, counters and callback policy
-// are Rust; these retain the existing C++ SDK signatures.
-SignalHandler swoole_signal_set(int signo, SignalHandler handler, bool safety) {
-    return reinterpret_cast<SignalHandler>(swr_v1_signal_loop_set(signo, reinterpret_cast<uintptr_t>(handler), safety, &signal_ops()));
-}
-void swoole_signal_callback(int signo) { swr_v1_signal_loop_callback(signo, &signal_ops()); }
-SignalHandler swoole_signal_get_handler(int signo) {
-    return reinterpret_cast<SignalHandler>(swr_v1_signal_loop_get(signo, &signal_ops()));
-}
-uint32_t swoole_signal_get_listener_num() { return swr_v1_signal_loop_listener_num(); }
-void swoole_signal_clear() { swr_v1_signal_loop_clear(&signal_ops()); }
