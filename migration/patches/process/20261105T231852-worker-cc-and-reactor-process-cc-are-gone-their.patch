+
+#ifdef HAVE_CPU_AFFINITY
+static void Worker_set_cpu_affinity(const Server *serv, const Worker *worker) {
+    const auto outcome = swr_v1_process_worker_affinity(
+        worker->get_id(), serv->cpu_affinity_available, serv->cpu_affinity_available_num, serv->is_thread_mode());
+    if (outcome.error != 0) {
+        errno = outcome.error;
+    }
+    if (outcome.status == 1) {
+        swoole_sys_warning("get CPU affinity for worker#%d failed", worker->get_id());
+    } else if (outcome.status == 2) {
+        swoole_warning("no available CPU for worker#%d", worker->get_id());
+    } else if (outcome.status == 3) {
+        swoole_sys_warning("set CPU affinity for worker#%d failed", worker->get_id());
+    }
+}
+#endif
+
+// What a crates/process/src/workers/event_worker.rs operation acts on.
+template <>
+struct WorkersNative<0> {
+    Server *serv;
+    Worker *worker;
+    DataHead *info;
+    Reactor *reactor;
+    Connection *conn;
+    const ExitStatus *status;
+    Socket *socket;
+
+    static uint64_t call(void *context, uint32_t op, uint64_t arg);
+    static uint64_t hot_call(void *context, uint32_t op, uint64_t arg);
+
+    int64_t run(uint32_t operation, uint64_t arg = 0) {
+        return swr_v1_workers_run(operation, arg, this, hot_call);
+    }
+};
+using WorkerContext = WorkersNative<0>;
+
+static void Worker_global_hook(Server *serv, Worker *worker, uint64_t hook) {
+    const swGlobalHookType id = hook == 0 ? SW_GLOBAL_HOOK_BEFORE_WORKER_START
+                             : (hook == 1 ? SW_GLOBAL_HOOK_BEFORE_WORKER_STOP : SW_GLOBAL_HOOK_BEFORE_SERVER_SHUTDOWN);
+    if (!swoole_isset_hook(id)) {
+        return;
+    }
+    if (hook == 2) {
+        swoole_call_hook(SW_GLOBAL_HOOK_BEFORE_SERVER_SHUTDOWN, serv);
+        return;
+    }
+    void *hook_args[2];
+    hook_args[0] = serv;
+    hook_args[1] = (void *) (uintptr_t) worker->get_id();
+    swoole_call_hook(id, hook_args);
+}
+
+uint64_t WorkerContext::call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<WorkerContext *>(context);
+    Server *serv = ctx->serv;
+    Worker *worker = ctx->worker;
+    DataHead *info = ctx->info;
+    Reactor *reactor = ctx->reactor;
+    switch (op) {
+    case SWR_WORKERS_OP_MODE:
+        return serv->is_base_mode() ? 1 : (serv->is_process_mode() ? 2 : 3);
+    case SWR_WORKERS_OP_SIGNAL_SET:
+        swr_workers_signal_set(arg, Server::worker_signal_handler);
+        return 0;
+    case SWR_WORKERS_OP_SIGNAL_LIVE:
+        return SwooleG.running && serv && worker && serv->is_running();
+    case SWR_WORKERS_OP_EVENT_AVAILABLE:
+        return swoole_event_is_available();
+    case SWR_WORKERS_OP_STOP_ASYNC:
+        serv->stop_async_worker(worker);
+        return 0;
+    case SWR_WORKERS_OP_WORKER_SHUTDOWN:
+        worker->shutdown();
+        return 0;
+    case SWR_WORKERS_OP_REOPEN_LOGGER:
+        Worker_reopen_logger();
+        return 0;
+    case SWR_WORKERS_OP_WORKER_STATUS:
+        if (arg) {
+            worker->set_status_to_busy();
+        } else {
+            worker->set_status_to_idle();
+        }
+        return 0;
+    case SWR_WORKERS_OP_INFO_TYPE:
+        return info->type;
+    case SWR_WORKERS_OP_INFO_LEN:
+        return info->len;
+    case SWR_WORKERS_OP_DISABLE_NOTIFY:
+        return serv->disable_notify;
+    case SWR_WORKERS_OP_DISCARD_TIMEOUT_REQUEST:
+        return serv->discard_timeout_request;
+    case SWR_WORKERS_LOG_DISCARD:
+        swoole_log_as("Worker_discard_data",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_SESSION_DISCARD_TIMEOUT_DATA,
+                                       "[2] ignore data[%u bytes] received from session#%ld",
+                                       info->len,
+                                       info->fd));
+        return 0;
+    case SWR_WORKERS_OP_DO_TASK: {
+        RecvData recv_data;
+        auto packet = serv->get_worker_message_bus()->get_packet();
+        recv_data.info = *info;
+        recv_data.info.len = packet.length;
+        recv_data.data = packet.data;
+        if ((arg ? serv->onPacket : serv->onReceive)(serv, &recv_data) == SW_OK) {
+            worker->add_request_count();
+            sw_atomic_fetch_add(&serv->gs->request_count, 1);
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_FREE_CLIENT_CERT: {
+        Connection *conn = serv->get_connection_verify_no_ssl(info->fd);
+        if (conn && conn->ssl_client_cert && conn->ssl_client_cert_pid == swoole_get_worker_pid()) {
+            delete conn->ssl_client_cert;
+            conn->ssl_client_cert = nullptr;
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_FACTORY_END:
+        serv->factory_->end(info->fd, false);
+        return 0;
+    case SWR_WORKERS_OP_STORE_CLIENT_CERT: {
+        Connection *conn = serv->get_connection_verify_no_ssl(info->fd);
+        if (conn) {
+            auto packet = serv->get_worker_message_bus()->get_packet();
+            conn->ssl_client_cert = new String(packet.data, packet.length);
+            conn->ssl_client_cert_pid = swoole_get_worker_pid();
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_ON_CONNECT:
+        if (serv->onConnect) {
+            serv->onConnect(serv, info);
+        }
+        return 0;
+    case SWR_WORKERS_OP_ON_BUFFER_FULL:
+        if (serv->onBufferFull) {
+            serv->onBufferFull(serv, info);
+        }
+        return 0;
+    case SWR_WORKERS_OP_ON_BUFFER_EMPTY:
+        if (serv->onBufferEmpty) {
+            serv->onBufferEmpty(serv, info);
+        }
+        return 0;
+    case SWR_WORKERS_OP_ON_FINISH:
+        serv->onFinish(serv, reinterpret_cast<EventData *>(serv->get_worker_message_bus()->get_buffer()));
+        return 0;
+    case SWR_WORKERS_OP_ON_PIPE_MESSAGE:
+        serv->onPipeMessage(serv, reinterpret_cast<EventData *>(serv->get_worker_message_bus()->get_buffer()));
+        return 0;
+    case SWR_WORKERS_OP_COMMAND_REQUEST:
+        serv->call_command_handler(serv->message_bus, worker->get_id(), serv->pipe_command->get_socket(false));
+        return 0;
+    case SWR_WORKERS_LOG_BAD_EVENT:
+        swoole_log_as("Server::worker_accept_event", swoole_warning("[Worker] error event[type=%d]", (int) info->type));
+        return 0;
+    case SWR_WORKERS_OP_EXCEEDED_MAX_REQUEST:
+        return worker->has_exceeded_max_request();
+    case SWR_WORKERS_OP_THREAD_SHUTDOWN: {
+        Reactor *current = sw_reactor();
+        serv->get_thread(current->id)->shutdown(current);
+        return 0;
+    }
+    case SWR_WORKERS_OP_ROOT_USER:
+        return swoole_is_root_user();
+    case SWR_WORKERS_OP_SET_ISOLATION:
+        swoole_set_isolation(serv->group_, serv->user_, serv->chroot_);
+        return 0;
+    case SWR_WORKERS_OP_WORKER_ID:
+        return worker->get_id();
+    case SWR_WORKERS_OP_ALL_CORE_WORKER_NUM:
+        return serv->worker_num + serv->task_worker_num;
+    case SWR_WORKERS_OP_OTHER_PIPE_NONBLOCK: {
+        Worker *other_worker = serv->get_worker(arg);
+        if (serv->is_worker() && other_worker->pipe_master) {
+            other_worker->pipe_master->set_nonblock();
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_PROTECT_SESSIONS:
+        sw_shm_protect(serv->session_list, PROT_READ);
+        return 0;
+    case SWR_WORKERS_OP_CALL_WORKER_START:
+        serv->call_worker_start_callback(worker);
+        return 0;
+    case SWR_WORKERS_OP_CPU_AFFINITY:
+#ifdef HAVE_CPU_AFFINITY
+        if (serv->open_cpu_affinity) {
+            Worker_set_cpu_affinity(serv, worker);
+        }
+#endif
+        return 0;
+    case SWR_WORKERS_OP_GLOBAL_HOOK:
+        Worker_global_hook(serv, worker, arg);
+        return 0;
+    case SWR_WORKERS_OP_SERVER_HOOK_WORKER_START:
+        if (serv->isset_hook(Server::HOOK_WORKER_START)) {
+            void *hook_args[2];
+            hook_args[0] = serv;
+            hook_args[1] = (void *) (uintptr_t) worker->get_id();
+            serv->call_hook(Server::HOOK_WORKER_START, hook_args);
+        }
+        return 0;
+    case SWR_WORKERS_OP_CLEAR_LAST_ERROR:
+        swoole_clear_last_error();
+        swoole_clear_last_error_msg();
+        return 0;
+    case SWR_WORKERS_OP_ON_WORKER_START:
+        if (serv->onWorkerStart) {
+            serv->onWorkerStart(serv, worker);
+        }
+        return 0;
+    case SWR_WORKERS_OP_ON_WORKER_STOP:
+        if (serv->onWorkerStop) {
+            serv->onWorkerStop(serv, worker);
+        }
+        return 0;
+    case SWR_WORKERS_OP_BUS_EMPTY:
+        return serv->get_worker_message_bus()->empty();
+    case SWR_WORKERS_LOG_UNPROCESSED:
+        swoole_log_as("Server::call_worker_stop_callback",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_SERVER_WORKER_UNPROCESSED_DATA,
+                                       "unprocessed data in the worker process buffer"));
+        return 0;
+    case SWR_WORKERS_OP_BUS_CLEAR:
+        serv->get_worker_message_bus()->clear();
+        return 0;
+    case SWR_WORKERS_OP_WORKER_STOPPED:
+        swr_v1_worker_global_stopped();
+        return 0;
+    case SWR_WORKERS_OP_ON_WORKER_ERROR:
+        if (serv->onWorkerError != nullptr) {
+            serv->onWorkerError(serv, worker, *ctx->status);
+        }
+        return 0;
+    case SWR_WORKERS_OP_WORKER_TYPE:
+        return worker->get_type();
+    case SWR_WORKERS_OP_ABORT_WORKER:
+        serv->abort_worker(worker);
+        return 0;
+    case SWR_WORKERS_OP_HAS_CURRENT_WORKER:
+        return sw_worker() != nullptr;
+    case SWR_WORKERS_LOG_KILL_NO_ID:
+        swoole_log_as("Server::kill_worker",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_WRONG_OPERATION,
+                                       "kill worker in non worker process requires specifying an id"));
+        return 0;
+    case SWR_WORKERS_OP_CURRENT_WORKER_ID:
+        return swoole_get_worker_id();
+    case SWR_WORKERS_OP_WORKER_EXISTS:
+        return serv->get_worker(static_cast<int>(arg)) != nullptr;
+    case SWR_WORKERS_LOG_KILL_BAD_ID:
+        swoole_log_as("Server::kill_worker",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_INVALID_PARAMS,
+                                       "the worker_id[%d] is invalid",
+                                       static_cast<int>(arg)));
+        return 0;
+    case SWR_WORKERS_OP_SEND_SHUTDOWN: {
+        swoole_log_as("Server::kill_worker", swoole_trace_log(SW_TRACE_SERVER, "kill worker#%d", static_cast<int>(arg)));
+        DataHead event = {};
+        event.type = SW_SERVER_EVENT_SHUTDOWN;
+        return serv->send_to_worker_from_worker(serv->get_worker(static_cast<int>(arg)), &event, sizeof(event), SW_PIPE_MASTER);
+    }
+    case SWR_WORKERS_OP_RESET_WORKER_COUNTER:
+        serv->reset_worker_counter(worker);
+        return 0;
+    case SWR_WORKERS_OP_RELOAD_ASYNC:
+        return serv->reload_async;
+    case SWR_WORKERS_OP_REACTOR_STOP:
+        reactor->running = false;
+        return 0;
+    case SWR_WORKERS_OP_REACTOR_WAIT_EXIT:
+        return reactor->wait_exit;
+    case SWR_WORKERS_OP_DETACH_WORKER:
+        swr_v1_worker_global_detach(reinterpret_cast<swr_v1_worker_record *>(worker));
+        return 0;
+    case SWR_WORKERS_OP_UNREAD_PIPE_WORKER: {
+        auto pipe_worker = serv->get_worker_pipe_worker_in_message_bus(worker);
+        if (pipe_worker && !pipe_worker->removed) {
+            reactor->remove_read_event(pipe_worker);
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_IS_EVENT_WORKER:
+        return serv->is_event_worker();
+    case SWR_WORKERS_OP_POOL_RUNNING:
+        return serv->get_event_worker_pool()->running;
+    case SWR_WORKERS_OP_ON_BEFORE_SHUTDOWN:
+        if (serv->onBeforeShutdown) {
+            serv->onBeforeShutdown(serv);
+        }
+        return 0;
+    case SWR_WORKERS_OP_UNREAD_PIPE_MASTER:
+        if (worker->pipe_master && !worker->pipe_master->removed) {
+            reactor->remove_read_event(worker->pipe_master);
+        }
+        return 0;
+    case SWR_WORKERS_OP_PORT_COUNT:
+        return serv->ports.size();
+    case SWR_WORKERS_OP_PORT_DEL:
+        reactor->del(serv->ports[arg]->socket);
+        return 0;
+    case SWR_WORKERS_OP_MINFD:
+        return (int64_t) serv->get_minfd();
+    case SWR_WORKERS_OP_MAXFD:
+        return (int64_t) serv->get_maxfd();
+    case SWR_WORKERS_OP_CONN_AT: {
+        Connection *conn = serv->get_connection(static_cast<int>(arg));
+        ctx->conn = Server::is_valid_connection(conn) ? conn : nullptr;
+        return ctx->conn != nullptr;
+    }
+    case SWR_WORKERS_OP_CONN_READABLE:
+        return !ctx->conn->peer_closed && !ctx->conn->socket->removed;
+    case SWR_WORKERS_OP_CONN_UNREAD:
+        reactor->remove_read_event(ctx->conn->socket);
+        return 0;
+    case SWR_WORKERS_OP_CONN_REACTOR:
+        return ctx->conn->reactor_id;
+    case SWR_WORKERS_OP_CLEAR_TIMER:
+        serv->clear_timer();
+        return 0;
+    case SWR_WORKERS_OP_PUSH_STOP_MESSAGE: {
+        WorkerStopMessage msg;
+        msg.pid = getpid();
+        msg.worker_id = worker->get_id();
+        return serv->get_event_worker_pool()->push_message(SW_WORKER_MESSAGE_STOP, &msg, sizeof(msg));
+    }
+    case SWR_WORKERS_LOG_PUSH_STOP:
+        swoole_log_as("Server::stop_async_worker", swoole_sys_warning("failed to push WORKER_STOP message"));
+        return 0;
+    case SWR_WORKERS_OP_REACTOR_NUM:
+        return serv->reactor_num;
+    case SWR_WORKERS_OP_REACTOR_ID:
+        return reactor->id;
+    case SWR_WORKERS_OP_WORKER_NUM:
+        return serv->worker_num;
+    case SWR_WORKERS_OP_UNREAD_THREAD_PIPE: {
+        auto pipe_master = serv->get_worker_pipe_master_in_message_bus(static_cast<WorkerId>(arg));
+        if (!pipe_master->removed) {
+            reactor->remove_read_event(pipe_master);
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_ABORT:
+        assert(0);
+        return 0;
+    case SWR_WORKERS_OP_ARM_EXIT:
+        reactor->set_wait_exit(true);
+        reactor->set_end_callback(Reactor::PRIORITY_TRY_EXIT, Worker_reactor_try_to_exit);
+        SwooleWG.exit_time = ::time(nullptr);
+        return 0;
+    case SWR_WORKERS_OP_REACTOR_IF_EXIT:
+        return reactor->if_exit();
+    case SWR_WORKERS_OP_HAS_ON_WORKER_EXIT:
+        return bool(serv->onWorkerExit);
+    case SWR_WORKERS_OP_ON_WORKER_EXIT:
+        serv->onWorkerExit(serv, sw_worker());
+        return 0;
+    case SWR_WORKERS_OP_EXIT_TIME:
+        return (int64_t) SwooleWG.exit_time;
+    case SWR_WORKERS_OP_MAX_WAIT_TIME:
+        return (int64_t) serv->max_wait_time;
+    case SWR_WORKERS_LOG_EXIT_TIMEOUT:
+        swoole_log_as("Worker_reactor_try_to_exit",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_SERVER_WORKER_EXIT_TIMEOUT,
+                                       "worker exit timeout, forced termination"));
+        return 0;
+    case SWR_WORKERS_OP_REACTOR_TIMEOUT:
+        return (int64_t) reactor->timeout_msec;
+    case SWR_WORKERS_OP_SET_REACTOR_TIMEOUT:
+        reactor->timeout_msec = static_cast<int32_t>(arg);
+        return 0;
+    case SWR_WORKERS_OP_HAS_REACTOR:
+        return sw_reactor() != nullptr;
+    case SWR_WORKERS_OP_DRAIN_WORKER_PIPES: {
+        Worker *_worker = serv->get_worker(arg);
+        if (_worker->pipe_worker) {
+            sw_reactor()->drain_write_buffer(_worker->pipe_worker);
+        }
+        if (_worker->pipe_master) {
+            sw_reactor()->drain_write_buffer(_worker->pipe_master);
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_REACTOR_DESTROYED:
+        swoole_log_as("Server::clean_worker_connections", swoole_trace_log(SW_TRACE_WORKER, "clean connections"));
+        sw_reactor()->destroyed = true;
+        return 0;
+    case SWR_WORKERS_OP_CLOSE_CONNECTION:
+        Server::close_connection(sw_reactor(), ctx->conn->socket);
+        return 0;
+    case SWR_WORKERS_OP_WORKER_ENTER:
+        swoole_set_worker_id(worker->get_id());
+        swoole_set_worker_type(SW_EVENT_WORKER);
+        serv->init_event_worker(worker);
+        return 0;
+    case SWR_WORKERS_OP_EVENT_INIT:
+        return swoole_event_init(0);
+    case SWR_WORKERS_OP_WORKER_SIGNAL_INIT:
+        serv->worker_signal_init();
+        return 0;
+    case SWR_WORKERS_OP_UNLIMIT_PIPES: {
+        // set pipe buffer size
+        const Worker *_worker = serv->get_worker(arg);
+        if (_worker->pipe_master) {
+            _worker->pipe_master->buffer_size = UINT_MAX;
+        }
+        if (_worker->pipe_worker) {
+            _worker->pipe_worker->buffer_size = UINT_MAX;
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_LISTEN_PIPE:
+        worker->pipe_worker->set_nonblock();
+        SwooleTG.reactor->ptr = serv;
+        SwooleTG.reactor->add(worker->pipe_worker, SW_EVENT_READ);
+        SwooleTG.reactor->set_handler(SW_FD_PIPE, SW_EVENT_READ, Worker_onPipeReceive);
+        return 0;
+    case SWR_WORKERS_OP_CO_DISPATCH:
+        return serv->dispatch_mode == Server::DISPATCH_CO_CONN_LB || serv->dispatch_mode == Server::DISPATCH_CO_REQ_LB;
+    case SWR_WORKERS_OP_COUNT_COROUTINES:
+        SwooleTG.reactor->set_end_callback(Reactor::PRIORITY_WORKER_CALLBACK,
+                                           [worker](Reactor *) { worker->coroutine_num = Coroutine::count(); });
+        return 0;
+    case SWR_WORKERS_OP_WORKER_START_CALLBACK:
+        serv->worker_start_callback(worker);
+        return 0;
+    case SWR_WORKERS_OP_REACTOR_WAIT:
+        return (int64_t) SwooleTG.reactor->wait();
+    case SWR_WORKERS_OP_DRAIN_PIPES:
+        serv->drain_worker_pipe();
+        return 0;
+    case SWR_WORKERS_OP_EVENT_FREE:
+        swoole_event_free();
+        return 0;
+    case SWR_WORKERS_OP_WORKER_STOP_CALLBACK:
+        serv->worker_stop_callback(worker);
+        return 0;
+    case SWR_WORKERS_OP_FREE_BUFFER_POOL:
+        delete serv->buffer_pool;
+        return 0;
+    case SWR_WORKERS_OP_BUS_READ:
+        return (int64_t) serv->get_worker_message_bus()->read(ctx->socket);
+    case SWR_WORKERS_OP_BUS_POP:
+        serv->get_worker_message_bus()->pop();
+        return 0;
+    default:
+        abort();
+    }
+}
+
+// The ops each received event makes, in a small frame of their own: the rest of
+// call needs a large, stack-protected one.
+uint64_t WorkerContext::hot_call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<WorkerContext *>(context);
+    Server *serv = ctx->serv;
+    Worker *worker = ctx->worker;
+    DataHead *info = ctx->info;
+    switch (op) {
+    case SWR_WORKERS_OP_EVENT_BEGIN:
+        worker->set_status_to_busy();
+        return info->type;
+    case SWR_WORKERS_OP_EVENT_END:
+        worker->set_status_to_idle();
+        return worker->has_exceeded_max_request();
+    case SWR_WORKERS_OP_PIPE_EVENT_WRITE:
+        return (int64_t) swoole_event_write(ctx->socket, info, arg);
+    case SWR_WORKERS_OP_PIPE_SEND_SYNC:
+        return (int64_t) ctx->socket->send_sync(info, arg);
+    case SWR_WORKERS_OP_RECV_CONN: {
+        Connection *conn = serv->get_connection_verify(info->fd);
+        if (!conn) {
+            return 0;
+        }
+        if (info->len > 0) {
+            auto packet = serv->get_worker_message_bus()->get_packet();
+            sw_atomic_fetch_sub(&conn->recv_queued_bytes, packet.length);
+            swoole_log_as("Server::worker_accept_event",
+                          swoole_trace_log(SW_TRACE_SERVER,
+                                           "[Worker] session_id=%ld, len=%lu, qb=%d",
+                                           conn->session_id,
+                                           packet.length,
+                                           conn->recv_queued_bytes));
+        }
+        conn->last_dispatch_time = info->time;
+        return conn->closed ? 2 : 1;
+    }
+    default:
+        return call(context, op, arg);
+    }
+}
+
+extern "C" void swr_workers_signal_set(uint64_t arg, void (*own)(int)) {
+    int signo = static_cast<int32_t>(static_cast<uint32_t>(arg));
+    if (signo == -1) {
+#ifdef SIGRTMIN
+        signo = SIGRTMIN;
+#else
+        return;
+#endif
+    }
+    const uint64_t handler = arg >> 32;
+    swoole_signal_set(signo, handler == 0 ? nullptr : (handler == 1 ? SIG_IGN : own));
+}
+
+static WorkerContext Worker_context(Server *serv, Worker *worker) {
+    return WorkerContext{serv, worker, nullptr, sw_reactor(), nullptr, nullptr, nullptr};
+}
+
+static void Worker_reactor_try_to_exit(Reactor *reactor) {
+    Server *serv;
+    if (sw_likely(swoole_get_worker_type() != SW_TASK_WORKER)) {
+        serv = static_cast<Server *>(reactor->ptr);
+    } else {
+        auto pool = static_cast<ProcessPool *>(reactor->ptr);
+        serv = static_cast<Server *>(pool->ptr);
+    }
+    auto ctx = Worker_context(serv, sw_worker());
+    ctx.reactor = reactor;
+    ctx.run(SWR_WORKERS_RUN_TRY_EXIT);
+}
+
+/**
+ * receive data from reactor
+ * This function is intended solely for process mode; in thread or base mode, `ReactorThread_onRead()` will be executed.
+ */
+static int Worker_onPipeReceive(Reactor *reactor, Event *event) {
+    auto *serv = static_cast<Server *>(reactor->ptr);
+    auto ctx = Worker_context(serv, sw_worker());
+    ctx.reactor = reactor;
+    ctx.info = &serv->get_worker_message_bus()->get_buffer()->info;
+    ctx.socket = event->socket;
+    ctx.run(SWR_WORKERS_RUN_PIPE_RECEIVE);
+    return SW_OK;
+}
+static int ReactorProcess_onPipeRead(Reactor *reactor, Event *event);
+static int ReactorProcess_onClose(Reactor *reactor, Event *event);
+static void ReactorProcess_onTimeout(Timer *timer, TimerNode *tnode);
+
+// What a crates/process/src/workers/reactor_process.rs operation acts on.
+template <>
+struct WorkersNative<1> {
+    Server *serv;
+    ProcessPool *pool;
+    Worker *worker;
+    Reactor *reactor;
+    Event *event;
+    Connection *conn;
+    double now;
+
+    static uint64_t call(void *context, uint32_t op, uint64_t arg);
+
+    int64_t run(uint32_t operation) {
+        return swr_v1_workers_run(operation, 0, this, call);
+    }
+};
+using ReactorProcessContext = WorkersNative<1>;
+
+uint64_t ReactorProcessContext::call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<ReactorProcessContext *>(context);
+    Server *serv = ctx->serv;
+    Worker *worker = ctx->worker;
+    Reactor *reactor = ctx->reactor ? ctx->reactor : SwooleTG.reactor;
+    Connection *conn = ctx->conn;
+    auto *pipe_buffer = serv->message_bus.get_buffer();
+    switch (op) {
+    case SWR_WORKERS_OP_SET_SINGLE_THREAD:
+        serv->single_thread = true;
+        return 0;
+    case SWR_WORKERS_OP_HAVE_STREAM_SOCK:
+        return serv->have_stream_sock == 1;
+    case SWR_WORKERS_OP_PORT_COUNT:
+        return serv->ports.size();
+    case SWR_WORKERS_OP_PORT_STREAM:
+        return serv->ports[arg]->is_stream();
+    case SWR_WORKERS_OP_REUSE_PORT:
+#if defined(__linux__) && defined(HAVE_REUSEPORT)
+        return serv->enable_reuse_port;
+#else
+        return 0;
+#endif
+    case SWR_WORKERS_OP_PORT_REUSE:
+#if defined(__linux__) && defined(HAVE_REUSEPORT)
+        return serv->ports[arg]->is_stream() && serv->enable_reuse_port;
+#else
+        return 0;
+#endif
+    case SWR_WORKERS_OP_PORT_CLOSE_SOCKET:
+#if defined(__linux__) && defined(HAVE_REUSEPORT)
+        serv->ports[arg]->close_socket();
+#endif
+        return 0;
+    case SWR_WORKERS_OP_PORT_CREATE_SOCKET:
+#if defined(__linux__) && defined(HAVE_REUSEPORT)
+        return (int64_t) serv->ports[arg]->create_socket();
+#else
+        return 0;
+#endif
+    case SWR_WORKERS_OP_PORT_LISTEN:
+        return (int64_t) serv->ports[arg]->listen();
+    case SWR_WORKERS_OP_POOL_CREATE: {
+        ProcessPool *pool = serv->get_event_worker_pool();
+        *pool = {};
+        if (pool->create(serv->worker_num, 0, SW_IPC_UNIXSOCK) < 0) {
+            return (int64_t) SW_ERR;
+        }
+        pool->set_max_request(serv->max_request, serv->max_request_grace);
+        // store to ProcessPool object
+        pool->ptr = serv;
+        pool->max_wait_time = serv->max_wait_time;
+        pool->use_msgqueue = 0;
+        pool->main_loop = Server::reactor_process_main_loop;
+        pool->onWorkerNotFound = [](ProcessPool *pool, const ExitStatus &exit_status) -> int {
+            auto serv = static_cast<Server *>(pool->ptr);
+            return serv->restart_worker_process(exit_status);
+        };
+        memcpy(serv->workers, pool->workers, sizeof(*serv->workers) * serv->worker_num);
+        pool->workers = serv->workers;
+        SW_LOOP_N(serv->worker_num) {
+            pool->workers[i].pool = pool;
+            pool->workers[i].set_id(i);
+            pool->workers[i].set_type(SW_WORKER);
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_INIT_IPC_MAX_SIZE:
+        serv->init_ipc_max_size();
+        return 0;
+    case SWR_WORKERS_OP_CREATE_PIPE_BUFFERS:
+        return (int64_t) serv->create_pipe_buffers();
+    case SWR_WORKERS_OP_SINGLE_WORKER:
+        return serv->is_single_worker();
+    case SWR_WORKERS_OP_RUN_SINGLE_WORKER: {
+        ProcessPool *pool = serv->get_event_worker_pool();
+        SwooleWG.worker = &pool->workers[0];
+        return (int64_t) Server::reactor_process_main_loop(pool, &pool->workers[0]);
+    }
+    case SWR_WORKERS_OP_START_MANAGER:
+        return (int64_t) serv->start_manager_process();
+    case SWR_WORKERS_OP_POOL_DESTROY:
+        serv->get_event_worker_pool()->destroy();
+        return 0;
+
+    case SWR_WORKERS_OP_BUS_READ:
+        return (int64_t) serv->message_bus.read(ctx->event->socket);
+    case SWR_WORKERS_OP_INFO_TYPE:
+        return pipe_buffer->info.type;
+    case SWR_WORKERS_OP_ON_PIPE_MESSAGE:
+        serv->onPipeMessage(serv, reinterpret_cast<EventData *>(pipe_buffer));
+        return 0;
+    case SWR_WORKERS_OP_ON_FINISH:
+        serv->onFinish(serv, reinterpret_cast<EventData *>(pipe_buffer));
+        return 0;
+    case SWR_WORKERS_OP_STOP_ASYNC:
+        serv->stop_async_worker(serv->get_worker(reactor->id));
+        return 0;
+    case SWR_WORKERS_OP_FINISH_SEND_FILE: {
+        SendData _send;
+        _send.info = pipe_buffer->info;
+        _send.data = pipe_buffer->data;
+        serv->factory_->finish(&_send);
+        return 0;
+    }
+    case SWR_WORKERS_OP_INFO_REACTOR_ID:
+        return (int64_t) pipe_buffer->info.reactor_id;
+    case SWR_WORKERS_OP_ALL_WORKER_NUM:
+        return (int64_t) (int16_t) serv->get_all_worker_num();
+    case SWR_WORKERS_LOG_INVALID_WORKER:
+        swoole_log_as("ReactorProcess_onPipeRead", swoole_warning("invalid worker_id=%d", pipe_buffer->info.reactor_id));
+        return 0;
+    case SWR_WORKERS_OP_FINISH_SEND_DATA: {
+        SendData _send;
+        auto packet = serv->message_bus.get_packet();
+        memcpy(&_send.info, &pipe_buffer->info, sizeof(_send.info));
+        _send.info.type = SW_SERVER_EVENT_RECV_DATA;
+        _send.data = packet.data;
+        _send.info.len = packet.length;
+        serv->factory_->finish(&_send);
+        return 0;
+    }
+    case SWR_WORKERS_OP_END_ACTIVELY:
+        serv->factory_->end(pipe_buffer->info.fd, Server::CLOSE_ACTIVELY);
+        return 0;
+    case SWR_WORKERS_OP_COMMAND_REQUEST:
+        serv->call_command_handler(serv->message_bus, sw_worker()->get_id(), serv->get_worker(0)->pipe_master);
+        return 0;
+    case SWR_WORKERS_OP_COMMAND_RESPONSE: {
+        int64_t request_id = pipe_buffer->info.fd;
+        auto packet = serv->message_bus.get_packet();
+        serv->call_command_callback(request_id, std::string(packet.data, packet.length));
+        return 0;
+    }
+    case SWR_WORKERS_OP_BUS_POP:
+        serv->message_bus.pop();
+        return 0;
+
+    case SWR_WORKERS_OP_WORKER_ENTER:
+        swoole_set_worker_type(SW_EVENT_WORKER);
+        swoole_set_worker_id(worker->get_id());
+        swoole_set_worker_pid(getpid());
+        serv->init_event_worker(worker);
+        return 0;
+    case SWR_WORKERS_OP_HAS_REACTOR:
+        return SwooleTG.reactor != nullptr;
+    case SWR_WORKERS_OP_EVENT_INIT:
+        return (int64_t) swoole_event_init(0);
+    case SWR_WORKERS_OP_TIMER_DETACHED:
+        return SwooleTG.timer && SwooleTG.timer->get_reactor() == nullptr;
+    case SWR_WORKERS_OP_TIMER_REINIT:
+        SwooleTG.timer->reinit();
+        return 0;
+    case SWR_WORKERS_OP_WORKER_SIGNAL_INIT:
+        serv->worker_signal_init();
+        return 0;
+    case SWR_WORKERS_OP_RESET_CONNECTION_NUM:
+        serv->gs->connection_nums[worker->get_id()] = 0;
+        return 0;
+    case SWR_WORKERS_OP_PORT_ADD: {
+        auto ls = serv->ports[arg];
+        ls->gs->connection_nums[worker->get_id()] = 0;
+        return (int64_t) reactor->add(ls->socket, SW_EVENT_READ);
+    }
+    case SWR_WORKERS_OP_REACTOR_SETUP:
+        reactor->id = worker->get_id();
+        reactor->ptr = serv;
+        reactor->max_socket = serv->get_max_connection();
+        reactor->close = Server::close_connection;
+        reactor->set_handler(SW_FD_STREAM_SERVER, SW_EVENT_READ, Server::accept_connection);
+    // close
+    reactor->set_default_error_handler(ReactorProcess_onClose);
+    // pipe
+        reactor->set_handler(SW_FD_PIPE, SW_EVENT_READ, ReactorProcess_onPipeRead);
+        return 0;
+    case SWR_WORKERS_OP_STORE_LISTEN_SOCKET:
+        serv->store_listen_socket();
+        return 0;
+    case SWR_WORKERS_OP_HAS_PIPE_WORKER:
+        return worker->pipe_worker != nullptr;
+    case SWR_WORKERS_OP_ADD_PIPES:
+        worker->pipe_worker->set_nonblock();
+        worker->pipe_master->set_nonblock();
+        if (reactor->add(worker->pipe_worker, SW_EVENT_READ) < 0) {
+            return (int64_t) SW_ERR;
+        }
+        return (int64_t) reactor->add(worker->pipe_master, SW_EVENT_READ);
+    case SWR_WORKERS_OP_TASK_WORKER_NUM:
+        return serv->task_worker_num;
+    case SWR_WORKERS_OP_TASK_IPC_UNIXSOCK:
+        return serv->task_ipc_mode == Server::TASK_IPC_UNIXSOCK;
+    case SWR_WORKERS_OP_TASK_POOL_WORKER_NUM:
+        return serv->get_task_worker_pool()->worker_num;
+    case SWR_WORKERS_OP_TASK_PIPE_NONBLOCK:
+        serv->get_task_worker_pool()->workers[arg].pipe_master->set_nonblock();
+        return 0;
+    case SWR_WORKERS_OP_INIT_REACTOR:
+        serv->init_reactor(reactor);
+        return 0;
+    case SWR_WORKERS_OP_WORKER_ID:
+        return worker->get_id();
+    case SWR_WORKERS_OP_SET_MASTER_PID:
+        serv->gs->master_pid = getpid();
+        return 0;
+    case SWR_WORKERS_OP_HAS_ON_START:
+        return serv->onStart != nullptr;
+    case SWR_WORKERS_OP_ONSTART_CALLED:
+        return serv->gs->onstart_called;
+    case SWR_WORKERS_OP_ON_START:
+        serv->gs->onstart_called = true;
+        serv->onStart(serv);
+        return 0;
+    case SWR_WORKERS_OP_ADD_MASTER_TIMER:
+        return (serv->master_timer = swoole_timer_add(1000L, true, Server::timer_callback, serv)) != nullptr;
+    case SWR_WORKERS_OP_WORKER_START_CALLBACK:
+        serv->worker_start_callback(worker);
+        return 0;
+    case SWR_WORKERS_OP_HEARTBEAT_INTERVAL:
+        return serv->heartbeat_check_interval;
+    case SWR_WORKERS_OP_ADD_HEARTBEAT_TIMER:
+        serv->heartbeat_timer =
+            swoole_timer_add(sec2msec(serv->heartbeat_check_interval), true, ReactorProcess_onTimeout, reactor);
+        return serv->heartbeat_timer != nullptr;
+    case SWR_WORKERS_OP_REACTOR_WAIT:
+        return (int64_t) reactor->wait();
+    case SWR_WORKERS_OP_MINFD:
+        return (int64_t) serv->get_minfd();
+    case SWR_WORKERS_OP_MAXFD:
+        return (int64_t) serv->get_maxfd();
+    case SWR_WORKERS_OP_CONN_AT: {
+        Connection *_conn = serv->get_connection(static_cast<int>(arg));
+        ctx->conn = Server::is_valid_connection(_conn) ? _conn : nullptr;
+        return ctx->conn != nullptr;
+    }
+    case SWR_WORKERS_OP_CLOSE_SESSION:
+        serv->close(conn->session_id, true);
+        return 0;
+    case SWR_WORKERS_OP_SERVER_HOOK_WORKER_CLOSE:
+        // call internal serv hooks
+        if (serv->isset_hook(Server::HOOK_WORKER_CLOSE)) {
+            void *hook_args[2];
+            hook_args[0] = serv;
+            hook_args[1] = (void *) (uintptr_t) worker->get_id();
+            serv->call_hook(Server::HOOK_WORKER_CLOSE, hook_args);
+        }
+        return 0;
+    case SWR_WORKERS_OP_EVENT_FREE:
+        swoole_event_free();
+        return 0;
+    case SWR_WORKERS_OP_WORKER_STOP_CALLBACK:
+        serv->worker_stop_callback(worker);
+        return 0;
+
+    case SWR_WORKERS_OP_EVENT_CONN_ACTIVE:
+        ctx->conn = serv->get_connection(ctx->event->fd);
+        return ctx->conn != nullptr && ctx->conn->active != 0;
+    case SWR_WORKERS_OP_EVENT_SOCKET_REMOVED:
+        return ctx->event->socket->removed;
+    case SWR_WORKERS_OP_CLOSE_EVENT_SOCKET:
+        return (int64_t) Server::close_connection(reactor, ctx->event->socket);
+    case SWR_WORKERS_OP_REACTOR_DEL_EVENT:
+        return (int64_t) reactor->del(ctx->event->socket);
+    case SWR_WORKERS_OP_CONN_CLOSE_QUEUED:
+        return conn->close_queued;
+    case SWR_WORKERS_OP_SET_PEER_CLOSED:
+        // the client has closed the connection and the connection is no longer available.
+        conn->peer_closed = 1;
+        return 0;
+    case SWR_WORKERS_OP_NOTIFY_CLOSE:
+        return serv->notify(conn, SW_SERVER_EVENT_CLOSE);
+    case SWR_WORKERS_OP_HEARTBEAT_NOW:
+        ctx->now = microtime();
+        return 0;
+    case SWR_WORKERS_OP_CONN_HEALTHY:
+        return serv->is_healthy_connection(ctx->now, conn);
+    case SWR_WORKERS_OP_CONN_SSL_PENDING:
+        return conn->socket->ssl && conn->socket->ssl_state != SW_SSL_STATE_READY;
+    case SWR_WORKERS_OP_DISABLE_NOTIFY:
+        return serv->disable_notify;
+    case SWR_WORKERS_OP_CONN_CLOSE_FORCE:
+        return conn->close_force;
+    case SWR_WORKERS_OP_CLOSE_CONNECTION:
+        Server::close_connection(reactor, conn->socket);
+        return 0;
+    case SWR_WORKERS_OP_SET_CLOSE_FORCE:
+        conn->close_force = 1;
+        return 0;
+    case SWR_WORKERS_OP_CLOSE_NOTIFY: {
+        Event notify_ev{};
+        notify_ev.type = SW_FD_SESSION;
+        notify_ev.fd = conn->fd;
+        notify_ev.socket = conn->socket;
+        notify_ev.reactor_id = conn->reactor_id;
+        ReactorProcess_onClose(reactor, &notify_ev);
+        return 0;
+    }
+    default:
+        abort();
+    }
+}
+
+static int ReactorProcess_onPipeRead(Reactor *reactor, Event *event) {
+    auto *serv = static_cast<Server *>(reactor->ptr);
+    return ReactorProcessContext{serv, nullptr, nullptr, reactor, event, nullptr, 0}.run(
+        SWR_WORKERS_RUN_REACTOR_PROCESS_PIPE_READ);
+}
+
+static int ReactorProcess_onClose(Reactor *reactor, Event *event) {
+    auto *serv = static_cast<Server *>(reactor->ptr);
+    return ReactorProcessContext{serv, nullptr, nullptr, reactor, event, nullptr, 0}.run(
+        SWR_WORKERS_RUN_REACTOR_PROCESS_CLOSE);
+}
+
+static void ReactorProcess_onTimeout(Timer *timer, TimerNode *tnode) {
+    auto *reactor = static_cast<Reactor *>(tnode->data);
+    auto *serv = static_cast<Server *>(reactor->ptr);
+    ReactorProcessContext{serv, nullptr, nullptr, reactor, nullptr, nullptr, 0}.run(
+        SWR_WORKERS_RUN_REACTOR_PROCESS_TIMEOUT);
+}
