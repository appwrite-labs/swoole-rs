-static WorkerContext Worker_context(Server *serv, Worker *worker) {
-    return WorkerContext{serv, worker, nullptr, sw_reactor(), nullptr, nullptr, nullptr};
-}
-
-void Server::worker_signal_init() const {
-    Worker_context(const_cast<Server *>(this), sw_worker()).run(SWR_WORKERS_RUN_SIGNAL_INIT);
-}
-
-void Server::worker_signal_handler(int signo) {
-    Worker_context(sw_server(), sw_worker()).run(SWR_WORKERS_RUN_WORKER_SIGNAL, signo);
-}
-
-void Server::worker_accept_event(DataHead *info) {
-    auto ctx = Worker_context(this, sw_worker());
-    ctx.info = info;
-    ctx.run(SWR_WORKERS_RUN_ACCEPT_EVENT);
-}
-
-void Server::worker_start_callback(Worker *worker) {
-    Worker_context(this, worker).run(SWR_WORKERS_RUN_WORKER_START);
