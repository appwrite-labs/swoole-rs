-extern "C" void swr_workers_signal_set(uint64_t arg, void (*own)(int)) {
-    int signo = static_cast<int32_t>(static_cast<uint32_t>(arg));
-    if (signo == -1) {
-#ifdef SIGRTMIN
-        signo = SIGRTMIN;
-#else
-        return;
-#endif
-    }
-    const uint64_t handler = arg >> 32;
-    swoole_signal_set(signo, handler == 0 ? nullptr : (handler == 1 ? SIG_IGN : own));
-}
