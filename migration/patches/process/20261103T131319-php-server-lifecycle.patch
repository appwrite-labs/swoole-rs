+int64_t lifecycle_fact(void *server, uint32_t id) {
+    Server *serv = as_server(server);
+    switch (id) {
+    case SWR_PHPSERVER_FACT_MODE: return serv->get_mode();
+    case SWR_PHPSERVER_FACT_STARTED: return serv->is_started();
+    case SWR_PHPSERVER_FACT_SHUTDOWN: return serv->is_shutdown();
+    case SWR_PHPSERVER_FACT_WORKER_THREAD: return serv->is_worker_thread();
+    case SWR_PHPSERVER_FACT_MASTER: return serv->is_master();
+    case SWR_PHPSERVER_FACT_THREAD_MODE: return serv->is_thread_mode();
+    case SWR_PHPSERVER_FACT_REACTOR: return sw_reactor() != nullptr;
+    case SWR_PHPSERVER_FACT_ENABLE_COROUTINE: return serv->enable_coroutine;
+    case SWR_PHPSERVER_FACT_SEND_YIELD: return serv->send_yield;
+    case SWR_PHPSERVER_FACT_HAS_ON_CLOSE: return serv->onClose != nullptr;
+    case SWR_PHPSERVER_FACT_UNSAFE_EVENTS: return serv->is_support_unsafe_events();
+    case SWR_PHPSERVER_FACT_HASH_DISPATCH: return serv->is_hash_dispatch_mode();
+    case SWR_PHPSERVER_FACT_CACHE_SESSION_ADDR: return swoole_http_server_can_cache_session_addr(serv);
+    case SWR_PHPSERVER_FACT_WORKER_NUM: return serv->worker_num;
+    case SWR_PHPSERVER_FACT_TASK_WORKER_NUM: return serv->task_worker_num;
+    case SWR_PHPSERVER_FACT_OUTPUT_BUFFER_SIZE: return serv->output_buffer_size;
+    case SWR_PHPSERVER_FACT_MAX_CONNECTION: return serv->get_max_connection();
+    default: return 0;
+    }
+}
+void lifecycle_install(void *server, uint32_t which) {
+    Server *serv = as_server(server);
+    switch (which) {
+    case SWR_PHPSERVER_INSTALL_CONTROL:
+        serv->onStart = php_swoole_server_onStart;
+        serv->onBeforeShutdown = php_swoole_server_onBeforeShutdown;
+        serv->onShutdown = php_swoole_server_onShutdown;
+        serv->onWorkerStart = php_swoole_server_onWorkerStart;
+        serv->onWorkerStop = php_swoole_server_onWorkerStop;
+        serv->onWorkerExit = php_swoole_server_onWorkerExit;
+        serv->onBeforeReload = php_swoole_server_onBeforeReload;
+        serv->onAfterReload = php_swoole_server_onAfterReload;
+        serv->onManagerStart = php_swoole_server_onManagerStart;
+        serv->onManagerStop = php_swoole_server_onManagerStop;
+        serv->onWorkerError = php_swoole_server_onWorkerError;
+        break;
+    case SWR_PHPSERVER_INSTALL_TASK:
+        serv->onTask = php_swoole_server_onTask;
+        serv->onFinish = php_swoole_server_onFinish;
+        break;
+    case SWR_PHPSERVER_INSTALL_PIPE_MESSAGE: serv->onPipeMessage = php_swoole_server_onPipeMessage; break;
+    case SWR_PHPSERVER_INSTALL_BUFFER_EMPTY: serv->onBufferEmpty = php_swoole_server_onBufferEmpty; break;
+    case SWR_PHPSERVER_INSTALL_CLOSE: serv->onClose = php_swoole_server_onClose; break;
+    case SWR_PHPSERVER_INSTALL_HTTP_CLOSE: serv->onClose = php_swoole_http_server_onClose; break;
+    case SWR_PHPSERVER_INSTALL_RECEIVE: serv->onReceive = php_swoole_server_onReceive; break;
+    case SWR_PHPSERVER_INSTALL_HTTP_RECEIVE: serv->onReceive = php_swoole_http_server_onReceive; break;
+    case SWR_PHPSERVER_INSTALL_REDIS_RECEIVE: serv->onReceive = php_swoole_redis_server_onReceive; break;
+    case SWR_PHPSERVER_INSTALL_USER_WORKER_START:
+        if (serv->onUserWorkerStart == nullptr) {
+            serv->onUserWorkerStart = php_swoole_server_onUserWorkerStart;
+        }
+        break;
+    case SWR_PHPSERVER_INSTALL_ALLOCATORS:
+        serv->message_bus.set_allocator(sw_zend_string_allocator());
+        if (serv->is_base_mode() || serv->is_thread_mode()) {
+            serv->recv_buffer_allocator = sw_zend_string_allocator();
+        }
+        break;
+    case SWR_PHPSERVER_INSTALL_ADMIN_COMMANDS: swoole::register_admin_server_commands(serv); break;
+    default: break;
+    }
+}
