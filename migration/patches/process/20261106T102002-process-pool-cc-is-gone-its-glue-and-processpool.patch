+static int64_t pool_call(void *_pool, void *_worker, uint32_t op, uint64_t arg) {
+    auto pool = static_cast<ProcessPool *>(_pool);
+    auto worker = static_cast<Worker *>(_worker);
+    switch (op) {
+    case SWR_POOL_OP_HAVE_MSGQUEUE:
+#ifdef HAVE_MSGQUEUE
+        return 1;
+#else
+        return 0;
+#endif
+    case SWR_POOL_OP_ALLOC_WORKERS:
+        pool->workers = static_cast<Worker *>(sw_mem_pool()->alloc(pool->worker_num * sizeof(Worker)));
+        return pool->workers != nullptr;
+    case SWR_POOL_OP_NEW_MESSAGE_BOX:
+        pool->message_box = Channel::make(arg, sizeof(EventData), SW_CHAN_LOCK | SW_CHAN_SHM);
+        return pool->message_box != nullptr;
+    case SWR_POOL_OP_NEW_QUEUE:
+        pool->queue = new MsgQueue(pool->msgqueue_key);
+        if (!pool->queue->ready()) {
+            delete pool->queue;
+            pool->queue = nullptr;
+            return 0;
+        }
+        return 1;
+    case SWR_POOL_OP_NEW_PIPES:
+        pool->pipes = new std::vector<std::shared_ptr<UnixSocket>>;
+        return 0;
+    case SWR_POOL_OP_NEW_PIPE: {
+        auto sock = new UnixSocket(true, SOCK_DGRAM);
+        if (!sock->ready()) {
+            delete sock;
+            delete pool->pipes;
+            pool->pipes = nullptr;
+            return 0;
+        }
+        pool->pipes->emplace_back(sock);
+        worker->pipe_master = sock->get_socket(true);
+        worker->pipe_worker = sock->get_socket(false);
+        worker->pipe_object = sock;
+        return 1;
+    }
+    case SWR_POOL_OP_MAIN_LOOP:
+        pool->main_loop = arg == SW_PROTOCOL_TASK      ? run_loop<SW_PROTOCOL_TASK>
+                          : arg == SW_PROTOCOL_STREAM  ? run_loop<SW_PROTOCOL_STREAM>
+                          : arg == SW_PROTOCOL_MESSAGE ? run_loop<SW_PROTOCOL_MESSAGE>
+                                                       : run_loop<4>;
+        return 0;
+    case SWR_POOL_OP_NEW_MESSAGE_BUS: {
+        auto *msg_id = static_cast<sw_atomic_long_t *>(sw_mem_pool()->alloc(sizeof(sw_atomic_long_t)));
+        if (msg_id == nullptr) {
+            return 0;
+        }
+        *msg_id = 1;
+        pool->message_bus = new MessageBus();
+        pool->message_bus->set_id_generator([msg_id]() { return sw_atomic_fetch_add(msg_id, 1); });
+        return 1;
+    }
+    case SWR_POOL_OP_SNDBUF: {
+        int bufsize;
+        return worker->pipe_master->get_option(SOL_SOCKET, SO_SNDBUF, &bufsize) != 0 ? -1 : bufsize;
+    }
+    case SWR_POOL_OP_BUS_BUFFER:
+        pool->message_bus->set_buffer_size(arg);
+        return pool->message_bus->alloc_buffer();
+    case SWR_POOL_OP_WORKER_TYPE:
+        swoole_set_worker_type((int) arg);
+        return 0;
+    case SWR_POOL_OP_UNLIMIT_PIPES:
+        if (worker->pipe_worker) {
+            worker->pipe_worker->buffer_size = UINT_MAX;
+        }
+        if (worker->pipe_master) {
+            worker->pipe_master->buffer_size = UINT_MAX;
+        }
+        return 0;
+    case SWR_POOL_OP_FORK:
+        return swoole_fork(0);
+    case SWR_POOL_OP_WORKER_INIT:
+        worker->init();
+        worker->set_pid(getpid());
+        swoole_set_worker_type(SW_WORKER);
+        swoole_set_worker_id(worker->get_id());
+        swoole_set_worker_pid(worker->get_pid());
+        SwooleWG.worker = worker;
+        return 0;
+    case SWR_POOL_OP_EVENT_INIT:
+        if (swoole_event_init(SW_EVENTLOOP_WAIT_EXIT) < 0) {
+            return -1;
+        }
+        sw_reactor()->ptr = pool;
+        return 0;
+    case SWR_POOL_OP_WORKER_SHUTDOWN:
+        worker->shutdown();
+        return 0;
+    case SWR_POOL_OP_EVENT_AVAILABLE:
+        return swoole_event_is_available();
+    case SWR_POOL_OP_REMOVE_PIPE:
+        // arg: only when the pipe is still in the reactor.
+        if (!arg || (worker->pipe_worker && !worker->pipe_worker->removed)) {
+            swoole_event_del(worker->pipe_worker);
+        }
+        return 0;
+    case SWR_POOL_OP_EXIT_CALLBACK:
+        sw_reactor()->set_end_callback(Reactor::PRIORITY_TRY_EXIT, [pool, worker](Reactor *reactor) {
+            pool->onWorkerExit(pool, worker);
+            if (reactor->if_exit()) {
+                reactor->running = false;
+            }
+        });
+        return 0;
+    case SWR_POOL_OP_REOPEN_LOGGER:
+        sw_logger()->reopen();
+        return 0;
+    case SWR_POOL_OP_IS_MASTER:
+        return pool->is_master();
+    case SWR_POOL_OP_RELOAD_TIMER:
+        swr_v1_process_reload_task_set_timer(
+            pool->reload_task,
+            swoole_timer_add(sec2msec(static_cast<int>(pool->max_wait_time)), false, [](Timer *, TimerNode *tnode) {
+                auto task = static_cast<swr_v1_process_reload_task *>(tnode->data);
+                swr_v1_process_reload_task_kill_all(task, SIGKILL, reload_warn);
+                swr_v1_process_reload_task_set_timer(task, nullptr);
+            }, pool->reload_task));
+        return 0;
+    case SWR_POOL_OP_TIMER_DEL:
+        swoole_timer_del(reinterpret_cast<TimerNode *>(arg));
+        return 0;
+    case SWR_POOL_OP_DONT_RESTART:
+        if (worker->pipe_worker) {
+            worker->pipe_worker->dont_restart = 1;
+        }
+        return 0;
+    case SWR_POOL_OP_TIMER_INIT:
+        if (swoole_timer_is_available()) {
+            sw_timer()->reinit(true);
+        } else {
+            swoole_timer_create(true);
+        }
+        return 0;
+    case SWR_POOL_OP_TIMER_FREE:
+        if (swoole_timer_is_available()) {
+            swoole_timer_free();
+        }
+        return 0;
+    case SWR_POOL_OP_ADD_PIPE:
+        return swoole_event_add(worker->pipe_worker, SW_EVENT_READ);
+    case SWR_POOL_OP_PIPE_HANDLER:
+        swoole_event_set_handler(SW_FD_PIPE, SW_EVENT_READ, arg ? recv_message : recv_packet);
+        return 0;
+    case SWR_POOL_OP_EVENT_WAIT:
+        return swoole_event_wait();
+    case SWR_POOL_OP_CURRENT_WORKER:
+        return (int64_t) (uintptr_t) SwooleWG.worker;
+    case SWR_POOL_OP_PUSH_STOP: {
+        WorkerStopMessage msg;
+        msg.pid = worker->get_pid();
+        msg.worker_id = worker->get_id();
+        return pool->push_message(SW_WORKER_MESSAGE_STOP, &msg, sizeof(msg));
+    }
+    case SWR_POOL_OP_SIGNAL_DISPATCH:
+        swoole_signal_dispatch();
+        return 0;
+    case SWR_POOL_OP_TIMER_SELECT:
+        if (sw_timer()) {
+            sw_timer()->select();
+        }
+        return 0;
+    case SWR_POOL_OP_POP_MESSAGE:
+        return pool->pop_message(&pool_message, sizeof(pool_message)) > 0 ? (int64_t) (uintptr_t) &pool_message : 0;
+    case SWR_POOL_OP_ON_WORKER_MESSAGE:
+        pool->onWorkerMessage(pool, &pool_message);
+        return 0;
+    case SWR_POOL_OP_ON_WORKER_NOT_FOUND:
+        pool->onWorkerNotFound(pool, exit_status_of(arg));
+        return 0;
+    case SWR_POOL_OP_WORKER_ERROR: {
+        const ExitStatus exit_status = exit_status_of(arg);
+        worker->report_error(exit_status);
+        if (pool->onWorkerError) {
+            pool->onWorkerError(pool, worker, exit_status);
+        }
+        return 0;
+    }
+    case SWR_POOL_OP_ON_AFTER_RELOAD:
+        pool->onAfterReload(pool);
+        return 0;
+    case SWR_POOL_OP_KILL_TIMER:
+        swoole_timer_add((long) pool->max_wait_time * 1000, false, [pool](Timer *, TimerNode *) {
+            pool->kill_all_workers();
+        });
+        return 0;
+    case SWR_POOL_OP_WAITPID: {
+        int status;
+        return swoole_waitpid((pid_t) arg, &status, 0);
+    }
+    case SWR_POOL_OP_BOX_PUSH: {
+        auto msg = reinterpret_cast<const EventData *>(arg);
+        return pool->message_box->push(msg, msg->size());
+    }
+    case SWR_POOL_OP_STREAM_SEND: {
+        auto data = reinterpret_cast<EventData *>(arg);
+        int port;
+        Stream *stream = Stream::create(swr_v1_process_pool_ipc_address_of(pool->ipc_, &port), 0, SW_SOCK_UNIX_STREAM);
+        if (!stream) {
+            return SW_ERR;
+        }
+        stream->response = nullptr;
+        if (stream->send(reinterpret_cast<char *>(data), data->size()) < 0) {
+            stream->cancel = true;
+            delete stream;
+            return SW_ERR;
+        }
+        return SW_OK;
+    }
+    case SWR_POOL_OP_SYNC_SEND: {
+        auto data = reinterpret_cast<EventData *>(arg);
+        return pool->dispatch_sync(reinterpret_cast<char *>(data), data->size());
+    }
+    case SWR_POOL_OP_FREE_PIPES:
+        delete pool->pipes;
+        return 0;
+    case SWR_POOL_OP_FREE_QUEUE:
+        delete pool->queue;
+        return 0;
+    case SWR_POOL_OP_FREE_MESSAGE_BOX:
+        pool->message_box->destroy();
+        return 0;
+    case SWR_POOL_OP_FREE_MESSAGE_BUS:
+        delete pool->message_bus;
+        return 0;
+    case SWR_POOL_OP_FREE_WORKERS:
+        sw_mem_pool()->free(pool->workers);
+        return 0;
+    case SWR_POOL_LOG_NO_SYSVMSG:
+        swoole_log_as("ProcessPool::create", swoole_warning("current platform does not support `sysvmsg`"));
+        return 0;
+    case SWR_POOL_LOG_ALLOC:
+        swoole_log_as(arg ? "ProcessPool::create_message_bus" : "ProcessPool::create",
+                      swoole_sys_warning("malloc[1] failed"));
+        return 0;
+    case SWR_POOL_LOG_NEEDS_UNIXSOCK:
+        swoole_log_as(arg ? "ProcessPool::run_with_message_protocol" : "ProcessPool::create_message_bus",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_OPERATION_NOT_SUPPORT,
+                                       "not support, ipc_mode must be SW_IPC_UNIXSOCK"));
+        return 0;
+    case SWR_POOL_LOG_BUS_EXISTS:
+        swoole_log_as(
+            "ProcessPool::create_message_bus",
+            swoole_error_log(SW_LOG_WARNING, SW_ERROR_WRONG_OPERATION, "the message bus has been created"));
+        return 0;
+    case SWR_POOL_LOG_MUST_LISTEN:
+        swoole_log_as("ProcessPool::start_check",
+                      swoole_error_log(SW_LOG_WARNING, SW_ERROR_WRONG_OPERATION, "must first listen to an tcp port"));
+        return 0;
+    case SWR_POOL_LOG_UNKNOWN_CHILD:
+        swoole_log_as("ProcessPool::wait_detached_worker",
+                      swoole_warning("received an exit signal from an unknown child process[pid=%d]", (int) arg));
+        return 0;
+    case SWR_POOL_LOG_WAIT_FAILED:
+        swoole_log_as("ProcessPool::wait", swoole_sys_warning("wait() failed"));
+        return 0;
+    case SWR_POOL_LOG_KILL_FAILED:
+        swoole_log_as("ProcessPool::wait", swoole_sys_warning("kill(%d, SIGTERM) failed", (int) arg));
+        return 0;
+    case SWR_POOL_LOG_WAITPID_FAILED:
+        swoole_log_as("ProcessPool::wait", swoole_sys_warning("waitpid(%d) failed", (int) arg));
+        return 0;
+    default:
+        return 0;
+    }
+}
+
+// The pool's callbacks, inside the bailout trap.
+static void pool_callback(void *arg) {
+    auto c = call_of(arg);
+    auto pool = call_pool(arg);
+    switch (c->flags) {
+    case SWR_POOL_CB_START:
+        pool->onStart(pool);
+        break;
+    case SWR_POOL_CB_BEFORE_RELOAD:
+        pool->onBeforeReload(pool);
+        break;
+    case SWR_POOL_CB_SHUTDOWN:
+        pool->onShutdown(pool);
+        break;
+    case SWR_POOL_CB_WORKER_START:
+        pool->onWorkerStart(pool, call_worker(arg));
+        break;
+    case SWR_POOL_CB_MAIN_LOOP:
+        c->result = pool->main_loop(pool, call_worker(arg));
+        break;
+    case SWR_POOL_CB_WORKER_STOP:
+        pool->onWorkerStop(pool, call_worker(arg));
+        break;
+    default:
+        break;
+    }
+}
+
+static const swr_v1_pool_native pool_native = {pool_call, pool_callback, &pool_hooks, reload_warn, sizeof(EventData)};
+// The ProcessPool and Worker methods crates/process/src/methods.rs defines run over this table.
+[[maybe_unused]] static const bool pool_native_set = (swr_v1_process_pool_set_native(&pool_native), true);
+
+// A callback's bailout is raised here, once the Rust frames are gone.
+static int run_main(ProcessPool *pool, Worker *worker, uint64_t protocol) {
+    int64_t result = swr_v1_process_pool_run_op(&pool_native, pool, worker, SWR_POOL_RUN_MAIN, protocol);
+    if (result == SWR_POOL_RAISE) {
+        swr_v1_process_bailout();
+    }
+    return (int) result;
+}
+
+static int listen_stream(const ProcessPool *pool, SocketType type, const char *host, int port, int backlog) {
+    if (pool->ipc_mode != SW_IPC_SOCKET) {
+        swoole_error_log(SW_LOG_WARNING, SW_ERROR_OPERATION_NOT_SUPPORT, "not support, ipc_mode must be SW_IPC_SOCKET");
+        return SW_ERR;
+    }
+    swr_v1_process_pool_ipc_address(pool->ipc_, host, port);
+    auto socket = make_server_socket(type, host, port, backlog);
+    if (!socket) {
+        return SW_ERR;
+    }
+    swr_v1_process_pool_ipc_set_listener(pool->ipc_, socket);
+    return SW_OK;
+}
+
+int ProcessPool::listen(const char *socket_file, int backlog) const {
+    return listen_stream(this, SW_SOCK_UNIX_STREAM, socket_file, 0, backlog);
+}
+
+int ProcessPool::listen(const char *host, int port, int backlog) const {
+    return listen_stream(this, SW_SOCK_TCP, host, port, backlog);
+}
+
+int ProcessPool::response(const char *data, uint32_t length) const {
+    if (!swr_v1_process_pool_ipc_respond(ipc_, reinterpret_cast<const uint8_t *>(data), length)) {
+        swoole_set_last_error(SW_ERROR_INVALID_PARAMS);
+        return SW_ERR;
+    }
+    return SW_OK;
+}
+
+bool ProcessPool::send_message(WorkerId worker_id, const char *message, size_t l_message) const {
+    Worker *worker = get_worker(worker_id);
+    if (message_bus) {
+        SendData _task{};
+        _task.info.reactor_id = swoole_get_worker_id();
+        _task.info.len = l_message;
+        _task.data = message;
+        return message_bus->write(worker->pipe_master, &_task);
+    } else {
+        return worker->pipe_master->send_async(message, l_message);
+    }
+}
+
+int ProcessPool::pop_message(void *data, size_t size) const {
+    if (!message_box) {
+        return SW_ERR;
+    }
+    return message_box->pop(data, size);
+}
+
+swResultCode ProcessPool::dispatch_sync(const char *data, uint32_t len) const {
+    assert(use_socket);
+
+    int port;
+    const char *address = swr_v1_process_pool_ipc_address_of(ipc_, &port);
+    network::Client client(pool_listener(this)->socket_type, false);
+    if (!client.ready()) {
+        return SW_ERR;
+    }
+    if (client.connect(address, port, -1, 0) < 0) {
+        return SW_ERR;
+    }
+    uint32_t packed_len = htonl(len);
+    if (client.send((char *) &packed_len, 4, 0) < 0) {
+        return SW_ERR;
+    }
+    if (client.send(data, len, 0) < 0) {
+        return SW_ERR;
+    }
+    client.close();
+    return SW_OK;
+}
+
+void Worker::set_max_request(uint32_t max_request, uint32_t max_request_grace) {
+    swr_v1_worker_global_max_requests(max_request, max_request_grace, swoole_system_random);
+}
+
+void Worker::report_error(const ExitStatus &exit_status) const {
+    swoole_warning("worker(pid=%d, id=%d) abnormal exit, status=%d, signal=%d"
+                   "%s",
+                   exit_status.get_pid(),
+                   get_id(),
+                   exit_status.get_code(),
+                   exit_status.get_signal(),
+                   exit_status.get_signal() == SIGSEGV ? SwooleG.bug_report_message.c_str() : "");
+}
