+static int recv_message(Reactor *reactor, Event *event) {
+    auto *pool = static_cast<ProcessPool *>(reactor->ptr);
+    if (pool->message_bus->read(event->socket) > 0) {
+        deliver_bus_message(pool);
+    }
+    return SW_OK;
