-// The warnings keep upstream's ReloadTask::kill_all/kill_one log prefixes.
-struct ReloadTask {
-    static void kill_all(int kind, int pid, uint32_t worker_id) {
-        if (kind == SWR_RELOAD_WARN_KILL_ALL_FAILED) {
-            swoole_sys_warning("failed to kill(%d, SIGTERM) worker#[%d]", pid, worker_id);
-        } else {
-            swoole_warning("force kill worker process(pid=%d, id=%d)", pid, worker_id);
-        }
-    }
-
-    static void kill_one(int pid, uint32_t worker_id) {
-        swoole_sys_warning("kill(%d, SIGTERM) [%d] failed", pid, worker_id);
-    }
-};
-
-void reload_warn(int kind, int pid, uint32_t worker_id) {
-    if (kind == SWR_RELOAD_WARN_KILL_ONE_FAILED) {
-        ReloadTask::kill_one(pid, worker_id);
-    } else {
-        ReloadTask::kill_all(kind, pid, worker_id);
-    }
-}
-
-static inline void worker_end_callback() {
-    swoole_timer_select();
-    swoole_signal_dispatch();
-}
-
-static void deliver_bus_message(ProcessPool *pool) {
-    auto pipe_buffer = pool->message_bus->get_buffer();
-    auto packet = pool->message_bus->get_packet();
-    RecvData msg;
-    msg.info = pipe_buffer->info;
-    msg.info.len = packet.length;
-    msg.data = packet.data;
-    pool->onMessage(pool, &msg);
-    pool->message_bus->pop();
-}
-
-// The native objects the Rust worker loops and dispatch (crates/process/src/pool.rs)
-// run over. Each hook takes a swr_v1_pool_call and saves errno right after its call.
-static swr_v1_pool_call *call_of(void *arg) {
-    return static_cast<swr_v1_pool_call *>(arg);
-}
-
-static ProcessPool *call_pool(void *arg) {
-    return static_cast<ProcessPool *>(call_of(arg)->pool);
-}
-
-static Worker *call_worker(void *arg) {
-    return static_cast<Worker *>(call_of(arg)->worker);
-}
-
-static Socket *pool_listener(const ProcessPool *pool) {
-    return static_cast<Socket *>(swr_v1_process_pool_ipc_listener(pool->ipc_));
-}
-
-static void pool_warn(void *_pool, void *worker, int kind, int64_t a, int64_t b) {
-    auto pool = static_cast<ProcessPool *>(_pool);
-    auto worker_id = worker ? static_cast<Worker *>(worker)->get_id() : 0;
-    switch (kind) {
-    case SWR_POOL_WARN_MSGRCV:
-        swoole_sys_warning("[Worker#%d] msgrcv(%d) failed", worker_id, pool->queue->get_id());
-        break;
-    case SWR_POOL_WARN_ACCEPT:
-        swoole_sys_warning("[Worker#%d] accept(%d) failed", worker_id, pool_listener(pool)->get_fd());
-        break;
-    case SWR_POOL_WARN_READ:
-        swoole_sys_warning("[Worker#%d] read(%d) failed", worker_id, static_cast<Worker *>(worker)->pipe_worker->fd);
-        break;
-    case SWR_POOL_WARN_BAD_PACKET:
-        swoole_warning("[Worker#%d] bad task packet, The received data-length[%ld] is inconsistent with the "
-                       "packet-length[%ld]",
-                       worker_id,
-                       (long) a,
-                       (long) b);
-        break;
-    case SWR_POOL_WARN_TASK_FAILED:
-        swoole_warning("[Worker#%d] the execution of task#%ld has failed", worker_id, (long) a);
-        break;
-    case SWR_POOL_WARN_PIPE:
-        swoole_sys_warning("[Worker #%d]failed to read data from pipe", worker_id);
-        break;
-    case SWR_POOL_TRACE_POP:
-        swoole_trace_log(SW_TRACE_WORKER, "pop from MsgQ#%d %lu bytes", pool->queue->get_id(), (ulong_t) a);
-        break;
-    case SWR_POOL_WARN_SEND:
-        swoole_warning("send %d bytes to worker#%d failed", (int) a, (int) b);
-        break;
-    case SWR_POOL_TRACE_PUSH:
-        swoole_trace_log(SW_TRACE_WORKER, "push to MsgQ#%d %lu bytes", pool->queue->get_id(), (ulong_t) a);
-        break;
-    default:
-        break;
-    }
-}
-
-static const swr_v1_pool_hooks pool_hooks = {
-    [](void *pool, void *worker) {
-        return static_cast<ProcessPool *>(pool)->is_worker_running(static_cast<Worker *>(worker));
-    },
-    [](void *) { worker_end_callback(); },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = call_pool(arg)->queue->pop(static_cast<QueueNode *>(c->data), c->length);
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = call_pool(arg)->queue->push(static_cast<QueueNode *>(c->data), c->length);
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->socket = pool_listener(call_pool(arg))->accept();
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = static_cast<Socket *>(c->socket)->recv_sync(c->data, c->length, c->flags);
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = static_cast<Socket *>(c->socket)->send_sync(c->data, c->length);
-        c->error = errno;
-    },
-    [](void *socket) { static_cast<Socket *>(socket)->free(); },
-    [](void *arg) {
-        auto c = call_of(arg);
-        auto pipe = call_worker(arg)->pipe_worker;
-        pipe->set_timeout(msec2sec(swoole_timer_get_next_msec()), SW_TIMEOUT_READ);
-        c->result = pipe->read_sync(c->data, c->length);
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = call_worker(arg)->pipe_worker->wait_event(swoole_timer_get_next_msec(), SW_EVENT_READ);
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = call_pool(arg)->message_bus->read(call_worker(arg)->pipe_worker);
-        c->error = errno;
-    },
-    [](void *arg) { deliver_bus_message(call_pool(arg)); },
-    [](void *arg) {
-        auto pool = call_pool(arg);
-        call_of(arg)->result = pool->onTask(pool, call_worker(arg), static_cast<EventData *>(call_of(arg)->data));
-    },
-    [](void *arg) {
-        auto pool = call_pool(arg);
-        RecvData msg{};
-        msg.info.reactor_id = -1;
-        msg.info.len = call_of(arg)->length;
-        msg.data = static_cast<char *>(call_of(arg)->data);
-        pool->onMessage(pool, &msg);
-    },
-    [](void *worker) { static_cast<Worker *>(worker)->shutdown(); },
-    [](void *arg) {
-        auto c = call_of(arg);
-        auto socket = static_cast<Socket *>(c->socket);
-        if (c->flags && swoole_event_is_available()) {
-            c->result = swoole_event_write(socket, c->data, c->length);
-        } else {
-            c->result = socket->send_sync(c->data, c->length);
-        }
-        c->error = errno;
-    },
-    pool_warn,
-};
