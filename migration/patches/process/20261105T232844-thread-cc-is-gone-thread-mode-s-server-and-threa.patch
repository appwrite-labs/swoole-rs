+// What a crates/process/src/workers/thread.rs operation acts on.
+template <>
+struct WorkersNative<5> {
+    Server *serv;
+    ThreadFactory *factory;
+    Worker *worker;
+
+    static uint64_t call(void *context, uint32_t op, uint64_t arg);
+
+    int64_t run(uint32_t operation, uint64_t arg = 0) {
+        return swr_v1_workers_run(operation, arg, this, call);
+    }
+};
+using ThreadContext = WorkersNative<5>;
+
+uint64_t ThreadContext::call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<ThreadContext *>(context);
+    Server *serv = ctx->serv;
+    ThreadFactory *factory = ctx->factory;
+    Worker *worker = ctx->worker;
+    switch (op) {
+    case SWR_WORKERS_OP_THREAD_MANAGER:
+        return (uintptr_t) factory->manager_;
+    case SWR_WORKERS_OP_MANAGER_THREAD_ID:
+    case SWR_WORKERS_OP_ALL_WORKER_NUM:
+        return serv->get_all_worker_num();
+    case SWR_WORKERS_OP_THREAD_SUPPORTED:
+#ifdef SW_THREAD
+        return 1;
+#else
+        return 0;
+#endif
+    case SWR_WORKERS_LOG_THREAD_UNSUPPORTED:
+        swoole_log_as("Server::create_thread_factory",
+                      swoole_error_log(SW_LOG_ERROR,
+                                       SW_ERROR_OPERATION_NOT_SUPPORT,
+                                       "Thread support is not enabled, cannot create server with MODE_THREAD"));
+        return 0;
+    case SWR_WORKERS_OP_THREAD_REACTOR_NUM:
+        serv->reactor_num = serv->worker_num;
+        return 0;
+    case SWR_WORKERS_OP_CALLOC_CONNECTIONS:
+        serv->connection_list = static_cast<Connection *>(sw_calloc(serv->max_connection, sizeof(Connection)));
+        return serv->connection_list != nullptr;
+    case SWR_WORKERS_LOG_CALLOC_CONNECTIONS:
+        swoole_log_as("Server::create_thread_factory",
+                      swoole_sys_warning("calloc[2](%d) failed",
+                                         static_cast<int>(serv->max_connection * sizeof(Connection))));
+        return 0;
+    case SWR_WORKERS_OP_NEW_REACTOR_THREADS:
+        serv->reactor_threads = new ReactorThread[serv->reactor_num]();
+        return 0;
+    case SWR_WORKERS_OP_SINGLE_REACTOR_PIPE:
+        serv->reactor_pipe_num = 1;
+        return 0;
+    case SWR_WORKERS_OP_NEW_THREAD_FACTORY:
+        return (uintptr_t) new ThreadFactory(serv);
+    case SWR_WORKERS_OP_FREE_THREAD_CONNECTIONS:
+        sw_free(serv->connection_list);
+        return 0;
+    case SWR_WORKERS_OP_DELETE_REACTOR_THREADS:
+        delete[] serv->reactor_threads;
+        return 0;
+    case SWR_WORKERS_TRACE_NOTIFY_MANAGER_EXIT:
+        swoole_log_as("ThreadFactory::terminate_manager_thread",
+                      swoole_trace_log(SW_TRACE_THREAD, "notify manager thread to exit"));
+        return 0;
+    case SWR_WORKERS_OP_JOIN_THREAD:
+        factory->thread_at(arg)->join();
+        swoole_log_as("ThreadFactory::wait", swoole_trace_log(SW_TRACE_THREAD, "thread=%d join", (int) arg));
+        return 0;
+    case SWR_WORKERS_TRACE_MANAGER_EXITED:
+        swoole_log_as("ThreadFactory::terminate_manager_thread",
+                      swoole_trace_log(SW_TRACE_THREAD, "manager thread is exited"));
+        return 0;
+    case SWR_WORKERS_OP_ALL_CORE_WORKER_NUM:
+        return serv->get_core_worker_num();
+    case SWR_WORKERS_OP_KILL_WORKER:
+        serv->kill_worker(static_cast<int>(arg));
+        return 0;
+    case SWR_WORKERS_OP_TERMINATE_MANAGER_THREAD:
+        factory->terminate_manager_thread();
+        return 0;
+    case SWR_WORKERS_OP_TIMER_NEXT_MSEC:
+        return (int64_t) swoole_timer_get_next_msec();
+    case SWR_WORKERS_TRACE_MANAGER_WAKE:
+        swoole_log_as("ThreadFactory::wait",
+                      swoole_trace_log(SW_TRACE_THREAD,
+                                       "manager thread is waiting for worker exit, queue size: %zu",
+                                       (size_t) arg));
+        return 0;
+    case SWR_WORKERS_OP_HAS_TIMER:
+        return sw_timer() != nullptr;
+    case SWR_WORKERS_OP_TIMER_SELECT:
+        sw_timer()->select();
+        return 0;
+    case SWR_WORKERS_OP_RUNNING:
+        return serv->running;
+    case SWR_WORKERS_OP_SELECT_WORKER:
+        ctx->worker = reinterpret_cast<Worker *>(arg);
+        swoole_log_as("ThreadFactory::wait",
+                      swoole_trace_log(SW_TRACE_THREAD,
+                                       "worker(type=%d, tid=%d, id=%d) exit, status=%d",
+                                       ctx->worker->get_type(),
+                                       ctx->worker->get_pid(),
+                                       ctx->worker->get_id(),
+                                       swr_v1_worker_status(reinterpret_cast<const swr_v1_worker_record *>(ctx->worker))));
+        return 0;
+    case SWR_WORKERS_OP_WORKER_ID:
+        return worker->get_id();
+    case SWR_WORKERS_OP_THREAD_EXIT_STATUS:
+        return (int64_t) factory->thread_at(worker->get_id())->get_exit_status();
+    case SWR_WORKERS_OP_CALL_WORKER_ERROR: {
+        ExitStatus exit_status(worker->get_pid(), factory->thread_at(worker->get_id())->get_exit_status() << 8);
+        serv->call_worker_error_callback(worker, exit_status);
+        swoole_log_as("ThreadFactory::wait",
+                      swoole_trace_log(SW_TRACE_THREAD,
+                                       "worker(tid=%d, id=%d) abnormal exit, status=%d",
+                                       exit_status.get_pid(),
+                                       worker->get_id(),
+                                       exit_status.get_code()));
+        return 0;
+    }
+    case SWR_WORKERS_OP_WORKER_TYPE:
+        return worker->get_type();
+    case SWR_WORKERS_OP_SPAWN_THREAD:
+        factory->thread_at(arg & UINT32_MAX)->start([serv, factory, arg]() {
+            ThreadContext{serv, factory}.run(SWR_WORKERS_RUN_THREAD_BODY, arg);
+        });
+        return 0;
+    case SWR_WORKERS_OP_THREAD_ENTER:
+        swoole_thread_init(false);
+        swoole_set_thread_id(arg);
+        swoole_set_thread_type(Server::THREAD_WORKER);
+        swoole_trace_log(SW_TRACE_THREAD, "at_thread_enter=%d", (int) arg);
+        return swoole_thread_get_native_id();
+    case SWR_WORKERS_OP_THREAD_EXIT:
+        swoole_trace_log(SW_TRACE_THREAD, "at_thread_exit=%d", (int) arg);
+        swoole_thread_clean(false);
+        return 0;
+    case SWR_WORKERS_OP_CREATE_MESSAGE_BUS: {
+        auto mb = new MessageBus();
+        mb->set_id_generator(serv->msg_id_generator);
+        mb->set_buffer_size(serv->ipc_max_size);
+        mb->set_always_chunked_transfer();
+        if (!mb->alloc_buffer()) {
+            throw std::bad_alloc();
+        }
+        serv->init_pipe_sockets(mb);
+        SwooleTG.message_bus = mb;
+        return 0;
+    }
+    case SWR_WORKERS_OP_DESTROY_MESSAGE_BUS:
+        SwooleTG.message_bus->clear();
+        delete SwooleTG.message_bus;
+        SwooleTG.message_bus = nullptr;
+        return 0;
+    case SWR_WORKERS_OP_GET_WORKER:
+        ctx->worker = serv->get_worker(static_cast<WorkerId>(arg));
+        return (uintptr_t) ctx->worker;
+    case SWR_WORKERS_OP_WORKER_THREAD_START:
+        serv->worker_thread_start(factory->thread_at(arg & UINT32_MAX), [serv, factory, worker, arg]() {
+            ThreadContext{serv, factory, worker}.run(SWR_WORKERS_RUN_THREAD_MAIN, arg);
+        });
+        return 0;
+    case SWR_WORKERS_OP_REACTOR_THREAD_MAIN:
+        Server::reactor_thread_main_loop(serv, static_cast<int>(arg));
+        return 0;
+    case SWR_WORKERS_OP_ON_WORKER_START: {
+        auto pool = serv->get_task_worker_pool();
+        if (pool->onWorkerStart != nullptr) {
+            pool->onWorkerStart(pool, worker);
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_POOL_MAIN_LOOP: {
+        auto pool = serv->get_task_worker_pool();
+        pool->main_loop(pool, worker);
+        return 0;
+    }
+    case SWR_WORKERS_OP_ON_WORKER_STOP: {
+        auto pool = serv->get_task_worker_pool();
+        if (pool->onWorkerStop != nullptr) {
+            pool->onWorkerStop(pool, worker);
+        }
+        return 0;
+    }
+    case SWR_WORKERS_OP_ON_USER_WORKER_START:
+        serv->onUserWorkerStart(serv, worker);
+        return 0;
+    case SWR_WORKERS_OP_ON_MANAGER_START:
+        if (serv->onManagerStart) {
+            serv->onManagerStart(serv);
+        }
+        return 0;
+    case SWR_WORKERS_OP_ON_MANAGER_STOP:
+        if (serv->onManagerStop) {
+            serv->onManagerStop(serv);
+        }
+        return 0;
+    case SWR_WORKERS_OP_TIMER_CREATE:
+        swoole_timer_create(true);
+        return 0;
+    case SWR_WORKERS_LOG_MANAGER_ABNORMAL:
+        swoole_log_as("ThreadFactory::spawn_manager_thread",
+                      swoole_warning("Fatal Error: manager thread exits abnormally"));
+        return 0;
+    case SWR_WORKERS_OP_TIMER_FREE:
+        /*
+         * In the function that closes the timer, the scheduler is called again;
+         * therefore, it is essential to set the scheduler to null after the timer has been consumed.
+         */
+        if (swoole_timer_is_available()) {
+            swoole_timer_free();
+        }
+        return 0;
+    case SWR_WORKERS_OP_CREATE_WORKER_PIPES:
+        return serv->create_worker_pipes();
+    case SWR_WORKERS_OP_CREATE_EVENT_WORKERS:
+        return serv->create_event_workers();
+    case SWR_WORKERS_OP_TASK_START_CHECK:
+        return (int64_t) serv->get_task_worker_pool()->start_check();
+    case SWR_WORKERS_OP_CREATE_USER_WORKERS:
+        return serv->create_user_workers();
+    case SWR_WORKERS_OP_ABORT:
+        abort();
+    case SWR_WORKERS_OP_WORKER_NUM:
+        return serv->worker_num;
+    case SWR_WORKERS_OP_TASK_WORKER_NUM:
+        return serv->task_worker_num;
+    case SWR_WORKERS_OP_USER_WORKER_NUM:
+        return serv->user_worker_list.size();
+    case SWR_WORKERS_OP_ON_BEFORE_RELOAD:
+        if (serv->onBeforeReload) {
+            serv->onBeforeReload(serv);
+        }
+        return 0;
+    case SWR_WORKERS_OP_ON_AFTER_RELOAD:
+        if (serv->onAfterReload) {
+            serv->onAfterReload(serv);
+        }
+        return 0;
+    case SWR_WORKERS_LOG_CANNOT_RELOAD:
+        swoole_log_as("ThreadFactory::reload",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_OPERATION_NOT_SUPPORT,
+                                       "Cannot reload %s workers, task workers are not started",
+                                       arg ? "all" : "task"));
+        return 0;
+    case SWR_WORKERS_OP_SET_NOT_SUPPORTED:
+        swoole_set_last_error(SW_ERROR_OPERATION_NOT_SUPPORT);
+        return 0;
+    case SWR_WORKERS_OP_IS_MANAGER:
+        return serv->is_manager();
+    case SWR_WORKERS_LOG_NOTIFY_MANAGER:
+        swoole_log_as("ThreadFactory::reload",
+                      swoole_info("Send a notification to the manager process to prepare for restarting %s worker "
+                                  "processes.",
+                                  arg ? "all" : "task"));
+        return 0;
+    case SWR_WORKERS_LOG_RELOADING:
+        swoole_log_as("ThreadFactory::reload", swoole_info("Server is reloading %s workers now", arg ? "all" : "task"));
+        return 0;
+    case SWR_WORKERS_OP_EVENT_INIT:
+        return (int64_t) swoole_event_init(0);
+    case SWR_WORKERS_OP_PORT_COUNT:
+        return serv->ports.size();
+    case SWR_WORKERS_OP_PORT_DGRAM:
+        return serv->ports[arg]->is_dgram();
+    case SWR_WORKERS_OP_PORT_LISTEN:
+        return (int64_t) serv->ports[arg]->listen();
+    case SWR_WORKERS_OP_EVENT_FREE:
+        swoole_event_free();
+        return 0;
+    case SWR_WORKERS_OP_PORT_ADD:
+        sw_reactor()->add(serv->ports[arg]->socket, SW_EVENT_READ);
+        return 0;
+    case SWR_WORKERS_OP_SET_MASTER_THREAD_ID:
+        SwooleTG.id = sw_reactor()->id = factory->get_master_thread_id();
+        return 0;
+    case SWR_WORKERS_OP_STORE_LISTEN_SOCKET:
+        serv->store_listen_socket();
+        return 0;
+    case SWR_WORKERS_OP_START_MASTER_THREAD:
+        return (int64_t) serv->start_master_thread(sw_reactor());
+    default:
+        abort();
+    }
+}
+
+static const swr_v1_thread_ops thread_ops = {
+    []() -> void * {
+        try { return new std::shared_ptr<Thread>(std::make_shared<Thread>()); }
+        catch (...) { return nullptr; }
+    },
+    [](void *slot) { delete static_cast<std::shared_ptr<Thread> *>(slot); },
+    [](void *slot) -> int32_t {
+        try {
+            auto &thread = *static_cast<std::shared_ptr<Thread> *>(slot);
+            if (thread->joinable()) thread->join();
+            return 0;
+        } catch (const std::system_error &error) { return error.code().value(); }
+          catch (...) { return EFAULT; }
+    },
+};
+
+ThreadFactory::ThreadFactory(Server *server) : BaseFactory(server) {
+    manager_ = swr_v1_thread_manager_new();
+    if (!swr_v1_thread_manager_threads_init(manager_, server_->get_all_worker_num() + 1, &thread_ops)) {
+        swr_v1_thread_manager_free(manager_);
+        throw std::bad_alloc();
+    }
+}
+
+std::shared_ptr<Thread> &ThreadFactory::thread_at(size_t index) const {
+    return *static_cast<std::shared_ptr<Thread> *>(swr_v1_thread_manager_thread(manager_, index));
+}
+
+ThreadFactory::~ThreadFactory() {
+    ThreadFactory::shutdown();
+    swr_v1_thread_manager_free(manager_);
+}
+
+bool ThreadFactory::shutdown() {
+    int error = swr_v1_thread_manager_join_all(manager_);
+    if (error) throw std::system_error(error, std::generic_category());
+    return true;
+}
