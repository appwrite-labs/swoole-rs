+int64_t server_heartbeat_interval(void *server) {
+    return as_server(server)->heartbeat_check_interval;
+}
+void server_heartbeat(void *server, bool close_connection, void (*each)(void *, int64_t), void *context) {
+    Server *serv = as_server(server);
+    double now = microtime();
+    serv->foreach_connection([serv, now, close_connection, each, context](Connection *conn) {
+        SessionId session_id = conn->session_id;
+        if (session_id <= 0) {
+            return;
+        }
+        swoole_trace("heartbeat check fd=%d", conn->fd);
+        if (serv->is_healthy_connection(now, conn)) {
+            return;
+        }
+        if (close_connection) {
+            conn->close_force = 1;
+            serv->close(session_id, false);
+        }
+        each(context, session_id);
+    });
+}
+void server_socket(void *server, int64_t port, zval *return_value) {
+#ifdef SWOOLE_SOCKETS_SUPPORT
+    const ListenPort *lp = as_server(server)->get_port(port);
+    php_socket *socket_object = php_swoole_convert_to_socket(lp->get_fd());
+    if (!socket_object) {
+        RETURN_FALSE;
+    }
+    SW_ZVAL_SOCKET(return_value, socket_object);
+    zval *zsocket = sw_zval_dup(return_value);
+    Z_TRY_ADDREF_P(zsocket);
+#else
+    (void) server;
+    (void) port;
+    RETURN_FALSE;
 #endif
+}
+int server_min_fd(void *server) {
+    return as_server(server)->get_minfd();
+}
+int server_max_fd(void *server) {
+    return as_server(server)->get_maxfd();
+}
+int server_session_fd(void *server, int64_t session_id) {
+    Connection *conn = as_server(server)->get_connection_verify(session_id);
+    return conn ? conn->fd : -1;
+}
+bool server_connection_at(void *server, int fd, int64_t *session_id, int *server_fd) {
+    Connection *conn = as_server(server)->get_connection_for_iterator(fd);
+    if (!conn) {
+        return false;
+    }
+    *session_id = conn->session_id;
+    *server_fd = conn->server_fd;
+    return true;
+}
+int server_port_fd(void *port) {
+    return static_cast<ListenPort *>(port)->get_fd();
+}
+int64_t server_connection_num(void *server, void *port) {
+    if (port) {
+        return static_cast<ListenPort *>(port)->get_connection_num();
+    }
+    return as_server(server)->get_connection_num();
+}
+bool server_call(void *server, int which, zval *argument, zval *retval) {
+    bool bailout = false;
+    zend_try {
+        zval *zserv = php_swoole_server_zval_ptr(as_server(server));
+        if (which == 0) {
+            sw_zend_call_method_with_1_params(zserv, swoole_server_ce, nullptr, "exists", retval, argument);
+        } else {
+            sw_zend_call_method_with_1_params(zserv, swoole_server_ce, nullptr, "getClientInfo", retval, argument);
+        }
+    } zend_catch {
+        bailout = true;
+    } zend_end_try();
+    return bailout;
+}
