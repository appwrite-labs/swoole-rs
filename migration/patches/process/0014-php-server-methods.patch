+namespace {
+void server_invalid(zend_object *object) {
+    php_swoole_fatal_error(E_ERROR, "Invalid instance of %s", ZSTR_VAL(object->ce->name));
+}
+void server_set_last_error(int code) {
+    swoole_set_last_error(code);
+}
+bool server_display_errors() {
+    return SWOOLE_G(display_errors);
+}
+Server *as_server(void *server) {
+    return static_cast<Server *>(server);
+}
+bool server_started(void *server) {
+    return as_server(server)->is_started();
+}
+bool server_role(void *server, int which) {
+    Server *serv = as_server(server);
+    return which == 0 ? serv->is_worker() || serv->is_task_worker() : serv->is_process_mode() || serv->is_task_worker();
+}
+int64_t server_worker_id() {
+    return swoole_get_worker_id();
+}
+int64_t server_pid(void *server, int which) {
+    return which == 0 ? as_server(server)->get_master_pid() : as_server(server)->get_manager_pid();
+}
+bool server_worker(void *server, int64_t worker_id, int64_t *pid, int64_t *status) {
+    Worker *worker = as_server(server)->get_worker(worker_id);
+    if (!worker) {
+        return false;
+    }
+    *pid = worker->get_pid();
+    *status = swr_v1_worker_status(reinterpret_cast<const swr_v1_worker_record *>(worker));
+    return true;
+}
+bool server_close(void *server, int64_t session_id, bool reset) {
+    return as_server(server)->close(session_id, reset);
+}
+int server_feedback(void *server, int64_t session_id, bool pause) {
+    Server *serv = as_server(server);
+    Connection *conn = serv->get_connection_verify(session_id);
+    if (!conn) {
+        return -1;
+    }
+    return serv->feedback(conn, pause ? SW_SERVER_EVENT_PAUSE_RECV : SW_SERVER_EVENT_RESUME_RECV);
+}
+int server_exists(void *server, int64_t session_id) {
+    Connection *conn = as_server(server)->get_connection_verify(session_id);
+    if (!conn) {
+        return -1;
+    }
+    return !(conn->closed || conn->closing);
+}
+bool server_protect(void *server, int64_t session_id, bool value) {
+    Connection *conn = as_server(server)->get_connection_verify(session_id);
+    if (!conn || conn->closed) {
+        return false;
+    }
+    conn->protect = value;
+    return true;
+}
+int server_bind(void *server, int64_t session_id, uint32_t uid) {
+    Connection *conn = as_server(server)->get_connection_verify(session_id);
+    if (conn == nullptr) {
+        return -1;
+    }
+    int bound;
+    sw_spinlock(&conn->lock);
+    if (conn->uid != 0) {
+        bound = 0;
+    } else {
+        conn->uid = uid;
+        bound = 1;
+    }
+    sw_spinlock_release(&conn->lock);
+    return bound;
+}
+bool server_client(void *server, int64_t session_id, swr_phpserver_client *client) {
+    Server *serv = as_server(server);
+    Connection *conn = serv->get_connection_verify(session_id);
+    if (!conn) {
+        return false;
+    }
+    client->uid = conn->uid;
+    client->uid_mode = serv->dispatch_mode == Server::DISPATCH_UIDMOD;
+    client->worker_id = conn->worker_id;
+    client->co_conn_lb = serv->dispatch_mode == Server::DISPATCH_CO_CONN_LB;
+    ListenPort *port = serv->get_port_by_fd(conn->fd);
+    client->websocket = port && port->open_websocket_protocol;
+    client->websocket_status = conn->websocket_status;
+    if (conn->ssl_client_cert && conn->ssl_client_cert_pid == swoole_get_worker_pid()) {
+        client->ssl_client_cert = conn->ssl_client_cert->str;
+        client->ssl_client_cert_length = conn->ssl_client_cert->length;
+    }
+    Connection *server_socket = serv->get_connection(conn->server_fd);
+    client->server_port = server_socket ? server_socket->info.get_port() : -1;
+    client->server_fd = conn->server_fd;
+    client->socket_fd = conn->fd;
+    client->socket_type = conn->socket_type;
+    client->remote_port = conn->info.get_port();
+    client->remote_ip = conn->info.get_addr();
+    client->reactor_id = conn->reactor_id;
+    client->connect_time = conn->connect_time;
+    client->last_time = (int) conn->last_recv_time;
+    client->last_recv_time = conn->last_recv_time;
+    client->last_send_time = conn->last_send_time;
+    client->last_dispatch_time = conn->last_dispatch_time;
+    client->close_errno = conn->close_errno;
+    client->recv_queued_bytes = conn->recv_queued_bytes;
+    client->send_queued_bytes = conn->send_queued_bytes;
+    return true;
+}
+bool server_sendwait(void *server, int64_t session_id, const char *data, size_t length) {
+    return as_server(server)->sendwait(session_id, data, length);
+}
+bool server_reload(void *server, bool all) {
+    return as_server(server)->reload(all);
+}
+bool server_shutdown(void *server) {
+    return as_server(server)->shutdown();
+}
+bool server_kill_worker(void *server, int64_t worker_id) {
+    return as_server(server)->kill_worker(worker_id);
+}
+void server_stats(void *server, int64_t *values) {
+    Server *serv = as_server(server);
+    int64_t base[] = {
+        serv->gs->start_time, (int64_t) serv->get_connection_num(), serv->gs->abort_count, serv->gs->accept_count,
+        serv->gs->close_count, serv->worker_num, serv->task_worker_num, serv->get_user_worker_num(),
+        serv->get_idle_worker_num(), serv->gs->dispatch_count, serv->gs->request_count, serv->gs->response_count,
+        serv->gs->total_recv_bytes, serv->gs->total_send_bytes, serv->gs->pipe_packet_msg_id,
+        serv->get_concurrency(), serv->gs->session_round, serv->gs->min_fd, serv->gs->max_fd,
+    };
+    static_assert(sizeof(base) / sizeof(base[0]) == SWR_PHPSERVER_STATS_WORKER, "stats layout");
+    memcpy(values, base, sizeof(base));
+    if (sw_worker()) {
+        values[SWR_PHPSERVER_STATS_WORKER] = 1;
+        values[SWR_PHPSERVER_STATS_WORKER + 1] = sw_worker()->request_count;
+        values[SWR_PHPSERVER_STATS_WORKER + 2] = sw_worker()->response_count;
+        values[SWR_PHPSERVER_STATS_WORKER + 3] = sw_worker()->dispatch_count;
+        values[SWR_PHPSERVER_STATS_WORKER + 4] = sw_worker()->concurrency;
+    }
+    if (serv->task_ipc_mode > Server::TASK_IPC_UNIXSOCK && serv->get_task_worker_pool()->queue) {
+        size_t queue_num = -1;
+        size_t queue_bytes = -1;
+        if (serv->get_task_worker_pool()->queue->stat(&queue_num, &queue_bytes)) {
