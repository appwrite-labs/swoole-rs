+void php_swoole_server_check_kernel_nobufs(Server *serv, SessionId session_id);
+namespace {
+bool io_closed(void *server) {
+    Server *serv = as_server(server);
+    return !serv->is_worker_thread() && serv->is_started();
+}
+bool io_set_callback(zend_object *object, int type, zval *callable) {
+    ServerObject *server_object = server_fetch_object(object);
+    if (server_object->property->callbacks[type]) {
+        sw_callable_free(server_object->property->callbacks[type]);
+    }
+    auto fci_cache = sw_callable_create(callable);
+    if (!fci_cache) {
+        return false;
+    }
+    server_object->property->callbacks[type] = fci_cache;
+    return true;
+}
+bool io_port_call(zend_object *object, int which, zval *name, zval *callable, zval *retval) {
+    bool bailout = false;
+    zend_try {
+        zval *port_object = server_fetch_object(object)->property->ports.at(0);
+        if (which == 0) {
+            sw_zend_call_method_with_2_params(port_object, swoole_server_port_ce, nullptr, "on", retval, name, callable);
+        } else {
+            sw_zend_call_method_with_1_params(port_object, swoole_server_port_ce, nullptr, "getcallback", retval, name);
+        }
+    } zend_catch {
+        bailout = true;
+    } zend_end_try();
+    return bailout;
+}
+bool io_listen(zend_object *object, const char *host, int64_t port, int64_t sock_type, zval *return_value) {
+    ServerObject *server_object = server_fetch_object(object);
+    Server *serv = server_object->serv;
+    ListenPort *ls;
+    if (serv->is_worker_thread()) {
+        ls = serv->get_port((enum swSocketType) sock_type, host, (int) port);
+    } else {
+        ls = serv->add_port((enum swSocketType) sock_type, host, (int) port);
+    }
+    if (!ls) {
+        return false;
+    }
+    zval *port_object = php_swoole_server_add_port(server_object, ls);
+    RETVAL_ZVAL(port_object, 1, 0);
+    return true;
+}
+int io_send_unix(void *server, const char *path, const char *data, size_t length, int64_t server_socket) {
+    Server *serv = as_server(server);
+    if (!serv->have_dgram_sock) {
+        return -1;
+    }
+    network::Socket *sock = server_socket == -1 ? serv->dgram_socket : serv->get_server_socket(server_socket);
+    if (sock == nullptr) {
+        return 0;
+    }
+    return sock->sendto(path, 0, data, length) > 0;
+}
+bool io_send(void *server, int64_t fd, zend_string *sdata) {
+    Server *serv = as_server(server);
+    bool rv = serv->send(fd, ZSTR_VAL(sdata), ZSTR_LEN(sdata));
+    if (!rv && swoole_get_last_error() == SW_ERROR_OUTPUT_SEND_YIELD) {
+        rv = php_swoole_server_send_yield(serv, fd, sdata);
+    } else {
+        php_swoole_server_check_kernel_nobufs(serv, fd);
+    }
+    return rv;
+}
+int io_sendto(void *server, int kind, const char *addr, int64_t port, const char *data, size_t len,
+              int64_t server_socket_fd) {
+    Server *serv = as_server(server);
+    network::Socket *socket = kind == 1 ? serv->udp_socket_ipv4 : kind == 2 ? serv->udp_socket_ipv6 : serv->dgram_socket;
+    if (!socket) {
+        return -1;
+    }
+    network::Socket *server_socket = server_socket_fd < 0 ? socket : serv->get_server_socket(server_socket_fd);
+    return server_socket->sendto(addr, port, data, len) >= 0;
+}
+bool io_is_master(void *server) {
+    return as_server(server)->is_master();
+}
+bool io_sendfile(void *server, int64_t fd, const char *filename, size_t len, int64_t offset, int64_t length) {
+    return as_server(server)->sendfile(fd, filename, len, offset, length);
+}
+bool io_has_pipe_message(void *server) {
+    return as_server(server)->onPipeMessage != nullptr;
+}
+bool io_is_worker(void *server) {
+    return as_server(server)->is_worker() || as_server(server)->is_task_worker();
+}
+int64_t io_core_worker_num(void *server) {
+    return (long) as_server(server)->get_core_worker_num();
+}
+int io_send_message(void *server, zval *zmessage, int64_t worker_id) {
+    EventData buf;
+    if (php_swoole_server_task_pack(zmessage, &buf) < 0) {
+        return -1;
+    }
+    return as_server(server)->send_pipe_message(worker_id, &buf);
+}
+bool io_task_enable_coroutine(void *server) {
+    return as_server(server)->task_enable_coroutine;
+}
+bool io_finish(void *server, zval *zdata, zend_object *task) {
+    EventData *info = nullptr;
+    if (task) {
+        info = (EventData *) &php_swoole_server_task_fetch_object(task)->info;
+    }
+    return php_swoole_server_task_finish(as_server(server), zdata, info);
+}
+void *io_task_server(zend_object *task) {
+    Server *serv = php_swoole_server_task_fetch_object(task)->serv;
+    if (!serv) {
+        php_swoole_fatal_error(E_ERROR, "Invalid instance of %s", ZSTR_VAL(task->ce->name));
+    }
+    return serv;
+}
