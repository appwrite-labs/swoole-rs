+using ThreadContext = WorkersNative<5>;
+
+uint64_t ThreadContext::call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<ThreadContext *>(context);
+    Server *serv = ctx->serv;
+    ThreadFactory *factory = ctx->factory;
+    Worker *worker = ctx->worker;
+    switch (op) {
+    case SWR_WORKERS_OP_THREAD_MANAGER:
+        return (uintptr_t) factory->manager_;
+    case SWR_WORKERS_OP_MANAGER_THREAD_ID:
+        return factory->get_manager_thread_id();
+    case SWR_WORKERS_OP_JOIN_THREAD:
+        factory->threads_[arg]->join();
+        swoole_log_as("ThreadFactory::wait", swoole_trace_log(SW_TRACE_THREAD, "thread=%d join", (int) arg));
+        return 0;
+    case SWR_WORKERS_TRACE_MANAGER_EXITED:
+        swoole_log_as("ThreadFactory::terminate_manager_thread",
+                      swoole_trace_log(SW_TRACE_THREAD, "manager thread is exited"));
+        return 0;
+    case SWR_WORKERS_OP_ALL_CORE_WORKER_NUM:
+        return serv->get_core_worker_num();
+    case SWR_WORKERS_OP_KILL_WORKER:
+        serv->kill_worker(static_cast<int>(arg));
+        return 0;
+    case SWR_WORKERS_OP_TERMINATE_MANAGER_THREAD:
+        factory->terminate_manager_thread();
+        return 0;
+    case SWR_WORKERS_OP_TIMER_NEXT_MSEC:
+        return (int64_t) swoole_timer_get_next_msec();
+    case SWR_WORKERS_TRACE_MANAGER_WAKE:
+        swoole_log_as("ThreadFactory::wait",
+                      swoole_trace_log(SW_TRACE_THREAD,
+                                       "manager thread is waiting for worker exit, queue size: %zu",
+                                       (size_t) arg));
+        return 0;
+    case SWR_WORKERS_OP_HAS_TIMER:
+        return sw_timer() != nullptr;
+    case SWR_WORKERS_OP_TIMER_SELECT:
+        sw_timer()->select();
+        return 0;
+    case SWR_WORKERS_OP_RUNNING:
+        return serv->running;
+    case SWR_WORKERS_OP_SELECT_WORKER:
+        ctx->worker = reinterpret_cast<Worker *>(arg);
+        swoole_log_as("ThreadFactory::wait",
+                      swoole_trace_log(SW_TRACE_THREAD,
+                                       "worker(type=%d, tid=%d, id=%d) exit, status=%d",
+                                       ctx->worker->get_type(),
+                                       ctx->worker->get_pid(),
+                                       ctx->worker->get_id(),
+                                       swr_v1_worker_status(reinterpret_cast<const swr_v1_worker_record *>(ctx->worker))));
+        return 0;
+    case SWR_WORKERS_OP_WORKER_ID:
+        return worker->get_id();
+    case SWR_WORKERS_OP_THREAD_EXIT_STATUS:
+        return (int64_t) factory->threads_[worker->get_id()]->get_exit_status();
+    case SWR_WORKERS_OP_CALL_WORKER_ERROR: {
+        ExitStatus exit_status(worker->get_pid(), factory->threads_[worker->get_id()]->get_exit_status() << 8);
+        serv->call_worker_error_callback(worker, exit_status);
+        swoole_log_as("ThreadFactory::wait",
+                      swoole_trace_log(SW_TRACE_THREAD,
+                                       "worker(tid=%d, id=%d) abnormal exit, status=%d",
+                                       exit_status.get_pid(),
+                                       worker->get_id(),
+                                       exit_status.get_code()));
+        return 0;
+    }
+    case SWR_WORKERS_OP_WORKER_TYPE:
+        return worker->get_type();
+    case SWR_WORKERS_OP_SPAWN_EVENT_THREAD:
+        factory->spawn_event_worker(static_cast<WorkerId>(arg));
+        return 0;
+    case SWR_WORKERS_OP_SPAWN_TASK_THREAD:
+        factory->spawn_task_worker(static_cast<WorkerId>(arg));
+        return 0;
+    case SWR_WORKERS_OP_SPAWN_USER_THREAD:
+        factory->spawn_user_worker(static_cast<WorkerId>(arg));
+        return 0;
+    case SWR_WORKERS_OP_SPAWN_MANAGER_THREAD:
+        factory->spawn_manager_thread(static_cast<WorkerId>(arg));
+        return 0;
+    case SWR_WORKERS_OP_ABORT:
+        abort();
+    case SWR_WORKERS_OP_WORKER_NUM:
+        return serv->worker_num;
+    case SWR_WORKERS_OP_TASK_WORKER_NUM:
+        return serv->task_worker_num;
+    case SWR_WORKERS_OP_USER_WORKER_NUM:
+        return serv->user_worker_list.size();
+    case SWR_WORKERS_OP_ON_BEFORE_RELOAD:
+        if (serv->onBeforeReload) {
+            serv->onBeforeReload(serv);
+        }
+        return 0;
+    case SWR_WORKERS_OP_ON_AFTER_RELOAD:
+        if (serv->onAfterReload) {
+            serv->onAfterReload(serv);
+        }
+        return 0;
+    case SWR_WORKERS_LOG_CANNOT_RELOAD:
+        swoole_log_as("ThreadFactory::reload",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_OPERATION_NOT_SUPPORT,
+                                       "Cannot reload %s workers, task workers are not started",
+                                       arg ? "all" : "task"));
+        return 0;
+    case SWR_WORKERS_OP_SET_NOT_SUPPORTED:
+        swoole_set_last_error(SW_ERROR_OPERATION_NOT_SUPPORT);
+        return 0;
+    case SWR_WORKERS_OP_IS_MANAGER:
+        return serv->is_manager();
+    case SWR_WORKERS_LOG_NOTIFY_MANAGER:
+        swoole_log_as("ThreadFactory::reload",
+                      swoole_info("Send a notification to the manager process to prepare for restarting %s worker "
+                                  "processes.",
+                                  arg ? "all" : "task"));
+        return 0;
+    case SWR_WORKERS_LOG_RELOADING:
+        swoole_log_as("ThreadFactory::reload", swoole_info("Server is reloading %s workers now", arg ? "all" : "task"));
+        return 0;
+    case SWR_WORKERS_OP_EVENT_INIT:
+        return (int64_t) swoole_event_init(0);
+    case SWR_WORKERS_OP_PORT_COUNT:
+        return serv->ports.size();
+    case SWR_WORKERS_OP_PORT_DGRAM:
+        return serv->ports[arg]->is_dgram();
+    case SWR_WORKERS_OP_PORT_LISTEN:
+        return (int64_t) serv->ports[arg]->listen();
+    case SWR_WORKERS_OP_EVENT_FREE:
+        swoole_event_free();
+        return 0;
+    case SWR_WORKERS_OP_PORT_ADD:
+        sw_reactor()->add(serv->ports[arg]->socket, SW_EVENT_READ);
+        return 0;
+    case SWR_WORKERS_OP_SET_MASTER_THREAD_ID:
+        SwooleTG.id = sw_reactor()->id = factory->get_master_thread_id();
+        return 0;
+    case SWR_WORKERS_OP_STORE_LISTEN_SOCKET:
+        serv->store_listen_socket();
+        return 0;
+    case SWR_WORKERS_OP_START_MASTER_THREAD:
+        return (int64_t) serv->start_master_thread(sw_reactor());
+    default:
+        abort();
+    }
 }
