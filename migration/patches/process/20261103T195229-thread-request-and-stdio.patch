-        s_in->flags |= PHP_STREAM_FLAG_NO_CLOSE;
-        s_out->flags |= PHP_STREAM_FLAG_NO_CLOSE;
-        s_err->flags |= PHP_STREAM_FLAG_NO_CLOSE;
