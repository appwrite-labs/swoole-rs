-    ZEND_CONSTANT_SET_FLAGS(&oc, CONST_CS, 0);
-    oc.name = zend_string_init_interned("STDOUT", sizeof("STDOUT") - 1, false);
-    zend_register_constant(&oc);
-
-    ZEND_CONSTANT_SET_FLAGS(&ec, CONST_CS, 0);
