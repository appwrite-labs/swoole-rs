+void dispatch_facts(void *server, swr_phpserver_facts *facts) {
+    Server *serv = as_server(server);
+    facts->master_pid = serv->gs->master_pid;
+    facts->manager_pid = serv->gs->manager_pid;
+    facts->event_object = serv->event_object;
+    facts->enable_coroutine = serv->enable_coroutine;
+    facts->coroutine = serv->is_enable_coroutine();
+    facts->enable_library = SWOOLE_G(enable_library);
+    facts->task_worker = serv->is_task_worker();
+}
+zval *dispatch_zserv(void *server) {
+    return php_swoole_server_zval_ptr(as_server(server));
+}
+void *dispatch_callback(void *server, int type) {
+    return server_fetch_object(Z_OBJ_P(php_swoole_server_zval_ptr(as_server(server))))->get_callback(type);
+}
+void *dispatch_port_callback(void *server, int server_fd, int type) {
+    return php_swoole_server_get_callback(as_server(server), server_fd, type);
+}
+int dispatch_call(void *callback, uint32_t argc, zval *args, bool coroutine) {
+    int result = 0;
+    zend_try {
+        result = zend::function::call(static_cast<zend::Callable *>(callback), argc, args, nullptr, coroutine);
+    } zend_catch {
+        result = 2;
+    } zend_end_try();
+    return result;
+}
+bool dispatch_helper(const char *name, uint32_t argc, zval *args) {
+    bool bailout = false;
+    zend_try {
+        zend::function::call(std::string(R"(\Swoole\Server\Helper::)") + name, argc, args);
+    } zend_catch {
+        bailout = true;
+    } zend_end_try();
+    return bailout;
+}
+void dispatch_recv_data(void *server, zval *data, void *request) {
+    php_swoole_get_recv_data(as_server(server), data, static_cast<RecvData *>(request));
+}
+void dispatch_close(void *server, int64_t session_id) {
+    as_server(server)->close(session_id, false);
+}
+void dispatch_worker_start(void *server) {
+    Server *serv = as_server(server);
+    if (serv->is_task_worker() && !serv->task_enable_coroutine && !serv->is_thread_mode()) {
+        PHPCoroutine::disable_hook();
+    }
+    serv->get_worker_message_bus()->set_allocator(sw_zend_string_allocator());
+}
+int64_t dispatch_pid() {
+    return getpid();
+}
 }  // namespace
