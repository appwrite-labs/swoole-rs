-int Server::close_connection(Reactor *reactor, Socket *socket) {
-    ReactorThreadContext ctx{static_cast<Server *>(reactor->ptr), reactor};
-    ctx.sock = socket;
-    // The connection list's lock is private.
-    return reactor_thread_run(SWR_SERVER_RUN_CLOSE_CONNECTION, 0, &ctx, [](void *c, uint32_t op, uint64_t arg) {
-        Server *serv = static_cast<ReactorThreadContext *>(c)->serv;
-        switch (op) {
-        case SWR_SERVER_OP_LOCK:
-            serv->lock();
-            return (uint64_t) 0;
-        case SWR_SERVER_OP_UNLOCK:
-            serv->unlock();
-            return (uint64_t) 0;
-        default:
-            return reactor_thread_call(c, op, arg);
-        }
-    });
-}
