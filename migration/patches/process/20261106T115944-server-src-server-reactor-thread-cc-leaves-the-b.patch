diff --git a/src/server/master.cc b/src/server/master.cc
index 72e9838..c47076a 100644
--- a/src/server/master.cc
+++ b/src/server/master.cc
@@ -2094,7 +2094,1076 @@ static uint64_t server_call(void *context, uint32_t op, uint64_t arg) {
 
-// reactor_thread.cc: a BaseFactory op over the task it dispatches.
-uint64_t base_factory_call(Server *serv, SendData *send, uint32_t op, uint64_t arg) {
-    ServerRustContext ctx{serv};
-    ctx.send = send;
-    return server_call(&ctx, op, arg);
+// Reactor threads (was src/server/reactor_thread.cc): the ops crates/server runs over.
+static int ReactorThread_onPipeWrite(Reactor *reactor, Event *ev);
+static int ReactorThread_onPipeRead(Reactor *reactor, Event *ev);
+static int ReactorThread_onRead(Reactor *reactor, Event *ev);
+static int ReactorThread_onWrite(Reactor *reactor, Event *ev);
+static int ReactorThread_onPacketReceived(Reactor *reactor, Event *event);
+static int ReactorThread_onClose(Reactor *reactor, Event *event);
+static void ReactorThread_resume_data_receiving(Timer *timer, TimerNode *tnode);
+
+static_assert(SW_CONTINUE == 1 && SW_WAIT == 2 && SW_ERROR == 4 && SW_READY == 5, "crates/server/src/reactor_thread.rs return codes");
+static_assert(SW_SERVER_EVENT_CLOSE_FORCE == SWR_SERVER_EVENT_CLOSE_FORCE &&
+                  SW_SERVER_EVENT_CLOSE_FORWARD == SWR_SERVER_EVENT_CLOSE_FORWARD &&
+                  SW_SERVER_EVENT_FINISH == SWR_SERVER_EVENT_FINISH &&
+                  SW_SERVER_EVENT_PIPE_MESSAGE == SWR_SERVER_EVENT_PIPE_MESSAGE &&
+                  SW_SERVER_EVENT_INCOMING == SWR_SERVER_EVENT_INCOMING &&
+                  SW_SERVER_EVENT_SHUTDOWN == SWR_SERVER_EVENT_SHUTDOWN &&
+                  SW_SERVER_EVENT_COMMAND_REQUEST == SWR_SERVER_EVENT_COMMAND_REQUEST &&
+                  SW_SERVER_EVENT_COMMAND_RESPONSE == SWR_SERVER_EVENT_COMMAND_RESPONSE &&
+                  SW_SERVER_EVENT_SHUTDOWN_SIGNAL == SWR_SERVER_EVENT_SHUTDOWN_SIGNAL,
+              "crates/server/src/ops.rs pipe events");
+
+// What a crates/server reactor-thread operation acts on.
+struct ReactorThreadContext {
+    Server *serv;
+    Reactor *reactor;
+    ReactorThread *thread;
+    Event *event;
+    ListenPort *port;
+    Socket *sock;
+    Connection *conn;
+    Timer *timer;
+    const RecvData *rdata;
+    PipeBuffer *resp;
+    DgramPacket *pkt;
+    SendData task;
+    // The worker-pipe message at the front of the output buffer.
+    const EventData *front = nullptr;
+    size_t front_length = 0;
+};
+
+static double f64_from(uint64_t bits) {
+    double value;
+    memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+#ifdef SW_HALFCLOSE_PREQUEUE
+#define SWR_CN_BUILT_PREQUEUE SWR_CN_PREQUEUE
+#else
+#define SWR_CN_BUILT_PREQUEUE 0
+#endif
+// M15's repairs to Socket::ssl_shutdown and handle_sendfile (crates/tls/src/upstream.rs).
+static const bool halfclose_socket_registered = (swr_v1_socket_set_halfclose_repairs(SWR_CN_BUILT_PREQUEUE != 0), true);
+
+static_assert(BufferChunk::TYPE_DATA == 0 && BufferChunk::TYPE_SENDFILE == 1 && BufferChunk::TYPE_CLOSE == 2,
+              "crates/server/src/conn_io.rs output kinds");
+
+// ReactorThread_onRead's facts; the context's port once the connection is found.
+static inline uint64_t read_facts(ReactorThreadContext *ctx) {
+    Connection *conn = ctx->conn;
+    if (!conn || conn->server_fd == 0) {
+        return 0;
+    }
+    Socket *sock = ctx->sock;
+    ctx->port = ctx->serv->get_port_by_fd(ctx->event->fd);
+    return SWR_CN_FOUND | SWR_CN_BUILT_PREQUEUE | (sock->close_notified ? SWR_CN_CLOSE_NOTIFIED : 0) |
+           (conn->close_queued ? SWR_CN_CLOSE_QUEUED : 0) |
+           (sock->ssl && sock->ssl_want_read ? SWR_CN_SSL_WANT_READ : 0) |
+           (sock->ssl && sock->ssl_state != SW_SSL_STATE_READY ? SWR_CN_SSL_PENDING : 0) |
+#ifdef SW_SUPPORT_DTLS
+           (ctx->port->is_dtls() ? SWR_CN_DTLS_PORT : 0) | (sock->dtls ? SWR_CN_DTLS_SOCKET : 0) |
+#endif
+           (ctx->serv->is_process_mode() ? SWR_CN_PROCESS : 0);
+}
+
+// ReactorThread_onWrite's facts; the context's port and connection.
+static uint64_t write_facts(ReactorThreadContext *ctx) {
+    Server *serv = ctx->serv;
+    int fd = ctx->event->fd;
+    ctx->port = serv->get_port_by_fd(fd);
+    if (serv->is_process_mode()) {
+        assert(fd % serv->reactor_num == ctx->reactor->id);
+        assert(fd % serv->reactor_num == SwooleTG.id);
+    }
+    Connection *conn = ctx->conn = serv->get_connection(fd);
+    if (conn == nullptr || conn->active == 0) {
+        return 0;
+    }
+    swoole_log_as("ReactorThread_onWrite",
+                  swoole_trace_log(SW_TRACE_REACTOR,
+                                   "fd=%d, conn->close_notify=%d, serv->disable_notify=%d, conn->close_force=%d",
+                                   fd,
+                                   conn->close_notify,
+                                   serv->disable_notify,
+                                   conn->close_force));
+    Socket *sock = ctx->sock;
+    return SWR_CN_FOUND | SWR_CN_BUILT_PREQUEUE | (conn->close_notify ? SWR_CN_CLOSE_NOTIFY : 0) |
+           (sock->ssl && sock->ssl_state != SW_SSL_STATE_READY ? SWR_CN_SSL_PENDING : 0) |
+           (serv->disable_notify ? SWR_CN_DISABLE_NOTIFY : 0) | (conn->close_force ? SWR_CN_CLOSE_FORCE : 0);
+}
+
+// What decides whether a clean FIN leaves the write side usable (native/halfclose/prequeue.md).
+static uint64_t prequeue_facts(Server *serv, Connection *conn) {
+    return SWR_CN_BUILT_PREQUEUE | (serv->is_process_mode() ? SWR_CN_PROCESS : 0) |
+           (serv->is_hash_dispatch_mode() ? SWR_CN_HASH_DISPATCH : 0) |
+           (serv->dispatch_func ? SWR_CN_DISPATCH_FUNC : 0) | (serv->enable_coroutine ? SWR_CN_COROUTINE : 0) |
+           (conn->ssl ? SWR_CN_CONN_SSL : 0) | (conn->close_errno ? SWR_CN_CLOSE_ERRNO : 0) |
+           (conn->close_force ? SWR_CN_CLOSE_FORCE : 0) | (conn->close_reset ? SWR_CN_CLOSE_RESET : 0);
+}
+
+// Server::close_connection's facts, with the socket's fd above bit 32; the context's
+// connection and port.
+static uint64_t close_facts(ReactorThreadContext *ctx) {
+    Socket *sock = ctx->sock;
+    Connection *conn = ctx->conn = static_cast<Connection *>(sock->object);
+    ctx->port = ctx->serv->get_port_by_fd(sock->fd);
+    return SWR_CN_BUILT_PREQUEUE | (conn->timer ? SWR_CN_TIMER : 0) |
+           (conn->websocket_buffer ? SWR_CN_WEBSOCKET_BUFFER : 0) | (sock->removed ? SWR_CN_REMOVED : 0) |
+           (ctx->serv->is_base_mode() ? SWR_CN_BASE : 0) | (sock->ssl ? SWR_CN_SOCKET_SSL : 0) |
+#ifdef SW_SUPPORT_DTLS
+           (sock->dtls ? SWR_CN_DTLS_SOCKET : 0) |
+#endif
+#ifdef SW_USE_SOCKET_LINGER
+           SWR_CN_LINGER |
+#endif
+           (sock->recv_buffer ? SWR_CN_RECV_BUFFER : 0) | (conn->close_force ? SWR_CN_CLOSE_FORCE : 0) |
+           (conn->close_reset ? SWR_CN_CLOSE_RESET : 0) | (conn->peer_closed ? SWR_CN_PEER_CLOSED : 0) |
+           (conn->close_queued ? SWR_CN_CLOSE_QUEUED : 0) | (sock->ssl_closed_ ? SWR_CN_SSL_CLOSED : 0) |
+           (sock->ssl && sock->ssl_state == SW_SSL_STATE_READY && sock->is_stream() ? SWR_CN_TLS_READY_STREAM : 0) |
+           ((uint64_t) (uint32_t) sock->fd << 32);
+}
+
+// ReactorThread_onWrite's state after flushing.
+static uint64_t write_state(ReactorThreadContext *ctx) {
+    Socket *sock = ctx->sock;
+    Connection *conn = ctx->conn;
+    uint32_t length = sock->get_out_buffer_length();
+    return (conn->overflow && length < sock->buffer_size ? SWR_CN_OVERFLOW_DRAINED : 0) |
+           (ctx->serv->onBufferEmpty && conn->high_watermark && length <= ctx->port->buffer_low_watermark
+                ? SWR_CN_LOW_WATERMARK
+                : 0) |
+           (sock->send_timer ? SWR_CN_SEND_TIMER : 0) | (Buffer::empty(sock->out_buffer) ? SWR_CN_OUT_EMPTY : 0) |
+           (conn->peer_closed ? SWR_CN_PEER_CLOSED : 0) | (sock->removed ? SWR_CN_REMOVED : 0);
+}
+
+static uint64_t reactor_thread_call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<ReactorThreadContext *>(context);
+    Server *serv = ctx->serv;
+    Reactor *reactor = ctx->reactor;
+    ReactorThread *thread = ctx->thread;
+    Socket *sock = ctx->sock;
+    Connection *conn = ctx->conn;
+    switch (op) {
+    case SWR_SERVER_OP_MODE:
+        return serv->is_base_mode() ? 1 : (serv->is_process_mode() ? 2 : 3);
+    case SWR_SERVER_OP_SINGLE_THREAD:
+        return serv->single_thread;
+    case SWR_SERVER_OP_ERRNO:
+        return errno;
+    case SWR_SERVER_OP_DELAY_RECEIVE:
+        return serv->enable_delay_receive;
+    case SWR_SERVER_OP_HAS_ON_CONNECT:
+        return serv->onConnect != nullptr;
+    case SWR_SERVER_OP_DISABLE_NOTIFY:
+        return serv->disable_notify;
+    case SWR_SERVER_OP_RUNNING:
+        return serv->running;
+    case SWR_SERVER_OP_MAXFD:
+        return (int64_t) serv->get_maxfd();
+    case SWR_SERVER_OP_MINFD:
+        return (int64_t) serv->get_minfd();
+    case SWR_SERVER_OP_FIELD:
+        return serv->heartbeat_check_interval;
+    case SWR_SERVER_OP_PORT_COUNT:
+        return serv->ports.size();
+    case SWR_SERVER_OP_PORT_DGRAM:
+        return serv->ports[arg]->is_dgram();
+    case SWR_SERVER_OP_PORT_REMOVED:
+        return serv->ports[arg]->socket->removed;
+    case SWR_SERVER_OP_EVENT_FREE:
+        swoole_event_free();
+        return 0;
+    case SWR_SERVER_OP_REACTOR_BARRIER:
+        serv->reactor_thread_barrier.wait();
+        return 0;
+    case SWR_SERVER_OP_EVENT_WAIT:
+        return (int64_t) swoole_event_wait();
+    case SWR_SERVER_OP_NOTIFY_CONNECT:
+        serv->notify(static_cast<Connection *>(sock->object), SW_SERVER_EVENT_CONNECT);
+        return 0;
+    case SWR_SERVER_OP_FORCE_CLOSE: {
+        conn->close_force = 1;
+        Event _ev = {};
+        _ev.fd = conn->fd;
+        _ev.socket = conn->socket;
+        reactor->trigger_close_event(&_ev);
+        return 0;
+    }
+
+    case SWR_SERVER_OP_SSL_ACCEPT:
+        return (int64_t) sock->ssl_accept();
+    case SWR_SERVER_OP_SSL_READY:
+        static_cast<Connection *>(sock->object)->ssl_ready = 1;
+        return 0;
+    case SWR_SERVER_OP_CLIENT_CERT:
+        return !ctx->port->get_ssl_client_cert_file().empty();
+    case SWR_SERVER_OP_VERIFY_PEER:
+        return ctx->port->get_ssl_verify_peer();
+    case SWR_SERVER_OP_PEER_CERT:
+        return sock->ssl_get_peer_certificate(sw_tg_buffer());
+    case SWR_SERVER_OP_SSL_VERIFY:
+        return sock->ssl_verify(ctx->port->get_ssl_allow_self_signed());
+    case SWR_SERVER_OP_DISPATCH_CERT: {
+        SendData task;
+        task.info.fd = sock->fd;
+        task.info.type = SW_SERVER_EVENT_CONNECT;
+        task.info.reactor_id = reactor->id;
+        task.info.len = sw_tg_buffer()->length;
+        task.data = sw_tg_buffer()->str;
+        serv->factory_->dispatch(&task);
+        return 0;
+    }
+    case SWR_SERVER_OP_REACTOR_DEL:
+        return (int64_t) reactor->del(sock);
+
+    case SWR_SERVER_OP_PACKET_INIT: {
+        int fd = ctx->event->fd;
+        ctx->conn = serv->get_connection(fd);
+        ctx->sock = ctx->conn->socket;
+        ctx->task = {};
+        ctx->pkt = reinterpret_cast<DgramPacket *>(sw_tg_buffer()->str);
+        ctx->task.info.server_fd = fd;
+        ctx->task.info.reactor_id = SwooleTG.id;
+        ctx->task.info.type = SW_SERVER_EVENT_RECV_DGRAM;
+        ctx->task.info.time = microtime();
+        ctx->pkt->socket_addr.type = ctx->pkt->socket_type = ctx->conn->socket_type;
+        return 0;
+    }
+    case SWR_SERVER_OP_RECVFROM:
+        return (int64_t) sock->recvfrom(
+            ctx->pkt->data, sw_tg_buffer()->size - sizeof(*ctx->pkt), 0, &ctx->pkt->socket_addr);
+    case SWR_SERVER_OP_PORT_DTLS:
+#ifdef SW_SUPPORT_DTLS
+        return static_cast<ListenPort *>(conn->object)->is_dtls();
+#else
+        return 0;
+#endif
+    case SWR_SERVER_OP_DTLS_ACCEPT: {
+#ifdef SW_SUPPORT_DTLS
+        auto port = static_cast<ListenPort *>(conn->object);
+        auto pkt = ctx->pkt;
+        dtls::Session *session = serv->accept_dtls_connection(port, &pkt->socket_addr);
+        if (!session) {
+            return (int64_t) SW_ERR;
+        }
+        session->append(pkt->data, (ssize_t) arg);
+        if (!session->listen()) {
+            return (int64_t) Server::close_connection(reactor, session->socket);
+        }
+        auto dtls_conn = static_cast<Connection *>(session->socket->object);
+        if (serv->single_thread) {
+            if (serv->connection_incoming(reactor, dtls_conn) < 0) {
+                reactor->close(reactor, session->socket);
+            }
+        } else {
+            DataHead ev{};
+            ev.type = SW_SERVER_EVENT_INCOMING;
+            ev.fd = dtls_conn->session_id;
+            ev.reactor_id = dtls_conn->reactor_id;
+            if (serv->send_to_reactor_thread(reinterpret_cast<EventData *>(&ev), sizeof(ev), dtls_conn->session_id) < 0) {
+                reactor->close(reactor, session->socket);
+            }
+        }
+#endif
+        return SW_OK;
+    }
+    case SWR_SERVER_OP_PACKET_DISPATCH: {
+        auto pkt = ctx->pkt;
+        if (pkt->socket_type == SW_SOCK_UDP) {
+            ctx->task.info.fd = *reinterpret_cast<int *>(&pkt->socket_addr.addr.inet_v4.sin_addr);
+        } else {
+            ctx->task.info.fd = swoole_crc32(pkt->socket_addr.get_addr(), pkt->socket_addr.len);
+        }
+        pkt->length = arg;
+        ctx->task.info.len = sizeof(*pkt) + arg;
+        ctx->task.data = reinterpret_cast<char *>(pkt);
+        return serv->factory_->dispatch(&ctx->task);
+    }
+    case SWR_SERVER_LOG_RECVFROM:
+        swoole_log_as("ReactorThread_onPacketReceived", swoole_sys_warning("recvfrom(%d) failed", ctx->event->fd));
+        return 0;
+
+    case SWR_SERVER_OP_HAVE_DGRAM:
+        return serv->have_dgram_sock == 1;
+    case SWR_SERVER_OP_PORT_FD:
+        return (int64_t) serv->ports[arg]->socket->fd;
+    case SWR_SERVER_OP_REACTOR_ID:
+        return reactor->id;
+    case SWR_SERVER_OP_REACTOR_NUM:
+        return serv->reactor_num;
+    case SWR_SERVER_OP_PORT_DEL:
+        reactor->del(serv->ports[arg]->socket);
+        return 0;
+    case SWR_SERVER_OP_HEARTBEAT_TIMER_CLEAR:
+        if (thread->heartbeat_timer) {
+            swoole_timer_del(thread->heartbeat_timer);
+            thread->heartbeat_timer = nullptr;
+        }
+        return 0;
+    case SWR_SERVER_OP_DESTROY_CALLBACK:
+        reactor->add_destroy_callback([serv, reactor](void *) {
+            serv->foreach_connection([reactor](Connection *conn) {
+                if (conn->reactor_id == reactor->id) {
+                    Server::close_connection(reactor, conn->socket);
+                }
+            });
+        });
+        return 0;
+    case SWR_SERVER_OP_STOP_THREAD_WORKER:
+        serv->stop_async_worker(serv->get_worker(reactor->id));
+        return 0;
+    case SWR_SERVER_OP_WORKER_NUM:
+        return serv->worker_num;
+    case SWR_SERVER_OP_WORKER_PIPE_UNREAD:
+        reactor->remove_read_event(thread->message_bus.get_pipe_socket(serv->get_worker_pipe_master(arg)));
+        return 0;
+    case SWR_SERVER_OP_CONN_AT: {
+        Connection *at = serv->get_connection((int) arg);
+        if (!Server::is_valid_connection(at)) {
+            return 0;
+        }
+        ctx->conn = at;
+        return 1;
+    }
+    case SWR_SERVER_OP_CONN_FD:
+        return (int64_t) conn->fd;
+    case SWR_SERVER_OP_CONN_REACTOR:
+        return (int64_t) conn->reactor_id;
+    case SWR_SERVER_OP_CONN_SESSION:
+        return (int64_t) conn->session_id;
+    case SWR_SERVER_OP_CONN_READING:
+        return !conn->peer_closed && !conn->socket->removed;
+    case SWR_SERVER_OP_CONN_UNREAD:
+        reactor->remove_read_event(conn->socket);
+        return 0;
+    case SWR_SERVER_OP_WAIT_EXIT:
+        reactor->set_wait_exit(true);
+        return 0;
+
+    case SWR_SERVER_OP_SESSION_CONN:
+        ctx->conn = serv->get_connection_verify_no_ssl((SessionId) arg);
+        return ctx->conn != nullptr;
+    case SWR_SERVER_LOG_NO_SESSION:
+        swoole_log_as("ReactorThread::close_connection",
+                      swoole_error_log(SW_LOG_TRACE,
+                                       SW_ERROR_SESSION_NOT_EXIST,
+                                       "force close connection failed, session#%ld does not exist",
+                                       (SessionId) arg));
+        return 0;
+    case SWR_SERVER_OP_CONN_FORCE:
+        return conn->close_force;
+    case SWR_SERVER_OP_CONN_HANDSHAKING:
+        return conn->ssl && !conn->ssl_ready;
+    case SWR_SERVER_OP_CLOSE:
+        return (int64_t) Server::close_connection(reactor, conn->socket);
+
+    case SWR_SERVER_OP_PIPE_READ:
+        ctx->resp = thread->message_bus.get_buffer();
+        return (int64_t) thread->message_bus.read_with_buffer(ctx->event->socket);
+    case SWR_SERVER_OP_PIPE_TYPE:
+        return ctx->resp->info.type;
+    case SWR_SERVER_OP_PIPE_FD:
+        return (int64_t) ctx->resp->info.fd;
+    case SWR_SERVER_OP_PIPE_POP:
+        thread->message_bus.pop();
+        return 0;
+    case SWR_SERVER_OP_INCOMING:
+        return (int64_t) serv->connection_incoming(reactor, conn);
+    case SWR_SERVER_OP_REACTOR_CLOSE:
+        reactor->close(reactor, conn->socket);
+        return 0;
+    case SWR_SERVER_OP_COMMAND_REQUEST:
+        serv->call_command_handler(thread->message_bus, thread->id, thread->pipe_command);
+        return 0;
+    case SWR_SERVER_OP_COMMAND_RESPONSE: {
+        auto packet = thread->message_bus.get_packet();
+        serv->call_command_callback(ctx->resp->info.fd, std::string(packet.data, packet.length));
+        return 0;
+    }
+    case SWR_SERVER_OP_KILL_SELF:
+        swoole_kill(getpid(), SIGTERM);
+        return 0;
+    case SWR_SERVER_OP_ON_FINISH:
+        serv->onFinish(serv, reinterpret_cast<EventData *>(ctx->resp));
+        return 0;
+    case SWR_SERVER_OP_ON_PIPE_MESSAGE:
+        serv->onPipeMessage(serv, reinterpret_cast<EventData *>(ctx->resp));
+        return 0;
+    case SWR_SERVER_OP_CLOSE_FORWARD:
+        serv->factory_->end((SessionId) arg, Server::CLOSE_ACTIVELY);
+        return 0;
+    case SWR_SERVER_OP_PIPE_SEND: {
+        SendData _send;
+        PacketPtr packet = thread->message_bus.get_packet();
+        _send.info = ctx->resp->info;
+        _send.info.len = packet.length;
+        _send.data = packet.data;
+        serv->send_to_connection(&_send);
+        return 0;
+    }
+
+    case SWR_SERVER_OP_DGRAM_BUFFER:
+        // support 64K packet
+        sw_tg_buffer()->extend();
+        return 0;
+    case SWR_SERVER_OP_SESSION_HANDLERS:
+        reactor->set_handler(SW_FD_DGRAM_SERVER, SW_EVENT_READ, ReactorThread_onPacketReceived);
+        reactor->set_handler(SW_FD_SESSION, SW_EVENT_WRITE, ReactorThread_onWrite);
+        reactor->set_handler(SW_FD_SESSION, SW_EVENT_READ, ReactorThread_onRead);
+        for (auto port : serv->ports) {
+            port->init_protocol();
+        }
+        return 0;
+    case SWR_SERVER_OP_MICROTIME:
+        return f64_bits(microtime());
+    case SWR_SERVER_OP_CONN_HEALTHY:
+        return serv->is_healthy_connection(f64_from(arg), conn);
+    case SWR_SERVER_OP_SEND_CLOSE_FORCE: {
+        DataHead ev{};
+        ev.type = SW_SERVER_EVENT_CLOSE_FORCE;
+        // the session id, so the reactor verifies the connection before closing it
+        ev.fd = (SessionId) arg;
+        serv->get_reactor_pipe_socket((SessionId) arg, conn->reactor_id)->send_sync(&ev, sizeof(ev));
+        return 0;
+    }
+
+    case SWR_SERVER_OP_EVENT_INIT: {
+        int ret = swoole_event_init(0);
+        ctx->reactor = sw_reactor();
+        return (int64_t) ret;
+    }
+    case SWR_SERVER_OP_PORT_LISTEN:
+        return (int64_t) serv->ports[arg]->listen();
+    case SWR_SERVER_OP_PORT_READ:
+        reactor->add(serv->ports[arg]->socket, SW_EVENT_READ);
+        return 0;
+    case SWR_SERVER_OP_THREAD0_INIT:
+        serv->get_thread(0)->init(serv, reactor, 0);
+        return 0;
+    case SWR_SERVER_OP_MASTER_REACTOR_ID:
+        // a special id for the master thread
+        reactor->id = serv->reactor_num;
+        SwooleTG.id = serv->reactor_num;
+        return 0;
+    case SWR_SERVER_OP_SPAWN_REACTOR_THREAD: {
+        int i = (int) arg;
+        serv->get_thread(i)->thread = std::thread([serv, i]() {
+            swoole_thread_init(false);
+            Server::reactor_thread_main_loop(serv, i);
+            swoole_thread_clean(false);
+        });
+        return 0;
+    }
+    case SWR_SERVER_OP_HEARTBEAT_TIMER:
+        serv->heartbeat_timer =
+            swoole_timer_add(sec2msec(serv->heartbeat_check_interval), true, Server::heartbeat_check, reactor);
+        return 0;
+
+    case SWR_SERVER_OP_THREAD_ENTER:
+        ctx->thread = serv->get_thread((int) arg);
+        ctx->thread->id = (int) arg;
+        SwooleTG.message_bus = &ctx->thread->message_bus;
+        return 0;
+    case SWR_SERVER_OP_WORKER_START:
+        serv->call_worker_start_callback(serv->get_worker(thread->id));
+        return 0;
+    case SWR_SERVER_OP_WORKER_STOP:
+        serv->call_worker_stop_callback(serv->get_worker(thread->id));
+        return 0;
+    case SWR_SERVER_OP_REACTOR_THREAD_TYPE:
+        swoole_set_thread_id((uint16_t) arg);
+        swoole_set_thread_type(Server::THREAD_REACTOR);
+        return 0;
+    case SWR_SERVER_OP_THREAD_INIT:
+        return (int64_t) thread->init(serv, reactor, thread->id);
+    case SWR_SERVER_OP_THREAD_CLEAN:
+        thread->clean();
+        return 0;
+
+    case SWR_SERVER_OP_QUEUE_FULL:
+        return conn->recv_queued_bytes > sw_server()->max_queued_bytes;
+    case SWR_SERVER_OP_WAITING_TIME:
+        return conn->waiting_time;
+    case SWR_SERVER_OP_SET_WAITING_TIME:
+        conn->waiting_time = arg;
+        return 0;
+    case SWR_SERVER_OP_RESUME_TIMER:
+        conn->timer = swoole_timer_add((long) conn->waiting_time, false, ReactorThread_resume_data_receiving, sock);
+        return conn->timer != nullptr;
+    case SWR_SERVER_OP_RESUME_READ:
+        ctx->timer->get_reactor()->add_read_event(sock);
+        conn->timer = nullptr;
+        return 0;
+
+    case SWR_SERVER_OP_QUEUE_SUB:
+        sw_atomic_fetch_sub(&conn->recv_queued_bytes, (uint32_t) arg);
+        return 0;
+
+    case SWR_SERVER_OP_THREAD_JOINABLE:
+        return serv->get_thread((int) arg)->thread.joinable();
+    case SWR_SERVER_OP_THREAD_NOTIFY: {
+        ReactorThread *joining = serv->get_thread((int) arg);
+        if (joining->notify_pipe) {
+            DataHead ev = {};
+            ev.type = SW_SERVER_EVENT_SHUTDOWN;
+            joining->notify_pipe->send_sync((void *) &ev, sizeof(ev));
+        }
+        return 0;
+    }
+    case SWR_SERVER_OP_THREAD_JOIN:
+        serv->get_thread((int) arg)->thread.join();
+        return 0;
+    case SWR_SERVER_OP_RT_BUF_EMPTY:
+        return Buffer::empty(ctx->event->socket->out_buffer);
+    case SWR_SERVER_OP_RT_FRONT: {
+        Buffer *buffer = ctx->event->socket->out_buffer;
+        const auto view = buffer->typed_front();
+        ctx->front = reinterpret_cast<const EventData *>(view.data);
+        ctx->front_length = view.length;
+        return 0;
+    }
+    case SWR_SERVER_OP_RT_FRONT_STREAM:
+        return Server::is_stream_event(ctx->front->info.type);
+    case SWR_SERVER_OP_RT_FRONT_CONN:
+        // the front's info.fd is the session id
+        ctx->conn = serv->get_connection_verify(ctx->front->info.fd);
+        return ctx->conn != nullptr;
+    case SWR_SERVER_OP_RT_TOUCH_SEND:
+        conn->last_send_time = microtime();
+        return 0;
+    case SWR_SERVER_OP_RT_FRONT_CONN_CLOSED:
+        return conn->closed;
+    case SWR_SERVER_LOG_RT_CLOSED_BY_SERVER:
+        swoole_log_as("ReactorThread_onPipeWrite",
+                      swoole_error_log(SW_LOG_NOTICE,
+                                       SW_ERROR_SESSION_CLOSED_BY_SERVER,
+                                       "Session#%ld is closed by server",
+                                       ctx->front->info.fd));
+        return 0;
+    case SWR_SERVER_OP_RT_DISCARD_TIMEOUT:
+        return serv->discard_timeout_request;
+    case SWR_SERVER_LOG_RT_DISCARD:
+        swoole_log_as("ReactorThread_onPipeWrite",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_SESSION_DISCARD_TIMEOUT_DATA,
+                                       "[1] ignore data[%u bytes] received from session#%ld",
+                                       ctx->front->info.len,
+                                       ctx->front->info.fd));
+        return 0;
+    case SWR_SERVER_OP_RT_POP:
+        ctx->event->socket->out_buffer->pop();
+        return 0;
+    case SWR_SERVER_OP_RT_SEND_FRONT:
+        return (int64_t) ctx->event->socket->send(ctx->front, ctx->front_length, 0);
+    case SWR_SERVER_OP_RT_CATCH_WAIT:
+        return ctx->event->socket->catch_write_error(errno) == SW_WAIT;
+    case SWR_SERVER_OP_RT_REMOVE_WRITE:
+        return (int64_t) reactor->remove_write_event(ctx->event->socket);
+    case SWR_SERVER_LOG_RT_SET_WRITE:
+        swoole_log_as("ReactorThread_onPipeWrite", swoole_sys_warning("reactor->set(%d) failed", ctx->event->fd));
+        return 0;
+
+    case SWR_SERVER_OP_RT_SETUP:
+        reactor->ptr = serv;
+        reactor->id = (uint16_t) arg;
+        reactor->wait_exit = false;
+        reactor->max_socket = serv->get_max_connection();
+        reactor->close = Server::close_connection;
+        reactor->set_default_error_handler(ReactorThread_onClose);
+        reactor->set_handler(SW_FD_PIPE, SW_EVENT_READ, ReactorThread_onPipeRead);
+        reactor->set_handler(SW_FD_PIPE, SW_EVENT_WRITE, ReactorThread_onPipeWrite);
+        return 0;
+    case SWR_SERVER_OP_RT_DGRAM_BIND: {
+        // listen UDP port
+        auto ls = serv->ports[arg];
+        int server_fd = ls->socket->fd;
+        Connection *serv_sock = serv->get_connection(server_fd);
+        serv_sock->fd = server_fd;
+        serv_sock->socket_type = ls->type;
+        serv_sock->object = ls;
+        ls->thread_id = pthread_self();
+        return (int64_t) reactor->add(ls->socket, SW_EVENT_READ);
+    }
+    case SWR_SERVER_OP_RT_INIT_REACTOR:
+        serv->init_reactor(reactor);
+        return 0;
+    case SWR_SERVER_OP_RT_INIT_PIPE_SOCKETS:
+        serv->init_pipe_sockets(&thread->message_bus);
+        return 0;
+    case SWR_SERVER_OP_RT_THREAD_WORKER: {
+        Worker *worker = serv->get_worker(reactor->id);
+        serv->init_event_worker(worker);
+        reactor->add(thread->message_bus.get_pipe_socket(worker->pipe_worker), SW_EVENT_READ);
+        return 0;
+    }
+    case SWR_SERVER_OP_RT_HEARTBEAT_TIMER:
+        thread->heartbeat_timer =
+            swoole_timer_add(sec2msec(serv->heartbeat_check_interval), true, Server::heartbeat_check, reactor);
+        return 0;
+    case SWR_SERVER_OP_RT_HAS_PIPE_COMMAND:
+        return serv->pipe_command != nullptr;
+    case SWR_SERVER_OP_RT_PIPE_COMMAND: {
+        auto pipe_socket = serv->pipe_command->get_socket(false);
+        thread->message_bus.init_pipe_socket(pipe_socket);
+        thread->pipe_command = thread->message_bus.get_pipe_socket(pipe_socket);
+        thread->pipe_command->buffer_size = UINT_MAX;
+        return 0;
+    }
+    case SWR_SERVER_OP_RT_BUS_SETUP:
+        thread->message_bus.set_id_generator(serv->msg_id_generator);
+        thread->message_bus.set_buffer_size(serv->ipc_max_size);
+        thread->message_bus.set_always_chunked_transfer();
+        return thread->message_bus.alloc_buffer();
+    case SWR_SERVER_OP_RT_ADD_WORKER_PIPE: {
+        Socket *socket = thread->message_bus.get_pipe_socket(serv->get_worker_pipe_master(arg));
+        if (reactor->add(socket, SW_EVENT_READ) < 0) {
+            return (int64_t) SW_ERR;
+        }
+        // Only synchronous sends go to the notify pipe: thread-safe, no separate memory.
+        if (thread->notify_pipe == nullptr) {
+            thread->notify_pipe = serv->workers[arg].pipe_worker;
+        }
+        return 0;
+    }
+    case SWR_SERVER_OP_RD_DTLS: {
+#ifdef SW_SUPPORT_DTLS
+        auto port = ctx->port;
+        dtls::Buffer *buffer = static_cast<dtls::Buffer *>(sw_malloc(sizeof(*buffer) + SW_BUFFER_SIZE_UDP));
+        buffer->length = sock->read(buffer->data, SW_BUFFER_SIZE_UDP);
+        dtls::Session *session = port->dtls_sessions->find(ctx->event->fd)->second;
+        session->append(buffer);
+        return !session->listened && !session->listen();
+#else
+        return 0;
+#endif
+    }
+    case SWR_SERVER_OP_RD_ABORT:
+        serv->abort_connection(reactor, ctx->port, sock);
+        return 0;
+    case SWR_SERVER_OP_RD_UNREAD:
+        reactor->remove_read_event(sock);
+        return 0;
+    case SWR_SERVER_OP_RD_WRITE_FACTS:
+        return write_facts(ctx);
+
+    case SWR_SERVER_OP_WR_NOTIFY_CLOSE:
+        serv->notify(conn, SW_SERVER_EVENT_CLOSE);
+        conn->close_notify = 0;
+        return 0;
+    case SWR_SERVER_OP_WR_FRONT:
+        if (Buffer::empty(sock->out_buffer)) {
+            return 0;
+        }
+        return 1 + sock->out_buffer->typed_front().kind;
+    case SWR_SERVER_OP_WR_CLOSE:
+        return (int64_t) reactor->close(reactor, sock);
+    case SWR_SERVER_OP_WR_SENDFILE:
+        return (int64_t) sock->handle_sendfile();
+    case SWR_SERVER_OP_WR_SEND:
+        return (int64_t) sock->handle_send();
+    case SWR_SERVER_OP_WR_QUEUED:
+        conn->send_queued_bytes = sock->out_buffer->length();
+        return 0;
+    case SWR_SERVER_OP_WR_WAIT:
+        return (sock->close_wait ? SWR_CN_CLOSE_WAIT : 0) | (sock->send_wait ? SWR_CN_SEND_WAIT : 0);
+    case SWR_SERVER_OP_WR_CLOSE_ERRNO:
+        conn->close_errno = errno;
+        return (int64_t) reactor->trigger_close_event(ctx->event);
+    case SWR_SERVER_OP_WR_STATE:
+        return write_state(ctx);
+    case SWR_SERVER_OP_WR_CLEAR_OVERFLOW:
+        conn->overflow = 0;
+        return 0;
+    case SWR_SERVER_OP_WR_BUFFER_EMPTY:
+        conn->high_watermark = 0;
+        serv->notify(conn, SW_SERVER_EVENT_BUFFER_EMPTY);
+        return 0;
+    case SWR_SERVER_OP_WR_TIMER_DEL:
+        swoole_timer_del(sock->send_timer);
+        sock->send_timer = nullptr;
+        return 0;
+    case SWR_SERVER_OP_WR_TIMER_DELAY:
+        swoole_timer_delay(sock->send_timer, ctx->port->max_idle_time);
+        return 0;
+    case SWR_SERVER_OP_WR_READ_ONLY:
+        reactor->set(sock, SW_EVENT_READ);
+        return 0;
+
+    case SWR_SERVER_OP_PC_NOTIFY: {
+        DataHead notify_ev{};
+        notify_ev.reactor_id = reactor->id;
+        notify_ev.fd = ctx->event->fd;
+        notify_ev.type = SW_SERVER_EVENT_CLOSE;
+        // arg: peer_closed, the connection is no longer available
+        conn->peer_closed = arg;
+        sock->close_notified = 1;
+        return (int64_t) serv->factory_->notify(&notify_ev);
+    }
+
+    case SWR_SERVER_OP_CC_FACTS:
+        return close_facts(ctx);
+    case SWR_SERVER_OP_CC_TIMER_DEL:
+        swoole_timer_del(conn->timer);
+        conn->timer = nullptr;
+        return 0;
+    case SWR_SERVER_OP_CC_SSL_SHUTDOWN:
+        return sock->ssl_shutdown();
+    case SWR_SERVER_OP_CC_SSL_WANT:
+        return sock->ssl_want_read || sock->ssl_want_write;
+    case SWR_SERVER_OP_CC_QUEUE_CLOSE:
+        if (!sock->out_buffer) {
+            sock->out_buffer = new Buffer(SW_SEND_BUFFER_SIZE);
+        }
+        sock->out_buffer->typed_close();
+        conn->close_queued = 1;
+        return 0;
+    case SWR_SERVER_OP_CC_WATCH_WRITE: {
+        // arg: the socket is out of the reactor
+        int events = sock->what_event_want(SW_EVENT_WRITE);
+        return (int64_t) (arg ? reactor->add(sock, events) : reactor->set(sock, events));
+    }
+    case SWR_SERVER_OP_CC_WEBSOCKET_FREE:
+        delete conn->websocket_buffer;
+        conn->websocket_buffer = nullptr;
+        return 0;
+    case SWR_SERVER_OP_CC_COUNT:
+        sw_atomic_fetch_add(&serv->gs->close_count, 1);
+        sw_atomic_fetch_add(&ctx->port->gs->close_count, 1);
+        // arg: base mode, which counts connections per reactor
+        if (arg) {
+            sw_atomic_fetch_sub(&serv->gs->connection_nums[reactor->id], 1);
+            sw_atomic_fetch_sub(&ctx->port->gs->connection_nums[reactor->id], 1);
+        } else {
+            sw_atomic_fetch_sub(&serv->gs->connection_num, 1);
+            sw_atomic_fetch_sub(&ctx->port->gs->connection_num, 1);
+        }
+        swoole_log_as("Server::close_connection", swoole_trace("Close Event.fd=%d|from=%d", sock->fd, reactor->id));
+        return 0;
+    case SWR_SERVER_OP_CC_SSL_CLOSE:
+        conn->socket->ssl_quiet_shutdown = conn->peer_closed;
+        conn->socket->ssl_close();
+        return 0;
+    case SWR_SERVER_OP_CC_DTLS_FREE: {
+#ifdef SW_SUPPORT_DTLS
+        dtls::Session *session = ctx->port->dtls_sessions->find(sock->fd)->second;
+        ctx->port->dtls_sessions->erase(sock->fd);
+        delete session;
+#endif
+        return 0;
+    }
+    case SWR_SERVER_OP_CC_RECV_FREE:
+        // free the reception memory buffer
+        delete sock->recv_buffer;
+        sock->recv_buffer = nullptr;
+        return 0;
+    case SWR_SERVER_OP_CC_HTTP_OBJECT:
+        return ctx->port->open_http_protocol && conn->object;
+    case SWR_SERVER_OP_CC_HTTP_DESTROY:
+        ctx->port->destroy_http_request(conn);
+        return 0;
+    case SWR_SERVER_OP_CC_REDIS_OBJECT:
+        return ctx->port->open_redis_protocol && conn->object;
+    case SWR_SERVER_OP_CC_REDIS_FREE:
+        sw_free(conn->object);
+        return 0;
+    case SWR_SERVER_OP_CC_LINGER: {
+        struct linger linger;
+        linger.l_onoff = 1;
+        linger.l_linger = 0;
+        return conn->socket->set_option(SOL_SOCKET, SO_LINGER, &linger, sizeof(struct linger)) != 0;
+    }
+    case SWR_SERVER_LOG_CC_LINGER:
+        swoole_log_as("Server::close_connection", swoole_sys_warning("setsockopt(SO_LINGER) failed"));
+        return 0;
+    case SWR_SERVER_OP_CC_SESSION_CLEAR:
+        serv->get_session(conn->session_id)->fd = 0;
+        return 0;
+    case SWR_SERVER_TRACE_CC_MAXFD:
+        swoole_log_as("Server::close_connection",
+                      swoole_trace_log(SW_TRACE_SERVER, "set_maxfd=%d|close_fd=%d", (int) arg, sock->fd));
+        return 0;
+    case SWR_SERVER_OP_CC_VALID:
+        return serv->is_valid_connection(serv->get_connection((int) arg));
+    case SWR_SERVER_OP_SET_MAXFD:
+        serv->set_maxfd((int) arg);
+        return 0;
+    case SWR_SERVER_OP_CC_FINISH:
+        conn->active = 0;
+        conn->closed = 1;
+        conn->socket = nullptr;
+        conn->object = nullptr;
+        return (int64_t) Reactor::_close(reactor, sock);
+
+    default:
+        return 0;
+    }
+}
+
+// The ops each received message makes, in a small frame of their own: the rest of
+// reactor_thread_call needs a large, stack-protected one.
+static uint64_t reactor_thread_hot_call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<ReactorThreadContext *>(context);
+    Server *serv = ctx->serv;
+    Connection *conn = ctx->conn;
+    switch (op) {
+    case SWR_SERVER_OP_RD_PORT_READ: {
+        Event *event = ctx->event;
+        ListenPort *port = ctx->port;
+        conn->last_recv_time = microtime();
+        long last_recv_bytes = event->socket->total_recv_bytes;
+        int retval = port->onRead(ctx->reactor, port, event);
+        long socket_recv_bytes = event->socket->total_recv_bytes - last_recv_bytes;
+        if (socket_recv_bytes > 0) {
+            sw_atomic_fetch_add(&port->gs->total_recv_bytes, socket_recv_bytes);
+            sw_atomic_fetch_add(&serv->gs->total_recv_bytes, socket_recv_bytes);
+        }
+        uint64_t result = (uint32_t) retval;
+        if (conn->active) {
+            result |= SWR_CN_ACTIVE | (event->socket->close_notified ? SWR_CN_READ_NOTIFIED : 0) |
+                      (serv->max_queued_bytes && conn->recv_queued_bytes > serv->max_queued_bytes ? SWR_CN_QUEUE_OVER
+                                                                                                   : 0);
+        }
+        return result;
+    }
+    case SWR_SERVER_OP_TASK_INIT:
+        sw_memset_zero(&ctx->task.info, sizeof(ctx->task.info));
+        ctx->task.info.server_fd = conn->server_fd;
+        ctx->task.info.reactor_id = conn->reactor_id;
+        ctx->task.info.ext_flags = ctx->rdata->info.ext_flags;
+        ctx->task.info.type = SW_SERVER_EVENT_RECV_DATA;
+        ctx->task.info.time = conn->last_recv_time;
+        ctx->task.info.fd = conn->fd;
+        ctx->task.info.len = ctx->rdata->info.len;
+        ctx->task.data = ctx->rdata->data;
+        swoole_log_as("Server::dispatch_task", swoole_trace("dispatch task, size=%u bytes", ctx->rdata->info.len));
+        // arg: the bytes to queue for the worker, if any
+        if (arg) {
+            sw_atomic_fetch_add(&conn->recv_queued_bytes, (uint32_t) arg);
+            swoole_log_as("Server::dispatch_task",
+                          swoole_trace_log(SW_TRACE_SERVER,
+                                           "session_id=%ld, len=%d, qb=%d",
+                                           conn->session_id,
+                                           ctx->rdata->info.len,
+                                           conn->recv_queued_bytes));
+        }
+        return (uintptr_t) &ctx->task;
+    case SWR_SERVER_OP_BASE_PASS: {
+        // A BaseFactory op over the task it dispatches.
+        ServerRustContext base{serv};
+        base.send = &ctx->task;
+        return server_call(&base, op, arg);
+    }
+    case SWR_SERVER_OP_ON_RECEIVE:
+        return serv->onReceive(serv, reinterpret_cast<RecvData *>(arg)) == SW_OK;
+    case SWR_SERVER_OP_FACTORY_DISPATCH:
+        return serv->factory_->dispatch(&ctx->task);
+    case SWR_SERVER_OP_COUNT_DISPATCH:
+        if (serv->is_process_mode()) {
+            serv->get_thread(conn->reactor_id)->dispatch_count++;
+        }
+        sw_atomic_fetch_add(&serv->gs->dispatch_count, 1);
+        sw_atomic_fetch_add(&ctx->port->gs->dispatch_count, 1);
+        return 0;
+    default:
+        return reactor_thread_call(context, op, arg);
+    }
+}
+
+static int64_t reactor_thread_run(uint32_t operation, uint64_t arg, ReactorThreadContext *ctx,
+                                  swr_v1_server_call call = reactor_thread_hot_call) {
+    return swr_v1_server_run_state(operation, arg, ctx, call, ctx->serv->state_handle());
+}
+
+/**
+ * for udp
+ */
+static int ReactorThread_onPacketReceived(Reactor *reactor, Event *event) {
+    ReactorThreadContext ctx{static_cast<Server *>(reactor->ptr), reactor};
+    ctx.event = event;
+    return reactor_thread_run(SWR_SERVER_RUN_PACKET_RECEIVED, 0, &ctx);
+}
+
+int Server::close_connection(Reactor *reactor, Socket *socket) {
+    ReactorThreadContext ctx{static_cast<Server *>(reactor->ptr), reactor};
+    ctx.sock = socket;
+    // The connection list's lock is private.
+    return reactor_thread_run(SWR_SERVER_RUN_CLOSE_CONNECTION, 0, &ctx, [](void *c, uint32_t op, uint64_t arg) {
+        Server *serv = static_cast<ReactorThreadContext *>(c)->serv;
+        switch (op) {
+        case SWR_SERVER_OP_LOCK:
+            serv->lock();
+            return (uint64_t) 0;
+        case SWR_SERVER_OP_UNLOCK:
+            serv->unlock();
+            return (uint64_t) 0;
+        default:
+            return reactor_thread_call(c, op, arg);
+        }
+    });
+}
+
+static int ReactorThread_onClose(Reactor *reactor, Event *event) {
+    auto *serv = static_cast<Server *>(reactor->ptr);
+    int fd = event->fd;
+    assert(fd % serv->reactor_num == reactor->id);
+    assert(fd % serv->reactor_num == SwooleTG.id);
+    swoole_trace_log(SW_TRACE_CLOSE, "client[fd=%d] close the connection", fd);
+    ReactorThreadContext ctx{serv, reactor};
+    ctx.event = event;
+    ctx.sock = event->socket;
+    ctx.conn = serv->get_connection(fd);
+    Connection *conn = ctx.conn;
+    uint64_t facts = 0;
+    if (conn && conn->active) {
+        facts = SWR_CN_FOUND | (serv->disable_notify ? SWR_CN_DISABLE_NOTIFY : 0) |
+                (conn->close_queued ? SWR_CN_CLOSE_QUEUED : 0) |
+                (event->socket->close_notified ? SWR_CN_CLOSE_NOTIFIED : 0) | prequeue_facts(serv, conn);
+    }
+    return reactor_thread_run(SWR_SERVER_RUN_PEER_CLOSE, facts, &ctx);
+}
+
+void ReactorThread::shutdown(Reactor *reactor) {
+    ReactorThreadContext ctx{static_cast<Server *>(reactor->ptr), reactor, this};
+    reactor_thread_run(SWR_SERVER_RUN_THREAD_SHUTDOWN, 0, &ctx);
+}
+
+int ReactorThread::close_connection(Reactor *reactor, SessionId session_id) {
+    ReactorThreadContext ctx{static_cast<Server *>(reactor->ptr), reactor, this};
+    return reactor_thread_run(SWR_SERVER_RUN_THREAD_CLOSE, session_id, &ctx);
+}
+
+/**
+ * receive data from worker process pipe
+ */
+static int ReactorThread_onPipeRead(Reactor *reactor, Event *ev) {
+    auto *serv = static_cast<Server *>(reactor->ptr);
+    ReactorThreadContext ctx{serv, reactor, serv->get_thread(reactor->id), ev};
+    return reactor_thread_run(SWR_SERVER_RUN_PIPE_READ, 0, &ctx);
+}
+
+/**
+ * [ReactorThread] worker pipe can write.
+ */
+static int ReactorThread_onPipeWrite(Reactor *reactor, Event *ev) {
+    ReactorThreadContext ctx{static_cast<Server *>(reactor->ptr), reactor, nullptr, ev};
+    return reactor_thread_run(SWR_SERVER_RUN_RT_PIPE_WRITE, 0, &ctx);
+}
+
+void Server::init_reactor(Reactor *reactor) {
+    ReactorThreadContext ctx{this, reactor};
+    reactor_thread_run(SWR_SERVER_RUN_INIT_REACTOR, 0, &ctx);
+}
+
+static int ReactorThread_onRead(Reactor *reactor, Event *event) {
+    auto *serv = static_cast<Server *>(reactor->ptr);
+    ReactorThreadContext ctx{serv, reactor};
+    ctx.event = event;
+    ctx.sock = event->socket;
+    ctx.conn = serv->get_connection(event->fd);
+    return reactor_thread_run(SWR_SERVER_RUN_RT_READ, read_facts(&ctx), &ctx);
+}
+
+static int ReactorThread_onWrite(Reactor *reactor, Event *ev) {
+    ReactorThreadContext ctx{static_cast<Server *>(reactor->ptr), reactor};
+    ctx.event = ev;
+    ctx.sock = ev->socket;
+    return reactor_thread_run(SWR_SERVER_RUN_RT_WRITE, write_facts(&ctx), &ctx);
+}
+
+void Server::heartbeat_check(Timer *timer, TimerNode *tnode) {
+    auto reactor = static_cast<Reactor *>(tnode->data);
+    auto serv = static_cast<Server *>(reactor->ptr);
+    ReactorThreadContext ctx{serv, reactor, serv->get_thread(reactor->id)};
+    reactor_thread_run(SWR_SERVER_RUN_HEARTBEAT_CHECK, 0, &ctx);
+}
+
+/**
+ * [master]
+ */
+int Server::start_reactor_threads() {
+    ReactorThreadContext ctx{this};
+    // Listen sockets, the heartbeat thread and the master thread are private.
+    return reactor_thread_run(SWR_SERVER_RUN_START_REACTOR_THREADS, 0, &ctx, [](void *c, uint32_t op, uint64_t arg) {
+        auto *context = static_cast<ReactorThreadContext *>(c);
+        switch (op) {
+        case SWR_SERVER_OP_STORE_LISTEN_SOCKET:
+            context->serv->store_listen_socket();
+            return (uint64_t) 0;
+        case SWR_SERVER_OP_HEARTBEAT_THREAD:
+            context->serv->start_heartbeat_thread();
+            return (uint64_t) 0;
+        case SWR_SERVER_OP_START_MASTER_THREAD:
+            return (uint64_t) (int64_t) context->serv->start_master_thread(context->reactor);
+        default:
+            return reactor_thread_hot_call(c, op, arg);
+        }
+    });
+}
+
+int ReactorThread::init(Server *serv, Reactor *reactor, uint16_t reactor_id) {
+    ReactorThreadContext ctx{serv, reactor, this};
+    return reactor_thread_run(SWR_SERVER_RUN_RT_INIT, reactor_id, &ctx);
+}
+
+void ReactorThread::clean() {
+    message_bus.free_buffer();
+}
+
+void Server::reactor_thread_main_loop(Server *serv, int reactor_id) {
+    ReactorThreadContext ctx{serv};
+    reactor_thread_run(SWR_SERVER_RUN_REACTOR_THREAD_MAIN, reactor_id, &ctx);
+}
+
+static void ReactorThread_resume_data_receiving(Timer *timer, TimerNode *tnode) {
+    auto *_socket = static_cast<Socket *>(tnode->data);
+    ReactorThreadContext ctx{sw_server()};
+    ctx.sock = _socket;
+    ctx.conn = static_cast<Connection *>(_socket->object);
+    ctx.timer = timer;
+    reactor_thread_run(SWR_SERVER_RUN_RESUME_RECEIVING, 0, &ctx);
+}
+
+/**
+ * dispatch request data [only data frame]
+ */
+int Server::dispatch_task(const Protocol *proto, Socket *_socket, const RecvData *rdata) {
+    auto *serv = static_cast<Server *>(proto->private_data_2);
+    ReactorThreadContext ctx{serv};
+    ctx.sock = _socket;
+    ctx.conn = static_cast<Connection *>(_socket->object);
+    ctx.port = const_cast<ListenPort *>(serv->get_port_by_fd(ctx.conn->fd));
+    ctx.rdata = rdata;
+    return reactor_thread_run(SWR_SERVER_RUN_DISPATCH_TASK, rdata->info.len, &ctx);
+}
+
+void Server::join_heartbeat_thread() {
+    /**
+     * Shutdown heartbeat thread
+     */
+    if (heartbeat_thread.joinable()) {
+        swoole_trace_log(SW_TRACE_SERVER, "terminate heartbeat thread");
+        heartbeat_thread.join();
+    }
+}
+
+void Server::join_reactor_thread() {
+    ReactorThreadContext ctx{this};
+    reactor_thread_run(SWR_SERVER_RUN_JOIN_REACTOR_THREADS, 0, &ctx, [](void *c, uint32_t op, uint64_t arg) {
+        if (op == SWR_SERVER_OP_JOIN_HEARTBEAT) {
+            static_cast<ReactorThreadContext *>(c)->serv->join_heartbeat_thread();
+            return (uint64_t) 0;
+        }
+        return reactor_thread_hot_call(c, op, arg);
+    });
+}
+
+void Server::start_heartbeat_thread() {
+    heartbeat_thread = std::thread([this]() {
+        swoole_signal_block_all();
+        swoole_set_thread_type(THREAD_HEARTBEAT);
+        swoole_set_thread_type(reactor_num + 1);
+        ReactorThreadContext ctx{this};
+        reactor_thread_run(SWR_SERVER_RUN_HEARTBEAT_THREAD, 0, &ctx);
+    });
 }
