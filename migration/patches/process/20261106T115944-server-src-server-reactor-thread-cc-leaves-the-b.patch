-static int64_t reactor_thread_run(uint32_t operation, uint64_t arg, ReactorThreadContext *ctx,
-                                  swr_v1_server_call call = reactor_thread_hot_call) {
-    return swr_v1_server_run_state(operation, arg, ctx, call, ctx->serv->state_handle());
-}
