-    return reactor_thread_run(SWR_SERVER_RUN_START_REACTOR_THREADS, 0, &ctx, [](void *c, uint32_t op, uint64_t arg) {
-        auto *context = static_cast<ReactorThreadContext *>(c);
-        switch (op) {
-        case SWR_SERVER_OP_STORE_LISTEN_SOCKET:
-            context->serv->store_listen_socket();
-            return (uint64_t) 0;
-        case SWR_SERVER_OP_HEARTBEAT_THREAD:
-            context->serv->start_heartbeat_thread();
-            return (uint64_t) 0;
-        case SWR_SERVER_OP_START_MASTER_THREAD:
-            return (uint64_t) (int64_t) context->serv->start_master_thread(context->reactor);
-        default:
-            return reactor_thread_hot_call(c, op, arg);
-        }
-    });
