-static int ReactorThread_onPacketReceived(Reactor *reactor, Event *event) {
-    ReactorThreadContext ctx{static_cast<Server *>(reactor->ptr), reactor};
-    ctx.event = event;
-    return reactor_thread_run(SWR_SERVER_RUN_PACKET_RECEIVED, 0, &ctx);
