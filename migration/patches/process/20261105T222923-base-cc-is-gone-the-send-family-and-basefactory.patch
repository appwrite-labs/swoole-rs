-
-    case SWR_SERVER_OP_WORKER_ID:
-        return swoole_get_worker_id();
-    case SWR_SERVER_OP_ACCEPT_EVENT:
-        serv->worker_accept_event(reinterpret_cast<DataHead *>(arg));
