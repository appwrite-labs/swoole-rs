-static int64_t base_factory_run(uint32_t operation,
-                                uint64_t arg,
-                                BaseFactoryContext *ctx,
-                                swr_v1_server_call call = base_factory_call) {
-    return swr_v1_server_run_state(operation, arg, ctx, call, ctx->serv->state_handle());
