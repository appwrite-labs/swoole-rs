+static void settings_set_double(void *server, double send_timeout) {
+    static_cast<Server *>(server)->send_timeout = send_timeout;
+}
+
+static void settings_text(void *server, uint32_t id, const char *value, size_t length) {
+    Server *serv = static_cast<Server *>(server);
+    std::string text(value, length);
+    switch (id) {
+    case SWR_PHPSERVER_TEXT_CHROOT: serv->chroot_ = text; break;
+    case SWR_PHPSERVER_TEXT_USER: serv->user_ = text; break;
+    case SWR_PHPSERVER_TEXT_GROUP: serv->group_ = text; break;
+    case SWR_PHPSERVER_TEXT_PID_FILE: serv->pid_file = text; break;
+    case SWR_PHPSERVER_TEXT_TASK_TMPDIR: swoole_set_task_tmpdir(text); break;
+    case SWR_PHPSERVER_TEXT_UPLOAD_TMP_DIR: serv->upload_tmp_dir = text; break;
+    case SWR_PHPSERVER_TEXT_DOCUMENT_ROOT: serv->set_document_root(text); break;
+    case SWR_PHPSERVER_TEXT_INDEX_FILE: serv->add_static_handler_index_files(text); break;
+#ifdef SW_HAVE_COMPRESSION
+    case SWR_PHPSERVER_TEXT_COMPRESSION_TYPE: serv->add_http_compression_type(text); break;
+#endif
+    case SWR_PHPSERVER_TEXT_STATIC_LOCATION: serv->add_static_handler_location(text); break;
+    default: break;
+    }
+}
+
+static void settings_rewrite(void *server, const char *pattern, size_t pattern_length, const char *replacement,
+                             size_t replacement_length) {
+    static_cast<Server *>(server)->add_rewrite_rule(std::string(pattern, pattern_length),
+                                                   std::string(replacement, replacement_length));
+}
+
+static int64_t settings_parse_size(zval *value) {
+    return php_swoole_parse_to_size(value);
+}
+
+static bool settings_global_options(void *settings) {
+    bool bailout = false;
+    zend_try {
+        HashTable *vht = Z_ARRVAL_P(static_cast<zval *>(settings));
+        php_swoole_set_global_option(vht);
+        php_swoole_set_coroutine_option(vht);
+        php_swoole_set_aio_option(vht);
+    } zend_catch {
+        bailout = true;
+    } zend_end_try();
+    return bailout;
+}
+
+static bool settings_dispatch_func(void *server, zval *ztmp) {
+    Server *serv = static_cast<Server *>(server);
+    bool bailout = false;
+    zend_try {
+        auto fci_cache = sw_callable_create(ztmp);
+        if (fci_cache) {
+            if (serv->private_data_3) {
+                sw_callable_free(serv->private_data_3);
+            }
+            serv->private_data_3 = fci_cache;
+            serv->dispatch_func = php_swoole_server_dispatch_func;
+            serv->single_thread = true;
+        }
+    } zend_catch {
+        bailout = true;
+    } zend_end_try();
+    return bailout;
+}
+
+static int settings_cpu_affinity_ignore(void *server, zval *ztmp) {
+    int result = 0;
+#ifdef HAVE_CPU_AFFINITY
+    zend_try {
+        result = php_swoole_server_set_cpu_affinity_ignore(static_cast<Server *>(server), ztmp);
+    } zend_catch {
+        result = 2;
+    } zend_end_try();
+#else
+    (void) server;
+    (void) ztmp;
+#endif
+    return result;
+}
+
+static int settings_create_dir(const char *path, size_t length) {
+    return php_swoole_create_dir(path, length);
+}
+
+static bool settings_msgqueue_key_valid(int64_t key) {
+    return php_swoole_msgqueue_key_is_valid(key);
+}
+
+static bool settings_thread_options(zend_object *object, void *settings) {
+    bool bailout = false;
+#ifdef SW_THREAD
+    zend_try {
+        HashTable *vht = Z_ARRVAL_P(static_cast<zval *>(settings));
+        zval zobject, *ztmp;
+        ZVAL_OBJ(&zobject, object);
+        if (php_swoole_array_get_value(vht, "bootstrap", ztmp)) {
+            zend::object_set(&zobject, ZEND_STRL("bootstrap"), ztmp);
+        }
+        if (php_swoole_array_get_value(vht, "init_arguments", ztmp)) {
+            server_fetch_object(object)->init_arguments = *ztmp;
+        }
+    } zend_catch {
+        bailout = true;
+    } zend_end_try();
+#else
+    (void) object;
+    (void) settings;
+#endif
+    return bailout;
+}
+
+static bool settings_finish(zend_object *object, zval *zset) {
+    bool bailout = false;
+    zend_try {
+        ServerObject *server_object = server_fetch_object(object);
+        sw_zend_call_method_with_1_params(
+            server_object->property->ports.at(0), swoole_server_port_ce, nullptr, "set", nullptr, zset);
+        zval zobject;
+        ZVAL_OBJ(&zobject, object);
+        zval *zsetting = sw_zend_read_and_convert_property_array(swoole_server_ce, &zobject, ZEND_STRL("setting"), 0);
+        SEPARATE_ARRAY(zsetting);
+        php_array_merge(Z_ARRVAL_P(zsetting), Z_ARRVAL_P(zset));
+    } zend_catch {
+        bailout = true;
+    } zend_end_try();
+    return bailout;
+}
