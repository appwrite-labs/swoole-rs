+// Server::set(): the fields crates/phpserver's settings.rs sets by id.
+static int64_t settings_get(void *server, uint32_t id) {
+    Server *serv = static_cast<Server *>(server);
+    switch (id) {
+    case SWR_PHPSERVER_SET_CPU_NUM: return SW_CPU_NUM;
+    case SWR_PHPSERVER_SET_GLOBAL_ENABLE_COROUTINE: return SwooleG.enable_coroutine;
+    case SWR_PHPSERVER_SET_WORKER_THREAD: return serv->is_worker_thread();
+    case SWR_PHPSERVER_SET_STARTED: return serv->is_started();
+    case SWR_PHPSERVER_SET_WORKER_MAX_CONCURRENCY: return serv->get_worker_max_concurrency();
+    case SWR_PHPSERVER_SET_MAX_CONCURRENCY: return serv->get_max_concurrency();
+    case SWR_PHPSERVER_SET_ENABLE_COROUTINE: return serv->enable_coroutine;
+    case SWR_PHPSERVER_SET_DISPATCH_MODE: return serv->dispatch_mode;
+    case SWR_PHPSERVER_SET_TASK_IPC_MODE: return serv->task_ipc_mode;
+    case SWR_PHPSERVER_SET_TASK_ENABLE_COROUTINE: return serv->task_enable_coroutine;
+    case SWR_PHPSERVER_SET_PATH_MAX: return PATH_MAX;
+#if defined(__linux__) and defined(HAVE_REUSEPORT)
+    case SWR_PHPSERVER_SET_HAVE_REUSE_PORT: return 1;
+#endif
+#ifdef HAVE_CPU_AFFINITY
+    case SWR_PHPSERVER_SET_HAVE_CPU_AFFINITY: return 1;
+#endif
+#ifdef SW_HAVE_COMPRESSION
+    case SWR_PHPSERVER_SET_HAVE_COMPRESSION: return 1;
+#endif
+#ifdef SW_HAVE_ZLIB
+    case SWR_PHPSERVER_SET_HAVE_ZLIB: return 1;
+#endif
+#ifdef HAVE_MSGQUEUE
+    case SWR_PHPSERVER_SET_HAVE_MSGQUEUE: return 1;
+#endif
+#ifdef SW_THREAD
+    case SWR_PHPSERVER_SET_THREAD: return 1;
+#endif
+    default: return 0;
+    }
+}
+
+static void settings_set(void *server, uint32_t id, int64_t v) {
+    Server *serv = static_cast<Server *>(server);
+    switch (id) {
+    case SWR_PHPSERVER_SET_DAEMONIZE: serv->daemonize = v; break;
+    case SWR_PHPSERVER_SET_REACTOR_NUM: serv->reactor_num = v; break;
+    case SWR_PHPSERVER_SET_SINGLE_THREAD: serv->single_thread = v; break;
+    case SWR_PHPSERVER_SET_WORKER_NUM: serv->worker_num = v; break;
+    case SWR_PHPSERVER_SET_MAX_WAIT_TIME: serv->max_wait_time = v; break;
+    case SWR_PHPSERVER_SET_MAX_QUEUED_BYTES: serv->max_queued_bytes = v; break;
+    case SWR_PHPSERVER_SET_MAX_CONCURRENCY: serv->set_max_concurrency(v); break;
+    case SWR_PHPSERVER_SET_WORKER_MAX_CONCURRENCY: serv->set_worker_max_concurrency(v); break;
+    case SWR_PHPSERVER_SET_ENABLE_COROUTINE: serv->enable_coroutine = v; break;
+    case SWR_PHPSERVER_SET_DISPATCH_MODE: serv->dispatch_mode = v; break;
+    case SWR_PHPSERVER_SET_SEND_YIELD: serv->send_yield = v; break;
+    case SWR_PHPSERVER_SET_DISCARD_TIMEOUT_REQUEST: serv->discard_timeout_request = v; break;
+    case SWR_PHPSERVER_SET_ENABLE_UNSAFE_EVENT: serv->enable_unsafe_event = v; break;
+    case SWR_PHPSERVER_SET_ENABLE_DELAY_RECEIVE: serv->enable_delay_receive = v; break;
+#if defined(__linux__) and defined(HAVE_REUSEPORT)
+    case SWR_PHPSERVER_SET_ENABLE_REUSE_PORT: serv->enable_reuse_port = v; break;
+#endif
+    case SWR_PHPSERVER_SET_TASK_OBJECT: serv->task_object = v; break;
+    case SWR_PHPSERVER_SET_EVENT_OBJECT: serv->event_object = v; break;
+    case SWR_PHPSERVER_SET_TASK_ENABLE_COROUTINE: serv->task_enable_coroutine = v; break;
+    case SWR_PHPSERVER_SET_TASK_WORKER_NUM: serv->task_worker_num = v; break;
+    case SWR_PHPSERVER_SET_TASK_IPC_MODE: serv->task_ipc_mode = v; break;
+    case SWR_PHPSERVER_SET_TASK_MAX_REQUEST: serv->task_max_request = v; break;
+    case SWR_PHPSERVER_SET_TASK_MAX_REQUEST_GRACE: serv->task_max_request_grace = v; break;
+    case SWR_PHPSERVER_SET_MAX_CONNECTION: serv->set_max_connection(v); break;
+    case SWR_PHPSERVER_SET_START_SESSION_ID: serv->set_start_session_id(v); break;
+    case SWR_PHPSERVER_SET_HEARTBEAT_CHECK_INTERVAL: serv->heartbeat_check_interval = v; break;
+    case SWR_PHPSERVER_SET_MAX_REQUEST: serv->max_request = v; break;
+    case SWR_PHPSERVER_SET_MAX_REQUEST_GRACE: serv->max_request_grace = v; break;
+    case SWR_PHPSERVER_SET_RELOAD_ASYNC: serv->reload_async = v; break;
+    case SWR_PHPSERVER_SET_OPEN_CPU_AFFINITY: serv->open_cpu_affinity = v; break;
+    case SWR_PHPSERVER_SET_HTTP_PARSE_COOKIE: serv->http_parse_cookie = v; break;
+    case SWR_PHPSERVER_SET_HTTP_PARSE_POST: serv->http_parse_post = v; break;
+    case SWR_PHPSERVER_SET_HTTP_PARSE_FILES: serv->http_parse_files = v; break;
+#ifdef SW_HAVE_COMPRESSION
+    case SWR_PHPSERVER_SET_HTTP_COMPRESSION: serv->http_compression = v; break;
+    case SWR_PHPSERVER_SET_HTTP_COMPRESSION_LEVEL: serv->http_compression_level = v; break;
+    case SWR_PHPSERVER_SET_COMPRESSION_MIN_LENGTH: serv->compression_min_length = v; break;
+#endif
+#ifdef SW_HAVE_ZLIB
+    case SWR_PHPSERVER_SET_WEBSOCKET_COMPRESSION: serv->websocket_compression = v; break;
+#endif
+    case SWR_PHPSERVER_SET_UPLOAD_MAX_FILESIZE: serv->upload_max_filesize = v; break;
+    case SWR_PHPSERVER_SET_ENABLE_STATIC_HANDLER: serv->enable_static_handler = v; break;
+    case SWR_PHPSERVER_SET_HTTP_AUTOINDEX: serv->http_autoindex = v; break;
+    case SWR_PHPSERVER_SET_INPUT_BUFFER_SIZE: serv->input_buffer_size = v; break;
+    case SWR_PHPSERVER_SET_OUTPUT_BUFFER_SIZE: serv->output_buffer_size = v; break;
+    case SWR_PHPSERVER_SET_MESSAGE_QUEUE_KEY: serv->message_queue_key = v; break;
+    default: assert(false);
+    }
+}
