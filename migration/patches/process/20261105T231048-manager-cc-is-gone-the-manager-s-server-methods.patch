diff --git a/src/server/process.cc b/src/server/process.cc
index b9f20ce..79a1161 100644
--- a/src/server/process.cc
+++ b/src/server/process.cc
@@ -19,2 +19,3 @@
 #include "swoole_rs_workers.h"
+#include "swoole_util.h"
 
@@ -391,2 +392,387 @@ uint64_t FactoryContext::call(void *context, uint32_t op, uint64_t arg) {
 
+// What a crates/process/src/workers/manager.rs operation acts on.
+template <>
+struct WorkersNative<3> {
+    Server *serv;
+    // The worker being restarted, or the message being read.
+    Worker *worker;
+    const EventData *task;
+    Server::Command::Handler *handler;
+    EventData msg;
+    WorkerStopMessage stop;
+    int wait_status;
+    int wait_error;
+
+    static uint64_t call(void *context, uint32_t op, uint64_t arg);
+
+    int64_t run(uint32_t operation, uint64_t arg = 0) {
+        return swr_v1_workers_run(operation, arg, this, call);
+    }
+};
+using ManagerContext = WorkersNative<3>;
+
+static void Manager_signal_handler(int signo) {
+    ManagerContext ctx{sw_server()};
+    ctx.run(SWR_WORKERS_RUN_MANAGER_SIGNAL, signo);
+}
+
+static void Manager_timer_callback(Timer *timer, TimerNode *tnode) {
+    auto *serv = static_cast<Server *>(tnode->data);
+    if (serv->isset_hook(Server::HOOK_MANAGER_TIMER)) {
+        serv->call_hook(Server::HOOK_MANAGER_TIMER, serv);
+    }
+}
+
+static ExitStatus Manager_exit_status(uint64_t exited) {
+    return ExitStatus(static_cast<pid_t>(exited & 0xffffffff), static_cast<int>(exited >> 32));
+}
+
+uint64_t ManagerContext::call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<ManagerContext *>(context);
+    Server *serv = ctx->serv;
+    switch (op) {
+    case SWR_WORKERS_OP_CREATE_EVENT_WORKERS:
+        return serv->create_event_workers();
+    case SWR_WORKERS_OP_HAS_MESSAGE_BOX:
+        return serv->get_event_worker_pool()->message_box != nullptr;
+    case SWR_WORKERS_OP_CREATE_MESSAGE_BOX:
+        return (int64_t) serv->get_event_worker_pool()->create_message_box(SW_MESSAGE_BOX_SIZE);
+    case SWR_WORKERS_OP_USER_WORKER_NUM:
+        return serv->get_user_worker_num();
+    case SWR_WORKERS_OP_CREATE_USER_WORKERS:
+        return serv->create_user_workers();
+    case SWR_WORKERS_OP_MODE:
+        return serv->is_base_mode() ? 1 : (serv->is_process_mode() ? 2 : 3);
+    case SWR_WORKERS_OP_FORK_MANAGER:
+        return (int64_t) swoole_fork_exec([serv]() {
+            ManagerContext child{serv};
+            child.run(SWR_WORKERS_RUN_MANAGER_MAIN);
+        });
+    case SWR_WORKERS_LOG_FORK_MANAGER:
+        swoole_log_as("Server::start_manager_process", swoole_sys_warning("failed fork manager process"));
+        return 0;
+    case SWR_WORKERS_OP_SET_MANAGER_PID:
+        serv->gs->manager_pid = getpid();
+        return 0;
+    case SWR_WORKERS_OP_TASK_WORKER_NUM:
+        return serv->task_worker_num;
+    case SWR_WORKERS_OP_START_TASK_POOL:
+        return (int64_t) serv->get_task_worker_pool()->start();
+    case SWR_WORKERS_LOG_START_TASK_POOL:
+        swoole_log_as("Server::start_manager_process", swoole_sys_error("failed to start task worker"));
+        return 0;
+    case SWR_WORKERS_OP_SET_MANAGER_TYPE:
+        swoole_set_worker_type(SW_MANAGER);
+        return 0;
+    case SWR_WORKERS_OP_WORKER_NUM:
+        return serv->worker_num;
+    case SWR_WORKERS_OP_SPAWN_EVENT_WORKER:
+        return (int64_t) serv->factory_->spawn_event_worker(serv->get_worker(arg));
+    case SWR_WORKERS_LOG_FORK_EVENT_WORKER:
+        swoole_log_as("Server::start_manager_process", swoole_sys_error("failed to fork event worker"));
+        return 0;
+    case SWR_WORKERS_OP_SPAWN_USER_WORKER:
+        return (int64_t) serv->factory_->spawn_user_worker(serv->user_worker_list[arg]);
+    case SWR_WORKERS_LOG_FORK_USER_WORKER:
+        swoole_log_as("Server::start_manager_process", swoole_sys_error("failed to fork user worker"));
+        return 0;
+
+    case SWR_WORKERS_OP_MANAGER_INIT: {
+        ProcessPool *pool = serv->get_event_worker_pool();
+        ProcessPool *task_pool = serv->get_task_worker_pool();
+        serv->manager_ = reinterpret_cast<Manager *>(arg);
+        pool->onWorkerMessage = Server::read_worker_message;
+        pool->max_wait_time = serv->max_wait_time;
+        serv->gs->manager_pid = pool->master_pid = task_pool->master_pid = getpid();
+        return 0;
+    }
+    case SWR_WORKERS_OP_EVENT_FREE:
+        swoole_event_free();
+        return 0;
+    case SWR_WORKERS_OP_SIGNAL_SET:
+        swr_workers_signal_set(arg, Manager_signal_handler);
+        return 0;
+    case SWR_WORKERS_OP_DEATH_SIGNAL:
+        swoole_set_process_death_signal(SIGTERM);
+        return 0;
+    case SWR_WORKERS_OP_MANAGER_BARRIER:
+        serv->gs->manager_barrier.wait();
+        return 0;
+    case SWR_WORKERS_OP_RELOAD_ASYNC:
+        return serv->reload_async;
+    case SWR_WORKERS_OP_ROOT_USER:
+        return swoole_is_root_user();
+    case SWR_WORKERS_OP_HAS_USER:
+        return !serv->user_.empty();
+    case SWR_WORKERS_OP_SET_ISOLATION:
+        swoole_set_isolation(serv->group_, serv->user_, serv->chroot_);
+        return 0;
+    case SWR_WORKERS_OP_SERVER_HOOK_MANAGER_START:
+        if (serv->isset_hook(Server::HOOK_MANAGER_START)) {
+            serv->call_hook(Server::HOOK_MANAGER_START, serv);
+        }
+        return 0;
+    case SWR_WORKERS_OP_ON_MANAGER_START:
+        if (serv->onManagerStart) {
+            serv->onManagerStart(serv);
+        }
+        return 0;
+    case SWR_WORKERS_OP_MANAGER_ALARM:
+        return (int64_t) serv->manager_alarm;
+    case SWR_WORKERS_OP_ADD_MANAGER_TIMER:
+        swoole_timer_add(sec2msec(serv->manager_alarm), true, Manager_timer_callback, serv);
+        return 0;
+    case SWR_WORKERS_OP_DROP_RELOAD_TASK:
+        serv->get_event_worker_pool()->drop_reload_task();
+        return 0;
+    case SWR_WORKERS_OP_TIMER_AVAILABLE:
+        return swoole_timer_is_available();
+    case SWR_WORKERS_OP_TIMER_FREE:
+        swoole_timer_free();
+        return 0;
+    case SWR_WORKERS_OP_MAX_WAIT_TIME:
+        return serv->max_wait_time;
+    case SWR_WORKERS_OP_EVENT_WORKER_PID:
+        return (int64_t) serv->workers[arg].get_pid();
+    case SWR_WORKERS_OP_TASK_POOL_WORKER_NUM:
+        return serv->get_task_worker_pool()->worker_num;
+    case SWR_WORKERS_OP_TASK_WORKER_PID:
+        return (int64_t) serv->get_task_worker_pool()->workers[arg].get_pid();
+    case SWR_WORKERS_OP_WORKER_REGISTRY:
+        return reinterpret_cast<uintptr_t>(serv->worker_registry);
+    case SWR_WORKERS_OP_KILL_EVENT_WORKERS:
+        serv->factory_->kill_event_workers();
+        return 0;
+    case SWR_WORKERS_OP_KILL_TASK_WORKERS:
+        serv->factory_->kill_task_workers();
+        return 0;
+    case SWR_WORKERS_OP_KILL_USER_WORKERS:
+        serv->factory_->kill_user_workers();
+        return 0;
+    case SWR_WORKERS_OP_ON_MANAGER_STOP:
+        if (serv->onManagerStop) {
+            serv->onManagerStop(serv);
+        }
+        return 0;
+
+    case SWR_WORKERS_OP_RUNNING:
+        return serv->running;
+    case SWR_WORKERS_OP_RELOAD_INIT:
+        return serv->get_event_worker_pool()->reload_init;
+    case SWR_WORKERS_OP_SET_RELOAD_INIT:
+        serv->get_event_worker_pool()->reload_init = arg;
+        return 0;
+    case SWR_WORKERS_OP_RELOAD_TASK:
+        return (uintptr_t) serv->get_event_worker_pool()->reload_task;
+    case SWR_WORKERS_OP_REAP_WAIT:
+        return (int64_t) swr_v1_process_reap_wait(nullptr, arg, &ctx->wait_status, &ctx->wait_error);
+    case SWR_WORKERS_OP_WAIT_STATUS:
+        return (int64_t) ctx->wait_status;
+    case SWR_WORKERS_OP_WAIT_ERROR:
+        return (int64_t) ctx->wait_error;
+    case SWR_WORKERS_OP_SIGNAL_DISPATCH:
+        swoole_signal_dispatch();
+        return 0;
+    case SWR_WORKERS_OP_READ_MESSAGE:
+        return serv->get_event_worker_pool()->read_message;
+    case SWR_WORKERS_OP_SET_READ_MESSAGE:
+        serv->get_event_worker_pool()->read_message = arg;
+        return 0;
+    case SWR_WORKERS_OP_POP_MESSAGE:
+        return (int64_t) serv->get_event_worker_pool()->pop_message(&ctx->msg, sizeof(ctx->msg));
+    case SWR_WORKERS_OP_MESSAGE_TYPE:
+        return ctx->msg.info.type;
+    case SWR_WORKERS_OP_HAS_ON_WORKER_MESSAGE:
+        return serv->get_event_worker_pool()->onWorkerMessage != nullptr;
+    case SWR_WORKERS_OP_ON_WORKER_MESSAGE:
+        serv->get_event_worker_pool()->onWorkerMessage(serv->get_event_worker_pool(), &ctx->msg);
+        return 0;
+    case SWR_WORKERS_OP_STOP_MESSAGE_WORKER:
+        memcpy(&ctx->stop, ctx->msg.data, sizeof(ctx->stop));
+        return ctx->stop.worker_id;
+    case SWR_WORKERS_OP_SPAWN_TASK_WORKER:
+        serv->factory_->spawn_task_worker(serv->get_worker(arg));
+        return 0;
+    case SWR_WORKERS_OP_DETACH_STOPPED:
+        swr_v1_process_worker_registry_detach(static_cast<swr_v1_process_worker_registry *>(serv->worker_registry),
+                                              ctx->stop.pid);
+        return 0;
+    case SWR_WORKERS_OP_HAS_TIMER:
+        return sw_timer() != nullptr;
+    case SWR_WORKERS_OP_TIMER_SELECT:
+        sw_timer()->select();
+        return 0;
+    case SWR_WORKERS_LOG_WAIT_FAILED:
+        swoole_log_as("Manager::wait", swoole_sys_warning("wait() failed"));
+        return 0;
+    case SWR_WORKERS_LOG_RELOADING:
+        if (arg) {
+            swoole_log_as("Manager::wait", swoole_info("Server is reloading all workers now"));
+        } else {
+            swoole_log_as("Manager::wait", swoole_info("Server is reloading task workers now"));
+        }
+        return 0;
+    case SWR_WORKERS_LOG_NO_TASK_RELOAD:
+        swoole_log_as("Manager::wait", swoole_warning("cannot reload task workers, task workers is not started"));
+        return 0;
+    case SWR_WORKERS_OP_ON_BEFORE_RELOAD:
+        if (serv->onBeforeReload != nullptr) {
+            serv->onBeforeReload(serv);
+        }
+        return 0;
+    case SWR_WORKERS_OP_RELOAD_ADD_EVENT_WORKERS:
+        swr_v1_process_reload_task_add_workers(serv->get_event_worker_pool()->reload_task,
+                                               reinterpret_cast<swr_v1_worker_record *>(serv->workers),
+                                               serv->worker_num);
+        return 0;
+    case SWR_WORKERS_OP_RELOAD_ADD_TASK_WORKERS:
+        swr_v1_process_reload_task_add_workers(
+            serv->get_event_worker_pool()->reload_task,
+            reinterpret_cast<swr_v1_worker_record *>(serv->get_task_worker_pool()->workers),
+            serv->task_worker_num);
+        return 0;
+    case SWR_WORKERS_OP_RELOAD_KILL_ALL:
+        swr_v1_process_reload_task_kill_all(serv->get_event_worker_pool()->reload_task, SIGTERM, reload_warn);
+        return 0;
+    case SWR_WORKERS_OP_RELOAD_WARN:
+        return (uintptr_t) reload_warn;
+    case SWR_WORKERS_OP_RESTART_WORKER:
+        serv->restart_worker_process(Manager_exit_status(arg));
+        return 0;
+    case SWR_WORKERS_OP_ON_AFTER_RELOAD:
+        if (serv->onAfterReload != nullptr) {
+            serv->onAfterReload(serv);
+        }
+        return 0;
+
+    case SWR_WORKERS_OP_MANAGER:
+        return serv ? (uintptr_t) serv->manager_ : 0;
+    case SWR_WORKERS_OP_IS_MANAGER:
+        return getpid() == serv->gs->manager_pid;
+    case SWR_WORKERS_OP_SET_RUNNING:
+        serv->running = arg;
+        return 0;
+    case SWR_WORKERS_OP_SERVER_RELOAD:
+        serv->reload(arg);
+        return 0;
+    case SWR_WORKERS_LOG_KILL_TIMEOUT:
+        swoole_log_as("Manager::terminate_all_worker",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_SERVER_WORKER_EXIT_TIMEOUT,
+                                       "wait timeout, all worker processes will be forcibly terminated"));
+        return 0;
+    case SWR_WORKERS_OP_REOPEN_LOGGER:
+        sw_logger()->reopen();
+        return 0;
+    case SWR_WORKERS_OP_ALL_WORKER_NUM:
+        return serv->get_all_worker_num();
+    case SWR_WORKERS_OP_ANY_WORKER_PID:
+        return (int64_t) serv->get_worker(arg)->get_pid();
+
+    case SWR_WORKERS_OP_WORKER_BY_PID:
+        ctx->worker = serv->get_worker_by_pid(static_cast<pid_t>(arg));
+        return ctx->worker != nullptr;
+    case SWR_WORKERS_OP_REAP_DETACHED:
+        if (!swr_v1_process_worker_registry_reap_detached(
+                static_cast<swr_v1_process_worker_registry *>(serv->worker_registry), static_cast<pid_t>(arg))) {
+            return 0;
+        }
+        swoole_log_as("Server::restart_worker_process",
+                      swoole_trace_log(SW_TRACE_SERVER, "Detached process [%d] exited normally", (int) arg));
+        return 1;
+    case SWR_WORKERS_LOG_UNKNOWN_CHILD:
+        swoole_log_as("Server::restart_worker_process",
+                      swoole_warning("Unknown type child process [%d] exited", (int) arg));
+        return 0;
+    case SWR_WORKERS_OP_UNREGISTER_PID:
+        swr_v1_process_worker_registry_unregister(static_cast<swr_v1_process_worker_registry *>(serv->worker_registry),
+                                                  static_cast<pid_t>(arg));
+        return 0;
+    case SWR_WORKERS_OP_CHECK_EXIT_STATUS:
+        serv->factory_->check_worker_exit_status(ctx->worker, Manager_exit_status(arg));
+        return 0;
+    case SWR_WORKERS_OP_WORKER_TYPE:
+        return ctx->worker->get_type();
+    case SWR_WORKERS_OP_RESPAWN_EVENT_WORKER:
+        return (int64_t) serv->factory_->spawn_event_worker(ctx->worker);
+    case SWR_WORKERS_OP_RESPAWN_TASK_WORKER:
+        return (int64_t) serv->factory_->spawn_task_worker(ctx->worker);
+    case SWR_WORKERS_OP_RESPAWN_USER_WORKER:
+        return (int64_t) serv->factory_->spawn_user_worker(ctx->worker);
+    case SWR_WORKERS_LOG_UNKNOWN_WORKER_TYPE:
+        swoole_log_as("Server::restart_worker_process",
+                      swoole_warning("Unknown worker [pid=%d] type [%d]", (int) arg, ctx->worker->get_type()));
+        return 0;
+
+    case SWR_WORKERS_OP_INFO_TYPE:
+        return ctx->task->info.type;
+    case SWR_WORKERS_LOG_UNKNOWN_MESSAGE:
+        swoole_log_as("Server::read_worker_message",
+                      swoole_warning("unknown worker message type[%d]", ctx->task->info.type));
+        return 0;
+    case SWR_WORKERS_OP_HAS_COMMAND: {
+        ctx->handler = serv->get_command_handler(ctx->task->info.server_fd);
+        return ctx->handler != nullptr;
+    }
+    case SWR_WORKERS_LOG_UNKNOWN_COMMAND:
+        swoole_log_as("Server::read_worker_message",
+                      swoole_error_log(SW_LOG_ERROR,
+                                       SW_ERROR_SERVER_INVALID_COMMAND,
+                                       "Unknown command[command_id=%d]",
+                                       (int) ctx->task->info.server_fd));
+        return 0;
+    case SWR_WORKERS_OP_COMMAND_REPLY: {
+        const auto result = (*ctx->handler)(serv, std::string(ctx->task->data, ctx->task->info.len));
+        SendData task{};
+        task.info.fd = ctx->task->info.fd;
+        task.info.reactor_id = 0;
+        task.info.server_fd = -1;
+        task.info.type = SW_SERVER_EVENT_COMMAND_RESPONSE;
+        task.info.len = result.length();
+        task.data = result.c_str();
+        serv->message_bus.write(serv->get_command_reply_socket(), &task);
+        return 0;
+    }
+
+    case SWR_WORKERS_OP_RELOAD_THREADS:
+        return serv->reload_worker_threads(arg);
+    case SWR_WORKERS_OP_MANAGER_PID:
+        return (int64_t) serv->gs->manager_pid;
+    case SWR_WORKERS_LOG_RELOAD_SINGLE_PROCESS:
+        swoole_log_as("Server::reload",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_OPERATION_NOT_SUPPORT,
+                                       "not supported with single process mode"));
+        return 0;
+    case SWR_WORKERS_OP_POOL_RELOAD:
+        return serv->get_event_worker_pool()->reload();
+    default:
+        abort();
+    }
+}
+
+// The Server methods of the deleted worker-side files are Rust
+// (crates/process/src/workers/entry.rs); each enters here with its operation, and
+// this builds the context its C++ forward built.
+static int64_t workers_enter(uint32_t operation, void *object, void *other, uint64_t arg) {
+    switch (operation) {
+    case SWR_WORKERS_RUN_START_MANAGER:
+    case SWR_WORKERS_RUN_RELOAD:
+        return ManagerContext{static_cast<Server *>(object)}.run(operation, arg);
+    case SWR_WORKERS_RUN_RESTART_WORKER: {
+        const auto *status = static_cast<const ExitStatus *>(other);
+        return ManagerContext{static_cast<Server *>(object)}.run(
+            operation, (uint64_t) (uint32_t) status->get_pid() | ((uint64_t) (uint32_t) status->get_status() << 32));
+    }
+    case SWR_WORKERS_RUN_READ_WORKER_MESSAGE:
+        return ManagerContext{static_cast<Server *>(static_cast<ProcessPool *>(object)->ptr),
+                              nullptr,
+                              static_cast<EventData *>(other)}
+            .run(operation, arg);
+    default:
+        abort();
+    }
+}
+static const bool workers_enter_registered = (swr_v1_workers_set_enter(workers_enter), true);
+
 ProcessFactory::ProcessFactory(Server *server) : Factory(server) {}
