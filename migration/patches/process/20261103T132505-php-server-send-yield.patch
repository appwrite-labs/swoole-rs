+// Wake the coroutines send_yield parked on a session: resume them when its output drained, or
+// cancel them when it closed (each leaves the queue as it wakes).
+static void php_swoole_server_send_wake(Server *serv, SessionId session_id, bool cancel) {
+    void *waiters = swr_v1_phpserver_send_waiters(serv, session_id);
+    if (!waiters) {
+        return;
+    }
+    while (auto *co = static_cast<Coroutine *>(swr_v1_phpserver_send_next(waiters, !cancel))) {
+        if (cancel) {
+            co->cancel();
+        } else {
+            co->resume();
+        }
+    }
+    swr_v1_phpserver_send_waiters_free(waiters);
+}
