-static int port_read(Reactor *reactor, ListenPort *port, Event *event, uint32_t kind) {
-    auto *conn = static_cast<Connection *>(event->socket->object);
-    auto *serv = static_cast<Server *>(reactor->ptr);
-    PortRead context{{}, reactor, port, event, event->socket, conn, serv, kind};
-    if (kind == SWR_PORTS_ON_READ_HTTP) {
-        context.shared.websocket = conn->websocket_status >= websocket::STATUS_HANDSHAKE;
-        context.shared.upgraded = conn->http_upgrade;
-        context.shared.http2_stream = conn->http2_stream;
-        context.shared.static_handler = serv->enable_static_handler;
-    }
-#ifdef SW_LOG_TRACE_OPEN
-    context.shared.trace = 1;
-#endif
-    return swr_v1_ports_on_read(kind, &context, port_read_hot_call);
-}
