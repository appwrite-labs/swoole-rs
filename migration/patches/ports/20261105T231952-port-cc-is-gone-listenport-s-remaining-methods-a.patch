+namespace {
+// One ListenPort operation; Rust (swr_v1_ports_run) decides its steps.
+struct PortRun {
+    ListenPort *port;
+    SSLContext *target = nullptr;  // the context ssl_context_create works on
+    bool allow_empty_cert = false;
+    const std::string *name = nullptr;
+    const std::shared_ptr<SSLContext> *sni = nullptr;
+    Socket *sock = nullptr;
+    SSL *ssl = nullptr;
+    int fd = -1, type = 0, optval = 0;
+    bool started = false;
+    decltype(ListenPort::sni_contexts)::iterator entry;
+};
+}  // namespace
+
+static_assert(SSL_TLSEXT_ERR_OK == 0 && SSL_TLSEXT_ERR_NOACK == 3, "SNI verdicts crates/ports/src/lifecycle.rs returns");
+
+static uint64_t port_run_call(void *context, uint32_t op, uint64_t arg) {
+    auto &c = *static_cast<PortRun *>(context);
+    ListenPort *port = c.port;
+    switch (op) {
+    case SWR_PORTS_LC_OP_CERT_EMPTY: return c.target->cert_file.empty();
+    case SWR_PORTS_LC_OP_KEY_EMPTY: return c.target->key_file.empty();
+    case SWR_PORTS_LC_OP_LOG_REQUIRE_CERT:
+        swoole_log_as(
+            "ListenPort::ssl_context_create",
+            swoole_error_log(
+                SW_LOG_ERROR, SW_ERROR_WRONG_OPERATION, "require `ssl_cert_file` and `ssl_key_file` options"));
+        return 0;
+    case SWR_PORTS_LC_OP_SET_HTTP: c.target->http = 1; return 0;
+    case SWR_PORTS_LC_OP_SET_HTTP2: c.target->http_v2 = 1; return 0;
+    case SWR_PORTS_LC_OP_CREATE: return c.target->create();
+    case SWR_PORTS_LC_OP_WARN_CREATE:
+        swoole_log_as("ListenPort::ssl_context_create", swoole_warning("failed to create ssl content"));
+        return 0;
+    case SWR_PORTS_LC_OP_SNI_EMPLACE: port->sni_contexts.emplace(*c.name, *c.sni); return 0;
+    case SWR_PORTS_LC_OP_HAS_SNI: return port->has_sni_contexts();
+    case SWR_PORTS_LC_OP_SET_SNI_CALLBACK:
+        SSL_CTX_set_tlsext_servername_callback(port->ssl_context->get_context(), ListenPort::ssl_server_sni_callback);
+        return 0;
+    case SWR_PORTS_LC_OP_SOCKET_SSL: return c.sock->ssl_create(port->ssl_context.get(), SW_SSL_SERVER);
+    case SWR_PORTS_LC_OP_SET_CREATE_ERROR: swoole_set_last_error(SW_ERROR_SSL_CREATE_SESSION_FAILED); return 0;
+    case SWR_PORTS_LC_OP_SET_EX_DATA: return SSL_set_ex_data(c.sock->ssl, swoole_ssl_get_ex_port_index(), port);
+    case SWR_PORTS_LC_OP_WARN_EX_DATA:
+        swoole_log_as("ListenPort::ssl_create", swoole_warning("SSL_set_ex_data() failed"));
+        return 0;
+    case SWR_PORTS_LC_OP_ALLOW_EMPTY_CERT: return c.allow_empty_cert;
+    case SWR_PORTS_LC_OP_CONTEXT_NEW: port->ssl_context = std::make_shared<SSLContext>(); return 0;
+    case SWR_PORTS_LC_OP_CONTEXT_FLAG:
+        switch (arg >> 1) {
+        case SWR_PORTS_CONTEXT_PREFER_SERVER_CIPHERS: port->ssl_context->prefer_server_ciphers = arg & 1; break;
+        case SWR_PORTS_CONTEXT_SESSION_TICKETS: port->ssl_context->session_tickets = arg & 1; break;
+        case SWR_PORTS_CONTEXT_STAPLING: port->ssl_context->stapling = arg & 1; break;
+        default: port->ssl_context->stapling_verify = arg & 1; break;
+        }
+        return 0;
+    case SWR_PORTS_LC_OP_CONTEXT_CIPHERS:
+        port->ssl_context->ciphers = SW_SSL_CIPHER_LIST;
+        port->ssl_context->ecdh_curve = SW_SSL_ECDH_CURVE;
+        return 0;
+    case SWR_PORTS_LC_OP_DTLS_SUPPORTED:
+#ifdef SW_SUPPORT_DTLS
+        return 1;
+#else
+        return 0;
+#endif
+    case SWR_PORTS_LC_OP_CONTEXT_DTLS:
+#ifdef SW_SUPPORT_DTLS
+        port->ssl_context->protocols = SW_SSL_DTLS;
+        port->dtls_sessions = new std::unordered_map<int, dtls::Session *>;
+#endif
+        return 0;
+    case SWR_PORTS_LC_OP_WARN_NO_DTLS:
+        swoole_log_as("ListenPort::ssl_context_init", swoole_warning("DTLS support require openssl-1.1 or later"));
+        return 0;
+    case SWR_PORTS_LC_OP_SERVER_NAME:
+        return reinterpret_cast<uintptr_t>(SSL_get_servername(c.ssl, TLSEXT_NAMETYPE_host_name));
+    case SWR_PORTS_LC_OP_SSL_PORT:
+        c.port = static_cast<ListenPort *>(SSL_get_ex_data(c.ssl, swoole_ssl_get_ex_port_index()));
+        return 0;
+    case SWR_PORTS_LC_OP_SNI_EMPTY: return port->sni_contexts.empty();
+    case SWR_PORTS_LC_OP_SNI_NEXT:
+        if (c.started) {
+            ++c.entry;
+        } else {
+            c.entry = port->sni_contexts.begin();
+            c.started = true;
+        }
+        return c.entry == port->sni_contexts.end() ? 0 : reinterpret_cast<uintptr_t>(c.entry->first.c_str());
+    case SWR_PORTS_LC_OP_SNI_SELECT: SSL_set_SSL_CTX(c.ssl, c.entry->second->get_context()); return 0;
+    case SWR_PORTS_LC_OP_SOCKET_NEW:
+        c.sock = port->socket = new Socket();
+        c.sock->fd = c.fd;
+        return 0;
+    case SWR_PORTS_LC_OP_GET_TYPE: return c.sock->get_option(SOL_SOCKET, SO_TYPE, &c.type);
+    case SWR_PORTS_LC_OP_GET_NAME: return c.sock->get_name();
+    case SWR_PORTS_LC_OP_GET_ACCEPTCONN: return c.sock->get_option(SOL_SOCKET, SO_ACCEPTCONN, &c.optval);
+    case SWR_PORTS_LC_OP_ACCEPTCONN: return c.optval;
+    case SWR_PORTS_LC_OP_WARN_IMPORT:
+        switch (arg) {
+        case SWR_PORTS_IMPORT_TYPE:
+            swoole_log_as("ListenPort::import", swoole_sys_warning("getsockopt(%d, SOL_SOCKET, SO_TYPE) failed", c.fd));
+            break;
+        case SWR_PORTS_IMPORT_NAME:
+            swoole_log_as("ListenPort::import", swoole_sys_warning("getsockname(%d) failed", c.fd));
+            break;
+        case SWR_PORTS_IMPORT_ACCEPTCONN:
+            swoole_log_as("ListenPort::import",
+                          swoole_sys_warning("getsockopt(%d, SOL_SOCKET, SO_ACCEPTCONN) failed", c.fd));
+            break;
+        default:
+            swoole_log_as("ListenPort::import",
+                          swoole_error_log(SW_LOG_WARNING, EINVAL, "the socket[%d] is not a listening socket", c.fd));
+            break;
+        }
+        return 0;
+    case SWR_PORTS_LC_OP_SOCKET_FAIL:
+        c.sock->move_fd();
+        delete c.sock;
+        return 0;
+    case SWR_PORTS_LC_OP_ADOPT: {
+        Socket *socket = port->socket = c.sock;
+        socket->socket_type = socket->info.type = port->type =
+            Socket::convert_to_type(socket->info.addr.ss.sa_family, c.type);
+        port->host = socket->info.get_addr();
+        port->port = socket->info.get_port();
+        port->listening = true;
+        socket->fd_type = socket->is_dgram() ? SW_FD_DGRAM_SERVER : SW_FD_STREAM_SERVER;
+        socket->removed = 1;
+        return 0;
+    }
+    case SWR_PORTS_LC_OP_HAS_CONTEXT: return port->ssl_context != nullptr;
+    case SWR_PORTS_LC_OP_RESET_CONTEXT: port->ssl_context.reset(); return 0;
+    case SWR_PORTS_LC_OP_DELETE_DTLS:
+#ifdef SW_SUPPORT_DTLS
+        delete port->dtls_sessions;
+#endif
+        return 0;
+    case SWR_PORTS_LC_OP_FREE_SOCKET:
+        port->socket->free();
+        port->socket = nullptr;
+        return 0;
+    case SWR_PORTS_LC_OP_UNLINK: unlink(port->host.c_str()); return 0;
+    default: abort();
+    }
+}
+
+static int port_run(PortRun &&context, uint32_t kind) {
+    return swr_v1_ports_run_state(kind, &context, port_run_call, context.port ? context.port->config_handle() : nullptr);
+}
+
+bool ListenPort::ssl_add_sni_cert(const std::string &name, const std::shared_ptr<SSLContext> &ctx) {
+    PortRun run{this, ctx.get()};
+    run.name = &name;
+    run.sni = &ctx;
+    return port_run(std::move(run), SWR_PORTS_RUN_SNI_ADD);
+}
+
+#ifdef SW_SUPPORT_DTLS
+dtls::Session *ListenPort::create_dtls_session(Socket *sock) const {
+    auto *session = new dtls::Session(sock, ssl_context);
+    if (!session->init()) {
+        delete session;
+        return nullptr;
+    }
+    dtls_sessions->emplace(sock->get_fd(), session);
+    return session;
+}
+#endif
+
+bool ListenPort::ssl_init() const {
+    return port_run(PortRun{const_cast<ListenPort *>(this), ssl_context.get()}, SWR_PORTS_RUN_SSL_INIT);
+}
+
+int ListenPort::listen() {
+    constexpr uint32_t capabilities = 0
+#ifdef TCP_DEFER_ACCEPT
+        | 1
+#endif
+#ifdef SO_ACCEPTFILTER
+        | 2
+#endif
+#ifdef TCP_FASTOPEN
+        | 4
+#endif
+#ifdef SO_KEEPALIVE
+        | 8
+#endif
+#ifdef TCP_KEEPIDLE
+        | 16
+#endif
+#ifdef TCP_USER_TIMEOUT
+        | 32
+#endif
+        ;
+    SwrPortsListenState state{};
+    int result = 0;
+    while (true) {
+        SwrPortsListenInput input{capabilities, listening, open_tcp_keepalive, buffer_high_watermark,
+            tcp_defer_accept, tcp_fastopen, tcp_keepidle, tcp_keepinterval, tcp_keepcount, tcp_user_timeout, result};
+        auto action = swr_v1_ports_listen_step(&state, &input);
+#define PORTS_OPTION(KIND, LEVEL, OPTION, CMP) \
+        case KIND: \
+            if (socket->set_option(LEVEL, OPTION, action.value) CMP 0) { \
+                swoole_sys_warning("setsockopt(" #OPTION ") failed"); \
+            } \
+            break
+        switch (action.kind) {
+        case 0: return action.status;
+        case 1:
+            result = socket->listen(backlog);
+            if (result < 0) { swoole_sys_warning("listen(%s:%d, %d) failed", host.c_str(), port, backlog); }
+            break;
+        case 2: listening = true; break;
+#ifdef TCP_DEFER_ACCEPT
+        PORTS_OPTION(3, IPPROTO_TCP, TCP_DEFER_ACCEPT, !=);
+#endif
+#ifdef SO_ACCEPTFILTER
+        case 4: {
+            struct accept_filter_arg a;
+            memset(&a, 0, sizeof(a));
+            strcpy(a.af_name, "httpready");
+            if (socket->set_option(SOL_SOCKET, SO_ACCEPTFILTER, &a, sizeof(a)) != 0) {
+                swoole_sys_warning("setsockopt(SO_ACCEPTFILTER) failed");
+            }
+            break;
+        }
+#endif
+#ifdef TCP_FASTOPEN
+        PORTS_OPTION(5, IPPROTO_TCP, TCP_FASTOPEN, !=);
+#endif
+#ifdef SO_KEEPALIVE
+        PORTS_OPTION(6, SOL_SOCKET, SO_KEEPALIVE, !=);
+#ifdef TCP_KEEPIDLE
+        PORTS_OPTION(7, IPPROTO_TCP, TCP_KEEPIDLE, <);
+        PORTS_OPTION(8, IPPROTO_TCP, TCP_KEEPINTVL, <);
+        PORTS_OPTION(9, IPPROTO_TCP, TCP_KEEPCNT, <);
+#endif
+#ifdef TCP_USER_TIMEOUT
+        PORTS_OPTION(10, IPPROTO_TCP, TCP_USER_TIMEOUT, !=);
+#endif
+#endif
+        case 11: buffer_high_watermark = socket_buffer_size * 0.8; break;
+        default: return SW_ERR;
+        }
+#undef PORTS_OPTION
+    }
+}
+
+void ListenPort::init_protocol() {
+    const bool datagram = is_dgram();
+    const uint32_t flags = port_protocol_flags(*this) | (datagram ? SWR_PORTS_DGRAM : 0) |
+                           (datagram && is_dtls() ? SWR_PORTS_DTLS : 0);
+    const auto plan = swr_v1_ports_protocol_plan({flags, (uint8_t) protocol.package_length_type,
+        protocol.package_eof_len, SW_DATA_EOF_MAXLEN, SW_HTTP2_FRAME_HEADER_SIZE,
+        SW_WEBSOCKET_FRAME_HEADER_SIZE, SW_MQTT_MAX_LENGTH_SIZE});
+    using Reader = int (*)(Reactor *, ListenPort *, Event *);
+    static constexpr Reader readers[] = {nullptr, readable_callback_eof, readable_callback_length,
+        readable_callback_http, readable_callback_redis, readable_callback_raw};
+    using Package = int (*)(const Protocol *, Socket *, const RecvData *);
+    static constexpr Package packages[] = {nullptr, Server::dispatch_task,
+        http_server::dispatch_frame, websocket::dispatch_frame};
+    static constexpr Protocol::LengthFunc lengths[] = {nullptr, Protocol::default_length_func,
+        http_server::get_package_length, http2::get_frame_length, websocket::get_package_length, mqtt::get_package_length};
+    for (uint32_t i = 0; i < plan.count; i++) {
+        const auto action = plan.actions[i];
+        switch (action.kind) {
+        case SWR_PORTS_SET_EOF_LEN: protocol.package_eof_len = action.value; break;
+        case SWR_PORTS_SET_READ: onRead = readers[action.value]; break;
+        case SWR_PORTS_SET_PACKAGE: protocol.onPackage = packages[action.value]; break;
+        case SWR_PORTS_SET_LENGTH_FN: protocol.get_package_length = lengths[action.value]; break;
+        case SWR_PORTS_SET_LENGTH_SIZE_FN: protocol.get_package_length_size = http_server::get_package_length_size; break;
+        case SWR_PORTS_SET_LENGTH_SIZE: protocol.package_length_size = action.value; break;
+        case SWR_PORTS_SET_LENGTH_OFFSET: protocol.package_length_offset = action.value; break;
+        case SWR_PORTS_SET_BODY_OFFSET: protocol.package_body_offset = action.value; break;
+        }
+    }
+}
+
+void ListenPort::set_eof_protocol(const std::string &eof, bool find_from_right) {
+    static_assert(sizeof(protocol.package_eof) <= UINT8_MAX, "ports EOF length field");
+    auto settings = swr_v1_ports_framing_settings({SWR_PORTS_EOF_SETTINGS, find_from_right,
+        eof.length(), sizeof(protocol.package_eof), 0, 0, 0, 0});
+    open_eof_check = settings.enabled;
+    protocol.split_by_eof = settings.split;
+    protocol.package_eof_len = settings.length;
+    memcpy(protocol.package_eof, eof.c_str(), protocol.package_eof_len);
+}
+
+void ListenPort::set_length_protocol(uint32_t length_offset, char length_type, uint32_t body_offset) {
+    static_assert(std::is_same<decltype(protocol.package_length_size), uint8_t>::value &&
+                  std::is_same<decltype(protocol.package_length_offset), uint16_t>::value &&
+                  std::is_same<decltype(protocol.package_body_offset), uint16_t>::value, "ports length fields");
+    auto settings = swr_v1_ports_framing_settings({SWR_PORTS_LENGTH_SETTINGS, 0, 0, 0,
+        static_cast<uint8_t>(length_type), swoole_type_size(length_type), length_offset, body_offset});
+    open_length_check = settings.enabled;
+    protocol.package_length_type = static_cast<char>(settings.length_type);
+    protocol.package_length_size = settings.length_size;
+    protocol.package_length_offset = settings.length_offset;
+    protocol.package_body_offset = settings.body_offset;
+}
+
+void ListenPort::set_stream_protocol() {
+    auto settings = swr_v1_ports_stream_settings();
+    open_length_check = settings.enabled;
+    protocol.get_package_length = Protocol::default_length_func;
+    protocol.package_length_type = static_cast<char>(settings.length_type);
+    protocol.package_length_size = settings.length_size;
+    protocol.package_body_offset = settings.body_offset;
+    protocol.package_length_offset = settings.length_offset;
+}
+
+void ListenPort::clear_protocol() {
+    open_eof_check = false;
+    open_length_check = false;
+    open_http_protocol = false;
+    open_websocket_protocol = false;
+    open_http2_protocol = false;
+    open_mqtt_protocol = false;
+    open_redis_protocol = false;
+}
