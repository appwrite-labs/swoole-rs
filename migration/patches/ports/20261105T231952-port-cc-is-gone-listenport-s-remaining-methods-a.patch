+#define CLIENT_INFO_FMT " from session#%ld on %s:%d"
+#define CLIENT_INFO_ARGS c.conn->session_id, c.port->host.c_str(), c.port->port
+
+namespace {
+// One readable event; Rust (swr_v1_ports_on_read) runs the callback over it, reading
+// and writing the current buffer and request (crates/http/src/request.rs) in place
+// through `shared`.
+struct PortRead {
+    SwrPortsShared shared;
+    Reactor *reactor;
+    ListenPort *port;
+    Event *event;
+    Socket *socket;
+    Connection *conn;
+    Server *serv;
+    uint32_t kind;
+    String *buffer() const {
+        return reinterpret_cast<String *>(shared.buffer);
+    }
+    void set_buffer(String *buffer) {
+        shared.buffer = reinterpret_cast<SwrPortsString *>(buffer);
+    }
+    void set_request(void *request) {
+        shared.request = request;
+    }
+};
+}  // namespace
+
+static_assert(std::is_standard_layout<String>::value && sizeof(size_t) == 8 && sizeof(off_t) == 8 &&
+                  offsetof(String, length) == offsetof(SwrPortsString, length) &&
+                  offsetof(String, size) == offsetof(SwrPortsString, size) &&
+                  offsetof(String, offset) == offsetof(SwrPortsString, offset) &&
+                  offsetof(String, str) == offsetof(SwrPortsString, str),
+              "SwrPortsString is swoole::String's head");
+static_assert(offsetof(PortRead, shared) == 0, "the context starts with SwrPortsShared");
+
+static_assert(SW_HTTP_PRI == 27 && SW_HTTP_HEADER_MAX_SIZE == 65536 && sizeof(SW_HTTP2_PRI_STRING) - 1 == 24 &&
+                  sizeof(SW_HTTP_CHUNK_EOF) - 1 == 5 && SW_BUFFER_SIZE_BIG == 65536 && SW_CLOSE == 3 && SW_ERROR == 4,
+              "constants crates/ports/src/read.rs decides with");
+
+static uint64_t port_read_call(void *context, uint32_t op, uint64_t arg) {
+    auto &c = *static_cast<PortRead *>(context);
+    auto *request = static_cast<http_server::Request *>(c.conn->object);
+    String *buffer = c.buffer();
+    switch (op) {
+    case SWR_PORTS_OP_CATCH: return c.socket->catch_read_error(errno);
+    case SWR_PORTS_OP_WARN_RECV:
+        if (c.kind == SWR_PORTS_ON_READ_HTTP) {
+            swoole_log_as("ListenPort::readable_callback_http",
+                          swoole_sys_warning("recv from connection#%d failed", c.event->fd));
+        } else {
+            swoole_log_as("ListenPort::readable_callback_raw",
+                          swoole_sys_warning("recv from connection#%d failed", c.event->fd));
+        }
+        return 0;
+    case SWR_PORTS_OP_CLOSE_ERRNO: c.conn->close_errno = errno; return 0;
+    case SWR_PORTS_OP_CLOSE: c.reactor->trigger_close_event(c.event); return 0;
+    case SWR_PORTS_OP_SEND:
+        switch (arg) {
+        case SWR_PORTS_SEND_BAD_REQUEST: return c.socket->send(SW_STRL(SW_HTTP_BAD_REQUEST_PACKET), 0);
+        case SWR_PORTS_SEND_TOO_LARGE: return c.socket->send(SW_STRL(SW_HTTP_REQUEST_ENTITY_TOO_LARGE_PACKET), 0);
+        case SWR_PORTS_SEND_UNAVAILABLE: return c.socket->send(SW_STRL(SW_HTTP_SERVICE_UNAVAILABLE_PACKET), 0);
+        default: return c.socket->send(SW_STRL(SW_HTTP_100_CONTINUE_PACKET), 0);
+        }
+    case SWR_PORTS_OP_RECV_EOF: return c.port->protocol.recv_with_eof_protocol(c.socket, buffer);
+    case SWR_PORTS_OP_RECV_REDIS: return redis::recv_packet(&c.port->protocol, c.conn, buffer);
+    case SWR_PORTS_OP_DISPATCH_TASK:
+    case SWR_PORTS_OP_DISPATCH_REQUEST: {
+        RecvData data{};
+        data.info.len = arg;
+        data.data = buffer->str;
+        if (op == SWR_PORTS_OP_DISPATCH_TASK) {
+            return Server::dispatch_task(&c.port->protocol, c.socket, &data);
+        }
+        int retval = http_server::dispatch_request(c.serv, &c.port->protocol, c.socket, &data);
+        c.set_request(c.conn->object);
+        return retval;
+    }
+    case SWR_PORTS_OP_WEBSOCKET_ACTIVATE:
+        c.conn->websocket_status = websocket::STATUS_ACTIVE;
+        c.conn->http_upgrade = 1;
+        return 0;
+    case SWR_PORTS_OP_HTTP2_ENABLED: return c.port->open_http2_protocol;
+    case SWR_PORTS_OP_HTTP2_START:
+        c.conn->http2_stream = 1;
+        http2::send_setting_frame(&c.port->protocol, c.socket);
+        return 0;
+    case SWR_PORTS_OP_SKIP_RECV: c.conn->socket->skip_recv = 1; return 0;
+    case SWR_PORTS_OP_UPLOADS: return c.serv->upload_max_filesize > 0;
+    case SWR_PORTS_OP_STATIC: return c.serv->select_static_handler(request, c.conn);
+    case SWR_PORTS_OP_BUF_REDUCE: buffer->reduce(arg); return 0;
+    case SWR_PORTS_OP_BUF_EXTEND: buffer->extend(arg); return 0;
+    case SWR_PORTS_OP_BUF_HEADER_END: return memmem(buffer->str, buffer->length, SW_STRL("\r\n\r\n")) != nullptr;
+    case SWR_PORTS_OP_REQ_MULTIPART_INIT:
+        request->init_multipart_parser(c.serv);
+        c.set_buffer(request->buffer_);
+        return 0;
+    case SWR_PORTS_LOG_UNKNOWN_PROTOCOL:
+        swoole_log_as("ListenPort::readable_callback_http",
+                      swoole_error_log(SW_LOG_TRACE,
+                                       SW_ERROR_HTTP_INVALID_PROTOCOL,
+                                       "Bad Request: unknown protocol" CLIENT_INFO_FMT,
+                                       CLIENT_INFO_ARGS));
+        return 0;
+    case SWR_PORTS_LOG_UNKNOWN_METHOD:
+        swoole_log_as("ListenPort::readable_callback_http",
+                      swoole_error_log(SW_LOG_TRACE,
+                                       SW_ERROR_HTTP_INVALID_PROTOCOL,
+                                       "Bad Request: unknown HTTP method" CLIENT_INFO_FMT,
+                                       CLIENT_INFO_ARGS));
+        return 0;
+    case SWR_PORTS_LOG_NO_HTTP2:
+        swoole_log_as("ListenPort::readable_callback_http",
+                      swoole_error_log(SW_LOG_TRACE,
+                                       SW_ERROR_HTTP_INVALID_PROTOCOL,
+                                       "Bad Request: can not handle HTTP2 request" CLIENT_INFO_FMT,
+                                       CLIENT_INFO_ARGS));
+        return 0;
+    case SWR_PORTS_LOG_HEADER_TOO_LARGE:
+        swoole_log_as("ListenPort::readable_callback_http",
+                      swoole_error_log(SW_LOG_TRACE,
+                                       SW_ERROR_HTTP_INVALID_PROTOCOL,
+                                       "Bad Request: request header size is too large" CLIENT_INFO_FMT,
+                                       CLIENT_INFO_ARGS));
+        return 0;
+    case SWR_PORTS_LOG_CHUNKED_ERROR:
+        swoole_log_as("ListenPort::readable_callback_http",
+                      swoole_error_log(SW_LOG_TRACE,
+                                       SW_ERROR_HTTP_INVALID_PROTOCOL,
+                                       "Bad Request: protocol error when parse chunked length" CLIENT_INFO_FMT,
+                                       CLIENT_INFO_ARGS));
+        return 0;
+    case SWR_PORTS_LOG_CHUNKED_TOO_LARGE:
+        swoole_log_as(
+            "ListenPort::readable_callback_http",
+            swoole_error_log(SW_LOG_WARNING,
+                             SW_ERROR_HTTP_INVALID_PROTOCOL,
+                             "Request Entity Too Large: request length (chunked) has already been greater than the "
+                             "package_max_length(%u)" CLIENT_INFO_FMT,
+                             c.port->protocol.package_max_length,
+                             CLIENT_INFO_ARGS));
+        return 0;
+    case SWR_PORTS_LOG_TOO_LARGE:
+        swoole_log_as("ListenPort::readable_callback_http",
+                      swoole_error_log(SW_LOG_WARNING,
+                                       SW_ERROR_HTTP_INVALID_PROTOCOL,
+                                       "Request Entity Too Large: header-length (%u) + content-length (%" PRIu64
+                                       ") is greater than the package_max_length(%u)" CLIENT_INFO_FMT,
+                                       request->header_length_,
+                                       request->content_length_,
+                                       c.port->protocol.package_max_length,
+                                       CLIENT_INFO_ARGS));
+        return 0;
+    case SWR_PORTS_LOG_DISCARD:
+        swoole_log_as("ListenPort::readable_callback_http",
+                      swoole_error_log(SW_LOG_TRACE,
+                                       SW_ERROR_HTTP_INVALID_PROTOCOL,
+                                       "Invalid Request: %zu bytes has been discard" CLIENT_INFO_FMT,
+                                       (size_t) arg,
+                                       CLIENT_INFO_ARGS));
+        return 0;
+    case SWR_PORTS_TRACE_HEADER:
+        swoole_log_as("ListenPort::readable_callback_http",
+                      swoole_trace_log(SW_TRACE_SERVER,
+                                       "content-length=%" PRIu64 ", keep-alive=%u, chunked=%u",
+                                       request->content_length_,
+                                       request->keep_alive,
+                                       request->chunked));
+        return 0;
+    case SWR_PORTS_TRACE_CHUNKED:
+        swoole_log_as(
+            "ListenPort::readable_callback_http",
+            swoole_trace_log(
+                SW_TRACE_SERVER, "received chunked eof, real content-length=%" PRIu64, request->content_length_));
+        return 0;
+    case SWR_PORTS_TRACE_POST_WAIT:
+        swoole_log_as("ListenPort::readable_callback_http",
+                      swoole_trace_log(SW_TRACE_SERVER,
+                                       "PostWait: request->content_length=%" PRIu64
+                                       ", buffer->length=%zu, request->header_length=%d\n",
+                                       request->content_length_,
+                                       buffer->length,
+                                       request->header_length_));
+        return 0;
+    case SWR_PORTS_TRACE_CLOSE:
+        swoole_log_as("ListenPort::readable_callback_length",
+                      swoole_trace("Close Event.FD=%d|From=%d", c.event->fd, c.event->reactor_id));
+        return 0;
+    default: abort();
+    }
+}
+
+// The ops each read makes, in a small frame of their own: the rest of
+// port_read_call needs a large, stack-protected one.
+static uint64_t port_read_hot_call(void *context, uint32_t op, uint64_t arg) {
+    auto &c = *static_cast<PortRead *>(context);
+    auto *request = static_cast<http_server::Request *>(c.conn->object);
+    String *buffer = c.buffer();
+    switch (op) {
+    case SWR_PORTS_OP_RECV:
+        return arg ? c.socket->recv(buffer->str, buffer->size, 0)
+                   : c.socket->recv(buffer->str + buffer->length, buffer->size - buffer->length, 0);
+    case SWR_PORTS_OP_RECV_BUFFER:
+        c.set_buffer(c.serv->get_recv_buffer(c.socket));
+        return c.buffer() != nullptr;
+    case SWR_PORTS_OP_RELEASE:
+        if (c.socket->recv_buffer && (!arg || c.socket->recv_buffer->length == 0) &&
+            c.socket->recv_buffer->size > SW_BUFFER_SIZE_BIG * 2) {
+            delete c.socket->recv_buffer;
+            c.socket->recv_buffer = nullptr;
+            return 1;
+        }
+        return 0;
+    case SWR_PORTS_OP_RECV_LENGTH: return c.port->protocol.recv_with_length_protocol(c.socket, buffer);
+    case SWR_PORTS_OP_ACTIVE: return c.conn->active && !c.socket->removed;
+    case SWR_PORTS_OP_MAX_LENGTH: return c.port->protocol.package_max_length;
+    case SWR_PORTS_OP_REQ_INIT:
+        if (!request) {
+            c.conn->object = request = new http_server::Request();
+        }
+        if (!request->buffer_) {
+            request->buffer_ = c.serv->get_recv_buffer(c.socket);
+        }
+        c.set_buffer(request->buffer_);
+        c.set_request(request);
+        return 0;
+    case SWR_PORTS_OP_REQ_DESTROY:
+        c.port->destroy_http_request(c.conn);
+        c.set_request(nullptr);
+        return 0;
+    default: return port_read_call(context, op, arg);
+    }
+}
+
+static int port_read(Reactor *reactor, ListenPort *port, Event *event, uint32_t kind) {
+    auto *conn = static_cast<Connection *>(event->socket->object);
+    auto *serv = static_cast<Server *>(reactor->ptr);
+    PortRead context{{}, reactor, port, event, event->socket, conn, serv, kind};
+    if (kind == SWR_PORTS_ON_READ_HTTP) {
+        context.shared.websocket = conn->websocket_status >= websocket::STATUS_HANDSHAKE;
+        context.shared.upgraded = conn->http_upgrade;
+        context.shared.http2_stream = conn->http2_stream;
+        context.shared.static_handler = serv->enable_static_handler;
+    }
+#ifdef SW_LOG_TRACE_OPEN
+    context.shared.trace = 1;
+#endif
+    return swr_v1_ports_on_read(kind, &context, port_read_hot_call);
+}
+
+// The ListenPort methods crates/ports/src/methods.rs defines run through these.
+[[maybe_unused]] static const bool port_native_set = (swr_v1_ports_set_native(
+    [](uint32_t kind, void *port, void *target, void *sock, void *ssl, int number) {
+        PortRun run{static_cast<ListenPort *>(port), static_cast<SSLContext *>(target)};
+        run.sock = static_cast<Socket *>(sock);
+        run.ssl = static_cast<SSL *>(ssl);
+        run.fd = number;
+        run.allow_empty_cert = number;
+        return port_run(std::move(run), kind);
+    },
+    [](void *reactor, void *port, void *event, uint32_t kind) {
+        return port_read(static_cast<Reactor *>(reactor), static_cast<ListenPort *>(port), static_cast<Event *>(event), kind);
+    }), true);
+
+const char *ListenPort::get_protocols() const {
+    return swr_v1_ports_protocol_name(port_protocol_flags(*this) | (is_dgram() ? SWR_PORTS_DGRAM : 0));
+}
+
+size_t ListenPort::get_connection_num() const {
+    return swr_v1_server_port_connections(gs, gs->connection_nums ? sw_server()->worker_num : 0);
+}
+
+int ListenPort::create_socket() {
+    auto *server = static_cast<Server *>(protocol.private_data_2);
+    // Address has no construction/destruction effects; storage may precede the decisions.
+    static_assert(std::is_trivial<Address>::value, "ports Address lifetime boundary");
+    Address addr;
+    constexpr uint32_t capabilities = 0
+#if defined(__linux__) && defined(HAVE_REUSEPORT)
+        | 1
+#endif
+#if defined(SW_SUPPORT_DTLS) && defined(HAVE_KQUEUE)
+        | 2
+#endif
+        ;
+    SwrPortsSocketState state{};
+    int result = 0;
+    while (true) {
+        SwrPortsSocketInput input{capabilities, socket != nullptr, result};
+        auto action = swr_v1_ports_socket_step(&state, &input);
+        switch (action.kind) {
+        case 0: return action.status;
+#if defined(__linux__) && defined(HAVE_REUSEPORT)
+        case 1: result = server->enable_reuse_port; break;
+#endif
+        case 2: close_socket(); break;
+        case 3:
+            socket = make_socket(type, is_dgram() ? SW_FD_DGRAM_SERVER : SW_FD_STREAM_SERVER,
+                                 SW_SOCK_CLOEXEC | SW_SOCK_NONBLOCK);
+            break;
+        case 4: swoole_set_last_error(errno); return SW_ERR;
+#if defined(SW_SUPPORT_DTLS) && defined(HAVE_KQUEUE)
+        case 5: result = is_dtls(); break;
+        case 6: socket->set_reuse_port(); break;
+#endif
+#if defined(__linux__) && defined(HAVE_REUSEPORT)
+        case 7: result = socket->set_reuse_port(); break;
+#endif
+        case 8: swoole_set_last_error(errno); socket->free(); return SW_ERR;
+        case 9: result = addr.assign(type, host, port, true); break;
+        case 10: {
+            auto type_str = Address::type_str(type);
+            swoole_warning("Invalid %s address '%s:%d'", type_str, host.c_str(), port);
+            break;
+        }
+        case 11:
+            if (socket->set_reuse_addr() < 0) { swoole_sys_warning("setsockopt(%d, SO_REUSEADDR) failed", socket->get_fd()); }
+            break;
+        case 12: result = socket->bind(addr); break;
+        case 13: result = socket->get_name(); break;
+        case 14: port = socket->get_port(); break;
+        default: return SW_ERR;
+        }
+    }
+}
+
+void ListenPort::close_socket() {
+    if (::close(socket->fd) < 0) {
+        swoole_sys_warning("close(%d) failed", socket->fd);
+    }
+    delete socket;
+    socket = nullptr;
+}
+
+void ListenPort::destroy_http_request(Connection *conn) {
+    const auto request = static_cast<http_server::Request *>(conn->object);
+    if (!request) {
+        return;
+    }
+    delete request;
+    conn->object = nullptr;
+}
+
