-        }
-    }
-    if (cb && swr_v1_phpserver_on_connection(serv, cb, true, session_id, info->reactor_id, info->time)) {
-        zend_bailout();
-    }
-    if (conn->http2_stream) {
-        php_swoole_http2_server_onClose(serv, conn->session_id);
-    }
-}
