+// Swoole\Redis\Server (crates/phpredis): its receive hook and what it asks of the Server and Zend.
+static int php_swoole_redis_server_onReceive(Server *serv, RecvData *req) {
+    auto fd = req->info.fd;
+    Connection *conn = serv->get_connection_by_session_id(fd);
+    if (!conn) {
+        swoole_warning("connection[%ld] is closed", fd);
+        return SW_ERR;
+    }
+    // other server port
+    if (!serv->get_port_by_fd(conn->fd)->open_redis_protocol) {
+        return php_swoole_server_onReceive(serv, req);
+    }
+    // The handler runs in swr_redis_host_call, inside zend_try; a bailout is re-raised here.
+    int result = swr_v1_phpredis_receive(serv, req);
+    if (result == SWR_PHPREDIS_BAILED) {
+        zend_bailout();
+    }
+    return result;
+}
