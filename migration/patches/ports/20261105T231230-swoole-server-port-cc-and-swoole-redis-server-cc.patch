+// Swoole\Server\Port (crates/phpserver, port.rs): the ListenPort settings and the hooks its callbacks install.
+static void port_apply_number(ListenPort *port, uint32_t field, int64_t value) {
+    switch (field) {
+    case SWR_PORTS_NUMBER_BACKLOG: port->backlog = value; break;
+    case SWR_PORTS_NUMBER_SOCKET_BUFFER: port->socket_buffer_size = value; break;
+    case SWR_PORTS_NUMBER_KERNEL_RECV: port->kernel_socket_recv_buffer_size = value; break;
+    case SWR_PORTS_NUMBER_KERNEL_SEND: port->kernel_socket_send_buffer_size = value; break;
+    case SWR_PORTS_NUMBER_HEARTBEAT: port->heartbeat_idle_time = value; break;
+    case SWR_PORTS_NUMBER_HIGH_WATERMARK: port->buffer_high_watermark = value; break;
+    case SWR_PORTS_NUMBER_LOW_WATERMARK: port->buffer_low_watermark = value; break;
+    case SWR_PORTS_NUMBER_DEFER_ACCEPT: port->tcp_defer_accept = value; break;
+    case SWR_PORTS_NUMBER_KEEP_IDLE: port->tcp_keepidle = value; break;
+    case SWR_PORTS_NUMBER_KEEP_INTERVAL: port->tcp_keepinterval = value; break;
+    case SWR_PORTS_NUMBER_KEEP_COUNT: port->tcp_keepcount = value; break;
+    case SWR_PORTS_NUMBER_USER_TIMEOUT: port->tcp_user_timeout = value; break;
+    case SWR_PORTS_NUMBER_MAX_LENGTH: port->protocol.package_max_length = value; break;
+    default: assert(false);
+    }
+}
+static void port_apply_flags(ListenPort *port, SwrPortsProtocolPlan plan) {
+    assert(plan.count <= 2);
+    for (uint32_t n = 0; n < plan.count; n++) {
+        switch (plan.actions[n].kind) {
+        case SWR_PORTS_SET_NODELAY: port->open_tcp_nodelay = plan.actions[n].value; break;
+        case SWR_PORTS_SET_KEEPALIVE: port->open_tcp_keepalive = plan.actions[n].value; break;
+        case SWR_PORTS_SET_CHECK_EOF: port->open_eof_check = plan.actions[n].value; break;
+        case SWR_PORTS_SET_SPLIT_EOF: port->protocol.split_by_eof = plan.actions[n].value; break;
+        case SWR_PORTS_SET_HTTP_FLAG: port->open_http_protocol = plan.actions[n].value; break;
+        case SWR_PORTS_SET_WEBSOCKET_FLAG: port->open_websocket_protocol = plan.actions[n].value; break;
+        case SWR_PORTS_SET_HTTP2_FLAG: port->open_http2_protocol = plan.actions[n].value; break;
+        case SWR_PORTS_SET_MQTT_FLAG: port->open_mqtt_protocol = plan.actions[n].value; break;
+        case SWR_PORTS_SET_REDIS_FLAG: port->open_redis_protocol = plan.actions[n].value; break;
+        case SWR_PORTS_SET_FASTOPEN: port->tcp_fastopen = plan.actions[n].value; break;
+        case SWR_PORTS_SET_CHECK_LENGTH: port->open_length_check = plan.actions[n].value; break;
+        default: assert(false);
+        }
+    }
+}
+static_assert(sizeof(zend_long) == 8, "ports PHP integer ABI");
+static_assert(SW_SERVER_CB_onConnect == 0 && SW_SERVER_CB_onReceive == 1 && SW_SERVER_CB_onClose == 2 &&
+              SW_SERVER_CB_onPacket == 3 && SW_SERVER_CB_onRequest == 4 && SW_SERVER_CB_onHandshake == 5 &&
+              SW_SERVER_CB_onBeforeHandshakeResponse == 6 && SW_SERVER_CB_onOpen == 7 &&
+              SW_SERVER_CB_onMessage == 8 && SW_SERVER_CB_onDisconnect == 9 &&
+              SW_SERVER_CB_onBufferFull == 10 && SW_SERVER_CB_onBufferEmpty == 11, "ports callback ABI");
+
+static ssize_t php_swoole_server_length_func(const Protocol *protocol, network::Socket *conn, PacketLength *pl) {
+    auto *cb = static_cast<zend::Callable *>(protocol->private_data_1);
+    zval zdata;
+    zval retval;
+    ssize_t ret = -1;
+
+    ZVAL_STRINGL(&zdata, pl->buf, pl->buf_size);
+    HOOK_PHP_CALL_STACK(auto call_result = sw_zend_call_function_ex(nullptr, cb->ptr(), 1, &zdata, &retval););
+    if (UNEXPECTED(call_result) != SUCCESS) {
+        php_swoole_fatal_error(E_WARNING, "length function handler error");
+    } else {
+        ret = zval_get_long(&retval);
+        zval_ptr_dtor(&retval);
+    }
+    zval_ptr_dtor(&zdata);
+
+    /* the exception should only be thrown after unlocked */
+    if (UNEXPECTED(EG(exception))) {
+        zend_exception_error(EG(exception), E_ERROR);
+    }
+
+    return ret;
+}
+
+static bool php_swoole_server_set_ssl_option(zend_array *vht, SSLContext *ctx) {
+    zval *ztmp;
+    for (size_t index = 0;; index++) {
+        auto option = swr_v1_ports_tls_option(SWR_PORTS_TLS_CONTEXT_FILES, index);
+        if (option.action == SWR_PORTS_OPTION_END) break;
+        ztmp = zend_hash_str_find(vht, (const char *) option.key.data, option.key.len);
+        if (!ztmp || ZVAL_IS_NULL(ztmp)) continue;
+        zend::String str_v(ztmp);
+        switch (option.target) {
+        case SWR_PORTS_TLS_CERT_FILE:
+            if (!ctx->set_cert_file(str_v.to_std_string())) {
+                php_swoole_fatal_error(E_ERROR, "ssl cert file[%s] not found", str_v.val());
+                return false;
+            }
+            break;
+        case SWR_PORTS_TLS_KEY_FILE:
+            if (!ctx->set_key_file(str_v.to_std_string())) {
+                php_swoole_fatal_error(E_ERROR, "ssl key file[%s] not found", str_v.val());
+                return false;
+            }
+            break;
+        default: assert(false);
+        }
+    }
+    return true;
+}
+
+static bool port_apply_settings(ListenPort *port, ServerPortProperty *property, HashTable *vht) {
+    zval *ztmp;
+    // backlog and following ordinary options use the sole immutable Rust catalog.
+    for (size_t index = 0;; index++) {
+        auto option = swr_v1_ports_option(index);
+        if (option.action == SWR_PORTS_OPTION_END) break;
+        bool present = true;
+        if (option.policy != SWR_PORTS_OPTION_ALWAYS) {
+            ztmp = zend_hash_str_find(vht, (const char *) option.key.data, option.key.len);
+            present = ztmp && !ZVAL_IS_NULL(ztmp);
+            if (!present && option.alias.len) {
+                ztmp = zend_hash_str_find(vht, (const char *) option.alias.data, option.alias.len);
+                present = ztmp && !ZVAL_IS_NULL(ztmp);
+            }
+            if (!present && option.policy == SWR_PORTS_MISSING_SKIP) continue;
+        }
+        if (option.action != SWR_PORTS_OPTION_SPECIAL) {
+            int64_t value = 0;
+            if (present) {
+                switch (option.converter) {
+                case SWR_PORTS_CONVERT_LONG: value = zval_get_long(ztmp); break;
+                case SWR_PORTS_CONVERT_SIZE: value = php_swoole_parse_to_size(ztmp); break;
+                case SWR_PORTS_CONVERT_TRUTH: value = zval_is_true(ztmp); break;
+                default: assert(false);
+                }
+            }
+            switch (option.action) {
+            case SWR_PORTS_OPTION_NUMBER:
+                port_apply_number(port, option.target, swr_v1_ports_number(option.number_kind, value));
+                break;
+            case SWR_PORTS_OPTION_BUFFER: {
+                auto plan = swr_v1_ports_buffer_setting(value);
+                assert(plan.count == 1 || plan.count == 2);
+                port_apply_number(port, option.target, plan.first);
+                if (plan.count == 2) port_apply_number(port, option.target, plan.last);
+                break;
+            }
+            case SWR_PORTS_OPTION_FLAG:
+                port_apply_flags(port, swr_v1_ports_flag_setting(option.target, value, present));
+                break;
+            default: assert(false);
+            }
+            continue;
+        }
+        switch (option.target) {
+        case SWR_PORTS_SPECIAL_PACKET_EOF: {
+            zend::String str_v(ztmp);
+            static_assert(sizeof(port->protocol.package_eof) == SW_DATA_EOF_MAXLEN && SW_DATA_EOF_MAXLEN <= UINT8_MAX, "ports EOF capacity");
+            auto packet = swr_v1_ports_packet_eof(str_v.len(), sizeof(port->protocol.package_eof));
+            port->protocol.package_eof_len = packet.value;
+            if (packet.status == 1) {
+                php_swoole_fatal_error(E_ERROR, "package_eof cannot be an empty string");
+                return false;
+            } else if (packet.status == 2) {
+                php_swoole_fatal_error(E_ERROR, "package_eof max length is %d", SW_DATA_EOF_MAXLEN);
+                return false;
+            }
+            memcpy(port->protocol.package_eof, str_v.val(), packet.copy_len);
+            break;
+        }
+        case SWR_PORTS_SPECIAL_WEBSOCKET_OPTIONS: {
+            php_swoole_server_set_websocket_option(port, vht);
+            break;
+        }
+        case SWR_PORTS_SPECIAL_MAX_IDLE: {
+            double v = zval_get_double(ztmp);
+            port->max_idle_time = SW_MAX(v, SW_TIMER_MIN_SEC);
+            break;
+        }
+        case SWR_PORTS_SPECIAL_PACKET_TYPE: {
+            zend::String str_v(ztmp);
+            port->protocol.package_length_type = str_v.val()[0];
+            auto packet = swr_v1_ports_packet_width(swoole_type_size(port->protocol.package_length_type));
+            port->protocol.package_length_size = packet.value;
+            if (packet.status) {
+                php_swoole_fatal_error(E_ERROR, "unknown package_length_type, see pack(). Link: https://php.net/pack");
+                return false;
+            }
+            break;
+        }
+        case SWR_PORTS_SPECIAL_LENGTH_OFFSET: {
+            zend_long v = zval_get_long(ztmp);
+            static_assert(SW_IPC_BUFFER_SIZE <= UINT32_MAX, "ports offset bound");
+            auto packet = swr_v1_ports_packet_offset(v, SW_IPC_BUFFER_SIZE);
+            port->protocol.package_length_offset = packet.value;
+            if (packet.status) {
+                php_swoole_fatal_error(E_ERROR, "'package_length_offset' value is too large");
+            }
+            break;
+        }
+        case SWR_PORTS_SPECIAL_BODY_OFFSET: {
+            zend_long v = zval_get_long(ztmp);
+            static_assert(SW_IPC_BUFFER_SIZE <= UINT32_MAX, "ports offset bound");
+            auto packet = swr_v1_ports_packet_offset(v, SW_IPC_BUFFER_SIZE);
+            port->protocol.package_body_offset = packet.value;
+            if (packet.status) {
+                php_swoole_fatal_error(E_ERROR, "'package_body_offset' value is too large");
+            }
+            break;
+        }
+        case SWR_PORTS_SPECIAL_LENGTH_CALLBACK: {
+            auto cb = sw_callable_create(ztmp);
+            if (cb) {
+                port->protocol.get_package_length = php_swoole_server_length_func;
+                if (port->protocol.private_data_1) {
+                    sw_callable_free(port->protocol.private_data_1);
+                }
+                port->protocol.private_data_1 = cb;
+                port->protocol.package_length_size = 0;
+                port->protocol.package_length_type = '\0';
+                port->protocol.package_length_offset = SW_IPC_BUFFER_SIZE;
+                property->serv->single_thread = true;
+            }
+            break;
+        }
+        default: assert(false);
+        }
+    }
+
+    if (port->ssl) {
+        if (!php_swoole_server_set_ssl_option(vht, port->get_ssl_context())) {
+            return false;
+        }
+        // TLS frontend order/conversion only; SNI and crypto algorithms remain native.
+        for (size_t index = 0;; index++) {
+            auto option = swr_v1_ports_tls_option(SWR_PORTS_TLS_PORT, index);
+            if (option.action == SWR_PORTS_OPTION_END) break;
+            ztmp = zend_hash_str_find(vht, (const char *) option.key.data, option.key.len);
+            if (!ztmp || ZVAL_IS_NULL(ztmp)) continue;
+            if (option.action != SWR_PORTS_OPTION_SPECIAL) {
+                int64_t raw = option.converter == SWR_PORTS_CONVERT_TRUTH ? zval_is_true(ztmp) : zval_get_long(ztmp);
+                auto value = swr_v1_ports_tls_value(option.target, raw);
+                switch (option.target) {
+                case SWR_PORTS_TLS_COMPRESS: port->set_ssl_disable_compress(value); break;
+                case SWR_PORTS_TLS_PROTOCOLS: port->set_ssl_protocols(value); break;
+                case SWR_PORTS_TLS_VERIFY_PEER: port->set_ssl_verify_peer(value); break;
+                case SWR_PORTS_TLS_ALLOW_SELF_SIGNED: port->set_ssl_allow_self_signed(value); break;
+                case SWR_PORTS_TLS_VERIFY_DEPTH: port->set_ssl_verify_depth(value); break;
+                case SWR_PORTS_TLS_PREFER_CIPHERS: port->set_ssl_prefer_server_ciphers(value); break;
+                default: assert(false);
+                }
+                continue;
+            }
+            switch (option.target) {
+            case SWR_PORTS_TLS_CLIENT_CERT: {
+                zend::String str_v(ztmp);
+                if (!port->set_ssl_client_cert_file(str_v.to_std_string())) {
+                    php_swoole_fatal_error(E_ERROR, "ssl_client_cert_file[%s] not found", str_v.val());
+                    return false;
+                }
+                break;
+            }
+            case SWR_PORTS_TLS_CAFILE: {
+                zend::String str_v(ztmp);
+                port->set_ssl_cafile(str_v.to_std_string());
+                break;
+            }
+            case SWR_PORTS_TLS_CAPATH: {
+                zend::String str_v(ztmp);
+                port->set_ssl_capath(str_v.to_std_string());
+                break;
+            }
+            case SWR_PORTS_TLS_CIPHERS: {
+                port->set_ssl_ciphers(zend::String(ztmp).to_std_string());
+                break;
+            }
+            case SWR_PORTS_TLS_ECDH_CURVE: {
+                port->set_ssl_ecdh_curve(zend::String(ztmp).to_std_string());
+                break;
+            }
+            case SWR_PORTS_TLS_DH_PARAM: {
+                port->set_ssl_dhparam(zend::String(ztmp).to_std_string());
+                break;
+            }
+            default: assert(false);
+            }
+        }
+        // SNI frontend admission only; native iteration/context/crypto remains authoritative.
+        auto sni = swr_v1_ports_sni_plan(0, 0, 0);
+        ztmp = zend_hash_str_find(vht, (const char *) sni.key.data, sni.key.len);
+        if (ztmp && !ZVAL_IS_NULL(ztmp)) {
+            auto mapping = swr_v1_ports_sni_plan(1, 0, Z_TYPE_P(ztmp) == IS_ARRAY);
+            if (mapping.status == 1) {
+                php_swoole_fatal_error(E_WARNING, "ssl_sni_certs requires an array mapping host names to cert paths");
+                return false;
+            }
+
+            zval *current;
+            zend_string *key;
+            zend_ulong key_index;
+
+            ZEND_HASH_FOREACH_KEY_VAL(Z_ARRVAL_P(ztmp), key_index, key, current) {
+                (void) key_index;
+                auto item = swr_v1_ports_sni_plan(2, key != nullptr, key ? Z_TYPE_P(current) == IS_ARRAY : false);
+                if (item.status == 2) {
+                    php_swoole_fatal_error(E_WARNING, "ssl_sni_certs array requires string host name keys");
+                    return false;
+                }
+                if (item.status == 3) {
+                    php_swoole_fatal_error(E_WARNING, "invalid SNI_cert setting");
+                    return false;
+                }
+                auto context = port->dup_ssl_context();
+                if (!php_swoole_server_set_ssl_option(Z_ARRVAL_P(current), context.get())) {
+                    return false;
+                }
+                if (!port->ssl_add_sni_cert(std::string(key->val, key->len), context)) {
+                    php_swoole_fatal_error(E_ERROR, "ssl_add_sni_cert() failed");
+                    return false;
+                }
