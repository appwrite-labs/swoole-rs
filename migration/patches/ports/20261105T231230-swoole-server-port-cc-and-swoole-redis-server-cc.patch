+}
+void swr_redis_host_close(void *serv, zend_long fd) {
+    static_cast<Server *>(serv)->close(fd, false);
+}
+int swr_redis_host_call(void *serv, void *callable, zval *args, zval *retval) {
+    bool called = false, bailed = false;
+    zend_try {
+        called = zend::function::call(static_cast<zend::Callable *>(callable)->ptr(),
+                                      2,
+                                      args,
+                                      retval,
+                                      static_cast<Server *>(serv)->is_enable_coroutine());
+    }
+    zend_catch {
+        bailed = true;
+    }
+    zend_end_try();
+    return bailed ? -1 : called;
+}
+bool swr_redis_host_callable(zval *zcallback, void **callable) {
+    bool bailed = false;
+    zend_try {
+        *callable = sw_callable_create(zcallback);
+    }
+    zend_catch {
+        bailed = true;
+    }
+    zend_end_try();
+    return !bailed;
+}
+bool swr_redis_host_update_property(zend_class_entry *scope, zend_object *object, const char *name, size_t length,
