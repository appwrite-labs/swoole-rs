+
+    pid_t get_pid() const {
+        return pid_;
+    }
+
+    int get_status() const {
+        return status_;
+    }
+
+    int get_code() const {
+        return WEXITSTATUS(status_);
+    }
+
+    int get_signal() const {
+        return WTERMSIG(status_);
+    }
+
+    bool is_normal_exit() const {
+        return WIFEXITED(status_);
+    }
+};
+
+struct ProcessPool;
+struct Worker;
