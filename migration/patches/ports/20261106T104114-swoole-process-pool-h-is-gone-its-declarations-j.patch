+    SW_PROTOCOL_STREAM,
+    SW_PROTOCOL_MESSAGE,
+};
+
+struct WorkerStopMessage {
+    pid_t pid;
+    uint16_t worker_id;
+};
+
+class ExitStatus {
+    pid_t pid_;
+    int status_;
