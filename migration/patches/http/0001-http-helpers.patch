+int http_no_digits_errno() {
+    // libc implementations differ on no-conversion errno. Probe only the foreign
+    // policy once; Rust still parses all request bytes, without native callbacks.
+    static const int value = [] {
+        int saved = errno; errno = 0;
+        char *end = nullptr; (void) strtoull("x", &end, 10);
+        int result = errno; errno = saved; return result;
+    }();
+    return value;
+}
+int frame_request(Request &request, uint32_t operation) {
+    swr_v1_http_frame_state state{static_cast<size_t>(request.buffer_->offset), request.content_length_,
+        request.method, request.version, request.excepted, request.url_offset_, request.url_length_,
+        request.request_line_length_, request.header_length_, request.known_length};
+    int32_t status = swr_v1_http_frame(reinterpret_cast<const uint8_t *>(request.buffer_->str),
+                                      request.buffer_->length, &state, operation);
+    request.buffer_->offset = state.offset;
+    request.content_length_ = state.content_length;
+    request.method = state.method; request.version = state.version; request.excepted = state.excepted;
+    request.url_offset_ = state.url_offset; request.url_length_ = state.url_length;
