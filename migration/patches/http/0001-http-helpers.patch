+    if (!plan) throw std::logic_error("Invalid HTTP multipart emission kind");
+    for (size_t i = 0; i < count; ++i) {
+        const auto &step = plan[i];
+        if (step.effects & 1) request->multipart_header_parsed = 1;
+        if (step.effects & 2) request->multipart_header_parsed = 0;
+        if (step.effects & 4) {
+            request->content_length_ = swr_v1_http_multipart_body_length(form_data->multipart_buffer_->length, request->header_length_);
+            request->tried_to_dispatch = 1;
+        }
+        switch (step.action) {
+        case 0: return 0;
+        case 1: form_data->multipart_buffer_->append(reinterpret_cast<const char *>(step.data), step.length); break;
+        case 2: form_data->multipart_buffer_->append(form_data->upload_tmpfile->str, strlen(form_data->upload_tmpfile->str)); break;
+        case 3: form_data->multipart_buffer_->append(p->boundary, p->boundary_length); break;
+        case 4: fflush(p->fp); break;
+        case 5: fclose(p->fp); p->fp = nullptr; break;
+        case 6: form_data->multipart_buffer_->append(form_data->current_header_name, form_data->current_header_name_len); break;
+        case 7: form_data->multipart_buffer_->append(at, length); break;
+        default: throw std::logic_error("Invalid HTTP multipart emission state");
+        }
+    }
+    return 0;
+}
