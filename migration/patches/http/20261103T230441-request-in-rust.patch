+uint64_t request_native(uint32_t op, void *a, const uint8_t *b, uint64_t n, uint64_t m) {
+    auto text = reinterpret_cast<const char *>(b);
+    auto parser = static_cast<multipart_parser *>(a);
+    auto fp = static_cast<FILE *>(a);
+    switch (op) {
+    case SWR_HTTP_NATIVE_STRING_NEW:
+        return reinterpret_cast<uintptr_t>(b ? new String(text, n) : new String(n));
+    case SWR_HTTP_NATIVE_STRING_FREE: delete static_cast<String *>(a); return 0;
+    case SWR_HTTP_NATIVE_STRING_APPEND: static_cast<String *>(a)->append(text, n); return 0;
+    case SWR_HTTP_NATIVE_PARSER_NEW:
