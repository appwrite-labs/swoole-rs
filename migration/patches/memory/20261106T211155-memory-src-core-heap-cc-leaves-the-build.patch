-#include "swoole.h"
-#include "swoole_heap.h"
-
-#include "swoole_rs_memory.h"
-#include <cstddef>
-#include <type_traits>
-namespace swoole {
-static_assert(std::is_standard_layout<HeapNode>::value, "heap node POD");
-static_assert(sizeof(HeapNode) == sizeof(swr_v1_memory_heap_node), "heap node size");
-static_assert(offsetof(HeapNode, priority) == offsetof(swr_v1_memory_heap_node, priority), "heap priority");
-static_assert(offsetof(HeapNode, position) == offsetof(swr_v1_memory_heap_node, position), "heap position");
-static_assert(offsetof(HeapNode, data) == offsetof(swr_v1_memory_heap_node, data), "heap token");
-Heap::Heap(size_t capacity, Type type) {
-    if (swr_v1_memory_heap_create(capacity, type == MAX_HEAP, &rust_) != 0) throw std::bad_alloc();
-}
-Heap::~Heap() { swr_v1_memory_heap_release(rust_); }
-int Heap::compare(uint64_t a, uint64_t b) const { return swr_v1_memory_heap_compare(rust_, a, b); }
-HeapNode *Heap::push(uint64_t priority, void *data) {
-    return reinterpret_cast<HeapNode *>(swr_v1_memory_heap_push(rust_, priority, data));
-}
-void Heap::change_priority(uint64_t priority, HeapNode *node) const {
-    const int status = swr_v1_memory_heap_update(rust_, priority, reinterpret_cast<swr_v1_memory_heap_node *>(node));
-    assert(status == 0);
-    (void) status;
-}
-void Heap::remove(HeapNode *node) {
-    const int status = swr_v1_memory_heap_remove(rust_, reinterpret_cast<swr_v1_memory_heap_node *>(node));
-    assert(status == 0);
-    (void) status;
-}
-void *Heap::pop() { return swr_v1_memory_heap_pop(rust_); }
-void *Heap::peek() const {
-    size_t index = 0;
-    swr_v1_memory_heap_node record{};
-    (void) swr_v1_memory_heap_debug_step(rust_, &index, &record);
-    return record.data;
-}
-void Heap::print() const {
-    size_t index = 0;
-    swr_v1_memory_heap_node record{};
-    while (swr_v1_memory_heap_debug_step(rust_, &index, &record) == 1) {
-        printf("#%zu\tpriority=%ld, data=%p\n", index, (long) record.priority, record.data);
-    }
-}
-} // namespace swoole
