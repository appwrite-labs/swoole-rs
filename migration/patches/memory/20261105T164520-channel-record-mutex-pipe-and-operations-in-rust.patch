-    const auto release_memory = [allocation = lifecycle.actions[0]](void *memory) {
-        allocation == SWR_CHANNEL_ALLOC_SHARED ? sw_shm_free(memory) : sw_free(memory);
-    };
-    std::unique_ptr<void, decltype(release_memory)> memory(nullptr, release_memory);
-    std::unique_ptr<Lock> next_lock;
-    std::unique_ptr<Pipe> next_pipe;
-    Channel *object = nullptr;
-    for (uint32_t i = 0; i < lifecycle.count; ++i) {
-        switch (lifecycle.actions[i]) {
