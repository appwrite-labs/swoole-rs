-        case SWR_CHANNEL_ALLOC_SHARED:
-            memory.reset(lifecycle.actions[i] == SWR_CHANNEL_ALLOC_SHARED ? sw_shm_malloc(plan.total) : sw_malloc(plan.total));
-            if (!memory) { swoole_warning("alloc(%ld) failed", size); return nullptr; }
