-namespace swoole {
-
-struct HeapNode {
-    uint64_t priority;
-    uint32_t position;
-    void *data;
-};
-static_assert(sizeof(HeapNode) == sizeof(swr_v1_memory_heap_node) &&
-                  offsetof(HeapNode, priority) == offsetof(swr_v1_memory_heap_node, priority) &&
-                  offsetof(HeapNode, position) == offsetof(swr_v1_memory_heap_node, position) &&
-                  offsetof(HeapNode, data) == offsetof(swr_v1_memory_heap_node, data),
-              "Rust's heap node layout");
-
-class Heap {
-  public:
-    enum Type {
-        MIN_HEAP,
-        MAX_HEAP,
-    };
-
-    // The rest of Heap's members are Rust under their upstream symbols (crates/memory/src/heap.rs).
-    Heap(size_t _n, Type _type) {
-        if (swr_v1_memory_heap_create(_n, _type == MAX_HEAP, &rust_) != 0) throw std::bad_alloc();
-    }
-    ~Heap();
-
-    size_t count() const {
-        return swr_v1_memory_heap_count(rust_);
-}
-
-    HeapNode *push(uint64_t priority, void *data);
-    void *pop();
-    void change_priority(uint64_t new_priority, HeapNode *ptr) const;
-    void remove(HeapNode *node);
-    void *peek() const;
-    void print() const;
-    int compare(uint64_t a, uint64_t b) const;
-
-    HeapNode *top() const {
-        return reinterpret_cast<HeapNode *>(swr_v1_memory_heap_at(rust_, 0));
-}
-
-  private:
-    void *rust_;
-};
-}  // namespace swoole
