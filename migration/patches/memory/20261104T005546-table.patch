-void TableColumn::clear(TableRow *row) const {
-    if (type == TYPE_STRING) {
-        row->set_value(this, nullptr, 0);
-    } else if (type == TYPE_FLOAT) {
-        double _value = 0;
-        row->set_value(this, &_value, 0);
-    } else {
-        long _value = 0;
-        row->set_value(this, &_value, 0);
-    }
