-
-#include "swoole_memory.h"
-#include "swoole_rs_memory.h"
-#include <mutex>
-
-#define SW_MIN_PAGE_SIZE 4096
-namespace swoole {
-struct GlobalMemoryImpl {
-    std::mutex lock;
-    void *registry = nullptr;
-    GlobalMemoryImpl(uint32_t size, bool use_shared);
-    ~GlobalMemoryImpl();
-    char *new_page();
-};
-GlobalMemory::GlobalMemory(uint32_t pagesize, bool shared) {
-    assert(pagesize >= SW_MIN_PAGE_SIZE);
-    impl = new GlobalMemoryImpl(pagesize, shared);
-}
-GlobalMemoryImpl::GlobalMemoryImpl(uint32_t size, bool use_shared) {
-    const int status = swr_v1_memory_global_open(size, swoole_pagesize(), use_shared, getpid(), &registry);
-    if (status == -2) throw Exception(SW_ERROR_INVALID_PARAMS);
-    if (status != 0) throw std::bad_alloc();
-    if (!new_page()) {
-        swr_v1_memory_global_release(registry);
-        throw std::bad_alloc();
-    }
-}
-char *GlobalMemoryImpl::new_page() {
-    swr_v1_memory_global_effect effect{};
-    if (swr_v1_memory_global_step(registry, 0, 0, 0, &effect) != 0) return nullptr;
-    auto *page = static_cast<char *>(effect.action == SWR_GLOBAL_ALLOC_SHARED
-                                         ? sw_shm_malloc(effect.page_size) : sw_malloc(effect.page_size));
-    if (!page) return nullptr;
-    if (swr_v1_memory_global_add_page(registry, page) != 0) {
-        effect.action == SWR_GLOBAL_ALLOC_SHARED ? sw_shm_free(page) : sw_free(page);
-        return nullptr;
-    }
-    return page;
-}
-GlobalMemoryImpl::~GlobalMemoryImpl() {
-    swr_v1_memory_global_effect effect{};
-    while (swr_v1_memory_global_step(registry, 2, 0, 0, &effect) == 0 && effect.action) {
-        effect.action == SWR_GLOBAL_FREE_SHARED ? sw_shm_free(effect.page) : sw_free(effect.page);
-    }
-    const int status = swr_v1_memory_global_release(registry);
-    assert(status == 0);
-    (void) status;
-}
-void *GlobalMemory::alloc(uint32_t size) {
-    std::unique_lock<std::mutex> lock(impl->lock);
-    swr_v1_memory_global_effect effect{};
-    if (swr_v1_memory_global_step(impl->registry, 1, getpid(), size, &effect) != 0) {
-        swoole_warning("failed to alloc %d bytes, exceed the maximum size[%d]", effect.aligned, effect.page_size);
-        return nullptr;
-    }
-    if (effect.action == SWR_GLOBAL_RESET_SHARED) {
-        // Preserve inherited pages and old mutex while this lock guard unwinds.
-        impl = new GlobalMemoryImpl(effect.page_size, true);
-    }
-    swoole_trace("alloc_size=%u, size=%u", effect.aligned + 8, effect.aligned);
-    void *result = nullptr;
-    int status = swr_v1_memory_global_alloc(impl->registry, size, &result);
-    if (status == 1) {
-        if (!impl->new_page()) { swoole_warning("alloc memory error"); return nullptr; }
-        status = swr_v1_memory_global_alloc(impl->registry, size, &result);
-    }
-    return status == 0 ? result : nullptr;
-}
-void GlobalMemory::free(void *ptr) { (void) ptr; }
-size_t GlobalMemory::capacity() const { return swr_v1_memory_global_capacity(impl->registry); }
-size_t GlobalMemory::get_memory_size() const { return swr_v1_memory_global_memory_size(impl->registry); }
-GlobalMemory::~GlobalMemory() { delete impl; }
-} // namespace swoole
