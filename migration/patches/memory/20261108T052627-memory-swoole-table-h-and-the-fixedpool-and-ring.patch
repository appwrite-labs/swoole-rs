-
-#pragma once
-
-#include "swoole_memory.h"
-#include "swoole_rs_memory.h"
-
-#include <string>
-
-#define SW_TABLE_FORCE_UNLOCK_TIME 2000  // milliseconds
-#define SW_TABLE_USE_PHP_HASH
-#define SW_TABLE_MAX_ROW_SIZE 0x80000000
-
-// The table, its columns and rows are Rust's (crates/memory/src/table.rs);
-// these classes are views of them.
-namespace swoole {
-typedef uint32_t TableStringLength;
-typedef uint64_t (*HashFunc)(const char *key, size_t len);
-
-void table_warning(const char *message, size_t length);
-
-struct TableRow;
-
-struct TableColumn : swr_v1_memory_table_column {
-    enum Type {
-        TYPE_INT = 1,
-        TYPE_FLOAT,
-        TYPE_STRING,
-    };
-
-    TableColumn() = delete;
-
-    void clear(TableRow *row) const;
-};
-
-struct TableRow : swr_v1_memory_table_row {
-    void lock() {
-        swr_v1_memory_table_row_lock(this, table_warning);
-    }
-
-    void unlock() {
-        swr_v1_memory_table_row_unlock(this);
-    }
-
-    void clear() {
-        swr_v1_memory_table_row_clear(this);
-    }
-
-    void set_value(const TableColumn *col, const void *value, size_t vlen) {
-        swr_v1_memory_table_set_value(this, col, value, vlen, table_warning);
-    }
-    void get_value(const TableColumn *col, double *dval) const {
-        swr_v1_memory_table_get_number(this, col, dval);
-    }
-    void get_value(const TableColumn *col, long *lval) const {
-        swr_v1_memory_table_get_number(this, col, lval);
-    }
-    void get_value(const TableColumn *col, char **strval, TableStringLength *strlen) {
-        swr_v1_memory_table_get_string(this, col, strval, strlen);
-    }
-};
-
-inline void TableColumn::clear(TableRow *row) const {
-    swr_v1_memory_table_clear_value(row, this);
-}
-
-enum TableFlag {
-    SW_TABLE_FLAG_NEW_ROW = 1,
-    SW_TABLE_FLAG_CONFLICT = 1u << 1,
-};
-
-class Table {
-  public:
-    Table() = delete;
-    ~Table() = delete;
-
-    static Table *make(uint32_t rows_size, float conflict_proportion);
-    bool create();
-    // release shared memory
-    void destroy();
-
-    size_t calc_memory_size() const {
-        return swr_v1_memory_table_memory_total(this);
-    }
-    size_t get_memory_size() const {
-        return swr_v1_memory_table_memory_size(this);
-    }
-    uint32_t get_available_slice_num() const {
-        return swr_v1_memory_table_slices(this, true);
-    }
-    uint32_t get_total_slice_num() const {
-        return swr_v1_memory_table_slices(this, false);
-    }
-    bool add_column(const std::string &name, enum TableColumn::Type type, size_t size) {
-        return swr_v1_memory_table_add_column(this, name.data(), name.size(), type, size);
-    }
-    TableColumn *get_column(const std::string &key) const {
-        return swr_v1_memory_table_find_column(this, key.data(), key.size());
-    }
-    // Every declaration, repeats included (upstream's column_list).
-    size_t get_column_list_size() const {
-        return swr_v1_memory_table_column_count(this, false);
-    }
-    TableColumn *get_column_at(size_t index) const {
-        return swr_v1_memory_table_column_at(this, index);
-    }
-    TableRow *set(const char *key, uint16_t keylen, TableRow **rowlock, int *out_flags) {
-        return swr_v1_memory_table_set(this, key, keylen, rowlock, out_flags);
-    }
-    TableRow *get(const char *key, uint16_t keylen, TableRow **rowlock) const {
-        return swr_v1_memory_table_get(this, key, keylen, rowlock);
-    }
-    bool exists(const char *key, uint16_t keylen) const {
-        return swr_v1_memory_table_exists(this, key, keylen);
-    }
-    bool del(const char *key, uint16_t keylen) {
-        return swr_v1_memory_table_del(this, key, keylen);
-    }
-    void forward() const {
-        swr_v1_memory_table_forward(this);
-    }
-    swr_v1_memory_table_stats stats() const {
-        return swr_v1_memory_table_counters(this);
-    }
-
-    bool is_created() const {
-        return swr_v1_memory_table_created(this);
-    }
-
-    bool ready() const {
-        return swr_v1_memory_table_ready(this);
-    }
-
-    void set_hash_func(HashFunc _fn) {
-        swr_v1_memory_table_set_hash(this, _fn);
-    }
-
-    size_t get_size() const {
-        return swr_v1_memory_table_size(this);
-    }
-
-    float get_conflict_proportion() const {
-        return swr_v1_memory_table_conflict_proportion(this);
-    }
-
-    size_t get_column_size() const {
-        return swr_v1_memory_table_column_count(this, true);
-    }
-
-    TableRow *get_by_index(uint32_t index) const {
-        const size_t size = get_size();
-        assert(index < size);
-        (void) size;
-        return swr_v1_memory_table_by_index(this, index);
-    }
-
-    size_t count() const {
-        return swr_v1_memory_table_count(this);
-    }
-
-    bool exists(const std::string &key) const {
-        return exists(key.c_str(), key.length());
-    }
-
-    TableRow *current() const {
-        return swr_v1_memory_table_current(this);
-    }
-
-    void rewind() const {
-        swr_v1_memory_table_rewind(this);
-    }
-
-    void clear_row(TableRow *row) const {
-        swr_v1_memory_table_clear_row(this, row);
-    }
-};
-}  // namespace swoole
