diff --git a/include/swoole_msg_queue.h b/include/swoole_msg_queue.h
index bee9e2f..a199d75 100644
--- a/include/swoole_msg_queue.h
+++ b/include/swoole_msg_queue.h
@@ -20,3 +20,5 @@
 #include "swoole.h"
-#include "swoole_rs_ossupport_msg_queue.h"
+#include "swoole_rs_ossupport.h"
+
+#include <sys/ipc.h>
 
@@ -36,2 +38,4 @@ struct QueueNode {
 
+// The queue's record and syscalls are Rust's (crates/ossupport/src/msg_queue.rs);
+// the diagnostics stay here, under upstream's method names.
 class MsgQueue {
@@ -41,4 +45,14 @@ class MsgQueue {
   public:
-    explicit MsgQueue(key_t msg_key, bool blocking = true, int perms = 0);
-    ~MsgQueue();
+    explicit MsgQueue(key_t msg_key, bool blocking = true, int perms = 0) {
+        if (!swr_v1_os_msg_queue_init(&state_, msg_key, blocking, perms)) {
+            swoole_sys_warning("msgget() failed");
+        }
+    }
+
+    ~MsgQueue() {
+        // private queue must be destroyed
+        if (state_.key == IPC_PRIVATE && state_.id >= 0) {
+            destroy();
+        }
+    }
 
@@ -52,8 +66,48 @@ class MsgQueue {
 
-    void set_blocking(bool blocking);
-    bool set_capacity(size_t queue_bytes) const;
-    bool push(const QueueNode *in, size_t mdata_length) const;
-    ssize_t pop(QueueNode *out, size_t mdata_size) const;
-    bool stat(size_t *queue_num, size_t *queue_bytes) const;
-    bool destroy();
+    void set_blocking(bool blocking) {
+        swr_v1_os_msg_queue_blocking(&state_, blocking);
+    }
+
+    bool set_capacity(size_t queue_bytes) const {
+        const int rc = swr_v1_os_msg_queue_set_capacity(&state_, queue_bytes);
+        if (rc == 2) {
+            swoole_sys_warning("msgctl(msqid=%d, IPC_SET, msg_qbytes=%lu) failed", state_.id, queue_bytes);
+        }
+        return rc == 0;
+    }
+
+    bool push(const QueueNode *in, size_t mdata_length) const {
+        const auto rc = swr_v1_os_msg_push(state_.id, in, mdata_length, state_.flags);
+        if (rc == 0) {
+            return true;
+        }
+        if (rc == 2) {
+            swoole_sys_warning("msgsnd(%d, %lu, %ld) failed", state_.id, mdata_length, in->mtype);
+        }
+        swoole_set_last_error(errno);
+        return false;
+    }
+
+    ssize_t pop(QueueNode *data, size_t mdata_size) const {
+        const auto ret = swr_v1_os_msg_pop(state_.id, data, mdata_size, data->mtype, state_.flags);
+        if (ret.result < 0) {
+            swoole_set_last_error(errno);
+            if (ret.warn) {
+                swoole_sys_warning("msgrcv(%d, %zu, %ld) failed", state_.id, mdata_size, data->mtype);
+            }
+        }
+        return ret.result;
+    }
+
+    bool stat(size_t *queue_num, size_t *queue_bytes) const {
+        return swr_v1_os_msg_queue_stat(&state_, queue_num, queue_bytes);
+    }
+
+    bool destroy() {
+        if (!swr_v1_os_msg_queue_remove(&state_)) {
+            swoole_sys_warning("msgctl(%d, IPC_RMID) failed", state_.id);
+            return false;
+        }
+        return true;
+    }
 };
