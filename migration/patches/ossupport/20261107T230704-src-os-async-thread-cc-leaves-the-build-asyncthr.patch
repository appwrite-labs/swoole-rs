-swoole::AsyncThreads *sw_async_threads() {
-    return SwooleTG.async_threads;
-}
-
-namespace swoole {
-namespace async {
-//-------------------------------------------------------------------------------
-// The pool (queue, workers, scheduling, idle retirement) lives in crates/ossupport;
-// these hooks run an event and hand it back to the reactor thread that owns it.
-static void send_event(AsyncEvent *event) {
-    if (event->pipe_socket->write_sync(&event, sizeof(event)) <= 0) {
-        swoole_log_as("ThreadPool::main_func", swoole_sys_warning("sendto swoole_aio_pipe_write failed"));
-        delete event;
-    }
-}
-
-static void execute(uintptr_t token) {
-    auto *event = reinterpret_cast<AsyncEvent *>(token);
-    if (sw_unlikely(event->handler == nullptr)) {
-        event->error = SW_ERROR_AIO_BAD_REQUEST;
-        event->retval = -1;
-    } else if (sw_unlikely(event->canceled)) {
-        event->error = SW_ERROR_AIO_CANCELED;
-        event->retval = -1;
-    } else {
-        event->handler(event);
-    }
-
-    swoole_trace_log(SW_TRACE_AIO,
-                     "aio_thread %s. ret=%ld, error=%d",
-                     event->retval > 0 ? "ok" : "failed",
-                     event->retval,
-                     event->error);
-    send_event(event);
-}
-
-static void release_callback(AsyncEvent *event) {
-    const auto key = reinterpret_cast<uintptr_t>(event->object);
-    if (!swr_v1_os_pool_join(SwooleTG.async_threads->pool, key)) {
-        swoole_log_as("ThreadPool::release_thread", swoole_warning("AIO thread#%s is missing", std::to_string(key).c_str()));
-    }
-    // balance
-    SwooleTG.async_threads->task_num++;
-}
-
-/* notifies the main thread to release this thread */
-static void retire(uintptr_t key) {
-    auto *event = new AsyncEvent{};
-    event->object = reinterpret_cast<void *>(key);
-    event->callback = release_callback;
-    event->pipe_socket = SwooleG.aio_default_socket;
-    send_event(event);
-}
-
-static void thread_init() {
-    swoole_thread_init(false);
-}
-
-static void thread_clean() {
-    swoole_thread_clean(false);
-}
-
-static void spawn_failed() {
-    swoole_log_as("ThreadPool::create_thread",
-                  swoole_sys_notice("create aio thread failed, please check your system configuration or adjust aio_worker_num"));
-}
-
-AsyncEvent *dispatch(const AsyncEvent *request) {
-    if (sw_unlikely(!SwooleTG.async_threads)) {
-        SwooleTG.async_threads = new AsyncThreads();
-    }
-    auto *event = new AsyncEvent(*request);
-    event->task_id = swr_v1_os_pool_task_id(SwooleTG.async_threads->pool);
-    event->timestamp = microtime();
-    event->pipe_socket = SwooleTG.async_threads->write_socket;
-    swr_v1_os_pool_dispatch(SwooleTG.async_threads->pool, reinterpret_cast<uintptr_t>(event));
-    SwooleTG.async_threads->task_num++;
-    return event;
-}
-
-//-------------------------------------------------------------------------------
-}  // namespace async
-
-static void complete(uintptr_t token) {
-    auto *_event = reinterpret_cast<AsyncEvent *>(token);
-    if (!_event->canceled) {
-        _event->callback(_event);
-    }
-    SwooleTG.async_threads->task_num--;
-    delete _event;
-}
-
-int AsyncThreads::callback(Reactor *reactor, Event *event) {
-    static_assert(SW_AIO_EVENT_NUM == 128, "the Rust completion read takes 128 tokens");
-    if (swr_v1_os_pool_complete(event->socket->fd, complete) < 0) {
-        swoole_sys_warning("read() aio events failed");
-        return SW_ERR;
-    }
-    return SW_OK;
-}
-
-size_t AsyncThreads::get_worker_num() const {
-    return swr_v1_os_pool_worker_num(pool);
-}
-
-size_t AsyncThreads::get_queue_size() const {
-    return swr_v1_os_pool_queue_size(pool);
-}
-
-void AsyncThreads::notify_one() const {
-    swr_v1_os_pool_notify_one(pool);
-}
-
-AsyncThreads::AsyncThreads() {
-    if (!SwooleTG.reactor) {
-        swoole_warning("no event loop, cannot initialized");
-        swoole_throw_error(SW_ERROR_WRONG_OPERATION);
-    }
-
-    pipe = new UnixSocket(false, SOCK_STREAM);
-    if (!pipe->ready()) {
-        delete pipe;
-        pipe = nullptr;
-        swoole_throw_error(SW_ERROR_SYSTEM_CALL_FAIL);
-        return;
-    }
-
-    read_socket = pipe->get_socket(false);
-    write_socket = pipe->get_socket(true);
-    read_socket->fd_type = SW_FD_AIO;
-    write_socket->fd_type = SW_FD_AIO;
-
-    swoole_event_add(read_socket, SW_EVENT_READ);
-
-    sw_reactor()->add_destroy_callback([](void *data) {
-        if (!SwooleTG.async_threads) {
-            return;
-        }
-        swoole_event_del(SwooleTG.async_threads->read_socket);
-        delete SwooleTG.async_threads;
-        SwooleTG.async_threads = nullptr;
-    });
-
-    sw_reactor()->set_exit_condition(Reactor::EXIT_CONDITION_AIO_TASK, [](Reactor *reactor, size_t &event_num) -> bool {
-        if (SwooleTG.async_threads && SwooleTG.async_threads->task_num == 0) {
-            event_num--;
-        }
-        return true;
-    });
-
-    static const swr_v1_os_pool_hooks hooks = {
-        async::thread_init, async::thread_clean, async::execute, async::retire, async::spawn_failed};
-    pool = swr_v1_os_pool_acquire(hooks,
-                                  SW_CPU_NUM,
-                                  SwooleG.aio_core_worker_num,
-                                  SwooleG.aio_worker_num,
-                                  SwooleG.aio_max_wait_time,
-                                  SwooleG.aio_max_idle_time);
-
-    SwooleG.aio_default_socket = write_socket;
-    SwooleTG.async_threads = this;
-}
-
-AsyncThreads::~AsyncThreads() {
-    // The last reference shuts the shared pool down and joins its workers.
-    swr_v1_os_pool_release(pool);
-    pool = nullptr;
-    pipe->close();
-    read_socket = nullptr;
-    write_socket = nullptr;
-    delete pipe;
-    pipe = nullptr;
-}
-};  // namespace swoole
