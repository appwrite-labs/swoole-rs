-    double timestamp;
-    void *object;
-    void (*handler)(AsyncEvent *event);
-    void (*callback)(AsyncEvent *event);
-
-    bool catch_error() const {
-        return (error == SW_ERROR_AIO_TIMEOUT || error == SW_ERROR_AIO_CANCELED);
-    }
-};
