+      index(prepared.fields->state.index), offset_bytes(prepared.fields->state.offset_bytes) {}
+IOVector::IOVector(const iovec *_iov, int _iovcnt) : IOVector(swr_v1_reactor_iov_prepare(_iov, _iovcnt)) {}
 
