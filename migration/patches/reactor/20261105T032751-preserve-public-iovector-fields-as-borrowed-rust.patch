+static swr_v1_reactor_iov *check_iov(swr_v1_reactor_iov_prepared prepared) {
+    if (prepared.status == -1) throw std::bad_array_new_length();
+    if (prepared.status != 0) throw std::bad_alloc();
+    return prepared.owner;
+}
+IOVector::IOVector(swr_v1_reactor_iov_prepared prepared)
+    : owner_(check_iov(prepared)), iov(prepared.fields->original), iov_iterator(prepared.fields->state.iterator),
