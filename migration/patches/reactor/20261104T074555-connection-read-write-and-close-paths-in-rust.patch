+// ReactorThread_onRead's facts; the context's port once the connection is found.
+static inline uint64_t read_facts(ReactorThreadContext *ctx) {
+    Connection *conn = ctx->conn;
+    if (!conn || conn->server_fd == 0) {
+        return 0;
+    }
+    Socket *sock = ctx->sock;
+    ctx->port = ctx->serv->get_port_by_fd(ctx->event->fd);
+    return SWR_CN_FOUND | SWR_CN_BUILT_PREQUEUE | (sock->close_notified ? SWR_CN_CLOSE_NOTIFIED : 0) |
+           (conn->close_queued ? SWR_CN_CLOSE_QUEUED : 0) |
+           (sock->ssl && sock->ssl_want_read ? SWR_CN_SSL_WANT_READ : 0) |
+           (sock->ssl && sock->ssl_state != SW_SSL_STATE_READY ? SWR_CN_SSL_PENDING : 0) |
+#ifdef SW_SUPPORT_DTLS
+           (ctx->port->is_dtls() ? SWR_CN_DTLS_PORT : 0) | (sock->dtls ? SWR_CN_DTLS_SOCKET : 0) |
+#endif
+           (ctx->serv->is_process_mode() ? SWR_CN_PROCESS : 0);
+}
+
+// ReactorThread_onWrite's facts; the context's port and connection.
+static uint64_t write_facts(ReactorThreadContext *ctx) {
+    Server *serv = ctx->serv;
+    int fd = ctx->event->fd;
+    ctx->port = serv->get_port_by_fd(fd);
+    if (serv->is_process_mode()) {
+        assert(fd % serv->reactor_num == ctx->reactor->id);
+        assert(fd % serv->reactor_num == SwooleTG.id);
+    }
+    Connection *conn = ctx->conn = serv->get_connection(fd);
+    if (conn == nullptr || conn->active == 0) {
+        return 0;
+    }
+    swoole_log_as("ReactorThread_onWrite",
+                  swoole_trace_log(SW_TRACE_REACTOR,
+                                   "fd=%d, conn->close_notify=%d, serv->disable_notify=%d, conn->close_force=%d",
+                                   fd,
+                                   conn->close_notify,
+                                   serv->disable_notify,
+                                   conn->close_force));
+    Socket *sock = ctx->sock;
+    return SWR_CN_FOUND | SWR_CN_BUILT_PREQUEUE | (conn->close_notify ? SWR_CN_CLOSE_NOTIFY : 0) |
+           (sock->ssl && sock->ssl_state != SW_SSL_STATE_READY ? SWR_CN_SSL_PENDING : 0) |
+           (serv->disable_notify ? SWR_CN_DISABLE_NOTIFY : 0) | (conn->close_force ? SWR_CN_CLOSE_FORCE : 0);
+}
+
+// What decides whether a clean FIN leaves the write side usable (native/halfclose/prequeue.md).
+static uint64_t prequeue_facts(Server *serv, Connection *conn) {
+    return SWR_CN_BUILT_PREQUEUE | (serv->is_process_mode() ? SWR_CN_PROCESS : 0) |
+           (serv->is_hash_dispatch_mode() ? SWR_CN_HASH_DISPATCH : 0) |
+           (serv->dispatch_func ? SWR_CN_DISPATCH_FUNC : 0) | (serv->enable_coroutine ? SWR_CN_COROUTINE : 0) |
+           (conn->ssl ? SWR_CN_CONN_SSL : 0) | (conn->close_errno ? SWR_CN_CLOSE_ERRNO : 0) |
+           (conn->close_force ? SWR_CN_CLOSE_FORCE : 0) | (conn->close_reset ? SWR_CN_CLOSE_RESET : 0);
+}
+
+// Server::close_connection's facts, with the socket's fd above bit 32; the context's
+// connection and port.
+static uint64_t close_facts(ReactorThreadContext *ctx) {
+    Socket *sock = ctx->sock;
+    Connection *conn = ctx->conn = static_cast<Connection *>(sock->object);
+    ctx->port = ctx->serv->get_port_by_fd(sock->fd);
+    return SWR_CN_BUILT_PREQUEUE | (conn->timer ? SWR_CN_TIMER : 0) |
+           (conn->websocket_buffer ? SWR_CN_WEBSOCKET_BUFFER : 0) | (sock->removed ? SWR_CN_REMOVED : 0) |
+           (ctx->serv->is_base_mode() ? SWR_CN_BASE : 0) | (sock->ssl ? SWR_CN_SOCKET_SSL : 0) |
+#ifdef SW_SUPPORT_DTLS
+           (sock->dtls ? SWR_CN_DTLS_SOCKET : 0) |
+#endif
+#ifdef SW_USE_SOCKET_LINGER
+           SWR_CN_LINGER |
+#endif
+           (sock->recv_buffer ? SWR_CN_RECV_BUFFER : 0) | (conn->close_force ? SWR_CN_CLOSE_FORCE : 0) |
+           (conn->close_reset ? SWR_CN_CLOSE_RESET : 0) | (conn->peer_closed ? SWR_CN_PEER_CLOSED : 0) |
+           (conn->close_queued ? SWR_CN_CLOSE_QUEUED : 0) | (sock->ssl_closed_ ? SWR_CN_SSL_CLOSED : 0) |
+           (sock->ssl && sock->ssl_state == SW_SSL_STATE_READY && sock->is_stream() ? SWR_CN_TLS_READY_STREAM : 0) |
+           ((uint64_t) (uint32_t) sock->fd << 32);
+}
+
+// ReactorThread_onWrite's state after flushing.
+static uint64_t write_state(ReactorThreadContext *ctx) {
+    Socket *sock = ctx->sock;
+    Connection *conn = ctx->conn;
+    uint32_t length = sock->get_out_buffer_length();
+    return (conn->overflow && length < sock->buffer_size ? SWR_CN_OVERFLOW_DRAINED : 0) |
+           (ctx->serv->onBufferEmpty && conn->high_watermark && length <= ctx->port->buffer_low_watermark
+                ? SWR_CN_LOW_WATERMARK
+                : 0) |
+           (sock->send_timer ? SWR_CN_SEND_TIMER : 0) | (Buffer::empty(sock->out_buffer) ? SWR_CN_OUT_EMPTY : 0) |
+           (conn->peer_closed ? SWR_CN_PEER_CLOSED : 0) | (sock->removed ? SWR_CN_REMOVED : 0);
+}
