-namespace {
-// The native effects of Rust's swr_v1_reactor_flush and swr_v1_reactor_drain.
-struct FlushContext {
-    Reactor *reactor;
-    Event *event;
-    static FlushContext *of(void *context) {
-        return static_cast<FlushContext *>(context);
-    }
-    Socket *socket() const {
-        return event->socket;
-    }
-};
-
-swr_v1_reactor_flush_ops flush_ops(FlushContext *context) {
-    return swr_v1_reactor_flush_ops{
-        context,
-        [](void *c) { return static_cast<int>(FlushContext::of(c)->socket()->out_buffer->typed_front().kind); },
-        [](void *c) { return FlushContext::of(c)->socket()->handle_send(); },
-        [](void *c) { return FlushContext::of(c)->socket()->handle_sendfile(); },
-        [](void *c) {
-            auto context = FlushContext::of(c);
-            return context->reactor->close(context->reactor, context->socket());
-        },
-        [](void *c) {
-            auto context = FlushContext::of(c);
-            return context->reactor->trigger_close_event(context->event);
-        },
-        [](void *c) { swoole_timer_del(FlushContext::of(c)->socket()->send_timer); },
-        [](void *c) {
-            auto context = FlushContext::of(c);
-            context->reactor->remove_write_event(context->socket());
-        },
-        [](void *c) {
-            return FlushContext::of(c)->socket()->wait_event(static_cast<int>(sec2msec(Socket::default_write_timeout)),
-                                                             SW_EVENT_WRITE);
-        },
-        [](void *c) { return static_cast<bool>(FlushContext::of(c)->socket()->removed); },
-    };
-}
