-// Rust runs ReactorEpoll/ReactorKqueue/ReactorPoll::wait over the state's backend
-// (swr_v1_reactor_wait); these are its native effects and each backend's warnings.
-int Reactor::wait() {
-    const swr_v1_reactor_wait_ops ops{
-        this,
-        [](void *r) { static_cast<Reactor *>(r)->execute_begin_callback(); },
-        [](void *r, int timed_out) { static_cast<Reactor *>(r)->execute_end_callbacks(timed_out != 0); },
-#ifdef SW_USE_IOURING
-        [](void *r) { return static_cast<int>(errno == EINTR && static_cast<Reactor *>(r)->iouring_interrupt_handler); },
-        [](void *r) {
-            auto reactor = static_cast<Reactor *>(r);
-            reactor->iouring_interrupt_handler(reactor);
-        },
-#else
-        nullptr,
-        nullptr,
-#endif
-        [](void *r, int entries) {
-            auto reactor = static_cast<Reactor *>(r);
-            int epfd = swr_v1_reactor_state_descriptor(reactor->handle());
-            if (reactor->type_ == TYPE_EPOLL) {
-                swoole_log_as("ReactorEpoll::wait",
-                              swoole_sys_warning("[Reactor#%d] epoll_wait(epfd=%d, max_events=%d, timeout=%d) failed",
-                                                 reactor->id,
-                                                 epfd,
-                                                 reactor->max_event_num,
-                                                 reactor->get_timeout_msec()));
-            } else if (reactor->type_ == TYPE_KQUEUE) {
-                swoole_log_as("ReactorKqueue::wait", swoole_sys_warning("kevent(epfd=%d) failed ", epfd));
-            } else {
-                swoole_log_as("ReactorPoll::wait",
-                              swoole_sys_warning("[Reactor#%d] poll(nfds=%d, timeout=%d) failed",
-                                                 reactor->id,
-                                                 entries,
-                                                 reactor->get_timeout_msec()));
-            }
-        },
-        [](void *r, uint32_t kind, const swr_v1_reactor_event *event) {
-            auto reactor = static_cast<Reactor *>(r);
-            if (reactor->type_ == TYPE_EPOLL) {
-                static const char *const names[] = {"EPOLLIN", "EPOLLOUT", "EPOLLERR"};
-                swoole_log_as("ReactorEpoll::wait",
-                              swoole_sys_warning("%s handle failed [fd=%d, type=%d]", names[kind], event->fd, event->type));
-                return;
-            }
-            if (reactor->type_ == TYPE_KQUEUE) {
-                swoole_log_as("ReactorKqueue::wait",
-                              swoole_sys_warning("kqueue event %s socket#%d handler failed",
-                                                 kind == 0 ? "read" : "write",
-                                                 event->fd));
-            } else {
-                static const char *const names[] = {"POLLIN", "POLLOUT", "POLLERR"};
-                swoole_log_as("ReactorPoll::wait",
-                              swoole_sys_warning("%s handle failed. fd=%d", names[kind], event->fd));
-            }
-            swoole_print_backtrace_on_error();
-        },
-        [](void *r, void *socket) {
-            auto reactor = static_cast<Reactor *>(r);
-            if (reactor->type_ == TYPE_EPOLL) {
-                swr_v1_reactor_state_socket(reactor->handle(), socket, 2, 0);
-            } else {
-                reactor->del(static_cast<Socket *>(socket));
-            }
-        },
-#ifdef HAVE_KQUEUE
-        [](void *signal) { swr_reactor_dispatch_signal(static_cast<Signal *>(signal)); },
-#else
-        nullptr,
-#endif
-        [](void *, int filter) {
-            swoole_log_as("ReactorKqueue::wait",
-                          swoole_error_log(SW_LOG_WARNING, SW_ERROR_EVENT_UNKNOWN_DATA, "unknown event filter[%d]", filter));
-        },
-    };
-    return swr_v1_reactor_wait(handle(), &ops) < 0 ? SW_ERR : SW_OK;
-}
