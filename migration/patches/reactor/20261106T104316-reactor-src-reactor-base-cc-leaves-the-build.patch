-int Reactor::_writable_callback(Reactor *reactor, Event *ev) {
-    FlushContext context{reactor, ev};
-    auto ops = flush_ops(&context);
-    return swr_v1_reactor_flush(ev->socket->output(), out_queue(ev->socket), &ops);
-}
-
-void Reactor::drain_write_buffer(Socket *socket) {
-    Event event = {};
-    event.socket = socket;
-    event.fd = socket->fd;
-    FlushContext context{this, &event};
-    auto ops = flush_ops(&context);
-    swr_v1_reactor_drain(socket->output(), out_queue(socket), &ops);
-}
