-// Rust decides (swr_v1_reactor_write); these are the native effects and reports.
-ssize_t Reactor::write_func(const Reactor *reactor,
-                            Socket *socket,
-                            const swr_v1_reactor_write_payload &payload,
-                            const std::function<ssize_t()> &send_fn) {
-    struct Context {
-        const Reactor *reactor;
-        Socket *socket;
-        const std::function<ssize_t()> &send;
-    } context{reactor, socket, send_fn};
-    const swr_v1_reactor_write_ops ops{
-        &context,
-        [](void *ctx) { static_cast<Context *>(ctx)->socket->set_fd_option(1, -1); },
-        [](void *ctx) { return static_cast<Context *>(ctx)->send(); },
-        [](void *ctx) {
-            auto socket = static_cast<Context *>(ctx)->socket;
-            socket->out_buffer = new Buffer(socket->chunk_size);
-            return socket->out_buffer->handle();
-        },
-        [](void *ctx) {
-            auto context = static_cast<Context *>(ctx);
-            if (!context->socket->isset_writable_event()) {
-                context->reactor->add_write_event(context->socket);
-            }
-        },
-    };
-    auto result = swr_v1_reactor_write(socket->output(), &socket->kernel_nobufs,
-        socket->out_buffer ? socket->out_buffer->handle() : nullptr, Socket::default_buffer_size, &payload, &ops);
-    switch (result.outcome) {
-    case 0:
-        return result.value;
-    case 1:
-        swoole_error_log(SW_LOG_WARNING,
-                         SW_ERROR_PACKAGE_LENGTH_TOO_LARGE,
-                         "data packet is too large, cannot exceed the socket buffer size");
-        break;
-    case 2:
-        swoole_error_log(SW_LOG_WARNING,
-                         SW_ERROR_OUTPUT_BUFFER_OVERFLOW,
-                         "socket#%d output buffer overflow: (%u/%u)",
-                         socket->get_fd(),
-                         socket->out_buffer->length(),
-                         socket->buffer_size);
-        break;
-    case 3:
-        swoole_set_last_error(errno);
-        break;
-    default:
-        Buffer::check(result.status);
-    }
-    return SW_ERR;
-}
