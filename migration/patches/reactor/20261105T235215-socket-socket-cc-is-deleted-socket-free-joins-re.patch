-// The request, its checks and its sends are Rust's (crates/tls/src/upstream.rs).
-int Socket::sendfile_async(const char *filename, off_t offset, size_t length) {
-    std::unique_ptr<swr_v1_socket_file_request, void (*)(swr_v1_socket_file_request *)> request(
-        swr_v1_socket_file_checked(filename, offset, length), swr_v1_socket_file_free);
-    if (!request) return SW_ERR;
-    if (out_buffer == nullptr) out_buffer = new Buffer(SW_SEND_BUFFER_SIZE);
-    out_buffer->typed_sendfile(request.get(), swr_v1_socket_file_dispose);
-    request.release();
-    return SW_OK;
