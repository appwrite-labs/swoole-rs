diff --git a/src/reactor/base.cc b/src/reactor/base.cc
index 2974894..83078e9 100644
--- a/src/reactor/base.cc
+++ b/src/reactor/base.cc
@@ -586,2 +586,33 @@ void Reactor::defer(const Callback &cb, void *data) {
 
+static void socket_free_defer(void *ptr) {
+    auto *sock = static_cast<Socket *>(ptr);
+    if (!swr_v1_socket_release(sock)) {
+        swoole_sys_warning("close(%d) failed", sock->fd);
+    }
+    delete sock;
+}
+
+// Socket::free, beside the defer it hands the socket to; Rust's make_server_socket
+// calls it through the registration below.
+void Socket::free() {
+    if (recv_timer) {
+        swoole_timer_del(recv_timer);
+    }
+    if (send_timer) {
+        swoole_timer_del(send_timer);
+    }
+    delete in_buffer;
+    delete out_buffer;
+    if (swoole_event_is_available()) {
+        if (fd != -1 && !removed) {
+            swoole_event_del(this);
+        }
+        swoole_event_defer(socket_free_defer, this);
+    } else {
+        socket_free_defer(this);
+    }
+}
+static const bool socket_free_registered =
+    (swr_v1_socket_set_free([](swr_v1_socket *socket) { static_cast<Socket *>(socket)->free(); }), true);
+
