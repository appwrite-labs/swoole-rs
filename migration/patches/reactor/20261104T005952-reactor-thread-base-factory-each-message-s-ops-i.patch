@@ -611,4 +579,49 @@ static uint64_t reactor_thread_call(void *context, uint32_t op, uint64_t arg) {
 
+// The ops each received message makes, in a small frame of their own: the rest of
+// reactor_thread_call needs a large, stack-protected one.
+static uint64_t reactor_thread_hot_call(void *context, uint32_t op, uint64_t arg) {
+    auto *ctx = static_cast<ReactorThreadContext *>(context);
+    Server *serv = ctx->serv;
+    Socket *sock = ctx->sock;
+    Connection *conn = ctx->conn;
+    switch (op) {
+    case SWR_SERVER_OP_SSL_PENDING:
+        return sock->ssl && sock->ssl_state != SW_SSL_STATE_READY;
+    case SWR_SERVER_OP_TASK_INIT:
+        sw_memset_zero(&ctx->task.info, sizeof(ctx->task.info));
+        ctx->task.info.server_fd = conn->server_fd;
+        ctx->task.info.reactor_id = conn->reactor_id;
+        ctx->task.info.ext_flags = ctx->rdata->info.ext_flags;
+        ctx->task.info.type = SW_SERVER_EVENT_RECV_DATA;
+        ctx->task.info.time = conn->last_recv_time;
+        ctx->task.info.fd = conn->fd;
+        ctx->task.info.len = ctx->rdata->info.len;
+        ctx->task.data = ctx->rdata->data;
+        swoole_log_as("Server::dispatch_task", swoole_trace("dispatch task, size=%u bytes", ctx->rdata->info.len));
+        return ctx->rdata->info.len;
+    case SWR_SERVER_OP_QUEUE_ADD:
+        sw_atomic_fetch_add(&conn->recv_queued_bytes, (uint32_t) arg);
+        swoole_log_as("Server::dispatch_task",
+                      swoole_trace_log(SW_TRACE_SERVER,
+                                       "session_id=%ld, len=%d, qb=%d",
+                                       conn->session_id,
+                                       ctx->rdata->info.len,
+                                       conn->recv_queued_bytes));
+        return 0;
+    case SWR_SERVER_OP_FACTORY_DISPATCH:
+        return serv->factory_->dispatch(&ctx->task);
+    case SWR_SERVER_OP_COUNT_DISPATCH:
+        if (serv->is_process_mode()) {
+            serv->get_thread(conn->reactor_id)->dispatch_count++;
+        }
+        sw_atomic_fetch_add(&serv->gs->dispatch_count, 1);
+        sw_atomic_fetch_add(&ctx->port->gs->dispatch_count, 1);
+        return 0;
+    default:
+        return reactor_thread_call(context, op, arg);
+    }
+}
+
 static int64_t reactor_thread_run(uint32_t operation, uint64_t arg, ReactorThreadContext *ctx,
-                                  swr_v1_server_call call = reactor_thread_call) {
+                                  swr_v1_server_call call = reactor_thread_hot_call) {
     return swr_v1_server_run(operation, arg, ctx, call);
@@ -985,3 +998,3 @@ int Server::start_reactor_threads() {
         default:
-            return reactor_thread_call(c, op, arg);
+            return reactor_thread_hot_call(c, op, arg);
         }
@@ -1043,3 +1056,3 @@ void Server::join_reactor_thread() {
