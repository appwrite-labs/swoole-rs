-static bool http2_server_respond(HttpContext *ctx, const String *body) {
-    auto client = http2_sessions[ctx->fd];
-    auto stream = client->get_stream(ctx->stream_id);
-
-    zval *ztrailer =
-        sw_zend_read_property_ex(swoole_http_response_ce, ctx->response.zobject, SW_ZSTR_KNOWN(SW_ZEND_STR_TRAILER), 0);
-    if (php_swoole_array_length_safe(ztrailer) == 0) {
-        ztrailer = nullptr;
-    }
-
-    bool end_stream = (ztrailer == nullptr);
-
-    SwRsHttp2RespondFacts facts{};
-    facts.header_sent = ctx->send_header_;
-    facts.trailer_present = ztrailer != nullptr;
-    auto action = sw_rs_http2_respond_next(SW_RS_HTTP2_RESP_START, 1, &facts);
-    for (;;) {
-        switch (action) {
-        case SW_RS_HTTP2_RESP_HEADER: {
-            bool sent = stream->send_header(body, end_stream);
-            action = sw_rs_http2_respond_next(action, sent, &facts);
-            break;
-        }
-        case SW_RS_HTTP2_RESP_COMMIT_END:
-            // Headers are sent: body failures must not permit a retry.
-            ctx->end_ = 1;
-#ifdef SW_HAVE_COMPRESSION
-            if (ctx->content_compressed) {
-                body = ctx->zlib_buffer.get();
-            }
-#endif
-            facts.chunked = ctx->send_chunked;
-            facts.body_length = body->length;
-            action = sw_rs_http2_respond_next(action, 1, &facts);
-            break;
-        case SW_RS_HTTP2_RESP_EMPTY: {
-            bool sent = stream->send_end_stream_data_frame();
-            action = sw_rs_http2_respond_next(action, sent, &facts);
-            break;
-        }
-        case SW_RS_HTTP2_RESP_BODY: {
-            bool sent = stream->send_body(body, end_stream, client);
-            action = sw_rs_http2_respond_next(action, sent, &facts);
-            break;
-        }
-        case SW_RS_HTTP2_RESP_TRAILER: {
-            bool sent = stream->send_trailer();
-            action = sw_rs_http2_respond_next(action, sent, &facts);
-            break;
-        }
-        case SW_RS_HTTP2_RESP_ERROR_CLOSE:
-        case SW_RS_HTTP2_RESP_REMOVE:
-            if (action == SW_RS_HTTP2_RESP_ERROR_CLOSE) {
-                ctx->close(ctx);
-            } else {
-                client->remove_stream(stream->id);
-            }
-            facts.shutting_down = client->shutting_down;
-            facts.streams_empty = facts.shutting_down ? client->streams.empty() : false;
-            action = sw_rs_http2_respond_next(action, 1, &facts);
-            break;
-        case SW_RS_HTTP2_RESP_ERROR_SHUTDOWN:
-        case SW_RS_HTTP2_RESP_SUCCESS_SHUTDOWN: {
-            bool success = action == SW_RS_HTTP2_RESP_SUCCESS_SHUTDOWN;
-            ctx->close(ctx);
-            return success;
-        }
-        case SW_RS_HTTP2_RESP_TRUE:
-            return true;
-        default:
-            return false;
-        }
-    }
-}
