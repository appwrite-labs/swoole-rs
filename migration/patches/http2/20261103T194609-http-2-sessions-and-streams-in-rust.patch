-// The references Rust holds while it works, recycled so a response allocates none.
-template <typename T>
-struct RefPool {
-    std::vector<std::shared_ptr<T> *> spare;
-    ~RefPool() {
-        for (auto *slot : spare) {
-            delete slot;
-        }
-    }
-    std::shared_ptr<T> *hold(std::shared_ptr<T> ref) {
-        if (spare.empty()) {
-            return new std::shared_ptr<T>(std::move(ref));
-        }
-        auto *slot = spare.back();
-        spare.pop_back();
-        *slot = std::move(ref);
-        return slot;
-    }
-    void release(void *slot) {
-        auto *ref = static_cast<std::shared_ptr<T> *>(slot);
-        ref->reset();
-        spare.push_back(ref);
-    }
-};
