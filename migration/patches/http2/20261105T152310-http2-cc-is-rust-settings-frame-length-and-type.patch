-void put_default_setting(enum swHttp2SettingId id, uint32_t value) {
-    if (!sw_rs_http2_put_default_setting(id, value)) {
-        assert(0);
-    }
-}
-
-uint32_t get_default_setting(enum swHttp2SettingId id) {
-    assert(sw_rs_http2_setting_index(id) >= 0);
-    return sw_rs_http2_get_default_setting(id);
-}
-
-size_t pack_setting_frame(char *buf, const Settings &settings, bool server_side) {
-    SwRsHttp2Settings facts = {settings.header_table_size, settings.enable_push,
-        settings.max_concurrent_streams, settings.init_window_size,
-        settings.max_frame_size, settings.max_header_list_size};
-    return sw_rs_http2_pack_settings((uint8_t *) buf,
-        SW_HTTP2_FRAME_HEADER_SIZE + SW_HTTP2_SETTING_OPTION_SIZE * (server_side ? 5 : 6),
-        &facts, server_side);
-}
-
-ReturnCode unpack_setting_data(const char *buf,
-                               ssize_t length,
-                               const std::function<ReturnCode(uint16_t, uint32_t)> &cb) {
-    while (length > 0) {
-        uint16_t id;
-        uint32_t value;
-        sw_rs_http2_unpack_setting((const uint8_t *) buf, &id, &value);
-        auto rc = cb(id, value);
-        if (rc != SW_SUCCESS) { return rc; }
-        buf += sizeof(id) + sizeof(value);
-        length -= sizeof(id) + sizeof(value);
-    }
-    return SW_SUCCESS;
-}
-
-int send_setting_frame(Protocol *protocol, Socket *_socket) {
-    char setting_frame[SW_HTTP2_SETTING_FRAME_SIZE];
-    auto defaults = sw_rs_http2_default_settings();
-    size_t n = sw_rs_http2_pack_settings((uint8_t *) setting_frame, sizeof(setting_frame), &defaults, true);
-    return _socket->send(setting_frame, n, 0);
-}
