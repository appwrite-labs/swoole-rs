@@ -149,7 +150,3 @@ uint32_t get_default_setting(enum swHttp2SettingId id);
 size_t pack_setting_frame(char *buf, const Settings &settings, bool server_side);
-ReturnCode unpack_setting_data(const char *buf,
-                               ssize_t length,
-                               const std::function<ReturnCode(uint16_t, uint32_t)> &cb);
 ssize_t get_frame_length(const Protocol *protocol, network::Socket *conn, PacketLength *pl);
-int send_setting_frame(Protocol *protocol, network::Socket *conn);
 const char *get_type(int type);
@@ -166,2 +163,23 @@ static sw_inline void init_settings(Settings *settings) {
 
+// The callback runs before the next item is read, so it may rewrite that item.
+static inline ReturnCode unpack_setting_data(const char *buf,
+                                             ssize_t length,
+                                             const std::function<ReturnCode(uint16_t, uint32_t)> &cb) {
+    for (; length > 0; buf += SW_HTTP2_SETTING_OPTION_SIZE, length -= SW_HTTP2_SETTING_OPTION_SIZE) {
+        auto p = (const uint8_t *) buf;
+        auto rc = cb((p[0] << 8) | p[1], (uint32_t(p[2]) << 24) | (p[3] << 16) | (p[4] << 8) | p[5]);
+        if (rc != SW_SUCCESS) {
+            return rc;
+        }
+    }
+    return SW_SUCCESS;
+}
+
+static inline int send_setting_frame(Protocol *protocol, network::Socket *conn) {
+    Settings settings;
+    init_settings(&settings);
+    char frame[SW_HTTP2_SETTING_FRAME_SIZE];
+    return conn->send(frame, pack_setting_frame(frame, settings, true), 0);
+}
