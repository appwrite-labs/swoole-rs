-
-#include "php_swoole_cxx.h"
-
-#include "swoole_rs_phpcollections.h"
-
-#include "swoole_table.h"
-
-using namespace swoole;
-
-// The class, its method table, objects and every method are Rust
-// (crates/phpcollections), over the memory module's table. C++ lends the
-// shared allocators, Zend's string hash and PHP's error reports.
-static const swr_v1_phpcollections_table_ops table_ops = {
-    [](uint32_t rows, float conflict) -> void * {
-        Table *table = Table::make(rows, conflict);
-        if (table) {
-            table->set_hash_func([](const char *key, size_t len) -> uint64_t {
-                return zend_string_hash_val(zend::fetch_zend_string_by_val((void *) key));
-            });
-        }
-        return table;
-    },
-    [](void *table) -> uint8_t { return static_cast<Table *>(table)->create(); },
-    [](void *table) { static_cast<Table *>(table)->destroy(); },
-    [] { swoole_fatal_error(SW_ERROR_WRONG_OPERATION, "must call constructor first"); },
-    [](int32_t level, const char *message) { php_swoole_fatal_error(level, "%s", message); },
-    [](const char *key) { php_swoole_fatal_error(E_WARNING, "key[%s] is too long", key); },
-    [](const char *key, int32_t length) {
-        php_swoole_error(E_WARNING, "failed to set('%*s'), unable to allocate memory", length, key);
-    },
-    [](const char *column) { php_swoole_fatal_error(E_WARNING, "column[%s] does not exist", column); },
-};
-
-void php_swoole_table_minit(int module_number) {
-    swr_v1_phpcollections_table_minit(swoole_exception_ce, &table_ops);
-}
