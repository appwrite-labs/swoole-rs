-// Rust selects the sequence; all native effects and callbacks run after return.
-// Pinned flag values are checked rather than silently translating a new ABI.
-static_assert(SW_FORK_EXEC == 2 && SW_FORK_DAEMON == 4 && SW_FORK_PRECHECK == 8,
-              "corebase Rust fork policy requires pinned flag values");
-
-pid_t swoole_fork_exec(const std::function<void(void)> &fn) {
-    swr_v1_corebase_lifecycle_state state = {};
-    uint64_t observed = 0;
-    pid_t pid = 0;
-    while (true) {
-        switch (swr_v1_corebase_lifecycle_next(SWR_COREBASE_FORK_EXEC, &state, observed, 0)) {
-        case SWR_COREBASE_FORK_CALL:
-            pid = fork();
-            observed = pid < 0 ? 0 : (pid == 0 ? 1 : 2);
-            break;
-        case SWR_COREBASE_FAILED_EXEC:
-            return false;
-        case SWR_COREBASE_EXEC_CALLBACK:
-            fn();
-            break;
-        case SWR_COREBASE_EXIT_CHILD:
-            exit(0);
-        case SWR_COREBASE_DONE:
-            return pid;
-        default:
-            std::abort();
-        }
-    }
-}
-
-pid_t swoole_fork(int flags) {
-    swr_v1_corebase_lifecycle_state state = {};
-    uint64_t observed = 0;
-    pid_t pid = 0;
-    while (true) {
-        switch (swr_v1_corebase_lifecycle_next(SWR_COREBASE_FORK, &state, observed,
-                                              static_cast<uint32_t>(flags))) {
-        case SWR_COREBASE_OBSERVE_COROUTINE:
-            observed = swoole_coroutine_is_in();
-            break;
-        case SWR_COREBASE_REJECT_COROUTINE:
-            swoole_fatal_error(SW_ERROR_OPERATION_NOT_SUPPORT, "must be forked outside the coroutine");
-            break;
-        case SWR_COREBASE_OBSERVE_ASYNC:
-            observed = SwooleTG.async_threads != nullptr;
-            break;
-        case SWR_COREBASE_REJECT_ASYNC:
-            swoole_trace("aio_task_num=%lu, reactor=%p", SwooleTG.async_threads->task_num, sw_reactor());
-            swoole_fatal_error(SW_ERROR_OPERATION_NOT_SUPPORT, "can not fork after using async-threads");
-            break;
-        case SWR_COREBASE_FORK_CALL:
-            pid = fork();
-            observed = pid < 0 ? 0 : (pid == 0 ? 1 : 2);
-            break;
-        case SWR_COREBASE_WARN_FORK:
-            // Keep warning formatting in the original facade and at this point.
-            swoole_sys_warning("fork() failed");
-            break;
-        case SWR_COREBASE_SLEEP_RETRY:
-            sleep(1);
-            break;
-        case SWR_COREBASE_OBSERVE_TIMER:
-            observed = swoole_timer_is_available();
-            break;
-        case SWR_COREBASE_FREE_TIMER:
-            swoole_timer_free();
-            break;
-        case SWR_COREBASE_REPLACE_POOL:
-            // The child's old shared pages remain owned by the OS as before.
-            swr_v1_core_set_memory_pool(new swoole::GlobalMemory(SW_GLOBAL_MEMORY_PAGESIZE, true));
-            break;
-        case SWR_COREBASE_REOPEN_LOGGER:
-            sw_logger()->reopen();
-            break;
-        case SWR_COREBASE_OBSERVE_REACTOR:
-            observed = swoole_event_is_available();
-            break;
-        case SWR_COREBASE_FREE_FORK_REACTOR:
-            swoole_event_free();
-            swoole_trace_log(SW_TRACE_REACTOR, "reactor has been destroyed");
-            break;
-        case SWR_COREBASE_CLOSE_LOGGER:
-            sw_logger()->close();
-            break;
-        case SWR_COREBASE_CLEAR_SIGNALS:
-            swoole_signal_clear();
-            break;
-        case SWR_COREBASE_OBSERVE_AFTER_FORK:
-            observed = swoole_isset_hook(SW_GLOBAL_HOOK_AFTER_FORK);
-            break;
-        case SWR_COREBASE_CALL_AFTER_FORK:
-            swoole_call_hook(SW_GLOBAL_HOOK_AFTER_FORK, nullptr);
-            break;
-        case SWR_COREBASE_DONE:
-            return pid;
-        default:
-            std::abort();
-        }
-    }
-}
