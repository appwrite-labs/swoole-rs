-bool swoole_set_task_tmpdir(const std::string &dir) {
-    std::unique_lock<std::mutex> _lock(sw_thread_lock);
-    if (dir.empty()) (void) dir.at(0);
-    char scratch[PATH_MAX];
-    auto result = swr_v1_core_config_set_task_path(SwooleG.config_handle(),
-        reinterpret_cast<const uint8_t *>(dir.c_str()), dir.size(), reinterpret_cast<uint8_t *>(scratch), sizeof(scratch));
-    if (result.mkdir_status == 1) {
-        swoole_log_as("swoole_mkdir_recursive", swoole_sys_warning("mkdir('%s') failed", scratch));
-    } else if (result.mkdir_status == 2) {
-        swoole_log_as("swoole_mkdir_recursive", swoole_error_log(SW_LOG_WARNING, SW_ERROR_NAME_TOO_LONG,
-            "mkdir() failed. Path exceeds the limit of %d characters", PATH_MAX - 1));
-    }
-    switch (result.status) {
-    case 1: swoole_warning("wrong absolute path '%s'", dir.c_str()); break;
-    case 2: swoole_warning("create task tmp dir('%s') failed", dir.c_str()); break;
-    case 3: swoole_warning("task tmp_dir is too large, the max size is '%d'", SW_TASK_TMP_PATH_SIZE - 1); break;
-    default: if (result.status < 0) SwooleG.task_tmpfile.check(result.status); break;
-    }
-    return result.status == 0;
-}
-
-std::string swoole_get_task_tmpdir() {
-    std::unique_lock<std::mutex> _lock(sw_thread_lock);
-    auto path = swr_v1_core_config_task_path(SwooleG.config_handle());
-    return {path.data, path.length};
-}
