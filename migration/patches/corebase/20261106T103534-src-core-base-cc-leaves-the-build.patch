-// Native effect shim shared by the three real lifecycle facades. The Rust
-// cursor never spans a native callback, destructor, allocation or exception.
-static void corebase_lifecycle(uint32_t operation, uint32_t argument) {
-    swr_v1_corebase_lifecycle_state state = {};
-    uint64_t observed = 0;
-    while (true) {
-        switch (swr_v1_corebase_lifecycle_next(operation, &state, observed, argument)) {
-        case SWR_COREBASE_CLEAR_SIGNALS:
-            swoole_signal_clear();
-            break;
-        case SWR_COREBASE_CLEAN_THREAD:
-            swoole_thread_clean(true);
-            break;
-        case SWR_COREBASE_OBSERVE_LOGGER:
-            observed = SwooleG.logger != nullptr;
-            break;
-        case SWR_COREBASE_CLOSE_LOGGER:
-            SwooleG.logger->close();
-            break;
-        case SWR_COREBASE_DELETE_LOGGER:
-            delete SwooleG.logger;
-            break;
-        case SWR_COREBASE_DELETE_POOL:
-            delete sw_mem_pool();
-            break;
-        case SWR_COREBASE_RESET_GLOBAL:
-            SwooleG = {};
-            swr_v1_core_reset();
-            break;
-        case SWR_COREBASE_DONE:
-            return;
-        case SWR_COREBASE_OBSERVE_BUFFER:
-            observed = SwooleTG.buffer_stack != nullptr;
-            break;
-        case SWR_COREBASE_ALLOCATE_BUFFER:
-            SwooleTG.buffer_stack = new String(SW_STACK_BUFFER_SIZE);
-            break;
-        case SWR_COREBASE_BLOCK_SIGNALS:
-            swoole_signal_block_all();
-            break;
-        case SWR_COREBASE_PUBLISH_MAIN:
-            SwooleTG.main_thread = argument != 0;
-            break;
-        case SWR_COREBASE_OBSERVE_TIMER:
-            observed = SwooleTG.timer != nullptr;
-            break;
-        case SWR_COREBASE_FREE_TIMER:
-            swoole_timer_free();
-            break;
-        case SWR_COREBASE_OBSERVE_REACTOR:
-            observed = SwooleTG.reactor != nullptr;
-            break;
-        case SWR_COREBASE_FREE_REACTOR:
-            swoole_event_free();
-            break;
-        case SWR_COREBASE_DELETE_BUFFER:
-            delete SwooleTG.buffer_stack;
-            SwooleTG.buffer_stack = nullptr;
-            break;
-        default:
-            std::abort();
-        }
-    }
-}
-
-void swoole_clean() {
-    corebase_lifecycle(SWR_COREBASE_CLEAN, 0);
-}
