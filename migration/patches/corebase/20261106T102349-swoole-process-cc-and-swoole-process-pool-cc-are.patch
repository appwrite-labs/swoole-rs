+static thread_local uint32_t server_user_worker_id = 0;
+
+static Worker *worker_of(void *worker) {
+    return static_cast<Worker *>(worker);
+}
+
+static int host_construct_guard() {
+    Server *server = sw_server();
+    if (server && server->is_started() && server->is_master()) {
+        return 1;
+    }
+    return SwooleTG.async_threads ? 2 : 0;
+}
+
+static bool host_worker_share(void *worker) {
+    Server *server = sw_server();
+    if (!server || !server->is_worker_thread()) {
+        return false;
+    }
+    Worker *process = worker_of(worker);
+    if (server->is_user_worker()) {
+        *process = *server->get_worker(swoole_get_worker_id());
+        process->pipe_current = process->pipe_worker;
+    } else {
+        *process = *server->get_worker((server_user_worker_id++) + server->get_core_worker_num());
+        process->pipe_current = process->pipe_master;
+    }
+    process->shared = true;
+    return true;
+}
+
+static uint32_t host_worker_base() {
+    Server *server = sw_server();
+    return server && server->is_started() ? server->get_all_worker_num() : 1;
+}
+
+static int host_worker_pipe(void *worker, int socket_type) {
+    Worker *process = worker_of(worker);
+    auto *_pipe = new UnixSocket(true, socket_type);
+    if (!_pipe->ready()) {
+        delete _pipe;
+        return -1;
+    }
+    process->pipe_master = _pipe->get_socket(true);
+    process->pipe_worker = _pipe->get_socket(false);
+    process->pipe_object = _pipe;
+    process->pipe_current = process->pipe_master;
+    return process->pipe_master->fd;
+}
+
+static swr_phpprocess_worker_view host_worker_view(const void *worker) {
+    auto process = static_cast<const Worker *>(worker);
+    return {process->get_id(),
+            process->get_pid(),
+            process->pipe_current ? process->pipe_current->fd : -1,
+            process->pipe_object != nullptr,
+            process->queue != nullptr,
+            process->msgqueue_mode == SW_MSGQUEUE_BALANCE,
+            process->redirect_stdin,
+            process->redirect_stdout,
+            process->redirect_stderr};
+}
+
+static int host_queue_use(void *worker, int32_t key, int64_t mode, bool blocking, int64_t capacity) {
+    auto *queue = new MsgQueue(key);
+    if (!queue->ready()) {
+        delete queue;
+        return -1;
+    }
+    if (!blocking) {
+        queue->set_blocking(false);
+    }
+    if (capacity > 0) {
+        queue->set_capacity(capacity);
+    }
+    worker_of(worker)->queue = queue;
+    worker_of(worker)->msgqueue_mode = mode;
+    return queue->get_id();
+}
+
+static bool host_queue_free(void *worker) {
+    Worker *process = worker_of(worker);
+    if (process->queue && process->queue->destroy()) {
+        delete process->queue;
+        process->queue = nullptr;
+        return true;
+    }
+    return false;
+}
+
+static int host_fork(void *worker) {
+    pid_t pid = swoole_fork(0);
+    if (pid > 0) {
+        worker_of(worker)->set_pid(pid);
+    }
+    if (pid >= 0) {
+        worker_of(worker)->child_process = pid == 0;
+    }
+    return pid;
+}
+
+static void host_child_enter(void *worker) {
+    Worker *process = worker_of(worker);
+    process->pipe_current = process->pipe_worker;
+    process->set_pid(getpid());
+    swoole_set_worker_id(process->get_id());
+    swoole_set_worker_pid(getpid());
+    SwooleWG.worker = process;
+}
+
+static int host_pipe_close(void *worker, int64_t which) {
+    Worker *process = worker_of(worker);
+    int ret;
+    if (which == SW_PIPE_CLOSE_READ) {
+        ret = process->pipe_current->shutdown(SHUT_RD);
+    } else if (which == SW_PIPE_CLOSE_WRITE) {
+        ret = process->pipe_current->shutdown(SHUT_WR);
+    } else {
+        ret = process->pipe_object->close(which);
+    }
+    if (ret >= 0 && which == 0) {
+        delete process->pipe_object;
+        process->pipe_object = nullptr;
+        process->pipe_current = nullptr;
+    }
+    return ret;
+}
+
+static void host_signal_set(int signo, swSignalHandler handler, bool safety) {
+#ifdef SW_USE_THREAD_CONTEXT
+    swoole_event_defer([signo, handler, safety](void *) { swoole_signal_set(signo, handler, safety); }, nullptr);
+#else
+    swoole_signal_set(signo, handler, safety);
+#endif
+}
+
+static void host_signal_listen() {
