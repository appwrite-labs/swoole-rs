+// The class, its method table, objects, every method and the pool's callbacks
+// are Rust (crates/phpprocess). Rust reaches the ProcessPool through `host`.
+static ProcessPool *pool_of(void *pool) {
+    return static_cast<ProcessPool *>(pool);
+}
+
+static void *host_pool_new(uint32_t worker_num, int32_t key, int ipc_type, zval *object, bool async) {
+    auto *pool = static_cast<ProcessPool *>(emalloc(sizeof(ProcessPool)));
+    *pool = {};
+    if (pool->create(worker_num, (key_t) key, (swIPCMode) ipc_type) < 0) {
+        int error = errno;
+        efree(pool);
+        errno = error;
+        return nullptr;
+    }
+    pool->ptr = sw_zval_dup(object);
+    pool->async = async;
+    return pool;
+}
+
+static swr_phpprocess_pool_view host_pool_view(const void *pool) {
+    auto p = static_cast<const ProcessPool *>(pool);
+    return {p->started, p->async, p->ipc_mode, p->message_bus != nullptr, p->onMessage != nullptr, p->worker_num};
+}
+
+static void host_pool_configure(void *pool, HashTable *vht) {
+    zval *ztmp;
+    php_swoole_set_global_option(vht);
+    php_swoole_set_coroutine_option(vht);
+    php_swoole_set_aio_option(vht);
+    if (php_swoole_array_get_value(vht, "max_package_size", ztmp)) {
+        pool_of(pool)->set_max_packet_size(php_swoole_parse_to_size(ztmp));
+    }
+    if (php_swoole_array_get_value(vht, "max_wait_time", ztmp)) {
+        zend_long v = zval_get_long(ztmp);
+        pool_of(pool)->max_wait_time = SW_MAX(0, SW_MIN(v, UINT32_MAX));
+    }
+}
+
+static int host_pool_listen(void *pool, const char *host, int64_t port, int64_t backlog, bool unix_socket) {
+    int ret = unix_socket ? pool_of(pool)->listen(host, backlog) : pool_of(pool)->listen(host, port, backlog);
+    if (auto socket = static_cast<network::Socket *>(swr_v1_process_pool_ipc_listener(pool_of(pool)->ipc_))) {
+        socket->set_fd_option(0, 1);
+    }
+    return ret;
+}
+
+static int host_pool_protocol(void *pool, bool message_bus) {
+    ProcessPool *p = pool_of(pool);
+    if (message_bus) {
+        if (p->message_bus == nullptr && p->create_message_bus() != SW_OK) {
+            return -1;
+        }
+        p->message_bus->set_allocator(sw_zend_string_allocator());
+        p->set_protocol(SW_PROTOCOL_MESSAGE);
+    } else {
+        p->set_protocol(SW_PROTOCOL_STREAM);
+    }
+    return 0;
+}
+
+static int host_pool_run(void *pool, const swr_v1_phpprocess_pool_events *events) {
+    ProcessPool *p = pool_of(pool);
+    if (events->message) {
+        p->onMessage = reinterpret_cast<void (*)(ProcessPool *, RecvData *)>(events->message);
+    } else {
+        p->main_loop = nullptr;
+    }
+    p->onStart = reinterpret_cast<void (*)(ProcessPool *)>(events->start);
+    p->onShutdown = reinterpret_cast<void (*)(ProcessPool *)>(events->shutdown);
+    p->onWorkerStart = reinterpret_cast<void (*)(ProcessPool *, Worker *)>(events->worker_start);
+    p->onWorkerStop = reinterpret_cast<void (*)(ProcessPool *, Worker *)>(events->worker_stop);
+    if (events->worker_exit) {
+        p->onWorkerExit = reinterpret_cast<void (*)(ProcessPool *, Worker *)>(events->worker_exit);
+    }
+    if (p->start() < 0) {
+        return -1;
+    }
+    p->wait();
+    return 0;
+}
+
+static void host_worker_signals(bool term, void (*handler)(int)) {
+    if (!swoole_signal_isset(SIGTERM) && term) {
+        swoole_signal_set(SIGTERM, handler);
+    }
+    if (!swoole_signal_isset(SIGWINCH)) {
+        swoole_signal_set(SIGWINCH, handler);
+    }
+#ifdef SIGRTMIN
+    if (!swoole_signal_isset(SIGRTMIN)) {
+        swoole_signal_set(SIGRTMIN, handler);
+    }
+#endif
+}
+
+static void host_message_data(void *pool, void *message, zval *target) {
+    auto msg = static_cast<RecvData *>(message);
+    const char *data = msg->data;
+    uint32_t length = msg->info.len;
+    if (length == 0) {
+        ZVAL_EMPTY_STRING(target);
+    } else if (msg->info.flags & SW_EVENT_DATA_OBJ_PTR) {
+        zend::assign_zend_string_by_val(target, (char *) data, length);
+        pool_of(pool)->message_bus->move_packet();
+    } else {
+        ZVAL_STRINGL(target, data, length);
+    }
+}
+
+static void *host_worker_copy(void *pool, int64_t worker_id, int *pipe) {
+    ProcessPool *current_pool = pool_of(pool);
+    // A local copy, separated from shared memory; the Process object frees it.
+    auto *worker = new Worker(current_pool->workers[worker_id]);
+    *pipe = -1;
+    if (current_pool->ipc_mode == SW_IPC_UNIXSOCK) {
+        // current process
+        if (worker->get_id() == swoole_get_worker_id()) {
+            worker->pipe_current = worker->pipe_worker;
+        } else {
+            worker->pipe_current = worker->pipe_master;
+        }
+        // Forbidden to close pipe in the php layer
+        worker->pipe_object = nullptr;
+        *pipe = worker->pipe_current->fd;
+    }
+    // The message bus is enabled and forbid to read/write/close the pipeline in the php layer
+    if (current_pool->message_bus) {
+        worker->pipe_current = nullptr;
+        worker->pipe_object = nullptr;
+    }
+    // The onMessage callback is not set, use getProcess()->push()/pop() to operate msgqueue
+    if (current_pool->ipc_mode == SW_IPC_MSGQUEUE && current_pool->onMessage == nullptr) {
+        worker->queue = current_pool->queue;
+        worker->msgqueue_mode = SW_MSGQUEUE_BALANCE;
+    }
+    return worker;
+}
+
+static swr_v1_phpprocess_pool_host pool_host = {
+    nullptr,
+    &swoole_process_ce,
+    []() -> bool { return sw_server() != nullptr; },
+    []() -> int64_t { return swoole_get_worker_id(); },
+    host_pool_new,
+    [](void *pool) {
+        efree(pool_of(pool)->ptr);
+        pool_of(pool)->destroy();
+        efree(pool);
+    },
+    host_pool_view,
+    [](const void *pool) { return static_cast<zval *>(static_cast<const ProcessPool *>(pool)->ptr); },
+    [](void *pool, bool async) { pool_of(pool)->async = async; },
+    host_pool_configure,
+    host_pool_listen,
+    [](void *pool, const char *data, size_t length) { return pool_of(pool)->response(data, length); },
+    [](void *pool, int64_t worker_id, const char *data, size_t length) -> bool {
+        return pool_of(pool)->send_message(worker_id, data, length);
+    },
+    [](int signo, void (*handler)(int)) { return reinterpret_cast<uintptr_t>(swoole_signal_set(signo, handler)); },
+    host_pool_protocol,
+    host_pool_run,
+    [](void *pool) -> bool { return pool_of(pool)->detach(); },
+    [](void *pool) -> bool { return pool_of(pool)->shutdown(); },
+    [](void *pool, void *worker, int signo) { pool_of(pool)->signal(signo, static_cast<Worker *>(worker)); },
+    host_worker_signals,
+    [](bool coroutine) {
+        swoole_set_worker_type(SW_WORKER);
+        SwooleG.enable_coroutine = coroutine;
+    },
+    []() {
+        swoole_set_worker_type(SW_MASTER);
+        SwooleG.enable_coroutine = false;
+    },
+    host_message_data,
+    [](bool busy) {
+        auto *worker = sw_worker();
+        if (busy) {
+            worker->set_status_to_busy();
+        } else {
+            worker->add_request_count();
+            worker->set_status_to_idle();
+        }
+    },
+    [](const void *pool, int64_t worker_id) -> int32_t {
+        return static_cast<const ProcessPool *>(pool)->workers[worker_id].get_pid();
+    },
+    [](void *worker, int32_t pid) { static_cast<Worker *>(worker)->set_pid(pid); },
+    host_worker_copy,
+};
+
+// The pool's Rust worker loops call PHP inside this trap and leave before re-raising.
+extern "C" int swr_zend_try(void (*body)(void *), void *arg);
+
+void php_swoole_process_pool_minit(int module_number) {
+    swr_v1_process_set_bailout(swr_zend_try, []() { zend_bailout(); });
+    pool_host.exception = swoole_exception_ce;
+    swr_v1_phpprocess_pool_minit(&pool_host);
+}
+
+ProcessPool *sw_process_pool() {
+    return static_cast<ProcessPool *>(swr_v1_phpprocess_pool_current());
+}
