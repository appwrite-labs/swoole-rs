+inline void hook_add(void **hooks, int type, const Callback &func, int push_back) {
+    if (!hooks[type]) {
+        hooks[type] = new std::list<Callback>;
+    }
+    auto *l = static_cast<std::list<Callback> *>(hooks[type]);
+    push_back ? l->push_back(func) : l->push_front(func);
+}
+inline void hook_call(void **hooks, int type, void *arg) {
+    if (hooks[type]) {
+        for (auto &i : *static_cast<std::list<Callback> *>(hooks[type])) {
+            i(arg);
+        }
+    }
+}
