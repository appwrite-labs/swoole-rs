-        for (size_t i = 0; i < plan.port_length; ++i) {
-            if (!facet.is(std::ctype_base::digit, url[plan.port_offset + i])) {
-                digits = false;
-                break;
-            }
-        }
-        if (digits) {
-            std::string host = url.substr(plan.host_offset, plan.host_length);
-            int port = std::stoi(url.substr(plan.port_offset, plan.port_length));
-            type = plan.kind == 2 ? (plan.datagram ? SW_SOCK_UDP6 : SW_SOCK_TCP6)
-                                  : (plan.datagram ? SW_SOCK_UDP : SW_SOCK_TCP);
-            return assign(type, host, port);
-        }
+    if (error != 0) {
+        swoole_set_last_error(error);
+        return false;
     }
-    swoole_error_log(SW_LOG_NOTICE, SW_ERROR_BAD_HOST_ADDR, "Invalid address '%s'", url.c_str());
-    return false;
+    return true;
 }
