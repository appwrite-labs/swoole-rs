-static int Client_onWrite(Reactor *reactor, Event *event) {
-    struct Context {
-        Client *cli;
-        Reactor *reactor;
-        Event *event;
-        Socket *saved_socket;
-    };
-    auto *cli = (Client *) event->socket->object;
-    Context context{cli, reactor, event, cli->socket};
-    const swr_v1_clients_write_ops ops{
-        &context,
-        cli->state_.get(),
-        [](void *c) -> bool {
-            auto *ctx = static_cast<Context *>(c);
-            return ctx->cli->open_ssl && ctx->saved_socket->ssl_state == SW_SSL_STATE_WAIT_STREAM;
-        },
-        [](void *c) -> int32_t { return static_cast<Context *>(c)->cli->ssl_handshake(); },
-        [](void *c) -> bool { return static_cast<Context *>(c)->saved_socket->ssl_state == SW_SSL_STATE_READY; },
-        [](void *c) -> bool { return static_cast<Context *>(c)->saved_socket->ssl_want_read; },
-        [](void *c) { swoole_event_set(static_cast<Context *>(c)->event->socket, SW_EVENT_READ); },
-        [](void *c) -> int32_t {
-            auto *ctx = static_cast<Context *>(c);
-            return Reactor::_writable_callback(ctx->reactor, ctx->event);
-        },
-        [](void *c) -> bool {
-            auto *ctx = static_cast<Context *>(c);
-            return ctx->cli->onBufferEmpty && ctx->cli->high_watermark &&
-                   ctx->saved_socket->get_out_buffer_length() <= ctx->cli->buffer_low_watermark;
-        },
-        [](void *c) {
-            Client *cli = static_cast<Context *>(c)->cli;
-            cli->high_watermark = false;
-            cli->onBufferEmpty(cli);
-        },
-        [](void *c) -> int32_t {
-            int error;
-            const int result = static_cast<Context *>(c)->saved_socket->get_option(SOL_SOCKET, SO_ERROR, &error);
-            swoole_set_last_error(error);
-            return result;
-        },
-        [](void *c) { swoole_sys_warning("getsockopt(%d) failed", static_cast<Context *>(c)->event->fd); },
-        [](void *) -> bool { return swoole_get_last_error() == 0; },
-        [](void *c) -> bool {
-            Client *cli = static_cast<Context *>(c)->cli;
-            return cli->socks5_proxy && cli->socks5_proxy->state == SW_SOCKS5_STATE_WAIT;
-        },
-        [](void *c) -> int32_t {
-            Client *cli = static_cast<Context *>(c)->cli;
-            const auto length = cli->socks5_proxy->pack_negotiate_request();
-            cli->socks5_proxy->state = SW_SOCKS5_STATE_HANDSHAKE;
-            return cli->send(cli->socks5_proxy->buf, length, 0);
-        },
-        [](void *c) -> bool {
-            Client *cli = static_cast<Context *>(c)->cli;
-            return cli->http_proxy && cli->http_proxy->state == SW_HTTP_PROXY_STATE_WAIT;
-        },
-        [](void *c) -> int32_t {
-            Client *cli = static_cast<Context *>(c)->cli;
-            auto proxy_buf = sw_tg_buffer();
-            auto host_name = cli->get_http_proxy_host_name();
-            const size_t length = cli->http_proxy->pack(proxy_buf, host_name);
-            swoole_trace_log(SW_TRACE_HTTP_CLIENT, "proxy request: <<EOF\n%.*sEOF", (int) length, proxy_buf->str);
-            return cli->send(proxy_buf->str, length, 0);
-        },
-        [](void *c) -> bool { return static_cast<Context *>(c)->cli->open_ssl; },
-        [](void *c) { static_cast<Context *>(c)->saved_socket->ssl_state = SW_SSL_STATE_WAIT_STREAM; },
-        [](void *c) { execute_onConnect(static_cast<Context *>(c)->cli); },
-        [](void *c, bool ssl) {
-            Client *cli = static_cast<Context *>(c)->cli;
-            if (ssl) {
-                swoole_set_last_error(SW_ERROR_SSL_HANDSHAKE_FAILED);
-            }
-            cli->set_active(false);
-            cli->close();
-            cli->onError(cli);
-        },
-    };
-    return swr_v1_clients_on_write(&ops);
-}
