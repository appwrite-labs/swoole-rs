-static int Client_onStreamRead(Reactor *reactor, Event *event) {
-    struct Context {
-        Client *cli;
-        Event *event;
-        char *buf;
-        ssize_t buf_size;
-        ssize_t n;
-        Socket *protocol_socket;
-    };
-    auto *cli = (Client *) event->socket->object;
-    Context context{
-        cli, event, cli->buffer->str + cli->buffer->length, ssize_t(cli->buffer->size - cli->buffer->length), 0, nullptr};
-    const swr_v1_clients_read_ops ops{
-        &context,
-        cli->state_.get(),
-        cli->open_ssl,
-        [](void *c) -> bool {
-            Client *cli = static_cast<Context *>(c)->cli;
-            return cli->http_proxy && cli->http_proxy->state != SW_HTTP_PROXY_STATE_READY;
-        },
-        [](void *c) -> ssize_t {
-            auto *ctx = static_cast<Context *>(c);
-            return ctx->n = ctx->event->socket->recv(ctx->buf, ctx->buf_size, 0);
-        },
-        [](void *c, ssize_t n) -> bool {
-            Client *cli = static_cast<Context *>(c)->cli;
-            cli->buffer->length += n;
-            return cli->http_proxy->handshake(cli->buffer);
-        },
-        [](void *c) {
-            Client *cli = static_cast<Context *>(c)->cli;
-            cli->http_proxy->state = SW_HTTP_PROXY_STATE_READY;
-            cli->buffer->clear();
-        },
-        [](void *c) -> bool {
-            Client *cli = static_cast<Context *>(c)->cli;
-            return cli->socks5_proxy && cli->socks5_proxy->state != SW_SOCKS5_STATE_READY;
-        },
-        [](void *c, ssize_t n) -> bool {
-            auto *ctx = static_cast<Context *>(c);
-            ctx->cli->buffer->length += n;
-            return ctx->cli->socks5_handshake(ctx->buf, ctx->buf_size);
-        },
-        [](void *c) -> bool { return static_cast<Context *>(c)->cli->socks5_proxy->state == SW_SOCKS5_STATE_READY; },
-        [](void *c) { static_cast<Context *>(c)->cli->buffer->clear(); },
-        [](void *c) -> bool {
-            Client *cli = static_cast<Context *>(c)->cli;
-            return cli->open_ssl && cli->socket->ssl_state != SW_SSL_STATE_READY;
-        },
-        [](void *c) -> ssize_t { return static_cast<Context *>(c)->cli->ssl_handshake(); },
-        [](void *c) -> bool { return static_cast<Context *>(c)->cli->socket->ssl_state == SW_SSL_STATE_READY; },
-        [](void *c) -> bool {
-            Client *cli = static_cast<Context *>(c)->cli;
-            return cli->open_eof_check || cli->open_length_check;
-        },
-        [](void *c) -> ssize_t {
-            auto *ctx = static_cast<Context *>(c);
-            Client *cli = ctx->cli;
-            ctx->protocol_socket = cli->socket;
-            const ssize_t n = cli->open_eof_check
-                                  ? cli->protocol.recv_with_eof_protocol(ctx->protocol_socket, cli->buffer)
-                                  : cli->protocol.recv_with_length_protocol(ctx->protocol_socket, cli->buffer);
-            // A callback that deleted the client (a PHP close frees it) leaves only the
-            // socket, whose free is deferred: nothing of the client may be read after it.
-            return ctx->protocol_socket->object == nullptr ? 0 : n;
-        },
-        [](void *c) -> bool {
-            auto *ctx = static_cast<Context *>(c);
-            return ctx->protocol_socket->removed == 0 && ctx->cli->remove_delay;
-        },
-        [](void *c) {
-            Client *cli = static_cast<Context *>(c)->cli;
-            cli->sleep();
-            cli->remove_delay = false;
-        },
-        [](void *c) -> int32_t {
-            const int error = static_cast<Context *>(c)->event->socket->catch_read_error(errno);
-            return error == SW_ERROR ? SWR_CLIENTS_READ_ERROR : (error == SW_CLOSE ? SWR_CLIENTS_READ_CLOSE : -1);
-        },
-        [](void *c) { swoole_sys_warning("Read from socket[%d] failed", static_cast<Context *>(c)->event->fd); },
-        [](void *c) -> int32_t { return static_cast<Context *>(c)->cli->close(); },
-        [](void *c, ssize_t n) {
-            auto *ctx = static_cast<Context *>(c);
-            ctx->cli->onReceive(ctx->cli, ctx->buf, n);
-        },
-        [](void *c) { execute_onConnect(static_cast<Context *>(c)->cli); },
-        [](void *c, uint32_t kind) {
-            Client *cli = static_cast<Context *>(c)->cli;
-            swoole_set_last_error(kind == SWR_CLIENTS_FAIL_HTTP    ? SW_ERROR_HTTP_PROXY_HANDSHAKE_ERROR
-                                  : kind == SWR_CLIENTS_FAIL_SOCKS ? SW_ERROR_SOCKS5_HANDSHAKE_FAILED
-                                                                   : SW_ERROR_SSL_HANDSHAKE_FAILED);
-            cli->set_active(false);
-            cli->close();
-            if (cli->onError) {
-                cli->onError(cli);
-            }
-        },
-    };
-    return swr_v1_clients_on_read(&ops);
-}
