-        // A user callback that throws stops the connect; the exception is rethrown below.
-        static bool guarded(void *c, void (*call)(Client *)) {
-            auto *ctx = static_cast<Context *>(c);
-            try {
-                call(ctx->cli);
-                return true;
-            } catch (...) {
-                ctx->thrown = std::current_exception();
-                return false;
-            }
-        }
-    } context{cli, host, port, timeout, udp_connect, nullptr};
-    const swr_v1_clients_udp_connect_ops ops{
-        &context,
-        cli->state_.get(),
-        timeout,
-        udp_connect,
-        [](void *c) {
-            auto *ctx = static_cast<Context *>(c);
-            ctx->cli->set_timeout(ctx->timeout);
-        },
-        [](void *c) {
-            auto *ctx = static_cast<Context *>(c);
-            ctx->cli->socket->set_kernel_timeout(ctx->timeout);
-        },
-        [](void *c) {
-            auto *ctx = static_cast<Context *>(c);
-            ctx->cli->sock_flags_ = ctx->udp_connect;
-        },
-        [](void *c) -> int32_t {
-            auto *ctx = static_cast<Context *>(c);
-            return Client_inet_addr(ctx->cli, ctx->host, ctx->port);
-        },
-        [](void *c) -> bool { return bool(static_cast<Context *>(c)->cli->onReceive); },
-        [](void *) { swoole_warning("`onReceive` callback have not set"); },
-        [](void *c) -> bool { return bool(static_cast<Context *>(c)->cli->onError); },
-        [](void *) { swoole_warning("`onError` callback have not set"); },
-        [](void *c) -> int32_t { return Client_dns_lookup(static_cast<Context *>(c)->cli); },
-        [](void *c) { static_cast<Context *>(c)->cli->socket->set_buffer_size(Socket::default_buffer_size); },
-        [](void *c) {
-            auto *ctx = static_cast<Context *>(c);
-            ctx->cli->socket->set_timeout(ctx->timeout);
-        },
-        [](void *c) -> bool { return static_cast<Context *>(c)->cli->socket->socket_type == SW_SOCK_UNIX_DGRAM; },
-        [](void *c) -> int32_t {
-            Client *cli = static_cast<Context *>(c)->cli;
-            sockaddr_un *unix_address = &cli->socket->info.addr.un;
-            sprintf(unix_address->sun_path, "/tmp/swoole-client.%d.%d.sock", getpid(), cli->socket->fd);
-            unix_address->sun_family = AF_UNIX;
-            unlink(unix_address->sun_path);
-            return bind(cli->socket->fd, reinterpret_cast<sockaddr *>(unix_address), sizeof(cli->socket->info.addr.un));
-        },
-        [](void *c) {
-            swoole_sys_warning("bind(%s) failed", static_cast<Context *>(c)->cli->socket->info.addr.un.sun_path);
-        },
-        [](void *c) -> bool { return static_cast<Context *>(c)->cli->open_ssl; },
-        [](void *c) -> bool {
-#ifdef SW_SUPPORT_DTLS
-            static_cast<Context *>(c)->cli->enable_dtls();
-            return true;
-#else
-            swoole_warning("DTLS support require openssl-1.1 or later");
-            return false;
-#endif
-        },
-        [](void *c) -> int32_t {
-            Client *cli = static_cast<Context *>(c)->cli;
-            return cli->socket->connect(cli->server_addr);
-        },
-        [](void *c) { static_cast<Context *>(c)->cli->socket->clean(); },
-        [](void *c) {
-            Client *cli = static_cast<Context *>(c)->cli;
-            cli->socket->removed = 1;
-            cli->close();
-        },
-        [](void *c) -> bool { return Context::guarded(c, [](Client *cli) { cli->onError(cli); }); },
-        [](void *c) -> bool { return bool(static_cast<Context *>(c)->cli->onConnect); },
-        [](void *c) -> int32_t { return swoole_event_add(static_cast<Context *>(c)->cli->socket, SW_EVENT_READ); },
-        [](void *c) -> bool { return Context::guarded(c, [](Client *cli) { execute_onConnect(cli); }); },
-        [](void *c) -> int32_t { return static_cast<Context *>(c)->cli->ssl_handshake(); },
-    };
-    const int result = swr_v1_clients_udp_connect(&ops);
-    if (context.thrown) {
-        std::rethrow_exception(context.thrown);
-    }
-    return result;
-}
