-#include "swoole_socket.h"
-
-#include "swoole_rs_clients.h"
-#include <stdexcept>
-
-namespace swoole {
-namespace network {
-static_assert(INET6_ADDRSTRLEN == 46, "Rust Address scratch capacity");
-
-
-const char *Address::addr_str(int family, const void *addr) {
-    return swr_v1_clients_address_string(family, addr);
-}
-
-bool Address::verify_ip(int family, const std::string &str) {
-    return swr_v1_clients_address_verify(family, str.c_str());
-}
-
-bool Address::verify_port(const int port, const bool for_connect) {
-    return swr_v1_clients_port(port, for_connect);
-}
-
-const char *Address::get_addr() const {
-    return swr_v1_clients_address_host(this);
-}
-
-bool Address::empty() const {
-    return swr_v1_clients_address_empty(this);
-}
-
-int Address::get_port() const {
-    return swr_v1_clients_address_port(this);
-}
-
-void Address::set_port(int _port) {
-    swr_v1_clients_address_set_port(this, _port);
-}
-
-static int address_resolve(int family, const char *name, char *address) {
-    return gethostbyname(family, name, address);
-}
-
-bool Address::assign(SocketType _type, const std::string &_host, int _port, bool _resolve_name) {
-    type = _type;
-    const int error = swr_v1_clients_address_assign(
-        &addr, &len, _type, _host.c_str(), _host.length(), _port, _resolve_name ? address_resolve : nullptr);
-    if (error != 0) {
-        swoole_set_last_error(error);
-        return false;
-    }
-    return true;
-}
-
-const char *Address::type_str(SocketType type) {
-    return swr_v1_clients_address_type(type);
-}
-
-bool Address::assign(const std::string &url) {
-    const auto plan = swr_v1_clients_url(reinterpret_cast<const uint8_t *>(url.data()), url.size());
-    if (plan.outcome == SWR_CLIENTS_URL_PORT_RANGE) {
-        throw std::out_of_range("stoi");
-    }
-    if (plan.outcome == SWR_CLIENTS_URL_INVALID) {
-        swoole_error_log(SW_LOG_NOTICE, SW_ERROR_BAD_HOST_ADDR, "Invalid address '%s'", url.c_str());
-        return false;
-    }
-    type = static_cast<SocketType>(plan.kind);
-    return assign(type, url.substr(plan.host_offset, plan.host_length), plan.port);
-}
-
-bool Address::is_loopback_addr() const {
-    return swr_v1_clients_address_loopback(this);
-}
