-std::vector<std::string> dns_lookup_impl_with_socket(const char *domain, int family, double timeout) {
-    std::vector<std::string> result;
-    auto server = swoole_dns_server();
-    if (server.host.empty()) {
-        if (!swoole_load_resolv_conf()) {
-            swoole_set_last_error(SW_ERROR_DNSLOOKUP_NO_SERVER);
-            return result;
-        }
-        server = swoole_dns_server();
-    }
-    Socket sock(SW_SOCK_UDP);
-    if (timeout > 0) {
-        sock.set_timeout(timeout);
-    }
-    struct Exchange {
-        Socket *sock;
-        std::vector<std::string> *result;
-        const swoole::DnsServer *server;
-    } exchange{&sock, &result, &server};
-    const int error = swr_v1_clients_dns_query(
-        domain,
-        family,
-        dns_request_id++,
-        &exchange,
-        [](void *context, const uint8_t *data, size_t length) {
-            auto *exchange = static_cast<Exchange *>(context);
-            return exchange->sock->sendto(
-                exchange->server->host.c_str(), exchange->server->port, reinterpret_cast<const char *>(data), length) != 0;
-        },
-        [](void *context, uint8_t *data, size_t capacity) -> ssize_t {
-            auto sock = static_cast<Exchange *>(context)->sock;
-            const ssize_t n = sock->recv(data, capacity);
-            return n <= 0 && sock->errCode == ECANCELED ? -ECANCELED : n;
-        },
-        [](void *context, const uint8_t *text, size_t length) {
-            static_cast<Exchange *>(context)->result->emplace_back(reinterpret_cast<const char *>(text), length);
-        },
-        std::numeric_limits<char>::is_signed);
-    if (error == -1) {
-        swoole_warning("invalid domain[%s]", domain);
-    } else if (error != 0) {
-        swoole_set_last_error(error);
-    }
-    return result;
-}
