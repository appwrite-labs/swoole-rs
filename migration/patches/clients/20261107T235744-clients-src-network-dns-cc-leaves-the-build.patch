-// The DNS server and the hosts file are crates/clients' (dns.rs).
-SW_API bool swoole_load_resolv_conf() {
-    const int found = swr_v1_clients_load_resolv_conf(SwooleG.dns_resolvconf_path.c_str());
-    if (found < 0) {
-        swoole_sys_warning("fopen(%s) failed", SwooleG.dns_resolvconf_path.c_str());
-    }
-    return found > 0;
-}
