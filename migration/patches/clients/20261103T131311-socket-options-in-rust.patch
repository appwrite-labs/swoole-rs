+void swoole_socket_coro_set_flag(void *socket, int flag, bool value) {
+    auto *sock = socket_of(socket);
+    (flag == 0 ? sock->open_length_check : (flag == 1 ? sock->open_eof_check : sock->http2)) = value;
+}
+
+static_assert(sizeof(swoole::Protocol) == 64 && offsetof(swoole::Protocol, get_package_length) == 48,
+              "crates/phpclients mirrors swoole::Protocol");
+
+void *swoole_socket_coro_protocol(void *socket) {
+    return &socket_of(socket)->protocol;
+}
+
+void swoole_socket_coro_protocol_preset(void *socket, int kind) {
+    auto *protocol = &socket_of(socket)->protocol;
+    if (kind == 0) {
+        swoole::mqtt::set_protocol(protocol);
+    } else {
+        protocol->get_package_length = swoole::Protocol::default_length_func;
+    }
+}
+
+void swoole_socket_coro_length_callable(void *call) {
+    auto *args = static_cast<swoole_socket_coro_callable *>(call);
+    auto *sock = socket_of(args->socket);
+    auto cb = sw_callable_create(args->value);
+    if (cb) {
+        sock->protocol.get_package_length = php_swoole_length_func;
+        if (sock->protocol.private_data_1) {
+            sw_callable_free(sock->protocol.private_data_1);
+        }
+        sock->protocol.private_data_1 = cb;
+        sock->protocol.package_length_size = 0;
+        sock->protocol.package_length_type = '\0';
+        sock->protocol.package_length_offset = SW_IPC_BUFFER_SIZE;
+    }
+}
+
+bool swoole_socket_coro_set_option(void *socket, int level, int name, int value) {
+    return socket_of(socket)->set_option(level, name, value);
+}
+
+void swoole_socket_coro_set_timeout(void *socket, double timeout, int type) {
+    socket_of(socket)->set_timeout(timeout, type);
+}
+
+double swoole_socket_coro_get_timeout(void *socket, int type) {
+    return socket_of(socket)->get_timeout((swoole::TimeoutType) type);
+}
+
+void swoole_socket_coro_proxy(void *socket, bool http, const char *host, size_t host_length, int64_t port,
+                              const char *user, size_t user_length, const char *password, size_t password_length) {
+    std::string h(host, host_length), u(user, user_length), p(password, password_length);
+    if (http) {
+        socket_of(socket)->set_http_proxy(h, port, u, p);
+    } else {
+        socket_of(socket)->set_socks5_proxy(h, port, u, p);
+    }
+}
+
+bool swoole_socket_coro_ssl_option(void *socket, int option, const char *text, size_t length, int64_t value) {
+    auto *sock = socket_of(socket);
+    std::string str = text ? std::string(text, length) : std::string();
+    switch (option) {
+    case SWR_PHPCLIENTS_SSL_ENABLE:
+        return sock->enable_ssl_encrypt();
+    case SWR_PHPCLIENTS_SSL_ENABLED:
+        return sock->ssl_is_enable();
+    case SWR_PHPCLIENTS_SSL_PROTOCOLS:
+        sock->set_ssl_protocols(value);
+        break;
+    case SWR_PHPCLIENTS_SSL_DISABLE_COMPRESS:
+        sock->set_ssl_disable_compress(value);
+        break;
+    case SWR_PHPCLIENTS_SSL_CERT_FILE:
+        return sock->set_ssl_cert_file(str);
+    case SWR_PHPCLIENTS_SSL_KEY_FILE:
+        return sock->set_ssl_key_file(str);
+    case SWR_PHPCLIENTS_SSL_HAS_CERT_FILE:
+        return !sock->get_ssl_cert_file().empty();
+    case SWR_PHPCLIENTS_SSL_HAS_KEY_FILE:
+        return !sock->get_ssl_key_file().empty();
+    case SWR_PHPCLIENTS_SSL_PASSPHRASE:
+        sock->set_ssl_passphrase(str);
+        break;
+#ifdef SSL_CTRL_SET_TLSEXT_HOSTNAME
+    case SWR_PHPCLIENTS_SSL_HOST_NAME:
+        sock->set_tls_host_name(str);
+        break;
+#endif
+    case SWR_PHPCLIENTS_SSL_VERIFY_PEER:
+        sock->set_ssl_verify_peer(value);
+        break;
+    case SWR_PHPCLIENTS_SSL_ALLOW_SELF_SIGNED:
+        sock->set_ssl_allow_self_signed(value);
+        break;
+    case SWR_PHPCLIENTS_SSL_CAFILE:
+        sock->set_ssl_cafile(str);
+        break;
+    case SWR_PHPCLIENTS_SSL_CAPATH:
+        sock->set_ssl_capath(str);
+        break;
+    case SWR_PHPCLIENTS_SSL_VERIFY_DEPTH:
+        sock->set_ssl_verify_depth(value);
+        break;
+    case SWR_PHPCLIENTS_SSL_CIPHERS:
+        sock->set_ssl_ciphers(str);
+        break;
+    case SWR_PHPCLIENTS_SSL_ECDH_CURVE:
+        sock->set_ssl_ecdh_curve(str);
+        break;
+#ifdef OPENSSL_IS_BORINGSSL
+    case SWR_PHPCLIENTS_SSL_GREASE:
+        sock->set_ssl_grease(value);
+        break;
+#endif
+    default:
+        return false;
+    }
+    return true;
+}
+
+bool swoole_socket_coro_ssl_supports(int option) {
+    switch (option) {
+#ifdef SSL_CTRL_SET_TLSEXT_HOSTNAME
+    case SWR_PHPCLIENTS_SSL_HOST_NAME:
+        return true;
+#endif
+#ifdef OPENSSL_IS_BORINGSSL
+    case SWR_PHPCLIENTS_SSL_GREASE:
+        return true;
+#endif
+    default:
+        return false;
+    }
+}
+
+void swoole_socket_coro_sockopt(void *call) {
+    auto *args = static_cast<swoole_socket_coro_sockopt_call *>(call);
+    auto *sock = socket_of(args->socket);
+    switch (args->op) {
+    case 0:
+        args->result = php_do_getsockopt_ipv6_rfc3542(sock, args->level, args->name, args->value);
+        break;
+    case 1:
+        args->result = php_do_setsockopt_ip_mcast(sock, args->level, args->name, args->value);
+        break;
+    case 2:
+        args->result = php_do_setsockopt_ipv6_mcast(sock, args->level, args->name, args->value);
+        break;
+    case 3:
+        args->result = php_do_setsockopt_ipv6_rfc3542(sock, args->level, args->name, args->value);
+        break;
+    default:
+        args->result = php_add4_to_if_index((struct in_addr *) args->address, sock, &args->index);
+        break;
+    }
+}
+
+int swoole_socket_coro_tcp_info(void *socket, int name, zval *array) {
+#ifdef TCP_INFO
+    if (name != TCP_INFO) {
+        return 0;
+    }
+    tcp_info info;
+    socklen_t len = sizeof(info);
+    if (socket_of(socket)->get_socket()->get_option(SOL_TCP, TCP_INFO, &info, &len) < 0) {
+        return -1;
+    }
+    array_init(array);
+    for (const auto &iter : sw_socket_parse_tcp_info(&info)) {
+        add_assoc_long_ex(array, iter.first.c_str(), iter.first.length(), (zend_long) iter.second);
+    }
+    return 1;
+#else
+    return 0;
+#endif
+}
+
+void swoole_socket_coro_import(void *call) {
+    auto *args = static_cast<swoole_socket_coro_import_call *>(call);
+    args->object = php_swoole_create_socket_from_fd(args->fd, (swSocketType) args->type);
+    if (args->object) {
+        auto *sock = socket_coro_fetch_object(args->object);
+        ZVAL_COPY(&sock->zstream, args->stream);
+        sock->socket->get_socket()->nonblock = args->nonblock;
+    }
 }
