-#error "require cURL version 7.56.0 or later"
-#endif
-
-CURLcode swoole_curl_easy_perform(CURL *cp);
-php_curl *swoole_curl_get_handle(zval *zid, bool exclusive = true, bool required = true);
-SW_EXTERN_C_BEGIN
-void swoole_curl_easy_reset(CURL *curl);
-SW_EXTERN_C_END
-
-namespace swoole {
-namespace curl {
-
-class Multi;
-
-// Rust's (crates/curl): ext/curl reads and sets multi.
-struct Handle {
-    CURL *cp;
-    Multi *multi;
-    Multi *easy_multi;
-};
-
-static inline Handle *get_handle(CURL *cp) {
-    return reinterpret_cast<Handle *>(swr_v1_curl_get_handle(cp));
-}
-
-static inline Handle *create_handle(CURL *cp) {
-    return reinterpret_cast<Handle *>(swr_v1_curl_create_handle(cp));
-}
-
-static inline void destroy_handle(CURL *cp) {
-    swr_v1_curl_destroy_handle(cp);
-}
-
-// The multi engine in Rust (crates/curl); C++ names it and raises the fatal
-// errors of a bound or missing coroutine.
-class Multi {
-    swr_v1_curl_multi *rs() {
-        return reinterpret_cast<swr_v1_curl_multi *>(this);
-    }
-    static swr_v1_curl_handle *rs(Handle *handle) {
-        return reinterpret_cast<swr_v1_curl_handle *>(handle);
-    }
-
-  public:
-    Multi() = delete;
-    static Multi *create();
-    static void destroy(Multi *multi) {
-        swr_v1_curl_multi_free(multi->rs());
-    }
-
-    CURLM *get_multi_handle() {
-        return static_cast<CURLM *>(swr_v1_curl_multi_handle(rs()));
-    }
-
-    int get_running_handles() {
-        return swr_v1_curl_multi_running(rs());
-    }
-
-    CURLMcode add_handle(Handle *handle) {
-        return static_cast<CURLMcode>(swr_v1_curl_multi_add_handle(rs(), rs(handle)));
-    }
-
-    CURLMcode remove_handle(Handle *handle) {
-        return static_cast<CURLMcode>(swr_v1_curl_multi_remove_handle(rs(), rs(handle)));
-    }
-
-    Coroutine *check_bound_co() {
-        auto co = static_cast<Coroutine *>(swr_v1_curl_multi_co(rs()));
-        if (co) {
-            Coroutine::set_socket_bound_cid(co->get_cid());
-            swoole_fatal_error(SW_ERROR_CO_HAS_BEEN_BOUND,
-                               "This cURL handle is currently executing in coroutine#%ld, cannot be operated",
-                               co->get_cid());
-            return nullptr;
-        }
-        return Coroutine::get_current_safe();
-    }
-
-    CURLMcode perform() {
-        check_bound_co();
-        return static_cast<CURLMcode>(swr_v1_curl_multi_perform(rs()));
-    }
-
-    long select(php_curlm *mh, double timeout = -1) {
-        if (zend_llist_count(&mh->easyh) == 0) {
-            return 0;
-        }
-        return swr_v1_curl_multi_select(rs(), check_bound_co(), timeout);
-    }
-
-    CURLcode exec(Handle *handle) {
-        int result = swr_v1_curl_multi_exec(rs(), rs(handle));
-        if (result < 0) {
-            check_bound_co();
-        }
-        return static_cast<CURLcode>(result);
-    }
-};
-};  // namespace curl
-}  // namespace swoole
-#endif
