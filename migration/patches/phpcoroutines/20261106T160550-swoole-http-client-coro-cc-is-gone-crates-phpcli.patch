-// Named as upstream's parser callback, whose warnings this keeps.
-static void *http_parser_on_body(const char *download_file_name, zend_long download_offset) {
-    auto *fp = new AsyncFile(download_file_name, O_CREAT | O_WRONLY, 0664);
-    if (!fp->ready()) {
-        swoole_sys_warning("open(%s, O_CREAT | O_WRONLY) failed", download_file_name);
-        delete fp;
-        return nullptr;
-    }
-    if (download_offset == 0) {
-        if (!fp->truncate(0)) {
-            swoole_sys_warning("ftruncate(%s) failed", download_file_name);
-            delete fp;
-            return nullptr;
-        }
-    } else {
-        if (!fp->set_offset(download_offset)) {
-            swoole_sys_warning("fseek(%s, %jd) failed", download_file_name, (intmax_t) download_offset);
-            delete fp;
-            return nullptr;
-        }
-    }
-    return fp;
-}
