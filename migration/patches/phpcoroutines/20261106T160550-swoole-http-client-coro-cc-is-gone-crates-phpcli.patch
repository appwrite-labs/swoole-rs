-int swoole_http_client_coro_call(void *callable, zend_object *client, const char *data, size_t length) {
-    zval argv[2];
-    ZVAL_OBJ(&argv[0], client);
-    ZVAL_STRINGL(&argv[1], data, length);
-    volatile int result = 1;
-    zend_try {
-        result = static_cast<zend::Callable *>(callable)->call(2, argv, nullptr) ? 0 : 1;
-    }
-    zend_catch {
-        result = 2;
-    }
-    zend_end_try();
-    zval_ptr_dtor(&argv[1]);
-    return result;
-}
