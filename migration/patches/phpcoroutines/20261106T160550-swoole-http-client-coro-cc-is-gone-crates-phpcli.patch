-// The class, its method table, object, state and every method are Rust
-// (crates/phpclients, http_client.rs). Methods that can run the `write_func`
-// callback are trampolines here, which the Rust table names, so a bailout
-// inside it is re-raised by C++.
-SW_EXTERN_C_BEGIN
-PHP_METHOD(swoole_http_client_coro, execute);
-PHP_METHOD(swoole_http_client_coro, get);
-PHP_METHOD(swoole_http_client_coro, post);
-PHP_METHOD(swoole_http_client_coro, download);
-PHP_METHOD(swoole_http_client_coro, upgrade);
-PHP_METHOD(swoole_http_client_coro, recv);
-SW_EXTERN_C_END
-
-#define HTTP_CLIENT_TRAMPOLINE(method)                                                                                 \
-    PHP_METHOD(swoole_http_client_coro, method) {                                                                      \
-        if (swr_v1_phpclients_http_client_##method(execute_data, return_value)) {                                      \
-            zend_bailout();                                                                                            \
-        }                                                                                                              \
-    }
-
-HTTP_CLIENT_TRAMPOLINE(execute)
-HTTP_CLIENT_TRAMPOLINE(get)
-HTTP_CLIENT_TRAMPOLINE(post)
-HTTP_CLIENT_TRAMPOLINE(download)
-HTTP_CLIENT_TRAMPOLINE(upgrade)
-HTTP_CLIENT_TRAMPOLINE(recv)
