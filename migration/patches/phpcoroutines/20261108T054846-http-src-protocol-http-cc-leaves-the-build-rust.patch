-        return 0;
-    case SWR_HTTP_NATIVE_LOG_PARSER_NEW:
-        swoole_log_as("Request::init_multipart_parser", swoole_warning("multipart_parser_init() failed"));
-        return 0;
-    case SWR_HTTP_NATIVE_LOG_FOPEN:
