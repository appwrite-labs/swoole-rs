-int http_no_digits_errno() {
-    // libc implementations differ on no-conversion errno. Probe only the foreign
-    // policy once; Rust still parses all request bytes, without native callbacks.
-    static const int value = [] {
-        int saved = errno; errno = 0;
-        char *end = nullptr; (void) strtoull("x", &end, 10);
-        int result = errno; errno = saved; return result;
-    }();
-    return value;
-}
-}
-
-//-----------------------------------------------------------------
-
-#if defined(_MSC_VER) || !defined(__GXX_ABI_VERSION)
-#error "Rust status array requires the qualified Itanium C++ symbol ABI"
-#endif
-static_assert(sizeof(int)==sizeof(int32_t) && alignof(int)==alignof(int32_t),
-    "Rust status array requires the qualified int32 C++ ABI");
-
-char *url_encode(char const *str, size_t len) {
-    size_t capacity = 0, written = 0;
-    int32_t status = swr_v1_http_url_capacity(reinterpret_cast<const uint8_t *>(str), len, &capacity);
-    if (status != 0) throw std::length_error("HTTP URL encode size overflow");
-    // Allocators may bailout; no Rust frame remains alive here.
-    char *result = static_cast<char *>(sw_malloc(capacity));
-    if (!result) throw std::bad_alloc();
-    status = swr_v1_http_url_encode(reinterpret_cast<const uint8_t *>(str), len,
-                                   reinterpret_cast<uint8_t *>(result), capacity, &written);
-    if (status != 0) { sw_free(result); throw std::invalid_argument("Invalid HTTP URL encode input"); }
-    return result;
-}
