-                                       "parse multipart body failed, %zu/%zu bytes processed",
-                                       static_cast<ssize_t>(n),
-                                       static_cast<size_t>(m)));
-        return 0;
-    case SWR_HTTP_NATIVE_TRACE_CHUNK:
-        swoole_log_as("Request::get_chunked_body_length",
-                      swoole_trace_log(SW_TRACE_HTTP, "chunk_length=%zu, chunk_len_str=%.*s\n", (size_t) m, (int) n, text));
-        return 0;
-    case SWR_HTTP_NATIVE_TRACE_HEADER_FIELD:
-        swoole_log_as("http_server::multipart_on_header_field",
