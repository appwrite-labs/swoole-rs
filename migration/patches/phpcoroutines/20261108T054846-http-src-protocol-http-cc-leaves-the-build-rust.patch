-    case SWR_HTTP_NATIVE_FDOPEN: return reinterpret_cast<uintptr_t>(fdopen(static_cast<int>(n), "wb+"));
-    case SWR_HTTP_NATIVE_FWRITE: return fwrite(b, sizeof(char), n, fp);
