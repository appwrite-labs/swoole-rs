-    case SWR_HTTP_NATIVE_FCLOSE: fclose(fp); return 0;
-    case SWR_HTTP_NATIVE_UNLINK: unlink(static_cast<const char *>(a)); return 0;
-    case SWR_HTTP_NATIVE_NUMBER_ERRORS:
-        if (n & 1u) errno = ERANGE;
