-
-class SessionStateOwner {
-  protected:
-    swr_v1_tls_dtls_prepared prepared_;
-    explicit SessionStateOwner(Socket *socket) : prepared_(swr_v1_tls_dtls_new(socket)) {}
-    SessionStateOwner(const SessionStateOwner &) = delete;
-    SessionStateOwner &operator=(const SessionStateOwner &) = delete;
-    ~SessionStateOwner() { swr_v1_tls_dtls_free(prepared_.owner); }
-    static void check(int status) { if (status) throw std::bad_alloc(); }
-};
-
-struct Session : private SessionStateOwner {
-    std::shared_ptr<SSLContext> ctx;
-    bool &listened = prepared_.fields->listened;
-    Socket *&socket = prepared_.fields->socket;
-    bool &peek_mode = prepared_.fields->peek;
-
-    Session(Socket *socket, const std::shared_ptr<SSLContext> &ctx)
-        : SessionStateOwner(socket), ctx(ctx) {}
-    Session(const Session &source) : SessionStateOwner(source.socket), ctx(source.ctx) {
-        check(swr_v1_tls_dtls_assign(handle(), source.handle()));
-    }
-    Session &operator=(const Session &source) {
-        if (this != &source) {
-            ctx = source.ctx;
-            check(swr_v1_tls_dtls_assign(handle(), source.handle()));
-        }
-        return *this;
-    }
-    ~Session() { swr_v1_tls_dtls_clear(handle()); }
-    swr_v1_tls_dtls_session *handle() const { return prepared_.owner; }
-    bool init() { return swr_v1_tls_dtls_init(handle(), ctx.get()); }
-    bool listen() { return swr_v1_tls_dtls_session_listen(handle()); }
-    void append(const char *data, ssize_t len) {
-        check(swr_v1_tls_dtls_append(handle(), reinterpret_cast<const uint8_t *>(data), len));
-    }
-    void append(Buffer *buffer) { check(swr_v1_tls_dtls_append_buffer(handle(), buffer)); }
-    size_t get_buffer_length() const { return swr_v1_tls_dtls_length(handle()); }
-};
-//-------------------------------------------------------------------------------
-}  // namespace dtls
-}  // namespace swoole
-#endif
