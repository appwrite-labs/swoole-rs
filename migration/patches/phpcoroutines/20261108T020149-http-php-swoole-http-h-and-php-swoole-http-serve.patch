-#undef SWR_PHPHTTP_NATIVE_RECORD_CONTEXT
-static_assert(sizeof(ContextState) == SWR_PHPHTTP_STATE_SIZE, "crates/phphttp/src/state.rs mirrors ContextState");
-
-// Rust allocates and frees it (swr_v1_phphttp_context_new, Context::free).
-struct Context : ContextState {
-    SocketImpl *get_co_socket() const {
-        return static_cast<SocketImpl *>(private_data);
-    }
-
-    void free() {
-        swr_v1_phphttp_context_free(this);
-    }
-};
-static_assert(sizeof(Context) == sizeof(ContextState), "a Context is the ContextState Rust allocates");
