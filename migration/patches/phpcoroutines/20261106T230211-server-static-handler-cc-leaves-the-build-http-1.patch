-template<class RequestView>
-static bool select_static_handler_impl(Server *server,const RequestView &request,const Connection *conn) {
-    const char *url = request.buffer()->str + request.url_offset();
-    size_t url_length = request.url_length();
-
-    http_server::StaticHandler handler(server, url, url_length);
-    swr_v1_http_static_selection selection{};
-    if (swr_v1_http_static_select(&selection, handler.try_serve(), 0) == SWR_HTTP_SELECT_SKIP) {
-        return false;
-    }
-
-    char header_buffer[1024];
-    SendData response;
-    response.info.fd = conn->session_id;
-    response.info.type = SW_SERVER_EVENT_SEND_DATA;
-
-    static_assert(SW_HTTP_HEAD == 3 && SW_HTTP_NOT_FOUND == 404 && SW_HTTP_PARTIAL_CONTENT == 206,
-                  "HTTP selection tags");
-    if (swr_v1_http_static_select(&selection, 0, handler.get_status()) == SWR_HTTP_SELECT_NOT_FOUND) {
-        swr_v1_http_static_header header{};
-        header.status = static_header_text(http_server::get_status_message(SW_HTTP_NOT_FOUND));
-        header.page = static_header_text(SW_HTTP_PAGE_404);
-        header.content_length = sizeof(SW_HTTP_PAGE_404) - 1;
-        response.info.len = encode_static_headers(header_buffer, sizeof(header_buffer), header);
-        response.data = header_buffer;
-        server->send_to_connection(&response);
-
-        return true;
-    }
-
-    auto date_str = handler.get_date();
-    auto date_str_last_modified = handler.get_date_last_modified();
-
-    swr_v1_http_static_header header{};
-    header.date = static_header_text(date_str.c_str());
-    header.modified = static_header_text(date_str_last_modified.c_str());
-    header.keep_alive = request.keep_alive();
-
-    std::string date_if_modified_since = request.get_header("If-Modified-Since");
-    int32_t action = swr_v1_http_static_select(&selection, date_if_modified_since.size(), 0);
-    if (action == SWR_HTTP_SELECT_CHECK_MODIFIED) {
-        action = swr_v1_http_static_select(&selection, handler.is_modified(date_if_modified_since), 0);
-    }
-    if (action == SWR_HTTP_SELECT_NOT_MODIFIED) {
-        header.variant = 1;
-        response.info.len = encode_static_headers(header_buffer, sizeof(header_buffer), header);
-        response.data = header_buffer;
-        server->send_to_connection(&response);
-
-        return true;
-    }
-
-    /**
-     * if http_index_files is enabled, need to search the index file first.
-     * if the index file is found, set filename to index filename.
-     */
-    if (swr_v1_http_static_select(&selection, handler.try_serve_index_file(), 0) == SWR_HTTP_SELECT_SKIP) {
-        return false;
-    }
-
-    /**
-     * the index file was not found in the current directory,
-     * if http_autoindex is enabled, should show the list of files in the current directory.
-     */
-    // These getters only read initialized handler/server fields; effects resume after Rust returns.
