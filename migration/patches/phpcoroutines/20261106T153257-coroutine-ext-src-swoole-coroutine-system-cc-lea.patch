diff --git a/src/coroutine/system.cc b/src/coroutine/system.cc
index feeae92..fd94abf 100644
--- a/src/coroutine/system.cc
+++ b/src/coroutine/system.cc
@@ -325,2 +325,51 @@ bool System::exec(const char *command, bool get_error_stream, std::shared_ptr<St
 
+// Swoole\Coroutine\System (crates/phpcoroutines) calls these: each result C++ holds
+// is copied out through `put`, one call per string.
+typedef void (*swr_v1_system_put)(void *out, const char *data, size_t length);
+
+extern "C" bool swr_v1_system_read_file(const char *file, bool lock, swr_v1_system_put put, void *out) {
+    auto content = System::read_file(file, lock);
+    if (content) {
+        put(out, content->str, content->length);
+    }
+    return content != nullptr;
+}
+
+extern "C" bool swr_v1_system_gethostbyname(
+    const char *host, size_t length, long family, double timeout, swr_v1_system_put put, void *out) {
+    auto address = System::gethostbyname(std::string(host, length), family, timeout);
+    if (!address.empty()) {
+        put(out, address.data(), address.size());
+    }
+    return !address.empty();
+}
+
+extern "C" bool swr_v1_system_getaddrinfo(const char *host,
+                                          long family,
+                                          long socktype,
+                                          long protocol,
+                                          const char *service,
+                                          double timeout,
+                                          swr_v1_system_put put,
+                                          void *out) {
+    auto addresses = System::getaddrinfo(host, family, socktype, protocol, service, timeout);
+    for (auto &address : addresses) {
+        put(out, address.data(), address.size());
+    }
+    return !addresses.empty();
+}
+
+extern "C" bool swr_v1_system_exec(const char *command, bool errors, int *status, swr_v1_system_put put, void *out) {
+    auto buffer = std::make_shared<String>(1024);
+    if (!System::exec(command, errors, buffer, status)) {
+        return false;
+    }
+    put(out, buffer->str, buffer->length);
+    return true;
+}
+
+extern "C" int swr_v1_system_wait_signal(const long *signals, size_t count, double timeout) {
+    return System::wait_signal(std::vector<int>(signals, signals + count), timeout);
+}
