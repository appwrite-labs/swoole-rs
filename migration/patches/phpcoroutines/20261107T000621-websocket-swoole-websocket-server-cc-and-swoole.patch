-// Swoole\WebSocket\Server, Frame and CloseFrame, frames and the handshake are
-// Rust (crates/phphttp/src/websocket.rs); C++ keeps the Server and answers it
-// through swr_ws_host_*.
-zend_class_entry *swoole_websocket_server_ce;
-zend_class_entry *swoole_websocket_frame_ce;
-
-static_assert(sizeof(FrameObject) == 16 && offsetof(FrameObject, data) == 8, "websocket.rs mirrors FrameObject");
-static_assert(sizeof(swr_ws_connection) == 12, "websocket.rs mirrors swr_ws_connection");
-
-bool FrameObject::pack(String *buffer) {
-    zend_string *packed = swr_v1_phphttp_websocket_pack(this);
-    if (!packed) {
-        return false;
-    }
-    buffer->clear();
-    buffer->append(ZSTR_VAL(packed), ZSTR_LEN(packed));
-    zend_string_release(packed);
-    return true;
-}
-
-FrameObject::FrameObject(zval *zdata, zend_long _opcode, zend_long _flags, zend_long _code) {
-    swr_v1_phphttp_websocket_frame_object(this, zdata, _opcode, _flags, _code);
-}
-
-void php_swoole_sha1(const char *str, int _len, unsigned char *digest) {
-    swr_v1_ws_sha1((const uint8_t *) str, _len, digest);
-}
-
-int swoole_websocket_onMessage(Server *serv, RecvData *req) {
-    return swr_v1_phphttp_websocket_message(serv, req, req->info.fd, req->info.server_fd, req->info.ext_flags);
-}
-
-bool swr_ws_host_server(zval *zobject, void **serv) {
-    // Only a dead server object raises, so only it needs the trap.
-    *serv = php_swoole_server_get_ptr(zobject);
-    return !*serv && swr_http_host_try([&] { *serv = php_swoole_server_get_and_check_server(zobject); });
-}
-
-bool swr_ws_host_started(void *serv) {
-    return static_cast<Server *>(serv)->is_started();
-}
-
-bool swr_ws_host_connection(void *serv, zend_long fd, bool verify, swr_ws_connection *out) {
-    auto *server = static_cast<Server *>(serv);
-    Connection *conn = verify ? server->get_connection_verify(fd) : server->get_connection_by_session_id(fd);
-    if (!conn) {
-        return false;
-    }
-    out->status = conn->websocket_status;
-    out->server_fd = conn->server_fd;
-    out->compression = conn->websocket_compression;
-    out->closed = conn->closed;
-    return true;
-}
-
-void swr_ws_host_set_status(void *serv, zend_long fd, int64_t status) {
-    Connection *conn = static_cast<Server *>(serv)->get_connection_by_session_id(fd);
-    if (conn) {
-        conn->websocket_status = status;
-    }
-}
-
-bool swr_ws_host_send(void *serv, zend_long fd, const char *data, size_t length, bool wait) {
-    auto *server = static_cast<Server *>(serv);
-    bool rv = server->send(fd, data, length);
-    if (!rv && wait && swoole_get_last_error() == SW_ERROR_OUTPUT_SEND_YIELD) {
-        auto sdata = zend_string_init(data, length, false);
-        rv = php_swoole_server_send_yield(server, fd, sdata);
-        zend_string_release(sdata);
-    }
-    return rv;
-}
-
-bool swr_ws_host_close(void *serv, zend_long fd, bool reset) {
-    return static_cast<Server *>(serv)->close(fd, reset);
-}
-
-int swr_ws_host_port_settings(void *serv, zend_long fd) {
-    ListenPort *port = static_cast<Server *>(serv)->get_port_by_session_id(fd);
-    if (!port) {
-        return -1;
-    }
-    const WebSocketSettings &settings = port->websocket_settings;
-    return settings.open_close_frame | (settings.open_ping_frame << 1) | (settings.open_pong_frame << 2);
-}
-
-const char *swr_ws_host_protocol(void *serv, int server_fd, size_t *length) {
-    ListenPort *port = static_cast<Server *>(serv)->get_port_by_server_fd(server_fd);
-    *length = port ? port->websocket_settings.protocol.length() : 0;
-    return port ? port->websocket_settings.protocol.c_str() : nullptr;
-}
-
-void swr_ws_host_recv_data(void *serv, void *req, zval *zdata) {
-    php_swoole_get_recv_data(static_cast<Server *>(serv), zdata, static_cast<RecvData *>(req));
-}
-
-int swr_ws_host_call(void *serv, int server_fd, int event, uint32_t argc, zval *args) {
-    static const int events[] = {
-        SW_SERVER_CB_onBeforeHandshakeResponse, SW_SERVER_CB_onOpen, SW_SERVER_CB_onMessage};
-    auto *server = static_cast<Server *>(serv);
-    auto cb = php_swoole_server_get_callback(server, server_fd, events[event]);
-    if (!cb) {
-        return SWR_WS_CALL_NONE;
-    }
-    int called = zend::function::call_trapped(cb->ptr(), argc, args, nullptr, server->is_enable_coroutine());
-    return called < 0 ? SWR_WS_CALL_BAILED : called ? SWR_WS_CALL_DONE : SWR_WS_CALL_FAILED;
-}
-
-zval *swr_ws_host_server_zval(void *serv) {
-    return php_swoole_server_zval_ptr(static_cast<Server *>(serv));
-}
-
-bool swr_ws_host_server_compression(void *serv) {
-    return static_cast<Server *>(serv)->websocket_compression;
-}
-
-void swr_ws_host_set_compression(void *serv, zend_long fd, bool compression) {
-    Connection *conn = static_cast<Server *>(serv)->get_connection_verify(fd);
-    if (conn) {
-        conn->websocket_compression = compression;
-    }
-}
-
-void swr_ws_host_co_protocol(void *ctx) {
-    auto sock = static_cast<HttpContext *>(ctx)->get_co_socket();
-    sock->open_length_check = true;
-    sock->protocol.package_length_size = SW_WEBSOCKET_HEADER_LEN;
-    sock->protocol.package_length_offset = 0;
-    sock->protocol.package_body_offset = 0;
-    sock->protocol.get_package_length = WebSocket::get_package_length;
-}
-
-void php_swoole_websocket_server_minit(int module_number) {
-#ifdef SW_THREAD
-    const bool serializable = true;
-#else
-    const bool serializable = false;
-#endif
-#ifdef SW_HAVE_ZLIB
-    const bool zlib = true;
-#else
-    const bool zlib = false;
-#endif
-    swoole_websocket_server_ce = swr_v1_phphttp_websocket_minit(
-        module_number, swoole_http_server_ce, serializable, zlib, &swoole_websocket_frame_ce);
-}
-
-void php_swoole_server_set_websocket_option(ListenPort *port, zend_array *vht) {
-    WebSocket::apply_setting(port->websocket_settings, vht, true);
-}
-
-void WebSocket::apply_setting(WebSocketSettings &settings, zend_array *vht, bool in_server) {
-    zval *ztmp;
-    if (php_swoole_array_get_value(vht, "websocket_subprotocol", ztmp)) {
-        settings.protocol = zend::String(ztmp).to_std_string();
-    }
-    if (php_swoole_array_get_value(vht, "websocket_mask", ztmp)) {
-        settings.mask = zval_is_true(ztmp);
-    } else {
-        settings.mask = !in_server;
-    }
-#ifdef SW_HAVE_ZLIB
-    if (php_swoole_array_get_value(vht, "websocket_compression", ztmp)) {
-        settings.compression = zval_is_true(ztmp);
-    }
-#endif
-    if (php_swoole_array_get_value(vht, "open_websocket_close_frame", ztmp)) {
-        settings.open_close_frame = zval_is_true(ztmp);
-    }
-    if (php_swoole_array_get_value(vht, "open_websocket_ping_frame", ztmp)) {
-        settings.open_ping_frame = zval_is_true(ztmp);
-    }
-    if (php_swoole_array_get_value(vht, "open_websocket_pong_frame", ztmp)) {
-        settings.open_pong_frame = zval_is_true(ztmp);
-    }
-    settings.in_server = in_server;
-}
-
-// Coroutine\Http\Client's WebSocket state and framing (crates/phpclients).
-struct HttpClientWebSocket {
-    WebSocketSettings settings;
-    void *continue_frame_buffer = nullptr;
-};
-
-void *swoole_http_client_coro_ws_new(void) {
-    return new HttpClientWebSocket();
-}
-
-void swoole_http_client_coro_ws_free(void *ws) {
-    auto *state = static_cast<HttpClientWebSocket *>(ws);
-    swr_v1_phphttp_websocket_buffer_free(&state->continue_frame_buffer);
-    delete state;
-}
-
-void swoole_http_client_coro_ws_apply(void *ws, const zval *settings) {
-    WebSocket::apply_setting(static_cast<HttpClientWebSocket *>(ws)->settings, Z_ARRVAL_P(settings), false);
-}
-
-bool swoole_http_client_coro_ws_compression(void *ws) {
-#ifdef SW_HAVE_ZLIB
-    return static_cast<HttpClientWebSocket *>(ws)->settings.compression;
-#else
-    return false;
-#endif
-}
-
-int swoole_http_client_coro_ws_push(
-    void *socket, void *ws, zval *data, int64_t opcode, int flags, int64_t code, bool compress) {
-    auto *sock = static_cast<SocketImpl *>(socket);
-    String *buffer = sock->get_write_buffer();
-    FrameObject frame(data, opcode, (uint8_t) flags, code);
-    if (static_cast<HttpClientWebSocket *>(ws)->settings.mask) {
-        frame.flags |= WebSocket::FLAG_MASK;
-    }
-    if (compress) {
-        sw_set_bit(frame.flags, WebSocket::FLAG_COMPRESS);
-    }
-    if (sw_unlikely(!frame.pack(buffer))) {
-        return 1;
-    }
-    return sock->send_all(buffer->str, buffer->length) == (ssize_t) buffer->length ? 0 : 2;
-}
-
-void swoole_http_client_coro_ws_recv(void *socket, void *ws, zval *return_value, double timeout) {
-    auto *state = static_cast<HttpClientWebSocket *>(ws);
-    WebSocket::recv_frame(
-        state->settings, &state->continue_frame_buffer, static_cast<SocketImpl *>(socket), return_value, timeout);
-}
