-uint64_t Server::rust_call(void *context, uint32_t op, uint64_t arg) {
-    auto *ctx = static_cast<ServerRustContext *>(context);
-    Server *serv = ctx->serv;
-    ListenPort *port = ctx->port;
-    Socket *sock = ctx->sock;
-    Connection *conn = ctx->conn;
-    switch (op) {
-    case SWR_SERVER_OP_ADD_RECV_TIMER:
-        conn->socket->read_timeout = port->max_idle_time;
-        conn->socket->recv_timer = swoole_timer_add(
-            sec2msec(port->max_idle_time), true, serv->get_timeout_callback(port, ctx->reactor, conn));
-        return 0;
-
-
-    case SWR_SERVER_OP_REACTOR_BARRIER:
-        serv->reactor_thread_barrier.wait();
-        return 0;
-    case SWR_SERVER_OP_MANAGER_BARRIER:
-        serv->gs->manager_barrier.wait();
-        return 0;
-    case SWR_SERVER_OP_RELEASE_PIPE_BUFFERS:
-        serv->release_pipe_buffers();
-        return 0;
-
-
-    case SWR_SERVER_OP_PORT_NEW: {
-        auto *ls = new ListenPort(serv);
-        ls->type = ctx->type;
-        ls->port = ctx->number;
-        ls->host = ctx->host;
-        if (arg) {
-            ls->type = static_cast<SocketType>(ctx->type & (~SW_SOCK_SSL));
-            ls->ssl = 1;
-            ls->ssl_context_init();
-        }
-        ctx->port = ls;
-        return 0;
-    }
-    case SWR_SERVER_OP_PORT_SOCKET:
-        if (port->create_socket() < 0) {
-            swoole_set_last_error(errno);
-            delete port;
-            ctx->port = nullptr;
-            return 0;
-        }
-        return 1;
-    case SWR_SERVER_OP_PORT_IMPORT: {
-        auto *ls = new ListenPort(serv);
-        if (!ls->import((int) arg)) {
-            delete ls;
-            return 0;
-        }
-        // O_NONBLOCK & O_CLOEXEC
-        ls->socket->set_fd_option(1, 1);
-        ctx->port = ls;
-        return 1;
-    }
-
-    case SWR_SERVER_OP_SC_IDLE_TIMER: {
-        const auto timeout_callback = serv->get_timeout_callback(port, ctx->reactor, conn);
-        sock->write_timeout = port->max_idle_time;
-        sock->last_sent_time = time<std::chrono::milliseconds>(true);
-        sock->send_timer = swoole_timer_add(sec2msec(port->max_idle_time), true, timeout_callback);
-        swoole_log_as("Server::send_to_connection",
-                      swoole_trace_log(SW_TRACE_SERVER,
-                                       "added send_timer[id=%ld], port->max_idle_time=%f",
-                                       sock->send_timer->id,
-                                       port->max_idle_time));
-        return 0;
-    }
-
-    case SWR_SERVER_OP_ST_CMD_SEND: {
-        const auto *c = reinterpret_cast<const swr_v1_server_command_send *>(arg);
-        if (c->action == SWR_COMMAND_TO_TASK_WORKER || c->action == SWR_COMMAND_TO_MANAGER) {
-            EventData buf;
-            bool sent = true;
-            if (c->action == SWR_COMMAND_TO_TASK_WORKER) {
-                sent = serv->task_pack(&buf, c->message, c->length);
-            } else {
-                memset(&buf.info, 0, sizeof(buf.info));
-                buf.info.len = c->length;
-                memcpy(buf.data, c->message, c->length);
-            }
-            buf.info.type = SW_SERVER_EVENT_COMMAND_REQUEST;
-            buf.info.fd = c->request_id;
-            buf.info.server_fd = c->command_id;
-            int _dst_worker_id = c->process_id;
-            return sent && (c->action == SWR_COMMAND_TO_TASK_WORKER ? serv->task(&buf, &_dst_worker_id)
-                                                                    : serv->get_event_worker_pool()->push_message(&buf) >= 0);
-        }
-        SendData task{};
-        task.info.fd = c->request_id;
-        task.info.reactor_id = c->process_id;
-        task.info.server_fd = c->command_id;
-        task.info.type = SW_SERVER_EVENT_COMMAND_REQUEST;
-        task.info.len = c->length;
-        task.data = c->message;
-        Worker *worker = serv->get_worker(c->process_id);
-        return serv->message_bus.write(
-            c->action == SWR_COMMAND_TO_REACTOR_THREAD ? worker->pipe_worker : worker->pipe_master, &task);
-    }
-    case SWR_SERVER_OP_ST_PIPE_COMMAND_NEW: {
-        auto _pipe = new UnixSocket(false, SOCK_DGRAM);
-        if (!_pipe->ready()) {
-            delete _pipe;
-            return 0;
-        }
-        serv->pipe_command = _pipe;
-        return 1;
-    }
-    case SWR_SERVER_OP_ST_VISIT:
-        (*static_cast<std::function<void(Connection *)> *>(ctx->object))(serv->get_connection((int) arg));
-        return 0;
-    default:
-        return 0;
-    }
-}
