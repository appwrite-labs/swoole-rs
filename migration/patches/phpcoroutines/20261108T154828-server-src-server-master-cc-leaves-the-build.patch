-bool Server::set_document_root(const std::string &path) {
-    ServerRustContext ctx{this};
-    ctx.data = path.c_str();
-    return server_run(SWR_SERVER_RUN_ST_DOCUMENT_ROOT, path.length(), &ctx);
-}
