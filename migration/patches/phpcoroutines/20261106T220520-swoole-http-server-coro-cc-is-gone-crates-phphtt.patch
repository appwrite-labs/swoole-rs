-// `start`'s `onAccept`: the callable and its cache, which outlive the accept loop.
-struct HttpServerAccept {
-    zend::Variable callback{"onAccept"};
-    zend_fcall_info_cache cache{};
-};
-
-int swr_hsc_accept_callable(zval *zobject, zend_execute_data *execute_data, void **out) {
-    auto *accept = new HttpServerAccept();
-    char *func_name = nullptr;
-    bool callable = false;
-    if (swr_http_host_try([&] {
-            callable = sw_zend_is_callable_at_frame(
-                accept->callback.ptr(), zobject, execute_data, 0, &func_name, nullptr, &accept->cache, nullptr);
-            if (!callable) {
-                php_swoole_fatal_error(E_CORE_ERROR, "function '%s' is not callable", func_name);
-            }
-        })) {
-        delete accept;
-        return -1;
-    }
-    if (!callable) {
-        delete accept;
-        return 1;
-    }
-    efree(func_name);
-    *out = accept;
-    return 0;
-}
-
-void swr_hsc_accept_free(void *accept) {
-    delete static_cast<HttpServerAccept *>(accept);
-}
