-int64_t swr_hsc_accept(void *sock, void *accept, bool *connected, bool *bailed) {
-    auto conn = sock_of(sock)->accept();
-    *connected = conn != nullptr;
-    if (!conn) {
-        return 0;
-    }
-    auto *handler = static_cast<HttpServerAccept *>(accept);
-    zval zsocket;
-    php_swoole_init_socket_object(&zsocket, conn);
-    long cid = 0;
-    uint8_t raised = 0;
-    // A warning's error handler can exit(): start() re-raises it (#913).
-    *bailed = swr_http_host_try(
-                  [&] { cid = swr_v1_phpcoroutines_create(&handler->cache, 1, &zsocket, handler->callback.ptr(), &raised); }) ||
-              raised;
-    if (*bailed) {
-        return 0;
-    }
-    zval_dtor(&zsocket);
-    return cid;
-}
