-// One `start` setting (SWR_HTTPBINDINGS_SETTING_*) from its value: 0 applied
-// (a flag's or a number's value in `*value`, for Rust to apply), 1 refused
-// (start returns false), -1 bailed out (an E_ERROR).
-int swr_hsc_setting(void *server, uint32_t kind, zend_array *vht, zval *ztmp, int64_t *value) {
-    int result = 0;
-    bool bailed = swr_http_host_try([&] {
-        switch (kind) {
-        case SWR_HTTPBINDINGS_SETTING_COOKIE:
-        case SWR_HTTPBINDINGS_SETTING_POST:
-        case SWR_HTTPBINDINGS_SETTING_FILES:
-        case SWR_HTTPBINDINGS_SETTING_COMPRESSION: *value = zval_is_true(ztmp); break;
-#ifdef SW_HAVE_COMPRESSION
-        case SWR_HTTPBINDINGS_SETTING_LEVEL: *value = swr_v1_httpbindings_server_level(zval_get_long(ztmp)); break;
-        case SWR_HTTPBINDINGS_SETTING_MINIMUM: *value = zval_get_long(ztmp); break;
-        case SWR_HTTPBINDINGS_SETTING_TYPES:
-            swr_v1_phphttp_server_coro_text(server, kind, nullptr, 0);
-            if (ZVAL_IS_ARRAY(ztmp)) {
-                zval *ztype;
-                SW_HASHTABLE_FOREACH_START(Z_ARRVAL_P(ztmp), ztype)
-                zend::String type(ztype);
-                if (type.len() > 0) {
-                    swr_v1_phphttp_server_coro_text(server, kind, type.val(), type.len());
-                }
-                SW_HASHTABLE_FOREACH_END();
-            } else {
-                php_swoole_fatal_error(E_ERROR, "http_compression_types must be array");
-                result = 1;
-            }
-            break;
-#endif
-        case SWR_HTTPBINDINGS_SETTING_UPLOAD: {
-            zend::String str_v(ztmp);
-            if (php_swoole_create_dir(str_v.val(), str_v.len()) < 0) {
-                php_swoole_fatal_error(E_ERROR, "Unable to create upload_tmp_dir[%s]", str_v.val());
-                result = 2;
-                break;
-            }
-            swr_v1_phphttp_server_coro_text(server, kind, str_v.val(), str_v.len());
-            break;
-        }
-        default: result = 2; break;
-        }
-    });
-    return bailed ? -1 : result;
-}
