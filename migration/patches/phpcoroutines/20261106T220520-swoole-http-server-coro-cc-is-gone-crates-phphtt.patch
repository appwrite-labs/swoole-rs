-// What stays C++ of upstream's HttpServer: the handler map, whose lookup order
-// is std::unordered_map's. The rest is Rust's.
-struct HttpServerSettings {
-    zend::Callable *default_handler = nullptr;
-    std::unordered_map<std::string, zend::Callable *> handlers;
-
-    ~HttpServerSettings() {
-        for (const auto &handler : handlers) {
-            sw_callable_free(handler.second);
-        }
-    }
-
-    bool set_handler(const std::string &pattern, zval *zfn) {
-        auto cb = sw_callable_create(zfn);
-        if (!cb) {
-            return false;
-        }
-        if (handlers.find(pattern) != handlers.end()) {
-            sw_callable_free(handlers[pattern]);
-        }
-        handlers[pattern] = cb;
-        if (pattern == "/") {
-            default_handler = cb;
-        }
-        return true;
-    }
-
-    zend::Callable *get_handler(const HttpContext *ctx) const {
-        for (auto &handler : handlers) {
-            if (handler.second == default_handler) continue;
-            if (swr_v1_httpbindings_handler(
-                    {reinterpret_cast<const uint8_t *>(ctx->request.path), ctx->request.path_len},
-                    {reinterpret_cast<const uint8_t *>(handler.first.data()), handler.first.size()}) == 1) return handler.second;
-        }
-        return default_handler;
-    }
-};
-};  // namespace coroutine
-};  // namespace swoole
