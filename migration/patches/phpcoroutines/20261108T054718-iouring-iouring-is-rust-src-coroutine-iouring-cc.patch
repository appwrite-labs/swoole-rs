-#include "swoole_iouring.h"
-#include "swoole_rs_hooks.h"
-
-#include "swoole_coroutine_system.h"
-
-#ifdef SW_USE_IOURING
-using swoole::Coroutine;
-
-namespace swoole {
-//-------------------------------------------------------------------------------
-const swr_v1_uring_host Iouring::host = {current, instance, yield, resume, event_running, submit, dispatch};
-
-Iouring::Iouring(Reactor *_reactor) {
-    reactor = _reactor;
-    swr_v1_uring_config config{SwooleG.iouring_entries, SwooleG.iouring_flag, SwooleG.iouring_workers, false, false};
-#ifdef HAVE_IOURING_FUTEX
-    config.probe_futex = true;
-#endif
-#ifdef HAVE_IOURING_FTRUNCATE
-    config.probe_ftruncate = true;
-#endif
-    auto opened = swr_v1_uring_open(config, &host);
-    engine = opened.uring;
-    switch (opened.status) {
-    case 1:
-        swoole_error("unsupported liburing version: Swoole requires liburing %d.%d or later with ABI major %d, but "
-                     "liburing %d.%d was loaded at runtime",
-                     opened.major,
-                     opened.minor,
-                     opened.major,
-                     opened.runtime_major,
-                     opened.runtime_minor);
-        break;
-    case 2:
-        swoole_sys_error("Failed to initialize io_uring instance; grant the process permission to use io_uring "
-                         "(for Docker, use privileged mode), or rebuild Swoole without --enable-iouring");
-        return;
-    case 3:
-        swoole_error("Failed to query the io_uring opcodes supported by the running kernel");
-        break;
-    case 4:
-        swoole_error("The running kernel does not support IORING_OP_FUTEX_WAIT and IORING_OP_FUTEX_WAKE");
-        break;
-    case 5:
-        swoole_error("The running kernel does not support IORING_OP_FTRUNCATE");
-        break;
-    case 6:
-        swoole_sys_error("Failed to set the maximum of io_uring async workers");
-        return;
-    default:
-        break;
-    }
-
-    ring_socket = make_socket(swr_v1_uring_fd(engine), SW_FD_IOURING);
-    ring_socket->object = this;
-
-    reactor->set_exit_condition(Reactor::EXIT_CONDITION_IOURING, [](Reactor *reactor, size_t &event_num) -> bool {
-        if (SwooleTG.iouring && SwooleTG.iouring->get_task_num() == 0 && SwooleTG.iouring->is_empty_waiting_tasks()) {
-            event_num--;
-        }
-        return true;
-    });
-
-    reactor->add_destroy_callback([](void *data) {
-        if (!SwooleTG.iouring) {
-            return;
-        }
-        delete SwooleTG.iouring;
-        SwooleTG.iouring = nullptr;
-    });
-
-    reactor->set_end_callback(Reactor::PRIORITY_IOURING_SUBMIT, [](Reactor *reactor) {
-        if (!SwooleTG.iouring) {
-            return;
-        }
-        swr_v1_uring_submit(SwooleTG.iouring->engine);
-    });
-
-    reactor->iouring_interrupt_handler = [this](Reactor *reactor) { swr_v1_uring_wakeup(engine); };
-
-    if (reactor->add(ring_socket, SW_EVENT_READ) == SW_ERR) {
-        swoole_sys_error("Failed to add io_uring ring fd to the event loop");
-    }
-}
-
-Iouring::~Iouring() {
-    if (!ring_socket) {
-        return;
-    }
-
-    if (!ring_socket->removed) {
-        reactor->del(ring_socket);
-    }
-    ring_socket->move_fd();
-    ring_socket->free();
-    ring_socket = nullptr;
-
-    swr_v1_uring_close(engine);
-}
-
-Iouring *Iouring::get_instance() {
-    if (sw_unlikely(!SwooleTG.iouring)) {
-        if (!swoole_event_is_available()) {
-            swoole_error("The event loop is unavailable, unable to create io_uring instance.");
-        }
-        SwooleTG.iouring = new Iouring(sw_reactor());
-    }
-    return SwooleTG.iouring;
-}
-
-void *Iouring::current() {
-    return Coroutine::get_current_safe();
-}
-
-swr_v1_uring *Iouring::instance() {
-    return get_instance()->engine;
-}
-
-void Iouring::yield(void *coroutine, void *event) {
-    Coroutine::CancelFunc cancel_fn = [event](Coroutine *) { return swr_v1_uring_cancel(&host, event); };
-    static_cast<Coroutine *>(coroutine)->yield(&cancel_fn);
-}
-
-void Iouring::resume(void *coroutine) {
-    static_cast<Coroutine *>(coroutine)->resume();
-}
-
-bool Iouring::event_running() {
-    return swoole_event_is_running();
-}
-
-void Iouring::submit() {
-    swoole_sys_error("io_uring_submit() failed");
-}
-
-void Iouring::dispatch(int ring_fd) {
-    swoole_warning("timeout setting failed, the iouring queue[%d] is full", ring_fd);
-}
-
-int Iouring::poll(struct pollfd *fds, nfds_t nfds, int timeout) {
-    if (nfds != 1) {
-        errno = EINVAL;
-        swoole_error_log(
-            SW_LOG_WARNING, SW_ERROR_INVALID_PARAMS, "incomplete poll() implementation, only supports one fd");
-        return -1;
-    }
-    return swr_v1_uring_poll(&host, fds, timeout);
-}
-
-int Iouring::callback(Reactor *reactor, Event *event) {
-    auto *iouring = static_cast<Iouring *>(event->socket->object);
-    return swr_v1_uring_wakeup(iouring->engine) ? SW_OK : SW_ERR;
-}
-}  // namespace swoole
-#endif
