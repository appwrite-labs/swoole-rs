-        return swr_v1_uring_writev(&host, fd, iovec, count, timeout);
-    }
-    static int shutdown(int fd, int how) {
-        return swr_v1_uring_shutdown(&host, fd, how);
-    }
-    static int close(int fd) {
-        return swr_v1_uring_close_fd(&host, fd);
-    }
-    static ssize_t read(int fd, void *buf, size_t size, double timeout = -1) {
