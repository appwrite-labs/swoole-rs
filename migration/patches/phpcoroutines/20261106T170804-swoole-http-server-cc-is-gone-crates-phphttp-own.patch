-// Rust routes the request, parses it and runs its handler (crates/phphttp/src/server.rs).
-int php_swoole_http_server_onReceive(Server *serv, RecvData *req) {
-    switch (swr_v1_phphttp_server_receive(serv, req, req->info.fd, req->info.server_fd)) {
-    case SWR_PHPHTTP_RECEIVE_CLOSED:
-        return SW_ERR;
-    case SWR_PHPHTTP_RECEIVE_TCP:
-        return php_swoole_server_onReceive(serv, req);
-    case SWR_PHPHTTP_RECEIVE_WEBSOCKET:
-        return swoole_websocket_onMessage(serv, req);
-    case SWR_PHPHTTP_RECEIVE_HTTP2:
-        return swoole_http2_server_onReceive(serv, serv->get_connection_verify_no_ssl(req->info.fd), req);
-    default:
-        return SW_OK;
-    }
-}
-
-static_assert(sizeof(swr_http_receive) == 40, "crates/phphttp/src/server.rs mirrors swr_http_receive");
-
-void *swr_http_host_receive(void *server, int64_t session_id, int server_fd, swr_http_receive *out) {
-    auto *serv = static_cast<Server *>(server);
-    Connection *conn = serv->get_connection_verify_no_ssl(session_id);
-    if (!conn) {
-        return nullptr;
-    }
-    auto *port = serv->get_port_by_server_fd(server_fd);
-    // Only whether either is set routes the data, so onMessage is asked only without onRequest.
-    out->http = port->open_http_protocol && php_swoole_server_isset_callback(serv, port, SW_SERVER_CB_onRequest);
-    out->websocket = !out->http && port->open_websocket_protocol &&
-                     php_swoole_server_isset_callback(serv, port, SW_SERVER_CB_onMessage);
-    out->websocket_status = conn->websocket_status;
-    out->http2 = conn->http2_stream;
-    return conn;
-}
-
-void *swr_http_host_receive_context(
-    void *server, void *connection, int64_t session_id, void *req, zval **zdata, swr_http_receive *out) {
-    auto *serv = static_cast<Server *>(server);
-    auto *conn = static_cast<Connection *>(connection);
-    out->last_recv_time = conn->last_recv_time;
-    out->local_port = conn->local_port;
-    out->remote_port = conn->info.get_port();
-    out->loopback = conn->info.is_loopback_addr() ? (conn->info.type == SW_SOCK_TCP6 ? 6 : 4) : 0;
-    out->cache = swoole_http_server_can_cache_session_addr(serv);
-    out->coroutine = serv->is_enable_coroutine();
-    HttpContext *ctx = swoole_http_context_new(session_id);
-    swr_v1_phphttp_context_init(ctx, serv);
-    ctx->before_request = 1;
-    *zdata = &ctx->request.zdata;
-    php_swoole_get_recv_data(serv, *zdata, static_cast<RecvData *>(req));
-    swoole_llhttp_parser_init(&ctx->parser, HTTP_REQUEST, (void *) ctx);
-    return ctx;
-}
-
-uint8_t swr_http_host_before_request(void *context, void *conn) {
-    if (swoole_isset_hook(static_cast<swGlobalHookType>(PHP_SWOOLE_HOOK_BEFORE_REQUEST))) {
-        swoole_call_hook(static_cast<swGlobalHookType>(PHP_SWOOLE_HOOK_BEFORE_REQUEST), context);
-    }
-    return static_cast<Connection *>(conn)->websocket_status;
-}
-
-void *swr_http_host_callback(void *server, int server_fd, bool handshake) {
-    return php_swoole_server_get_callback(
-        static_cast<Server *>(server), server_fd, handshake ? SW_SERVER_CB_onHandshake : SW_SERVER_CB_onRequest);
-}
-
-void swr_http_host_notice(const char *message) {
