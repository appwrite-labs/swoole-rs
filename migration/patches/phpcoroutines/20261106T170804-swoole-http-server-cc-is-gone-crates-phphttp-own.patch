-void php_swoole_http_server_onClose(Server *serv, DataHead *info) {
-    swr_v1_phphttp_server_close(info->fd);
-    php_swoole_server_onClose(serv, info);
-}
-
-void php_swoole_http_server_minit(int module_number) {
-    SW_INIT_CLASS_ENTRY_EX(swoole_http_server, "Swoole\\Http\\Server", nullptr, nullptr, swoole_server);
-    SW_SET_CLASS_NOT_SERIALIZABLE(swoole_http_server);
-    SW_SET_CLASS_CLONEABLE(swoole_http_server, sw_zend_class_clone_deny);
-    SW_SET_CLASS_UNSET_PROPERTY_HANDLER(swoole_http_server, sw_zend_class_unset_property_deny);
-}
-
-void php_swoole_http_server_rinit() {
-    // for is_uploaded_file and move_uploaded_file
-    if (!SG(rfc1867_uploaded_files)) {
-        ALLOC_HASHTABLE(SG(rfc1867_uploaded_files));
-        zend_hash_init(SG(rfc1867_uploaded_files), 8, nullptr, nullptr, 0);
-    }
-}
-
-void php_swoole_http_server_rshutdown() {
-    if (SG(rfc1867_uploaded_files)) {
-        destroy_uploaded_files_hash();
-        SG(rfc1867_uploaded_files) = nullptr;
-    }
-    swr_v1_phphttp_server_rshutdown();
-}
-
-HttpContext *swoole_http_context_new(SessionId fd) {
-    auto *ctx = static_cast<HttpContext *>(swr_v1_phphttp_context_new());
-    swr_v1_phphttp_context_objects(ctx, fd);
-    return ctx;
-}
-
-// What crates/phphttp/src/context.rs asks of the server a context is bound to.
-const char *swr_http_host_server_upload_tmp_dir(void *server) {
-    return static_cast<Server *>(server)->upload_tmp_dir.c_str();
-}
-
-bool swr_http_host_server_compression_type(void *server, const char *type, size_t length) {
-#ifdef SW_HAVE_COMPRESSION
-    auto &types = static_cast<Server *>(server)->http_compression_types;
-    if (!type || !types) {
-        return bool(types);
-    }
-    return types->find(std::string(type, length)) != types->end();
-#else
-    return false;
-#endif
-}
-
-bool swr_http_host_socket_closed(const zval *zsocket) {
-    return php_swoole_socket_is_closed(zsocket);
-}
-
-bool swr_http_host_connection_open(void *server, int64_t fd) {
-    auto *conn = static_cast<Server *>(server)->get_connection_by_session_id(fd);
-    return conn && !conn->closed && !conn->peer_closed;
-}
-
-bool swr_http_host_server_send(void *server, int64_t fd, const char *data, size_t length) {
-    auto *serv = static_cast<Server *>(server);
-    bool retval = serv->send(fd, data, length);
-    if (!retval && swoole_get_last_error() == SW_ERROR_OUTPUT_SEND_YIELD) {
-        auto sdata = zend_string_init(data, length, false);
-        auto rv = php_swoole_server_send_yield(serv, fd, sdata);
-        zend_string_release(sdata);
-        return rv;
-    }
-    return retval;
-}
-
-bool swr_http_host_server_sendfile(void *server, int64_t fd, zend_string *file, int64_t offset, size_t length) {
-    return static_cast<Server *>(server)->sendfile(fd, file->val, file->len, offset, length);
-}
-
-bool swr_http_host_server_close(void *server, int64_t fd) {
-    return static_cast<Server *>(server)->close(fd, false);
-}
-
-// The worker's request queue and the sessions' cached addresses are Rust's
-// (crates/phphttp/src/server.rs).
-
-bool swr_http_host_worker(swr_http_worker *worker) {
-    auto *server = sw_server();
-    auto *current = sw_worker();
-    if (!server || !current) {
-        return false;
-    }
-    worker->concurrency = &current->concurrency;
-    worker->server_concurrency = const_cast<uint32_t *>(&server->gs->concurrency);
-    worker->max_concurrency = server->worker_max_concurrency;
-    worker->shutdown = current->is_shutdown();
-    return true;
-}
-
-void swr_http_host_defer(void *context) {
-    swoole_event_defer(
-        [](void *private_data) {
-            auto *ctx = static_cast<HttpContext *>(private_data);
-            swr_v1_phphttp_server_deferred(ctx, ctx->get_async_server()->is_enable_coroutine());
-        },
-        context);
-}
-
-const char *swr_http_host_address(void *server, void *conn, bool local) {
-    auto *serv = static_cast<Server *>(server);
-    auto *c = static_cast<Connection *>(conn);
-    return local ? serv->get_local_addr(c) : serv->get_remote_addr(c);
-}
-
-/**
- * the addresses of a keep-alive session stay cached until php_swoole_http_server_onClose() erases them
- * so cache them only when the close event of the session reaches the same worker
- */
-bool swoole_http_server_can_cache_session_addr(const Server *server) {
-    return server->is_base_mode() || (server->is_process_mode() && server->dispatch_mode == Server::DISPATCH_FDMOD);
-}
