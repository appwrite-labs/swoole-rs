-void port_warn(int kind, const char *name) {
-    if (kind == 0) {
-        php_swoole_fatal_error(E_WARNING, "can't register event callback function after server started");
-    } else {
-        php_swoole_error(E_WARNING, "unknown event types[%s]", name);
-    }
-}
-const void *port_ssl_owner(void *port) {
-    SSLContext *context = static_cast<ListenPort *>(port)->get_ssl_context();
-    return context ? context->handle() : nullptr;
-}
-void *port_sni_context(void *port, const void **owner) {
-    auto *context = new std::shared_ptr<SSLContext>(static_cast<ListenPort *>(port)->dup_ssl_context());
-    *owner = (*context)->handle();
-    return context;
-}
-bool port_sni_add(void *port, const char *name, size_t length, void *context) {
-    std::unique_ptr<std::shared_ptr<SSLContext>> held(static_cast<std::shared_ptr<SSLContext> *>(context));
-    return name && static_cast<ListenPort *>(port)->ssl_add_sni_cert(std::string(name, length), *held);
-}
-bool port_ssl_init(void *port) {
-    return static_cast<ListenPort *>(port)->ssl_init();
-}
-}  // namespace
