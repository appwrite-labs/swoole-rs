-// The task family (crates/phpserver, task.rs): the Server, the task encoding and
-// the coroutine it reaches.
-namespace {
-static_assert(sizeof(EventData) <= SWR_PHPSERVER_EVENT_DATA_SIZE &&
-                  alignof(EventData) <= SWR_PHPSERVER_EVENT_DATA_ALIGN,
-              "the EventData crates/phpserver's task.rs allocates");
-static_assert(SW_TASK_NONBLOCK == 1 << 2 && SW_TASK_CALLBACK == 1 << 3 && SW_TASK_COROUTINE == 1 << 5 &&
-                  SW_TASK_NOREPLY == 1 << 7 && SW_MAX_CONCURRENT_TASK == 1024 && SW_SERVER_CB_onTask == 7 &&
-                  SW_SERVER_CB_onFinish == 8 && SW_ERROR_TASK_DISPATCH_FAIL == 2002,
-              "constants crates/phpserver's task.rs uses");
-bool task_dispatch_multi(void *server, zval *ztasks, double timeout, zval *return_value, bool *bailed) {
-    bool done = false;
-    zend_try {
-        Server::MultiTask mt(php_swoole_array_length(ztasks));
-        mt.pack = [ztasks](uint16_t i, EventData *buf) {
-            auto *ztask = zend::array_get(ztasks, (zend_ulong) i);
-            bool bailed = false;
-            TaskId id = swr_v1_phpserver_task_pack(ztask, buf, &bailed);
-            if (bailed) {
-                zend_bailout();
-            }
-            return id;
-        };
-        mt.unpack = [return_value](uint16_t i, EventData *result) {
-            zval zresult;
-            bool bailed = false;
-            if (swr_v1_phpserver_task_unpack(result, &zresult, &bailed)) {
-                add_index_zval(return_value, i, &zresult);
-            }
-            if (bailed) {
-                zend_bailout();
-            }
-        };
-        mt.fail = [return_value](uint16_t i) { add_index_bool(return_value, i, false); };
-        done = as_server(server)->task_sync(mt, timeout);
-    }
-    zend_catch {
-        *bailed = true;
-    }
-    zend_end_try();
-    return done;
-}
-}  // namespace
