-// The server object, its ports' callbacks and a request's payload are Rust's (instance.rs).
-namespace {
-void server_invalid(zend_object *object) {
-    php_swoole_fatal_error(E_ERROR, "Invalid instance of %s", ZSTR_VAL(object->ce->name));
-}
-Server *as_server(void *server) {
-    return static_cast<Server *>(server);
-}
-void port_socket(void *port, zval *return_value) {
-#ifdef SWOOLE_SOCKETS_SUPPORT
-    php_socket *socket_object = php_swoole_convert_to_socket(static_cast<ListenPort *>(port)->get_fd());
-    if (!socket_object) {
-        RETURN_FALSE;
-    }
-    SW_ZVAL_SOCKET(return_value, socket_object);
-    zval *zsocket = sw_zval_dup(return_value);
-    Z_TRY_ADDREF_P(zsocket);
-#else
-    (void) port;
-    RETURN_FALSE;
-#endif
-}
-void server_socket(void *server, int64_t port, zval *return_value) {
-    port_socket(as_server(server)->get_port(port), return_value);
-}
-void *dispatch_message_bus(void *server) {
-    return as_server(server)->get_worker_message_bus();
-}
-void dispatch_worker_start(void *server) {
-    Server *serv = as_server(server);
-    if (serv->is_task_worker() && !serv->task_enable_coroutine && !serv->is_thread_mode()) {
-        swr_v1_phpruntime_enable_hook(0);
-    }
-    serv->get_worker_message_bus()->set_allocator(sw_zend_string_allocator());
-}
-bool io_listen(zend_object *object, const char *host, int64_t port, int64_t sock_type, zval *return_value) {
-    Server *serv = server_fetch_object(object)->serv;
-    ListenPort *ls;
-    if (serv->is_worker_thread()) {
-        ls = serv->get_port((enum swSocketType) sock_type, host, (int) port);
-    } else {
-        ls = serv->add_port((enum swSocketType) sock_type, host, (int) port);
-    }
-    if (!ls) {
-        return false;
-    }
-    zval *port_object = swr_v1_phpserver_add_port(object, ls);
-    RETVAL_ZVAL(port_object, 1, 0);
-    return true;
-}
-int io_send_unix(void *server, const char *path, const char *data, size_t length, int64_t server_socket) {
-    Server *serv = as_server(server);
-    if (!serv->have_dgram_sock) {
-        return -1;
-    }
-    network::Socket *sock = server_socket == -1 ? serv->dgram_socket : serv->get_server_socket(server_socket);
-    if (sock == nullptr) {
-        return 0;
-    }
-    return sock->sendto(path, 0, data, length) > 0;
-}
-int io_sendto(void *server, int kind, const char *addr, int64_t port, const char *data, size_t len,
-              int64_t server_socket_fd) {
-    Server *serv = as_server(server);
-    network::Socket *socket = kind == 1 ? serv->udp_socket_ipv4 : kind == 2 ? serv->udp_socket_ipv6 : serv->dgram_socket;
-    if (!socket) {
-        return -1;
-    }
-    network::Socket *server_socket = server_socket_fd < 0 ? socket : serv->get_server_socket(server_socket_fd);
-    return server_socket->sendto(addr, port, data, len) >= 0;
-}
