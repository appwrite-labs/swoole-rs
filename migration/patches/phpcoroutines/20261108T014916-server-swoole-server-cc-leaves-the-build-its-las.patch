-// The Server object's lifecycle (crates/phpserver, lifecycle.rs): the Server, its
-// ports and the C++ callbacks it installs.
-namespace {
-static_assert(SW_ERROR_INVALID_PARAMS == 505 && SW_ERROR_OPERATION_NOT_SUPPORT == 507 && SW_ERROR_SERVER_UNRELATED_THREAD == 9016 && SW_SOCK_TCP == 1 &&
-                  PHP_SWOOLE_SERVER_CALLBACK_NUM == 14 && SW_SERVER_CB_onRequest == 4 &&
-                  SW_SERVER_CB_onMessage == 8 && SW_ERROR_PHP_RUNTIME_NOTICE == 510,
-              "constants crates/phpserver's lifecycle.rs uses");
-int64_t lifecycle_fact(void *server, uint32_t id) {
-    Server *serv = as_server(server);
-    switch (id) {
-    case SWR_PHPSERVER_FACT_CACHE_SESSION_ADDR: return swoole_http_server_can_cache_session_addr(serv);
-    default: return 0;
-    }
-}
-void lifecycle_install(void *server, uint32_t which) {
-    Server *serv = as_server(server);
-    switch (which) {
-    case SWR_PHPSERVER_INSTALL_ALLOCATORS:
-        serv->message_bus.set_allocator(sw_zend_string_allocator());
-        if (serv->is_base_mode() || serv->is_thread_mode()) {
-            serv->recv_buffer_allocator = sw_zend_string_allocator();
-        }
-        break;
-    case SWR_PHPSERVER_INSTALL_ADMIN_COMMANDS: swoole::register_admin_server_commands(serv); break;
-    default: break;
-    }
-}
-void *lifecycle_create(int64_t mode) {
-    auto *serv = new Server((enum Server::Mode) mode);
-    if (mode == Server::MODE_BASE) {
-        serv->reactor_num = 1;
-        serv->worker_num = 1;
-    }
-    return serv;
-}
-int lifecycle_add_systemd_socket(void *server) {
-    return as_server(server)->add_systemd_socket();
-}
-zval *lifecycle_port_object(void *server, void *port) {
-    auto *ls = static_cast<ListenPort *>(port);
-    zval *zport = sw_malloc_zval();
-    object_init_ex(zport, swoole_server_port_ce);
-    swr_v1_phpserver_port_set(Z_OBJ_P(zport), ls);
-    auto *property = static_cast<ServerPortProperty *>(swr_v1_phpserver_port_object_property(Z_OBJ_P(zport)));
-    property->serv = as_server(server);
-    property->port = ls;
-    swr_v1_phpserver_port_property(ls->object_id, &ls->ptr, property, true);
-    return zport;
-}
-const char *lifecycle_create_server(void *server) {
-    return as_server(server)->create() < 0 ? sw_error : nullptr;
-}
-int lifecycle_start(void *server, const char **error) {
-    Server *serv = as_server(server);
-    int result = 0;
-    zend_try {
-        if (serv->start() < 0) {
-            *error = serv->get_startup_error_message();
-            result = -1;
-        }
-    } zend_catch {
-        result = 1;
-    } zend_end_try();
-    return result;
-}
-void lifecycle_release(void *server) {
-    delete as_server(server);
-}
-int64_t lifecycle_add_process(void *server, zval *process) {
-    Server *serv = as_server(server);
-    if (serv->is_worker_thread()) {
-        if (!serv->is_user_worker()) {
-            return -2;
-        }
-        int worker_id = swoole_get_worker_id();
-        Worker *worker = serv->get_worker(worker_id);
-        worker->redirect_stdin = worker->redirect_stdout = worker->redirect_stderr = false;
-        return worker_id - serv->get_core_worker_num();
-    }
-    int64_t worker_id = -3;
-    zend_try {
-        auto *worker = static_cast<Worker *>(swr_v1_phpprocess_worker(process, true));
-        worker_id = serv->add_worker(worker);
-        if (worker_id >= 0) {
-            worker->ptr = process;
-        } else {
-            worker_id = -1;
-        }
-    } zend_catch {
-        worker_id = -3;
-    } zend_end_try();
-    return worker_id;
-}
-zend_string *lifecycle_json_encode(zval *data, bool *bailed) {
-    smart_str buf = {};
-    bool encoded = false;
-    zend_try {
-        encoded = php_json_encode(&buf, data, 0) != FAILURE && buf.s;
-    } zend_catch {
-        *bailed = true;
-    } zend_end_try();
-    if (!encoded) {
-        smart_str_free(&buf);
-        return nullptr;
-    }
-    return buf.s;
-}
-void lifecycle_json_decode(const char *text, size_t length, zval *out) {
-    if (php_json_decode(out, text, (int) length, true, 0) == FAILURE) {
-        ZVAL_FALSE(out);
-    }
-}
