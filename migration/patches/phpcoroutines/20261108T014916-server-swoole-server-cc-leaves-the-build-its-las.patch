-                  SW_SERVER_CB_onWorkerStart == 3 && SW_SERVER_CB_onWorkerStop == 4 &&
-                  SW_SERVER_CB_onBeforeReload == 5 && SW_SERVER_CB_onAfterReload == 6 &&
-                  SW_SERVER_CB_onWorkerExit == 9 && SW_SERVER_CB_onWorkerError == 10 &&
-                  SW_SERVER_CB_onManagerStart == 11 && SW_SERVER_CB_onManagerStop == 12 &&
-                  SW_SERVER_CB_onPipeMessage == 13 && SW_SERVER_CB_onReceive == 1 && SW_SERVER_CB_onPacket == 3 &&
-                  SW_SERVER_CB_onBufferFull == 10 && SW_SERVER_CB_onBufferEmpty == 11,
-                  "callback types crates/phpserver dispatches");
-    static_assert(offsetof(RecvData, data) == sizeof(DataHead) && offsetof(DgramPacket, socket_addr) == 4 &&
-                      offsetof(DgramPacket, length) == 4 + sizeof(network::Address) &&
-                      sizeof(ExitStatus) == 2 * sizeof(int),
