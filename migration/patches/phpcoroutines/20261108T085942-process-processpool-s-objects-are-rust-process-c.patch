-    }
-    case SWR_POOL_OP_ON_AFTER_RELOAD:
-        pool->onAfterReload(pool);
-        return 0;
-    case SWR_POOL_OP_KILL_TIMER:
-        swoole_timer_add((long) pool->max_wait_time * 1000, false, [pool](Timer *, TimerNode *) {
-            pool->kill_all_workers();
-        });
-        return 0;
-    case SWR_POOL_OP_BOX_PUSH: {
-        auto msg = reinterpret_cast<const EventData *>(arg);
