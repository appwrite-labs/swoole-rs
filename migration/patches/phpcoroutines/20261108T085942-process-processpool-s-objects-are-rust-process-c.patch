-static const swr_v1_pool_hooks pool_hooks = {
-    [](void *pool, void *worker) {
-        return static_cast<ProcessPool *>(pool)->is_worker_running(static_cast<Worker *>(worker));
-    },
-    [](void *) { worker_end_callback(); },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = swr_v1_os_msg_queue_pop(call_pool(arg)->queue, c->data, c->length);
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = swr_v1_os_msg_queue_push(call_pool(arg)->queue, c->data, c->length);
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->socket = pool_listener(call_pool(arg))->accept();
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = static_cast<Socket *>(c->socket)->recv_sync(c->data, c->length, c->flags);
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = static_cast<Socket *>(c->socket)->send_sync(c->data, c->length);
-        c->error = errno;
-    },
-    [](void *socket) { static_cast<Socket *>(socket)->free(); },
-    [](void *arg) {
-        auto c = call_of(arg);
-        auto pipe = call_worker(arg)->pipe_worker;
-        pipe->set_timeout(msec2sec(swoole_timer_get_next_msec()), SW_TIMEOUT_READ);
-        c->result = pipe->read_sync(c->data, c->length);
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = call_worker(arg)->pipe_worker->wait_event(swoole_timer_get_next_msec(), SW_EVENT_READ);
-        c->error = errno;
-    },
-    [](void *arg) {
-        auto c = call_of(arg);
-        c->result = call_pool(arg)->message_bus->read(call_worker(arg)->pipe_worker);
-        c->error = errno;
-    },
-    [](void *arg) { deliver_bus_message(call_pool(arg)); },
-    [](void *arg) {
-        auto pool = call_pool(arg);
-        call_of(arg)->result = pool->onTask(pool, call_worker(arg), static_cast<EventData *>(call_of(arg)->data));
-    },
-    [](void *arg) {
-        auto pool = call_pool(arg);
-        RecvData msg{};
-        msg.info.reactor_id = -1;
-        msg.info.len = call_of(arg)->length;
-        msg.data = static_cast<char *>(call_of(arg)->data);
-        pool->onMessage(pool, &msg);
-    },
-    [](void *worker) { static_cast<Worker *>(worker)->shutdown(); },
-    [](void *arg) {
-        auto c = call_of(arg);
-        auto socket = static_cast<Socket *>(c->socket);
-        if (c->flags && swoole_event_is_available()) {
-            c->result = swoole_event_write(socket, c->data, c->length);
-        } else {
-            c->result = socket->send_sync(c->data, c->length);
-        }
-        c->error = errno;
-    },
-    pool_warn,
-};
