-// The ops each read makes, in a small frame of their own: the rest of
-// port_read_call needs a large, stack-protected one.
-static uint64_t port_read_hot_call(void *context, uint32_t op, uint64_t arg) {
-    auto &c = *static_cast<PortRead *>(context);
-    auto *request = static_cast<http_server::Request *>(c.conn->object);
-    String *buffer = c.buffer();
-    switch (op) {
-    case SWR_PORTS_OP_RECV:
-        return arg ? c.socket->recv(buffer->str, buffer->size, 0)
-                   : c.socket->recv(buffer->str + buffer->length, buffer->size - buffer->length, 0);
-    case SWR_PORTS_OP_RECV_BUFFER:
-        c.set_buffer(c.serv->get_recv_buffer(c.socket));
-        return c.buffer() != nullptr;
-    case SWR_PORTS_OP_RELEASE:
-        if (c.socket->recv_buffer && (!arg || c.socket->recv_buffer->length == 0) &&
-            c.socket->recv_buffer->size > SW_BUFFER_SIZE_BIG * 2) {
-            delete c.socket->recv_buffer;
-            c.socket->recv_buffer = nullptr;
-            return 1;
-        }
-        return 0;
-    case SWR_PORTS_OP_RECV_LENGTH: return c.port->protocol.recv_with_length_protocol(c.socket, buffer);
-    case SWR_PORTS_OP_ACTIVE: return c.conn->active && !c.socket->removed;
-    case SWR_PORTS_OP_MAX_LENGTH: return c.port->protocol.package_max_length;
-    case SWR_PORTS_OP_REQ_INIT:
-        if (!request) {
-            c.conn->object = request = static_cast<http_server::Request *>(swr_v1_http_request_new());
-        }
-        if (!request->buffer_) {
-            request->buffer_ = c.serv->get_recv_buffer(c.socket);
-        }
-        c.set_buffer(request->buffer_);
-        c.set_request(request);
-        return 0;
-    case SWR_PORTS_OP_REQ_DESTROY:
-        c.port->destroy_http_request(c.conn);
-        c.set_request(nullptr);
-        return 0;
-    default: return port_read_call(context, op, arg);
-    }
-}
