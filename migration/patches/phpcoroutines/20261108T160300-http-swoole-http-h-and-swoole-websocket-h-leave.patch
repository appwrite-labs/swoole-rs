-// crates/http/src/request.rs: every Request operation, on the struct in place.
-extern "C" {
-void swr_v3_http_request_init(swoole::http_server::Request *);
-void swr_v3_http_request_clean(swoole::http_server::Request *);
-int32_t swr_v1_http_request_protocol(swoole::http_server::Request *);
