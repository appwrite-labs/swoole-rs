-uint32_t swr_v1_http_request_multipart_init(swoole::http_server::Request *, const uint8_t *, size_t, size_t);
-uint32_t swr_v1_http_request_multipart_parse(swoole::http_server::Request *, swoole::String *);
-void swr_v1_http_request_multipart_destroy(swoole::http_server::Request *);
-void swr_v1_http_form_free(swoole::http_server::FormData *);
-}
-
-namespace swoole {
-namespace http_server {
-//-----------------------------------------------------------------
-// The multipart form being streamed: Rust state. `delete` hands it back.
-struct FormData {
-    static void operator delete(void *form) {
-        swr_v1_http_form_free(static_cast<FormData *>(form));
-    }
-};
-
-// crates/http/src/request.rs mirrors this layout; one-byte flags, not bit-fields.
-struct Request {
-    uint8_t method;
-    uint8_t version;
-    bool excepted;
-    bool too_large;
-    bool unavailable;
-
-    bool header_parsed;
-    bool tried_to_dispatch;
-    bool multipart_header_parsed;
-
-    bool known_length;
-    bool keep_alive;
-    bool chunked;
-    bool nobody_chunked;
-
-    uint32_t url_offset_;
-    uint32_t url_length_;
-
-    uint32_t max_length_;
-    uint32_t request_line_length_; /* without \r\n  */
-    uint32_t header_length_;       /* include request_line_length + \r\n */
-    uint64_t content_length_;
-    uint8_t chunk_state_;
-    size_t chunk_length_;
-    size_t chunk_offset_;
-    size_t chunk_scan_offset_;
-
-    FormData *form_data_;
-    String *buffer_;
-    uint64_t (*native_)(uint32_t, void *, const uint8_t *, uint64_t, uint64_t);
-
-    Request() { swr_v3_http_request_init(this); }
-    ~Request() { swr_v1_http_request_multipart_destroy(this); }
-    void clean() { swr_v3_http_request_clean(this); }
-    int get_protocol() {
-        return swr_v1_http_request_protocol(this);
-    }
-    int get_header_length() {
-        return swr_v1_http_request_header_length(this);
-    }
-    int get_chunked_body_length() {
-        return swr_v1_http_request_chunked_length(this);
-    }
-    void parse_header_info() {
-        swr_v1_http_request_parse_header(this);
-    }
-    bool parse_multipart_data(String *buffer) {
-        return swr_v1_http_request_multipart_parse(this, buffer);
-    }
-    void destroy_multipart_parser() {
-        swr_v1_http_request_multipart_destroy(this);
-    }
-    std::string get_header(const char *name) const {
-        swr_v1_http_span value{};
-        return swr_v1_http_request_header(this, reinterpret_cast<const uint8_t *>(name), strlen(name), &value) == 1
-                   ? std::string(buffer_->str + value.offset, value.length)
-                   : std::string();
-    }
-    bool has_expect_header() const {
-        return swr_v1_http_request_expect(this);
-    }
-};
-
-int get_method(const char *method_str, size_t method_len);
-const char *get_method_string(int method);
-const char *get_status_message(int code);
-extern int list_of_status_code[128];
-/**
- * This function will directly modify the data in the input buffer.
- */
-size_t url_decode(char *str, size_t len);
-/**
- * Returns a new memory address, and the pointer at this address needs to be manually released in the calling layer.
- */
-char *url_encode(char const *str, size_t len);
-int dispatch_request(Server *serv, const Protocol *proto, network::Socket *socket, const RecvData *rdata);
-bool parse_multipart_boundary(
-    const char *at, size_t length, size_t offset, char **out_boundary_str, int *out_boundary_len);
-
-ssize_t get_package_length(const Protocol *protocol, network::Socket *conn, PacketLength *pl);
-uint8_t get_package_length_size(network::Socket *conn);
-int dispatch_frame(const Protocol *protocol, network::Socket *conn, const RecvData *rdata);
