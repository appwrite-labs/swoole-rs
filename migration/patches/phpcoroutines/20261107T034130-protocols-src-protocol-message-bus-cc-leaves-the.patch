-
-#include "swoole_message_bus.h"
-#include "swoole_server.h"
-
-using swoole::network::Socket;
-
-namespace swoole {
-
-bool MessageBus::alloc_buffer() {
-    void *buffer = allocator_->malloc(get_buffer_size());
-    swr_v1_bus_set_buffer(bus_, buffer);
-    return buffer != nullptr;
-}
-
-/**
- * @return -1: a fatal error has occurred and needs to be terminated
- * @return 0: continue
- * @return >0: success
- */
-ssize_t MessageBus::receive(Socket *sock, bool dgram) {
-    swr_bus_read state{};
-    for (;;) {
-        const ssize_t retval = swr_v1_bus_read(bus_, sock->get_fd(), dgram, &sock->kernel_nobufs, &state);
-        const DataHead *info = &get_buffer()->info;
-        switch (state.event) {
-        case SWR_BUS_ALLOCATE: {
-            // Native frame: the allocator may be Zend's, which can bail out.
-            auto allocator = state.data ? static_cast<const Allocator *>(state.allocator) : allocator_;
-            void *data = state.data ? allocator->realloc(state.data, state.size) : allocator->malloc(state.size);
-            if (data == nullptr) {
-                throw std::bad_alloc();
-            }
-            swr_v1_bus_adopt(bus_, data, state.size, allocator);
-            continue;
-        }
-        case SWR_BUS_CLOSED:
-            swoole_warning("receive data from socket#%d returns 0", sock->get_fd());
-            break;
-        case SWR_BUS_READV_CLOSED:
-            swoole_warning("receive pipeline data error, pipe_fd=%d, reactor_id=%d", sock->get_fd(), info->reactor_id);
-            break;
-        case SWR_BUS_ABNORMAL:
-            swoole_error_log(SW_LOG_WARNING,
-                             SW_ERROR_SERVER_WORKER_ABNORMAL_PIPE_DATA,
-                             "abnormal pipeline data, msg_id=%" PRIu64 ", pipe_fd=%d, reactor_id=%d",
-                             info->msg_id,
-                             sock->get_fd(),
-                             info->reactor_id);
-            break;
-        }
-        return retval;
-    }
-}
-
-static ssize_t bus_send(void *socket, const iovec *iov, size_t count) {
-    auto sock = static_cast<Socket *>(socket);
-    return swoole_event_is_available() ? swoole_event_writev(sock, iov, count) : sock->writev_sync(iov, count);
-}
-
-static bool bus_reduce(void *socket) {
-    return static_cast<Socket *>(socket)->catch_write_pipe_error(errno) == SW_REDUCE_SIZE;
-}
-
-bool MessageBus::write(Socket *sock, SendData *resp) const {
-    resp->info.msg_id = id_generator_();
-    return swr_v1_bus_write(bus_, sock, &resp->info, resp->data, bus_send, bus_reduce);
-}
-
-void MessageBus::init_pipe_socket(const Socket *sock) {
-    int pipe_fd = sock->get_fd();
-    if ((size_t) pipe_fd >= pipe_sockets_.size()) {
-        pipe_sockets_.resize(pipe_fd + 1);
-    }
-    auto _socket = make_socket(pipe_fd, SW_FD_PIPE);
-    _socket->buffer_size = UINT_MAX;
-    if (!_socket->nonblock) {
-        _socket->set_nonblock();
-    }
-    pipe_sockets_[pipe_fd] = _socket;
-}
-
-MessageBus::~MessageBus() {
-    swr_v1_bus_free(bus_);
-    for (auto _socket : pipe_sockets_) {
-        if (_socket) {
-            _socket->fd = -1;
-            _socket->free();
-        }
-    }
-}
-
-}  // namespace swoole
