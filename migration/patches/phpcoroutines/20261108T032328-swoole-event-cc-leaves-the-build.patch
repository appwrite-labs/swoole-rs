-#include "php_swoole_cxx.h"
-#include "swoole_server.h"
-#include "swoole_signal.h"
-
-#include "swoole_rs_phpevents.h"
-
-using namespace swoole;
-using swoole::network::Socket;
-
-// The class, its method table, the fd registry and callbacks, and add/set/del/
-// write/defer/cycle/isset are Rust (crates/phpevents). The reactor and the
-// loop-driven functions stay C++, extern "C" so the Rust table can name them.
-SW_EXTERN_C_BEGIN
-PHP_FUNCTION(swoole_event_wait);
-PHP_FUNCTION(swoole_event_rshutdown);
-PHP_FUNCTION(swoole_event_exit);
-PHP_FUNCTION(swoole_event_dispatch);
-SW_EXTERN_C_END
-
-static void event_object_free(void *data) {
-    if (swr_v1_phpevents_free(data)) {
-        zend_bailout();
-    }
-}
-
-static int event_ready(Event *event, uint8_t write) {
-    int result = swr_v1_phpevents_ready(event->socket, write);
-    if (result == 1) {
-        zend_bailout();
-    }
-    return result;
-}
-
-static int event_readable_callback(Reactor *reactor, Event *event) {
-    return event_ready(event, 0);
-}
-
-static int event_writable_callback(Reactor *reactor, Event *event) {
-    return event_ready(event, 1);
-}
-
-static int event_error_callback(Reactor *reactor, Event *event) {
-    swr_v1_phpevents_error_event context{event, event->socket, event->socket->fd, event->fd, event->socket->events, SW_OK};
-    if (swr_v1_phpevents_error(&context)) { zend_bailout(); }
-    return context.result;
-}
-
-static void event_defer_callback(void *data) {
-    if (swr_v1_phpevents_deferred(data)) {
-        zend_bailout();
-    }
-}
-
-static void event_cycle_callback(void *data) {
-    if (swr_v1_phpevents_cycle(data)) {
-        zend_bailout();
-    }
-}
-
-static DeferCallback *event_cycle_task(uint8_t before) {
-    return before ? &sw_reactor()->future_task : &sw_reactor()->idle_task;
-}
-
-static const swr_v1_phpevents_ops event_ops = {
-    [](void *data) {
-        auto *context = static_cast<swr_v1_phpevents_error_event *>(data);
-        auto *event = static_cast<Event *>(context->event);
-        auto *reactor = sw_reactor();
-        auto type = event->socket->events & SW_EVENT_READ ? SW_EVENT_READ : SW_EVENT_WRITE;
-        context->result = reactor->get_handler(event->socket->fd_type, type)(reactor, event);
-    },
-    {
-        []() -> uint8_t { return SWOOLE_G(cli); },
-        []() -> uint8_t { return SWOOLE_G(req_status) == PHP_SWOOLE_RSHUTDOWN_BEGIN; },
-        []() -> uint8_t {
-            auto *server = sw_server();
-            return server ? 1 | (server->is_task_worker() ? 2 : 0) |
-                                (server->task_enable_coroutine ? 4 : 0) | (server->is_manager() ? 8 : 0) : 0;
-        },
-        []() -> uint8_t { return php_swoole_is_fatal_error(); },
-        []() -> uint8_t { return swoole_coroutine_is_in(); },
-        []() -> uint8_t { return sw_reactor()->bailout; },
-        [](int32_t flags) -> int32_t { return swoole_event_init(flags); },
-        []() -> uint8_t { return swoole_event_isset_handler(SW_FD_USER, SW_EVENT_READ); },
-        [](void *) {
-            swoole_event_set_handler(SW_FD_USER, SW_EVENT_READ, event_readable_callback);
-            swoole_event_set_handler(SW_FD_USER, SW_EVENT_WRITE, event_writable_callback);
-            swoole_event_set_handler(SW_FD_USER, SW_EVENT_ERROR, event_error_callback);
-        },
-        [](void *) {
-#ifdef SW_LOG_TRACE_OPEN
-            if (SW_LOG_TRACE >= swoole_get_log_level() && (SW_TRACE_PHP & swr_v1_core_trace_flags())) {
-                size_t length = sw_snprintf(sw_error, SW_ERROR_MSG_SIZE,
-                                           "php_swoole_reactor_init(:%d): init reactor", __LINE__);
-                sw_logger()->put(SW_LOG_TRACE, sw_error, length);
-            }
-#endif
-        },
-        [](void *name) { php_swoole_register_shutdown_function(static_cast<char *>(name)); },
-        []() -> uint8_t { return bool(SwooleG.user_exit_condition); },
-        []() -> uint8_t { return sw_reactor()->isset_exit_condition(Reactor::EXIT_CONDITION_USER_AFTER_DEFAULT); },
-        [](void *) {
-            sw_reactor()->set_exit_condition(Reactor::EXIT_CONDITION_USER_AFTER_DEFAULT, SwooleG.user_exit_condition);
-        },
-        [](void *out) { *static_cast<uint8_t *>(out) = sw_reactor()->if_exit(); },
-        [](void *out) { *static_cast<int32_t *>(out) = sw_reactor()->wait(); },
-        [](void *) { swoole_event_free(); },
-        [](void *) { php_swoole_timer_clear_all(); },
-        [](uint8_t value) { sw_reactor()->running = value; },
-        [](uint8_t value) { sw_reactor()->once = value; },
-        [](int32_t level, const char *message) { php_swoole_fatal_error(level, "%s", message); },
-        [](int32_t code, int32_t level, const char *message) {
-            errno = code;
-            php_swoole_sys_error(level, "%s", message);
-        },
-    },
-    {
-        [](uint8_t index) { const sw_zend_known_string_id names[] = {SW_ZEND_STR_FD, SW_ZEND_STR_SOCK, SW_ZEND_STR_PIPE};
-                           return SW_ZSTR_KNOWN(names[index]); },
-        []() -> zend_class_entry * {
-#ifdef SWOOLE_SOCKETS_SUPPORT
-            return socket_ce;
-#else
-            return nullptr;
-#endif
-        },
-        [](zval *value, uint8_t *closed) -> int32_t {
-#ifdef SWOOLE_SOCKETS_SUPPORT
-            auto *socket = SW_Z_SOCKET_P(value);
-            *closed = IS_INVALID_SOCKET(socket);
-            return socket->bsd_socket;
-#else
-            *closed = 0;
-            return -1;
-#endif
-        },
-    },
-    []() -> uint8_t { return sw_reactor() != nullptr; },
-    [](void *callable) { swoole_event_defer([](void *handle) {
-        if (swr_v1_phpevents_callable_free(handle)) { zend_bailout(); }
-    }, callable); },
-    []() -> uint8_t { return php_swoole_is_enable_coroutine(); },
-    swr_v1_phpcoroutines_create,
-    [](int32_t fd, void *object) -> void * {
-        Socket *socket = make_socket(fd, SW_FD_USER);
-        socket->set_nonblock();
-        socket->object = object;
-        return socket;
-    },
-    [](void *socket, int64_t events) -> int32_t { return swoole_event_add(static_cast<Socket *>(socket), events); },
-    [](void *socket, const char *data, size_t length) -> int32_t {
-        return swoole_event_write(static_cast<Socket *>(socket), data, length);
-    },
-    [](void *socket, int64_t events) -> int32_t { return swoole_event_set(static_cast<Socket *>(socket), events); },
-    [](void *socket) -> int32_t { return swoole_event_del(static_cast<Socket *>(socket)); },
-    [](void *socket, uint8_t detach_fd) {
-        if (detach_fd) {
-            static_cast<Socket *>(socket)->fd = -1;
-        }
-        static_cast<Socket *>(socket)->free();
-    },
-    [](void *socket) { return static_cast<Socket *>(socket)->object; },
-    [](void *socket) { static_cast<Socket *>(socket)->object = nullptr; },
-    [](void *socket, uint8_t *removed) -> int32_t {
-        *removed = static_cast<Socket *>(socket)->removed;
-        return static_cast<Socket *>(socket)->events;
-    },
-    [](void *object) { swoole_event_defer(event_object_free, object); },
-    [](void *callable) { swoole_event_defer(event_defer_callback, callable); },
-    [](uint8_t before, uint8_t *armed) {
-        auto *task = event_cycle_task(before);
-        *armed = task->callback != nullptr;
-        return task->data;
-    },
-    [](uint8_t before, void *callable, uint8_t armed) {
-        auto *task = event_cycle_task(before);
-        task->callback = armed ? event_cycle_callback : nullptr;
-        task->data = callable;
-    },
-    [](const char *message) { php_swoole_fatal_error(E_WARNING, "%s", message); },
-    [](const char *message) { php_swoole_error(E_WARNING, "%s", message); },
-};
-
-void php_swoole_event_minit(int module_number) {
-    swr_v1_phpevents_minit(&event_ops);
-}
-
-int php_swoole_reactor_init() { return swr_v1_phpevents_init(); }
-void php_swoole_event_wait() { swr_v1_phpevents_wait(); }
-int php_swoole_convert_to_fd(zval *value) { return swr_v1_phpevents_fd(value); }
-
-#ifdef SWOOLE_SOCKETS_SUPPORT
-php_socket *php_swoole_convert_to_socket(int sock) {
-    php_socket *socket_object;
-    zval zsocket;
-    object_init_ex(&zsocket, socket_ce);
-    socket_object = Z_SOCKET_P(&zsocket);
-    auto new_sock = dup(sock);
-    if (new_sock < 0) {
-        return nullptr;
-    }
-    socket_import_file_descriptor(new_sock, socket_object);
-    return socket_object;
-}
-#endif
-
-PHP_FUNCTION(swoole_event_rshutdown) {
-    zend_try { swr_v1_phpevents_shutdown(); } zend_end_try();
-}
