-
-#include "php_swoole_client.h"
-#include "swoole_rs_clients.h"
-#include "swoole_rs_phpclients.h"
-
-#include "swoole_string.h"
-#include "swoole_socket.h"
-#include "swoole_protocol.h"
-
-using swoole::SSLContext;
-using swoole::String;
-using swoole::network::Address;
-
-static zend_class_entry *swoole_client_coro_ce;
-
-struct ClientCoroObject {
-    SocketImpl *socket;
-    zval zsocket;
-    /* safety zval */
-    zval zobject;
-    zend_object std;
-};
-
-// The class, its object and every method are Rust (crates/phpclients), with
-// the method tables over crates/phpstubs' arginfo.
-static ClientCoroObject *client_coro_fetch_object(zend_object *obj) {
-    return reinterpret_cast<ClientCoroObject *>(reinterpret_cast<char *>(obj) - offsetof(ClientCoroObject, std));
-}
-
-static ClientCoroObject *client_coro_get_client(const zval *zobject) {
-    return client_coro_fetch_object(Z_OBJ_P(zobject));
-}
-
-static void client_coro_socket_dtor(ClientCoroObject *client) {
-    if (client->socket->protocol.private_data_1) {
-        sw_callable_free(client->socket->protocol.private_data_1);
-        client->socket->protocol.private_data_1 = nullptr;
-    }
-    client->socket = nullptr;
-    zend_update_property_null(Z_OBJCE_P(&client->zobject), SW_Z8_OBJ_P(&client->zobject), ZEND_STRL("socket"));
-    zend_update_property_bool(Z_OBJCE_P(&client->zobject), SW_Z8_OBJ_P(&client->zobject), ZEND_STRL("connected"), 0);
-    zval_ptr_dtor(&client->zsocket);
-    ZVAL_NULL(&client->zsocket);
-}
-
-static SocketImpl *client_coro_create_socket(zval *zobject, zend_long type) {
-    auto socket_type = php_swoole_client_get_type(type);
-    auto object = php_swoole_create_socket(socket_type);
-    if (UNEXPECTED(!object)) {
-        php_swoole_socket_set_error_properties(zobject, errno);
-        return nullptr;
-    }
-    auto client = client_coro_get_client(zobject);
-    ZVAL_OBJ(&client->zsocket, object);
-    auto *socket = php_swoole_get_socket(&client->zsocket);
-
-    socket->set_dtor([client](CoSocket *_socket) { client_coro_socket_dtor(client); });
-
-    zend_update_property_long(Z_OBJCE_P(zobject), SW_Z8_OBJ_P(zobject), ZEND_STRL("fd"), socket->get_fd());
-    zend_update_property(Z_OBJCE_P(zobject), SW_Z8_OBJ_P(zobject), ZEND_STRL("socket"), &client->zsocket);
-
-    socket->set_buffer_allocator(sw_zend_string_allocator());
-    socket->set_zero_copy(true);
-
-    if ((type & SW_SOCK_SSL) && !socket->enable_ssl_encrypt()) {
-        php_swoole_socket_set_error_properties(zobject, EISCONN);
-        client_coro_socket_dtor(client);
-        return nullptr;
-    }
-
-    return socket;
-}
-
-void php_swoole_client_coro_minit(int module_number) {
-    swr_v1_phpclients_client_minit(SWOOLE_G(use_shortname), &swoole_client_coro_ce);
-}
-
-// What crates/phpclients' Client methods need from C++: one call per operation
-// (native/clients/swoole_rs_phpclients.h).
-static SocketImpl *client_socket_of(void *socket) {
-    return static_cast<SocketImpl *>(socket);
-}
-
-void swoole_rs_check_reactor(void) {
-    php_swoole_check_reactor();
-}
-
-void swoole_rs_set_last_error(int code) {
-    swoole_set_last_error(code);
-}
-
-void *swoole_client_coro_create_socket(zend_object *object, int64_t type) {
-    zval zobject;
-    ZVAL_OBJ(&zobject, object);
-    return client_coro_create_socket(&zobject, type);
-}
-
-void swoole_client_coro_merge_setting(zend_object *object, const zval *settings) {
-    zval zobject;
-    ZVAL_OBJ(&zobject, object);
-    zval *zsetting = sw_zend_read_and_convert_property_array(swoole_client_coro_ce, &zobject, ZEND_STRL("setting"), 0);
-    SEPARATE_ARRAY(zsetting);
-    php_array_merge(Z_ARRVAL_P(zsetting), Z_ARRVAL_P(settings));
-}
-
-zval *swoole_client_coro_setting(zend_object *object) {
-    zval zobject;
-    ZVAL_OBJ(&zobject, object);
-    return sw_zend_read_property_ex(swoole_client_coro_ce, &zobject, SW_ZSTR_KNOWN(SW_ZEND_STR_SETTING), 0);
-}
-
-int64_t swoole_client_coro_type_property(zend_object *object) {
-    zval zobject;
-    ZVAL_OBJ(&zobject, object);
-    return zval_get_long(sw_zend_read_property(swoole_client_coro_ce, &zobject, ZEND_STRL("type"), 1));
-}
-
-bool swoole_client_coro_connect(void *socket, const char *host, int64_t port, double timeout, int64_t flags) {
-    client_socket_of(socket)->set_timeout(timeout, SW_TIMEOUT_CONNECT);
-    return client_socket_of(socket)->connect(host, port, flags);
-}
-
-void swoole_client_coro_rdwr_timeout(void *socket, double timeout) {
-    client_socket_of(socket)->set_timeout(timeout, SW_TIMEOUT_RDWR);
-}
-
-bool swoole_client_coro_close(void *socket) {
-    return client_socket_of(socket)->close();
-}
-
-void *swoole_client_coro_socket_record(void *socket) {
-    return client_socket_of(socket)->get_socket();
-}
-
-int swoole_client_coro_type(void *socket) {
-    return client_socket_of(socket)->get_type();
-}
-
-bool swoole_client_coro_packet_mode(void *socket) {
-    return client_socket_of(socket)->open_length_check || client_socket_of(socket)->open_eof_check;
-}
-
-bool swoole_client_coro_is_connected(void *socket) {
-    return client_socket_of(socket)->is_connected();
-}
-
-bool swoole_client_coro_has_ssl(void *socket) {
-    return client_socket_of(socket)->get_ssl() != nullptr;
-}
-
-zend_string *swoole_client_coro_peer_cert(void *socket) {
-    if (!client_socket_of(socket)->get_socket()->ssl_get_peer_certificate(sw_tg_buffer())) {
-        return nullptr;
-    }
-    return zend_string_init(sw_tg_buffer()->str, sw_tg_buffer()->length, 0);
-}
-
-bool swoole_client_coro_verify_peer(void *socket, bool allow_self_signed) {
-    return client_socket_of(socket)->ssl_verify(allow_self_signed);
-}
