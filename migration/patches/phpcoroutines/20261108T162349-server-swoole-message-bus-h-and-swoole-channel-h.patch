-  |         Twosee  <twose@qq.com>                                       |
-  |         Tianfeng Han  <rango@swoole.com>                             |
-  +----------------------------------------------------------------------+
- */
-
-#pragma once
-#ifdef HAVE_CONFIG_H
-#include "config.h"
-#endif
-#include "swoole_rs_memory.h"
-
-#include "swoole_lock.h"
-
-namespace swoole {
-
-enum ChannelFlag {
-    SW_CHAN_LOCK = 1u << 1,
-    SW_CHAN_NOTIFY = 1u << 2,
-    SW_CHAN_SHM = 1u << 3,
-};
-
-static_assert(SW_CHAN_LOCK == 2 && SW_CHAN_NOTIFY == 4 && SW_CHAN_SHM == 8, "flags Rust reads");
-
-// A record's header; the payload follows it.
-struct ChannelSlice {
-    int length;
-};
-
-// The record, its mutex, its notification pipe and the queue operations are Rust's
-// (crates/memory/src/channel.rs); these methods keep upstream's assertions and logs.
-struct Channel : swr_v1_memory_channel {
-    bool empty() const {
-        return num == 0;
-    }
-    bool full() const {
-        const swr_v1_memory_channel_capacity state{head, tail, size, bytes, num, head_tag, tail_tag};
-        return swr_v1_memory_channel_full(&state) == 1;
-    }
-    /**
-     * pop data (lock)
-     */
-    int pop(void *out_buf, int buffer_length) {
-        assert(flags & SW_CHAN_LOCK);
-        swr_v1_memory_channel_lock(this, true);
-        int n = out(out_buf, buffer_length);
-        swr_v1_memory_channel_lock(this, false);
-        return n;
-    }
-    /**
-     * push data (lock)
-     */
-    int push(const void *in_data, int data_length) {
-        assert(flags & SW_CHAN_LOCK);
-        swr_v1_memory_channel_lock(this, true);
-        int ret = in(in_data, data_length);
-        swr_v1_memory_channel_lock(this, false);
-        return ret;
-    }
-    /**
-     * pop data(no lock)
-     */
-    int out(void *out_buf, int buffer_length) {
-        if (empty()) return SW_ERR;
-        const ChannelSlice header = slice();
-        const auto *item = &header;
-        assert(buffer_length >= item->length);
-        (void) item;
-        return swr_v1_memory_channel_out(this, out_buf, buffer_length, 1);
-    }
-    /**
-     * push data(no lock)
-     */
-    int in(const void *in_data, int data_length) {
-        assert(data_length <= maxlen);
-        return swr_v1_memory_channel_in(this, in_data, data_length);
-    }
-    /**
-     * peek data
-     */
-    int peek(void *out, int buffer_length) const {
-        if (empty()) return SW_ERR;
-        auto *self = const_cast<Channel *>(this);
-        swr_v1_memory_channel_lock(self, true);
-        const ChannelSlice header = slice();
-        const auto *item = &header;
-        assert(buffer_length >= item->length);
-        (void) item;
-        const int length = swr_v1_memory_channel_out(self, out, buffer_length, 0);
-        swr_v1_memory_channel_lock(self, false);
-        return length;
-    }
-    /**
-     * wait notify
-     */
-    int wait() const {
-        assert(flags & SW_CHAN_NOTIFY);
-        return swr_v1_memory_channel_signal(this, false);
-    }
-    /**
-     * new data coming, notify to customer
-     */
-    int notify() const {
-        assert(flags & SW_CHAN_NOTIFY);
-        return swr_v1_memory_channel_signal(this, true);
-    }
-    /**
-     * free channel
-     */
-    void destroy() {
-        const bool shared = flags & SW_CHAN_SHM;
-        swr_v1_memory_channel_close(this);
-        shared ? sw_shm_free(this) : sw_free(this);
-    }
-    void print() const {
-        swr_v1_memory_channel_print(this);
-    }
-    int count() const {
-        return num;
-    }
-    size_t get_bytes() const {
-        return bytes;
-    }
-    static Channel *make(size_t size, size_t maxlen, int flags) {
-        assert(size >= maxlen);
-        const size_t total = swr_v1_memory_channel_bytes(size, maxlen);
-        if (total == 0) return nullptr;
-        void *memory = (flags & SW_CHAN_SHM) ? sw_shm_malloc(total) : sw_malloc(total);
-        if (!memory) {
-            swoole_warning("alloc(%ld) failed", size);
-            return nullptr;
-        }
-        auto *object = static_cast<Channel *>(memory);
-        switch (swr_v1_memory_channel_init(object, size, maxlen, flags)) {
-        case 0:
-            return object;
-        case 1:
-            swoole_sys_warning("pipe() failed");
-            swoole_warning("notify_fd init failed");
-            break;
-        case 2:
-            swoole_warning("pthread_mutex_init() failed");
-            break;
-        }
-        (flags & SW_CHAN_SHM) ? sw_shm_free(memory) : sw_free(memory);
-        return nullptr;
-    }
-
-  private:
-    // The head record's header, which may be unaligned; the channel is not empty.
-    ChannelSlice slice() const {
-        ChannelSlice header;
-        memcpy(&header, static_cast<const char *>(mem) + head, sizeof(header));
-        return header;
-    }
-};
-}  // namespace swoole
diff --git a/include/swoole_message_bus.h b/include/swoole_message_bus.h
deleted file mode 100644
index 4f321cf..0000000
--- a/include/swoole_message_bus.h
+++ /dev/null
@@ -1,197 +0,0 @@
-/*
-  +----------------------------------------------------------------------+
-  | Swoole                                                               |
-  +----------------------------------------------------------------------+
-  | This source file is subject to version 2.0 of the Apache license,    |
-  | that is bundled with this package in the file LICENSE, and is        |
-  | available through the world-wide-web at the following url:           |
-  | http://www.apache.org/licenses/LICENSE-2.0.html                      |
-  | If you did not receive a copy of the Apache2.0 license and are unable|
-  | to obtain it through the world-wide-web, please send a note to       |
-  | license@swoole.com so we can mail you a copy immediately.            |
-  +----------------------------------------------------------------------+
-  | Author: Tianfeng Han  <rango@swoole.com>                             |
-  +----------------------------------------------------------------------+
-*/
-
-#pragma once
-
-#include "swoole_string.h"
-#include "swoole_socket.h"
-#include "swoole_protocol.h"
-#include "swoole_rs_protocols.h"
-
-namespace swoole {
-struct PipeBuffer {
-    DataHead info;
-    char data[0];
-};
-
-struct PacketPtr {
-    size_t length;
-    char *data;
-};
-
-struct DgramPacket {
-    SocketType socket_type;
-    network::Address socket_addr;
-    uint32_t length;
-    char data[0];
-};
-
-struct PacketTask {
-    size_t length;
-    char tmpfile[SW_TASK_TMP_PATH_SIZE];
-};
-
-class MessageBus {
-  private:
-    // First: crates/process reads it.
-    swr_bus *bus_;
-    const Allocator *allocator_;
-    std::function<uint64_t(void)> id_generator_;
-
-    // A native frame: the allocator may be Zend's, which can bail out.
-    ssize_t receive(network::Socket *sock, bool dgram) {
-        swr_bus_read state{};
-        for (;;) {
-            const ssize_t retval = swr_v1_bus_read(bus_, sock->get_fd(), dgram, &sock->kernel_nobufs, &state);
-            if (state.event != SWR_BUS_ALLOCATE) {
-                return retval;
-            }
-            auto allocator = state.data ? static_cast<const Allocator *>(state.allocator) : allocator_;
-            void *data = state.data ? allocator->realloc(state.data, state.size) : allocator->malloc(state.size);
-            if (data == nullptr) {
-                throw std::bad_alloc();
-            }
-            swr_v1_bus_adopt(bus_, data, state.size, allocator);
-        }
-    }
-
-  public:
-    MessageBus() : bus_(swr_v1_bus_create(SW_BUFFER_SIZE_STD)), allocator_(sw_std_allocator()) {}
-    MessageBus(const MessageBus &) = delete;
-    MessageBus &operator=(const MessageBus &) = delete;
-    ~MessageBus() {
-        swr_v1_bus_free(bus_);
-    }
-
-    bool empty() const {
-        return count() == 0;
-    }
-
-    size_t count() const {
-        return swr_v1_bus_count(bus_);
-    }
-
-    void clear() {
-        swr_v1_bus_clear(bus_);
-    }
-
-    void set_allocator(const Allocator *allocator) {
-        allocator_ = allocator;
-    }
-
-    void set_id_generator(const std::function<uint64_t(void)> &id_generator) {
-        id_generator_ = id_generator;
-        swr_v1_bus_set_id_source(
-            bus_, [](void *fn) { return (*static_cast<std::function<uint64_t(void)> *>(fn))(); }, &id_generator_);
-    }
-
-    void count_ids(sw_atomic_long_t *counter) {
-        swr_v1_bus_count_ids(bus_, const_cast<int64_t *>(counter));
-    }
-
-    void set_buffer_size(size_t buffer_size) {
-        swr_v1_bus_set_buffer_size(bus_, buffer_size);
-    }
-
-    void set_always_chunked_transfer() {
-        swr_v1_bus_set_always_chunked(bus_);
-    }
-
-    size_t get_buffer_size() const {
-        return swr_v1_bus_buffer_size(bus_);
-    }
-
-    size_t get_memory_size() const {
-        return swr_v1_bus_memory_size(bus_);
-    }
-
-    bool alloc_buffer() {
-        void *buffer = allocator_->malloc(get_buffer_size());
-        swr_v1_bus_set_buffer(bus_, buffer);
-        return buffer != nullptr;
-    }
-
-    /**
-     * If use the zend_string_allocator, must manually call this function to release the memory,
-     * otherwise coredump will occur when php shutdown, because zend_string has been released
-     */
-    void free_buffer() {
-        allocator_->free(get_buffer());
-        swr_v1_bus_set_buffer(bus_, nullptr);
-    }
-
-    void pass(const SendData *task) const {
-        swr_v1_bus_pass(bus_, &task->info, task->data);
-    }
-
-    /**
-     * Send data to socket. If the data sent is larger than Server::ipc_max_size, then it is sent in chunks.
-     * Otherwise, send it directly.
-     * When sending data in multi-thread environment, must use get_pipe_socket() to separate socket memory.
-     * @return: send success returns true, send failure returns false.
-     */
-    bool write(network::Socket *sock, SendData *packet) const {
-        return swr_v1_bus_write(bus_, sock, &packet->info, packet->data);
-    }
-    /**
-     * Receive data from socket, if only one chunk is received, packet will be saved in packet_pool.
-     * Then continue to listen to readable events, waiting for more chunks.
-     * @return: >0: receive a complete packet, 0: continue to wait for data, -1: an error occurred
-     */
-    ssize_t read(network::Socket *sock) {
-        return receive(sock, false);
-    }
-    /**
-     * Receive data from pipeline, and store data to buffer
-     * @return: >0: receive a complete packet, 0: continue to wait for data, -1: an error occurred
-     */
-    ssize_t read_with_buffer(network::Socket *sock) {
-        return receive(sock, true);
-    }
-    /**
-     * The last chunk of data has been received, return address and length, start processing this packet.
-     */
-    PacketPtr get_packet() const {
-        const auto packet = swr_v1_bus_packet(bus_);
-        return {packet.length, packet.data};
-    }
-    PipeBuffer *get_buffer() const {
-        return static_cast<PipeBuffer *>(swr_v1_bus_buffer(bus_));
-    }
-    /**
-     * Pop the data memory address to the outer layer, no longer managed by MessageBus
-     */
-    char *move_packet() {
-        return swr_v1_bus_move_packet(bus_);
-    }
-    /**
-     * The processing of this data packet has been completed, and the relevant memory has been released
-     */
-    void pop() {
-        swr_v1_bus_pop(bus_);
-    }
-    /**
-     * It is possible to operate the same pipe in multiple threads.
-     * Each thread must have a unique buffer and the socket memory must be separated.
-     */
-    network::Socket *get_pipe_socket(const network::Socket *sock) const {
-        return static_cast<network::Socket *>(swr_v1_bus_pipe_socket(bus_, sock->get_fd()));
-    }
-    void init_pipe_socket(const network::Socket *sock) {
-        swr_v1_bus_init_pipe_socket(bus_, sock->get_fd());
-    }
-};
-}  // namespace swoole
