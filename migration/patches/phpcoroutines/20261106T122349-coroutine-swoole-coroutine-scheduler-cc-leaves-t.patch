diff --git a/ext-src/swoole_coroutine.cc b/ext-src/swoole_coroutine.cc
index a7c675f..c25d7f2 100644
--- a/ext-src/swoole_coroutine.cc
+++ b/ext-src/swoole_coroutine.cc
@@ -40,2 +40,3 @@ using swoole::Coroutine;
 using swoole::PHPCoroutine;
+using swoole::Reactor;
 using swoole::Timer;
@@ -45,3 +46,2 @@ using swoole::coroutine::System;
 extern void php_swoole_load_library();
-void php_swoole_coroutine_set_exit_condition(zval *condition);
 
@@ -265,3 +265,21 @@ static const swr_v1_phpcoroutines_ops coroutine_ops = {
     [](long capacity) { System::set_dns_cache_capacity((size_t) capacity); },
-    [](zval *condition) { php_swoole_coroutine_set_exit_condition(condition); },
+    [](uint8_t set) {
+        // Co::set(['exit_condition' => ...]): Rust owns the callable.
+        if (set) {
+            SwooleG.user_exit_condition = [](Reactor *, size_t &) {
+                uint8_t exit = 0;
+                if (swr_v1_phpcoroutines_can_exit(&exit)) {
+                    zend_bailout();
+                }
+                return exit != 0;
+            };
+            if (sw_reactor()) {
+                sw_reactor()->set_exit_condition(Reactor::EXIT_CONDITION_USER_AFTER_DEFAULT, SwooleG.user_exit_condition);
+            }
+        } else if (sw_reactor()) {
+            sw_reactor()->remove_exit_condition(Reactor::EXIT_CONDITION_USER_AFTER_DEFAULT);
+            SwooleG.user_exit_condition = nullptr;
+        }
+    },
+    sw_callable_warning,
 };
