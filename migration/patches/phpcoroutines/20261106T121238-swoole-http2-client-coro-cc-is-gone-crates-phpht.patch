-#include "swoole_http2.h"
-#include "swoole_rs_phphttp2.h"
-
-using swoole::coroutine::Socket;
-
-namespace Http2 = swoole::http2;
-
-// The classes, their method table, objects, the client's state and every
-// method are Rust (crates/phphttp2).
-void php_swoole_http2_client_coro_minit(int module_number) {
-    swr_v1_phphttp2_client_minit(swoole_exception_ce, SWOOLE_G(use_shortname), module_number);
-}
-
-void php_swoole_http_parse_set_cookies(const char *at, size_t length, zval *zcookies, zval *zset_cookie_headers);
-
-// What crates/phphttp2's client needs from C++: the coroutine socket and
-// nghttp2's HPACK codec, one call per operation (native/http2/swoole_rs_phphttp2.h).
-static SocketImpl *http2_socket(void *socket) {
-    return static_cast<SocketImpl *>(socket);
-}
-
-zend_object *swoole_http2_client_coro_create_socket(
-    const char *host, size_t length, zend_string **converted, void **socket, int *error) {
-    std::string name(host, length);
-    auto object = php_swoole_create_socket(swoole::network::Socket::convert_to_type(name));
-    *converted = zend_string_init(name.c_str(), name.length(), 0);
-    if (!object) {
-        *error = errno;
-        return nullptr;
-    }
-    zval zsocket;
-    ZVAL_OBJ(&zsocket, object);
-    *socket = php_swoole_get_socket(&zsocket);
-    return object;
-}
-
-void swoole_http2_client_coro_setup(void *socket, void *conn) {
-    auto *sock = http2_socket(socket);
-    sock->set_dtor([conn](Socket *_socket) { swr_v1_phphttp2_client_socket_dtor(conn); });
-    sock->set_zero_copy(true);
-}
-
-bool swoole_http2_client_coro_enable_ssl(void *socket) {
-    return http2_socket(socket)->enable_ssl_encrypt();
-}
-
-void swoole_http2_client_coro_apply(void *socket, const zval *settings) {
-    if (ZVAL_IS_ARRAY(settings)) {
-        php_swoole_socket_set(http2_socket(socket), settings);
-    }
-}
-
-void swoole_http2_client_coro_protocol(void *socket, const zval *settings) {
-    auto *sock = http2_socket(socket);
-    sock->http2 = true;
-    sock->open_length_check = true;
-    sock->protocol.package_length_size = SW_HTTP2_FRAME_HEADER_SIZE;
-    sock->protocol.package_length_offset = 0;
-    sock->protocol.package_body_offset = 0;
-    sock->protocol.get_package_length = Http2::get_frame_length;
-    swoole_http2_client_coro_apply(socket, settings);
-}
-
-bool swoole_http2_client_coro_connect(void *socket, const char *host, size_t length, int port) {
-    return http2_socket(socket)->connect(std::string(host, length), port);
-}
-
-bool swoole_http2_client_coro_close(void *socket) {
-    return http2_socket(socket)->close();
-}
-
-bool swoole_http2_client_coro_is_connected(void *socket) {
-    return http2_socket(socket)->is_connected();
-}
-
-bool swoole_http2_client_coro_write_bound(void *socket) {
-    return http2_socket(socket)->has_bound(SW_EVENT_WRITE);
-}
-
-ssize_t swoole_http2_client_coro_send_all(void *socket, const char *data, size_t length) {
-    return http2_socket(socket)->send_all(data, length);
-}
-
-int swoole_http2_client_coro_error(void *socket, const char **message) {
-    *message = http2_socket(socket)->errMsg;
-    return http2_socket(socket)->errCode;
-}
-
-void swoole_http2_client_coro_set_error(void *socket, int code, const char *message) {
-    http2_socket(socket)->errCode = code;
-    http2_socket(socket)->errMsg = message;
-}
-
-ssize_t swoole_http2_client_coro_recv_packet(void *socket, double timeout) {
-    return http2_socket(socket)->recv_packet(timeout);
-}
-
-const char *swoole_http2_client_coro_read_buffer(void *socket) {
-    return http2_socket(socket)->get_read_buffer()->str;
-}
-
-void *swoole_http2_client_coro_inflater(int *error) {
-    nghttp2_hd_inflater *inflater = nullptr;
-    *error = nghttp2_hd_inflate_new2(&inflater, php_nghttp2_mem());
-    return inflater;
-}
-
-void *swoole_http2_client_coro_deflater(uint32_t table_size, int *error) {
-    nghttp2_hd_deflater *deflater = nullptr;
-    *error = nghttp2_hd_deflate_new2(&deflater, table_size, php_nghttp2_mem());
-    return deflater;
-}
-
-void swoole_http2_client_coro_hpack_free(void *inflater, void *deflater) {
-    if (inflater) {
-        nghttp2_hd_inflate_del(static_cast<nghttp2_hd_inflater *>(inflater));
-    }
-    if (deflater) {
-        nghttp2_hd_deflate_del(static_cast<nghttp2_hd_deflater *>(deflater));
-    }
-}
-
-int swoole_http2_client_coro_deflate_table(void *deflater, uint32_t size) {
-    return nghttp2_hd_deflate_change_table_size(static_cast<nghttp2_hd_deflater *>(deflater), size);
-}
-
-static_assert(sizeof(swoole_http2_client_coro_nv) == sizeof(nghttp2_nv), "nghttp2_nv layout");
-
-size_t swoole_http2_client_coro_deflate_bound(void *deflater, const swoole_http2_client_coro_nv *headers, size_t count) {
-    return nghttp2_hd_deflate_bound(
-        static_cast<nghttp2_hd_deflater *>(deflater), reinterpret_cast<const nghttp2_nv *>(headers), count);
-}
-
-ssize_t swoole_http2_client_coro_deflate(
-    void *deflater, uint8_t *out, size_t capacity, const swoole_http2_client_coro_nv *headers, size_t count) {
-    return nghttp2_hd_deflate_hd(static_cast<nghttp2_hd_deflater *>(deflater),
-                                 out,
-                                 capacity,
-                                 reinterpret_cast<const nghttp2_nv *>(headers),
-                                 count);
-}
-
-ssize_t swoole_http2_client_coro_inflate(
-    void *inflater, const uint8_t *in, size_t length, int *flags, swoole_http2_client_coro_nv *header) {
-    return nghttp2_hd_inflate_hd(static_cast<nghttp2_hd_inflater *>(inflater),
-                                 reinterpret_cast<nghttp2_nv *>(header),
-                                 flags,
-                                 (uint8_t *) in,
-                                 length,
-                                 1);
-}
-
-void swoole_http2_client_coro_inflate_end(void *inflater) {
-    nghttp2_hd_inflate_end_headers(static_cast<nghttp2_hd_inflater *>(inflater));
-}
-
-const char *swoole_http2_client_coro_strerror(int code) {
-    return nghttp2_strerror(code);
-}
-
-void swoole_http2_client_coro_set_cookies(const char *at, size_t length, zval *cookies, zval *set_cookie_headers) {
-    php_swoole_http_parse_set_cookies(at, length, cookies, set_cookie_headers);
-}
-
-void swoole_http2_client_coro_unconstructed(void) {
-    swoole_fatal_error(SW_ERROR_WRONG_OPERATION, "must call constructor first");
-}
-
-void swoole_http2_client_coro_last_error(int code) {
-    swoole_set_last_error(code);
-}
-
-const char *swoole_http2_client_coro_swoole_strerror(int code) {
-    return swoole_strerror(code);
-}
-
-void swoole_http2_client_coro_warning(const char *message) {
-    php_swoole_error(E_WARNING, "%s", message);
-}
-
-namespace swoole {
-namespace coroutine {
-namespace http2 {
-// Upstream's logs come from Client::parse_frame; this keeps the name.
-struct Client {
-    static void parse_frame(int what, uint32_t stream_id) {
-        if (what == 0) {
-            swoole_notice("http2 stream#%d belongs to an unknown type or it never registered", stream_id);
-        } else {
-            swoole_warning("decompress failed");
-        }
-    }
-};
-}  // namespace http2
-}  // namespace coroutine
-}  // namespace swoole
-
-void swoole_http2_client_coro_log(int what, uint32_t stream_id) {
-    swoole::coroutine::http2::Client::parse_frame(what, stream_id);
-}
