-// PHPCoroutine's state, each coroutine's PHP context and every method here
-// are Rust (crates/phpcoroutines), with the method tables. C++ lends the
-// coroutine core's operations and keeps the coroutine's entry, which traps
-// bailouts in zend_first_try so none crosses a Rust frame.
-
-using swoole::Coroutine;
-using swoole::PHPCoroutine;
-using swoole::Reactor;
-using swoole::Timer;
-using swoole::TimerNode;
-using swoole::coroutine::System;
-
-extern void php_swoole_load_library();
-
-/**
- * Exit Exception
- */
-static bool catch_exception() {
-    if (UNEXPECTED(EG(exception))) {
-        // the exception error messages MUST be output on the current coroutine stack
-        zend_exception_error(EG(exception), E_ERROR);
-        return true;
-    }
-    return false;
-}
-
-static void main_func(void *args) {
-    bool exception_caught = false;
-    void *ctx = swr_v1_phpcoroutines_open(args);
-
-    zend_first_try {
-        auto *call = static_cast<zend::Function *>(swr_v1_phpcoroutines_enter(ctx));
-        zend_call_function(&call->fci, &call->fci_cache);
-
-        // Catch exception in main function of the coroutine
-        exception_caught = catch_exception();
-
-        // The defer tasks still need to be executed after an exception occurs
-        zend::Function *defer_fci;
-        while ((defer_fci = static_cast<zend::Function *>(swr_v1_phpcoroutines_defer_next(ctx)))) {
-            if (UNEXPECTED(sw_zend_call_function_anyway(&defer_fci->fci, &defer_fci->fci_cache) != SUCCESS)) {
-                php_swoole_fatal_error(E_WARNING, "defer callback handler error");
-            }
-            if (EG(exception)) {
-                zend_bailout();
-            }
-            sw_zend_fci_cache_discard(&defer_fci->fci_cache);
-            efree(defer_fci);
-        }
-    }
-    zend_catch {
-        // zend_bailout is executed in the c function
-        catch_exception();
-        exception_caught = true;
-    }
-    zend_end_try();
-    swr_v1_phpcoroutines_close(ctx);
-    if (exception_caught) {
-        Coroutine::bailout([]() {
-            if (sw_reactor()) {
-                sw_reactor()->running = false;
-                sw_reactor()->bailout = true;
-            }
-            zend_bailout();
-        });
-    }
-}
-
-static void deactivate(void *) {
-    if (swr_v1_phpcoroutines_deactivate()) {
-        zend_bailout();
-    }
-}
-
-static Coroutine *co(void *co) {
-    return static_cast<Coroutine *>(co);
-}
-
-static const swr_v1_phpcoroutines_ops coroutine_ops = {
-    [](uint32_t mask) -> uint32_t {
-        auto set = [mask](uint32_t flag, auto &&test) -> uint32_t { return (mask & flag) && test() ? flag : 0; };
-        return set(SWR_PHPCOROUTINES_CLI, [] { return SWOOLE_G(cli); }) |
-               set(SWR_PHPCOROUTINES_SHORTNAME, [] { return SWOOLE_G(use_shortname); }) |
-               set(SWR_PHPCOROUTINES_LIBRARY, [] { return SWOOLE_G(enable_library); }) |
-               set(SWR_PHPCOROUTINES_FIBER_MOCK, [] { return SWOOLE_G(enable_fiber_mock); }) |
-               set(SWR_PHPCOROUTINES_PREEMPTIVE, [] { return SWOOLE_G(enable_preemptive_scheduler); }) |
-               set(SWR_PHPCOROUTINES_SHUTDOWN_FUNCTIONS,
-                   [] { return SWOOLE_G(req_status) == PHP_SWOOLE_CALL_USER_SHUTDOWNFUNC_BEGIN; }) |
-               set(SWR_PHPCOROUTINES_SERVER_STARTED, [] { return sw_server() && sw_server()->is_started(); }) |
-               set(SWR_PHPCOROUTINES_MAIN_THREAD, [] { return sw_is_main_thread(); }) |
-               set(SWR_PHPCOROUTINES_FATAL,
-                   [] { return php_swoole_is_fatal_error() || (sw_reactor() && sw_reactor()->bailout); }) |
-#ifdef SW_CORO_TIME
-               (mask & SWR_PHPCOROUTINES_CORO_TIME) |
-#endif
-#ifdef SW_THREAD
-               (mask & SWR_PHPCOROUTINES_THREAD) |
-#endif
-               0;
-    },
-    []() -> void * { return Coroutine::get_current(); },
-    []() -> void * { return Coroutine::get_current_safe(); },
-    []() -> void * { return Coroutine::get_current_task(); },
-    []() -> long { return Coroutine::get_current_cid(); },
-    [](long cid) -> void * { return Coroutine::get_task_by_cid(cid); },
-    [](long cid) -> void * { return Coroutine::get_by_cid(cid); },
-    [](void *args) -> long { return Coroutine::create(main_func, args); },
-    []() -> size_t { return Coroutine::count(); },
-    [](long cid) -> long { return Coroutine::get_elapsed(cid); },
-    [](long cid) -> long { return Coroutine::get_execute_time(cid); },
-    [](long *cids, size_t capacity) -> size_t {
-        size_t n = 0;
-        for (auto &co : Coroutine::coroutines) {
-            if (n == capacity) {
-                break;
-            }
-            cids[n++] = co.second->get_cid();
-        }
-        return n;
-    },
-    [](swr_v1_phpcoroutines_stats *stats) {
-        stats->event_num = sw_reactor() ? sw_reactor()->get_event_num() : 0;
-        stats->signal_listener_num = swoole_signal_get_listener_num();
-        if (sw_async_threads()) {
-            stats->aio_task_num = sw_async_threads()->get_task_num();
-            stats->aio_worker_num = sw_async_threads()->get_worker_num();
-            stats->aio_queue_size = sw_async_threads()->get_queue_size();
-        }
-        stats->c_stack_size = Coroutine::get_stack_size();
-        stats->coroutine_num = Coroutine::count();
-        stats->coroutine_peak_num = Coroutine::get_peak_num();
-        stats->coroutine_last_cid = Coroutine::get_last_cid();
-#ifdef SW_USE_IOURING
-        auto iouring = SwooleTG.iouring;
-        if (iouring) {
-            stats->iouring = 1;
-            stats->iouring_task_num = iouring->get_task_num();
-            stats->iouring_sq_usage_percent = iouring->get_sq_usage_percent();
-            stats->iouring_waiting_task_num = iouring->get_waiting_task_num();
-        }
-#endif
-    },
-    [](long count, double sleep_time) {
-        Coroutine::create([=](void *ptr) {
-            SW_LOOP_N(count) {
-                System::sleep(sleep_time);
-            }
-        });
-    },
-    [](void *c, void *task) { co(c)->set_task(task); },
-    [](void *c) -> void * {
-        Coroutine *origin = co(c)->get_origin();
-        return origin ? origin->get_task() : nullptr;
-    },
-    [](void *c) -> long { return co(c)->get_cid(); },
-    [](void *c) -> long { return co(c)->get_origin_cid(); },
-    [](void *c) -> int { return co(c)->get_state(); },
-    [](void *c, size_t *size) -> void * {
-#ifdef SW_USE_THREAD_CONTEXT
-        *size = 0;
-        return nullptr;
-#else
-        *size = co(c)->get_ctx().get_stack_size();
-        return co(c)->get_ctx().get_stack();
-#endif
-    },
-    [](void *c) { co(c)->yield(); },
-    [](void *c, uint8_t (*cancel)(void *)) {
-        Coroutine::CancelFunc cancel_fn = [cancel](Coroutine *co) { return cancel(co) != 0; };
-        co(c)->yield(&cancel_fn);
-    },
-    [](void *c, double timeout) -> uint8_t { return co(c)->yield_ex(timeout); },
-    [](void *c) { co(c)->resume(); },
-    [](void *c) -> uint8_t { return co(c)->cancel(); },
-    [](void *c) -> uint8_t { return co(c)->is_canceled(); },
-    [](void *c) -> uint8_t { return co(c)->is_end(); },
-    []() { php_swoole_check_reactor(); },
-    [](void (*on_yield)(void *), void (*on_resume)(void *), void (*on_close)(void *)) {
-        /* deactivate when reactor free */
-        sw_reactor()->add_destroy_callback(deactivate, nullptr);
-        Coroutine::activate();
-        Coroutine::set_on_yield(on_yield);
-        Coroutine::set_on_resume(on_resume);
-        Coroutine::set_on_close(on_close);
-    },
-    []() {
-        Coroutine::set_on_yield(nullptr);
-        Coroutine::set_on_resume(nullptr);
-        Coroutine::set_on_close(nullptr);
-    },
-    []() { Coroutine::deactivate(); },
-    [](uint32_t hook_flags) {
-        if (hook_flags) {
-            PHPCoroutine::enable_hook(hook_flags);
-        }
-        PHPCoroutine::disable_unsafe_function();
-    },
-    []() {
-        PHPCoroutine::disable_hook();
-        PHPCoroutine::enable_unsafe_function();
-    },
-    []() { swoole_signal_block_all(); },
-    [](void *) { php_swoole_load_library(); },
-    [](void *) { zend::function::call(R"(\Swoole\Coroutine\deadlock_check)", 0, nullptr); },
-    [](uint8_t stop, void *task) {
-        auto hook = stop ? SW_GLOBAL_HOOK_ON_CORO_STOP : SW_GLOBAL_HOOK_ON_CORO_START;
-        if (swoole_isset_hook(hook)) {
-            swoole_call_hook(hook, task);
-        }
-    },
-    []() -> long { return Timer::get_absolute_msec(); },
-    [](void (*fn)(void *), void *data) { swoole_event_defer(fn, data); },
-    [](double timeout, long cid, void (*fn)(long)) -> void * {
-        return swoole_timer_add(timeout, false, [cid, fn](Timer *, TimerNode *) { fn(cid); });
-    },
-    [](void *timer) { swoole_timer_del(static_cast<TimerNode *>(timer)); },
-    [](int code) { swoole_set_last_error(code); },
-    [](int level, const char *message) { php_swoole_fatal_error(level, "%s", message); },
-    [](int level, int code, const char *message) { php_swoole_error_ex(level, code, "%s", message); },
-    [](zend_execute_data *execute_data, zval *return_value) -> uint8_t {
-        return php_swoole_call_original_handler(ZEND_STRL("exit"), INTERNAL_FUNCTION_PARAM_PASSTHRU);
-    },
-    [](const char *message, size_t length, long status) {
-        if (message) {
-            php_write((void *) message, length);
-        }
-        sw_php_exit(status);
-    },
-    []() -> int { return php_swoole_reactor_init(); },
-    []() { php_swoole_event_wait(); },
-    [](zend_array *options) { php_swoole_set_global_option(options); },
-    [](zval *size) { Coroutine::set_stack_size(php_swoole_parse_to_size(size)); },
-    [](zval *resolver) { php_swoole_name_resolver_add(resolver); },
-    [](long expire) { System::set_dns_cache_expire((time_t) expire); },
-    [](long capacity) { System::set_dns_cache_capacity((size_t) capacity); },
-    [](uint8_t set) {
-        // Co::set(['exit_condition' => ...]): Rust owns the callable.
-        if (set) {
-            SwooleG.user_exit_condition = [](Reactor *, size_t &) {
-                uint8_t exit = 0;
-                if (swr_v1_phpcoroutines_can_exit(&exit)) {
-                    zend_bailout();
-                }
-                return exit != 0;
-            };
-            if (sw_reactor()) {
-                sw_reactor()->set_exit_condition(Reactor::EXIT_CONDITION_USER_AFTER_DEFAULT, SwooleG.user_exit_condition);
-            }
-        } else if (sw_reactor()) {
-            sw_reactor()->remove_exit_condition(Reactor::EXIT_CONDITION_USER_AFTER_DEFAULT);
-            SwooleG.user_exit_condition = nullptr;
-        }
-    },
-    sw_callable_warning,
-};
