-// What crates/phpthread reaches of C++: serialization, sockets and the thread
-// body.
-static swr_v1_phpthread_host thread_host = {
-    nullptr,
-    [](zval *value, bool *bailed) -> zend_string * {
-        zend_string *result = nullptr;
-        *bailed = false;
-        SWR_ZEND_TRY {
-            result = php_swoole_serialize(value);
-        }
-        SWR_ZEND_CATCH {
-            *bailed = true;
-        }
-        SWR_ZEND_END_TRY();
-        return result;
-    },
-    [](const char *data, size_t length, zval *out) -> bool {
-        bool bailed = false;
-        zend_string *serialized = zend_string_init(data, length, false);
-        SWR_ZEND_TRY {
-            php_swoole_unserialize(serialized, out);
-        }
-        SWR_ZEND_CATCH {
-            bailed = true;
-        }
-        SWR_ZEND_END_TRY();
-        zend_string_release(serialized);
-        return bailed;
-    },
-    [](zval *zvalue) -> uint32_t {
-        if (sw_zval_is_co_socket(zvalue)) {
-            return IS_CO_SOCKET;
-        }
-#ifdef SWOOLE_SOCKETS_SUPPORT
-        if (sw_zval_is_php_socket(zvalue)) {
-            return IS_PHP_SOCKET;
-        }
-#endif
-        return 0;
-    },
-    [](zval *zvalue, int *type) -> int {
-        swSocketType socket_type{};
-        int fd = php_swoole_thread_co_socket_cast(zvalue, &socket_type);
-        *type = socket_type;
-        return fd;
-    },
-#ifdef SWOOLE_SOCKETS_SUPPORT
-    thread_host_php_socket_cast,
-#else
-    nullptr,
-#endif
-    [](zval *return_value, int fd, int type) -> bool {
-        zend_object *object = php_swoole_create_socket_from_fd(fd, (swSocketType) type);
-        if (object) {
-            ZVAL_OBJ(return_value, object);
-        }
-        return object != nullptr;
-    },
-#ifdef SWOOLE_SOCKETS_SUPPORT
-    [](zval *return_value, int fd) -> bool {
-        object_init_ex(return_value, socket_ce);
-        return socket_import_file_descriptor(fd, Z_SOCKET_P(return_value));
-    },
-#else
-    nullptr,
-#endif
-    [](int error) { swoole_set_last_error(error); },
-    [](bool list) {
-        if (list) {
-            swoole_fatal_error(SW_ERROR_WRONG_OPERATION, "must call constructor first");
-        } else {
-            php_swoole_fatal_error(E_ERROR, "must call constructor first");
-        }
-    },
-    [](const char *file, size_t length, void *argv, void *context, void (*entered)(void *), void (*left)(void *, int)) {
-        thread_run(file, length, static_cast<ZendArray *>(argv), entered, left, context);
-    },
-    [](zval *return_value) {
-        if (Z_TYPE(thread_argv) == IS_ARRAY) {
-            RETURN_ZVAL(&thread_argv, 1, 0);
-        }
-    },
-    [](zval *return_value) {
-        array_init(return_value);
-        add_assoc_bool(return_value, "is_main_thread", tsrm_is_main_thread());
-        add_assoc_bool(return_value, "is_shutdown", tsrm_is_shutdown());
-        add_assoc_long(return_value, "thread_num", thread_num.load());
-    },
-    []() -> size_t { return thread_num.load(); },
-    [](const char *name) -> bool { return swoole_thread_set_name(name); },
-    []() -> int64_t { return swoole_thread_get_native_id(); },
-    [](int level, const char *message) { php_swoole_error(level, "%s", message); },
-    [](int level, const char *message) { php_swoole_sys_error(level, "%s", message); },
-    [](const char *message) {
-        if (SW_LOG_WARNING >= swoole_get_log_level()) {
-            sw_logger()->put(SW_LOG_WARNING, message, strlen(message));
-        }
-    },
-};
