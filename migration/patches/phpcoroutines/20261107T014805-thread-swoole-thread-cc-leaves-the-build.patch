-void php_swoole_thread_rshutdown() {
-    zval_dtor(&thread_argv);
-    if (!tsrm_is_main_thread()) {
-        return;
-    }
-    if (sw_active_thread_count() > 1) {
-        swoole_warning("Fatal Error: %zu active threads are running, cannot exit safely.", sw_active_thread_count());
-        exit(200);
-    }
-    swr_v1_phpthread_rshutdown();
-}
-
-// The body of a PHP thread: Swoole\Thread's (Rust starts the OS thread) and a
-// thread-mode Server's workers. `enter` and `exit` report its life to the owner.
-// Nothing allocates before `entered`: a new thread's first malloc can map an arena.
-static void thread_run(const char *path,
-                       size_t length,
-                       ZendArray *argv,
-                       void (*entered)(void *),
-                       void (*left)(void *, int),
-                       void *context) {
-    thread_num.fetch_add(1);
-    entered(context);
-    zend_string *file = zend_string_init(path, length, true);
-    ts_resource(0);
-#if defined(COMPILE_DL_SWOOLE) && defined(ZTS)
-    ZEND_TSRMLS_CACHE_UPDATE();
-#endif
-    zend_file_handle file_handle{};
-    zval global_argc, global_argv;
-    const char *path_translated;
-    int argc;
-    zend_string *argv_serialized = swr_v1_phpthread_request(&path_translated, &argc);
-
-    PG(expose_php) = false;
-    PG(auto_globals_jit) = true;
-    PG(enable_dl) = false;
-
-    swoole_thread_init(false);
-
-    if (php_request_startup() != SUCCESS) {
-        EG(exit_status) = 1;
-        goto _startup_error;
-    }
-
-    PG(during_request_startup) = false;
-    SG(sapi_started) = false;
-    SG(headers_sent) = 1;
-    SG(request_info).no_headers = true;
-    SG(request_info).path_translated = (char *) path_translated;
-    SG(request_info).argc = argc;
-
-#if PHP_VERSION_ID >= 80500
-    refresh_memory_manager();
-#endif
-
-    zend_stream_init_filename(&file_handle, ZSTR_VAL(file));
-    file_handle.primary_script = true;
-
-    zend_first_try {
-        thread_bailout = EG(bailout);
-        if (argv_serialized) {
-            php_swoole_unserialize(argv_serialized, &global_argv);
-            ZVAL_LONG(&global_argc, argc);
-            zend_hash_update(&EG(symbol_table), ZSTR_KNOWN(ZEND_STR_ARGV), &global_argv);
-            zend_hash_update(&EG(symbol_table), ZSTR_KNOWN(ZEND_STR_ARGC), &global_argc);
-        }
-        if (argv) {
-            argv->to_array(&thread_argv);
-            argv->del_ref();
-        }
-        swr_v1_phpthread_stdio_open();
-        php_execute_script(&file_handle);
-    }
-    zend_end_try();
-    thread_bailout = nullptr;
-    if (swr_zend_guard_pending() && sw_reactor()) {
-        sw_reactor()->running = false;
-        sw_reactor()->bailout = true;
-    }
-    swr_zend_guard_clear();
-
-    zend_destroy_file_handle(&file_handle);
-
-    php_request_shutdown(nullptr);
-    file_handle.filename = nullptr;
-    swr_v1_phpthread_stdio_close();
-
-_startup_error:
-    zend_string_release(file);
-    left(context, EG(exit_status));
-    ts_free_thread();
-    swoole_thread_clean(false);
-    thread_num.fetch_sub(1);
-}
-
-void php_swoole_thread_start(std::shared_ptr<Thread> thread, zend_string *file, ZendArray *argv) {
-    thread_run(
-        ZSTR_VAL(file),
-        ZSTR_LEN(file),
-        argv,
-        [](void *context) { static_cast<Thread *>(context)->enter(); },
-        [](void *context, int status) { static_cast<Thread *>(context)->exit(status); },
-        thread.get());
-}
-
-size_t sw_active_thread_count() {
-    return thread_num.load();
-}
-
-void php_swoole_thread_bailout() {
-    swr_zend_guard_mark();
-    if (void *target = swr_zend_guard_target()) {
-        EG(bailout) = static_cast<JMP_BUF *>(target);
-        zend_bailout();
-    }
-    if (auto *co = swoole::Coroutine::get_current()) {
-        // Return to the immediate native resumer; Rust owners relay the pending
-        // exit after cleanup. This request never resumes an exited PHP frame.
-        for (;;) {
-            co->yield();
-        }
-    }
-    if (thread_bailout) {
-        EG(bailout) = thread_bailout;
-    }
-    zend_bailout();
-}
-
-int php_swoole_thread_co_socket_cast(zval *zvalue, swSocketType *type) {
-    SocketImpl *socket = php_swoole_get_socket(zvalue);
-    if (!socket) {
-        return -1;
-    }
-    int sockfd = socket->get_fd();
-    if (sockfd < 0) {
-        return -1;
-    }
-    int newfd = dup(sockfd);
-    if (newfd < 0) {
-        return -1;
-    }
-    *type = socket->get_type();
-    return newfd;
-}
-
-#ifdef SWOOLE_SOCKETS_SUPPORT
-static int thread_host_php_socket_cast(zval *zvalue) {
-    php_socket *php_sock = SW_Z_SOCKET_P(zvalue);
-    if (php_sock->bsd_socket == -1) {
-        zend_throw_exception(swoole_exception_ce, "invalid socket fd", EBADF);
-        return -2;
-    }
-    int fd = dup(php_sock->bsd_socket);
-    if (fd == -1) {
-        zend_throw_exception(swoole_exception_ce, "failed to dup socket fd", errno);
-    }
-    return fd;
-}
-#endif
