-// A finished request is Rust's (crates/phphttp/src/server.rs): what it asks of
-// the server and the connection.
-static_assert(sizeof(swr_h2s_connection_facts) == 40, "crates/phphttp/src/server.rs mirrors swr_h2s_connection_facts");
-
-void *swr_h2s_connection(void *server, int64_t fd, swr_h2s_connection_facts *out) {
-    auto *serv = static_cast<Server *>(server);
-    Connection *conn = serv->get_connection_by_session_id(fd);
-    if (!conn) {
-        return nullptr;
-    }
-    out->last_recv_time = conn->last_recv_time;
-    out->local_port = conn->local_port;
-    out->remote_port = conn->info.get_port();
-    out->loopback = conn->info.is_loopback_addr() ? (conn->info.type == SW_SOCK_TCP6 ? 6 : 4) : 0;
-    out->server_fd = conn->server_fd;
-    out->cache = swoole_http_server_can_cache_session_addr(serv);
-    out->static_handler = serv->enable_static_handler;
-    out->unavailable = serv->is_unavailable();
-    out->coroutine = serv->is_enable_coroutine();
-    return conn;
-}
-
-// The static handler's and Response::sendfile's file responses are Rust's
-// (crates/phphttp2/src/files.rs): what they ask of the StaticHandler and the file.
-void *swr_h2s_static_new(void *server, const char *url, size_t length) {
-    return new StaticHandler(static_cast<Server *>(server), url, length);
-}
-
-void swr_h2s_static_free(void *handler) {
-    delete static_cast<StaticHandler *>(handler);
-}
-
-static StaticHandler *handler_of(void *handler) {
-    return static_cast<StaticHandler *>(handler);
-}
-
-int64_t swr_h2s_static(void *handler, int op) {
-    auto *h = handler_of(handler);
-    switch (op) {
-    case SWR_H2S_STATIC_SERVE: return h->try_serve();
-    case SWR_H2S_STATIC_STATUS: return h->get_status();
-    case SWR_H2S_STATIC_INDEX: return h->try_serve_index_file();
-    case SWR_H2S_STATIC_AUTOINDEX: return !h->has_index_file() && h->is_enabled_auto_index() && h->is_dir();
-    case SWR_H2S_STATIC_FILESIZE: return h->get_filesize();
-    case SWR_H2S_STATIC_CONTENT_LENGTH: return h->get_content_length();
-    default: return h->get_tasks().size();
-    }
-}
-
-zend_string *swr_h2s_static_text(void *handler, int which, size_t task) {
-    auto *h = handler_of(handler);
-    std::string text;
-    switch (which) {
-    case SWR_H2S_TEXT_INDEX_PAGE: {
-        String body(PATH_MAX);
-        body.length = h->make_index_page(&body);
-        return zend_string_init(body.str, body.length, false);
-    }
-    case SWR_H2S_TEXT_LAST_MODIFIED: text = h->get_date_last_modified(); break;
-    case SWR_H2S_TEXT_CONTENT_TYPE: text = h->get_content_type(); break;
-    case SWR_H2S_TEXT_FILENAME: text = h->get_filename(); break;
-    case SWR_H2S_TEXT_END_PART: text = h->get_end_part(); break;
-    case SWR_H2S_TEXT_PART_HEADER: text = h->get_tasks()[task].part_header; break;
-    default: text = SW_HTTP_PAGE_404; break;
-    }
-    return zend_string_init(text.data(), text.length(), false);
-}
-
-bool swr_h2s_static_modified(void *handler, const char *date, size_t length) {
-    return handler_of(handler)->is_modified(std::string(date, length));
-}
-
-void swr_h2s_static_range(void *handler, const char *range, const char *if_range) {
-    handler_of(handler)->parse_range(range, if_range);
-}
-
-void swr_h2s_static_task(void *handler, size_t task, int64_t *offset, size_t *length) {
-    auto tasks = handler_of(handler)->get_tasks();
-    *offset = tasks[task].offset;
-    *length = tasks[task].length;
-}
-
-void *swr_h2s_file_open(const char *path) {
-    auto *fp = new File(path, O_RDONLY);
-    if (!fp->ready()) {
-        delete fp;
-        return nullptr;
-    }
-    return fp;
-}
-
-ssize_t swr_h2s_file_read(void *file, int64_t offset, char *buf, size_t length, bool async) {
-    auto *fp = static_cast<File *>(file);
-    ssize_t n_reads = -1;
-    auto callback = [&]() -> bool {
-        fp->set_offset(offset);
-        n_reads = fp->read(buf, length);
-        return n_reads >= 0;
-    };
-    if (async ? !swoole::coroutine::async(callback) : !callback()) {
-        return -1;
-    }
-    return n_reads;
-}
-
-void swr_h2s_file_close(void *file) {
-    delete static_cast<File *>(file);
-}
-
-const char *swr_h2s_file_content(const char *path, size_t *length, void **owner) {
-    std::shared_ptr<String> body;
-    if (swoole_coroutine_is_in()) {
-        body = System::read_file(path, false);
-    } else {
-        File fp(path, O_RDONLY);
-        if (fp.ready()) {
-            body = fp.read_content();
-        }
-    }
-    if (!body) {
-        return nullptr;
-    }
-    *length = body->length;
-    *owner = new std::shared_ptr<String>(body);
-    return body->str;
-}
-
-void swr_h2s_file_content_free(void *owner) {
-    delete static_cast<std::shared_ptr<String> *>(owner);
-}
-
-// What crates/phphttp2 asks of the contexts, which stay C++
-// (native/http2/swoole_rs_phphttp2.h).
-void *swr_h2s_stream_context(void *default_ctx, int64_t fd, uint32_t stream_id) {
-    auto *ctx = swoole_http_context_new(fd);
-    swr_v1_phphttp_context_copy(ctx, static_cast<HttpContext *>(default_ctx));
-    ctx->http2 = true;
-    ctx->stream_id = stream_id;
-    ctx->keepalive = true;
-    zend::object_set(ctx->request.zobject, ZEND_STRL("streamId"), stream_id);
-    return ctx;
-}
-
-void swr_h2s_wait(void **coroutine) {
-    auto *co = Coroutine::get_current();
-    *coroutine = co;
-    co->yield();
-    *coroutine = nullptr;
-}
-
-void swr_h2s_wake(void *coroutine) {
-    static_cast<Coroutine *>(coroutine)->resume();
-}
-
-void swr_h2s_query(zval *array, const char *query, size_t length) {
-    sapi_module.treat_data(PARSE_STRING, estrndup(query, length), array);  // treat_data frees it
-}
-
-void swr_h2s_path(void *context, const char *path, size_t length) {
-    auto *ctx = static_cast<HttpContext *>(context);
-    ctx->request.path = estrndup(path, length);
-    ctx->request.path_len = length;
-}
-
-bool swr_h2s_multipart(void *context, const char *value, size_t length) {
-    auto *ctx = static_cast<HttpContext *>(context);
-    char *boundary_str;
-    int boundary_len;
-    if (!ctx->get_multipart_boundary(
-            value, length, sizeof("multipart/form-data") - 1, &boundary_str, &boundary_len)) {
-        return false;
-    }
-    ctx->init_multipart_parser(boundary_str, boundary_len);
-    ctx->parser.data = ctx;
-    return true;
-}
-
-bool swr_h2s_in_coroutine(void) {
-    return swoole_coroutine_is_in();
-}
-
-void swr_h2s_error(int code, int always, const char *message) {
-    swoole_set_last_error(code);
-    if (always || SWOOLE_G(display_errors)) {
-        php_error_docref(nullptr, E_WARNING, "%s", message);
-    }
-}
-
-int swoole_http2_server_onReceive(Server *serv, Connection *conn, RecvData *req) {
-    SessionId session_id = req->info.fd;
-    if (!swr_v1_phphttp2_session_exists(session_id)) {
-        auto *default_ctx = static_cast<HttpContext *>(swr_v1_phphttp_context_new());
-        swr_v1_phphttp_context_init(default_ctx, serv);
-        default_ctx->fd = session_id;
-        default_ctx->http2 = true;
-        default_ctx->keepalive = true;
-        default_ctx->before_request = 1;
-        swr_v1_phphttp2_session_new(
-            session_id, default_ctx, serv->get_package_max_length(conn), false, swr_v1_phphttp_server_http2_request, nullptr);
-    }
-
-    zval zdata;
-    php_swoole_get_recv_data(serv, &zdata, req);
-    int retval = swr_v1_phphttp2_session_parse(session_id, Z_STRVAL(zdata));
-    zval_ptr_dtor(&zdata);
-
-    return retval;
-}
-
-void php_swoole_http2_server_onClose(Server *serv, SessionId session_id) {
-    swr_v1_phphttp2_session_free(session_id);
-}
