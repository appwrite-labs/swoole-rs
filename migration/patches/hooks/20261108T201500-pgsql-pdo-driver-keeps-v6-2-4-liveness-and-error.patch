diff --git a/thirdparty/php82/pdo_pgsql/pgsql_driver.c b/thirdparty/php82/pdo_pgsql/pgsql_driver.c
index 10e9d61..0c87dce 100644
--- a/thirdparty/php82/pdo_pgsql/pgsql_driver.c
+++ b/thirdparty/php82/pdo_pgsql/pgsql_driver.c
@@ -77,5 +77,2 @@ int _pdo_pgsql_error(pdo_dbh_t *dbh, pdo_stmt_t *stmt, int errcode, const char *
 	pdo_pgsql_error_info *einfo = &H->einfo;
-	if (php_swoole_pgsql_handle_io_error(dbh, &msg)) {
-	    sqlstate = PHP_PDO_PGSQL_CONNECTION_FAILURE_SQLSTATE;
-	}
 	char *errmsg = PQerrorMessage(H->server);
@@ -540,3 +537,7 @@ static zend_result pdo_pgsql_check_liveness(pdo_dbh_t *dbh)
 {
-    return php_swoole_pgsql_check_liveness(dbh);
+	pdo_pgsql_db_handle *H = (pdo_pgsql_db_handle *)dbh->driver_data;
+	if (!PQconsumeInput(H->server) || PQstatus(H->server) == CONNECTION_BAD) {
+		PQreset(H->server);
+	}
+	return (PQstatus(H->server) == CONNECTION_OK) ? SUCCESS : FAILURE;
 }
