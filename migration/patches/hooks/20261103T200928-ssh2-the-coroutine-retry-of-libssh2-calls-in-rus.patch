diff --git a/ext-src/php_swoole_ssh2.h b/ext-src/php_swoole_ssh2.h
index efe2a0f..7bfbb61 100644
--- a/ext-src/php_swoole_ssh2.h
+++ b/ext-src/php_swoole_ssh2.h
@@ -8,2 +8,3 @@
 #include <libssh2_publickey.h>
+#include "swoole_rs_ssh2.h"
 
@@ -51,43 +52,15 @@ class ResourceGuard {
 
-static inline int ssh2_async_call(LIBSSH2_SESSION *session, const std::function<int(void)> &fn) {
-    auto event = ssh2_get_event_type(session);
-    auto socket = ssh2_get_socket(session);
-
-    socket->check_bound_co(SW_EVENT_READ);
-    socket->check_bound_co(SW_EVENT_WRITE);
-
-    int rc = 0;
-    while (1) {
-        rc = fn();
-        if (rc == LIBSSH2_ERROR_EAGAIN) {
-            if (!socket->poll(event)) {
-                return LIBSSH2_ERROR_SOCKET_NONE;
-            }
-            continue;
-        }
-        break;
-    }
-    return rc;
+// The coroutine wait the Rust hook (crates/ssh2) retries libssh2 calls over.
+static inline bool ssh2_wait(LIBSSH2_SESSION *session, int event) {
+    return ssh2_get_socket(session)->poll(static_cast<swoole::EventType>(event));
 }
 
-template <typename T>
-static inline T *ssh2_async_call_ex(LIBSSH2_SESSION *session, const std::function<T *(void)> &fn) {
-    auto event = ssh2_get_event_type(session);
-    auto socket = ssh2_get_socket(session);
+static const swr_v1_ssh2_ops ssh2_ops = {ssh2_wait};
 
+// A hooked call starts once no other coroutine is bound to the socket.
+static inline const swr_v1_ssh2_ops *ssh2_bound(LIBSSH2_SESSION *session) {
+    auto socket = ssh2_get_socket(session);
     socket->check_bound_co(SW_EVENT_READ);
     socket->check_bound_co(SW_EVENT_WRITE);
-
-    T *handle;
-    while (1) {
-        handle = fn();
-        if (handle) {
-            return handle;
-        }
-        if (libssh2_session_last_errno(session) == LIBSSH2_ERROR_EAGAIN && socket->poll(event)) {
-            continue;
-        }
-        break;
-    }
-    return nullptr;
+    return &ssh2_ops;
 }
diff --git a/ext-src/php_swoole_ssh2_hook.h b/ext-src/php_swoole_ssh2_hook.h
index ebf9b0b..f8ad333 100644
--- a/ext-src/php_swoole_ssh2_hook.h
+++ b/ext-src/php_swoole_ssh2_hook.h
@@ -1,6 +1,4 @@
-#define SSH2_ASYNC_CALL(session, libssh2_func, ...)                                                                    \
-    ssh2_async_call(session, [&](void) { return libssh2_func(__VA_ARGS__); })
-
-#define SSH2_ASYNC_CALL_EX(T, session, libssh2_func, ...)                                                              \
-    ssh2_async_call_ex<T>(session, [&](void) -> T * { return libssh2_func(__VA_ARGS__); })
+// Each call goes to its Rust hook (crates/ssh2), which retries it while libssh2 says EAGAIN.
+#define SSH2_ASYNC_CALL(session, libssh2_func, ...) swoole_##libssh2_func(ssh2_bound(session), session, __VA_ARGS__)
+#define SSH2_ASYNC_CALL_EX(T, session, libssh2_func, ...) SSH2_ASYNC_CALL(session, libssh2_func, __VA_ARGS__)
 
