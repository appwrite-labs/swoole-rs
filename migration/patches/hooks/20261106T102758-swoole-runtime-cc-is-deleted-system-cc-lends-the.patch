 #include "swoole_util.h"
@@ -1155,2 +1156,93 @@ static const swr_v1_hook_host hook_host = {
 };
+
+// What the Rust coroutine streams (crates/phpruntime/src/socket.rs) need of SocketImpl.
+using RuntimeCall = swr_v1_runtime_socket_call;
+// Declared extern "C" in swoole_rs_phpruntime.h, so the definition has C linkage.
+const swr_v1_runtime_socket_ops swr_v1_runtime_socket = {
+    [](void *arg) {
+        auto *call = static_cast<RuntimeCall *>(arg);
+        call->socket = call->fd < 0 ? new SocketImpl((swSocketType) call->type)
+                                    : new SocketImpl(call->fd, call->domain, call->type, call->protocol);
+    },
+    [](void *arg) {
+        auto *call = static_cast<RuntimeCall *>(arg);
+        call->result = SOCK(call->socket)->close();
+    },
+    [](void *socket) { delete SOCK(socket); },
+    [](void *socket) { return static_cast<swr_v1_co_socket *>(SOCK(socket)); },
+    [](void *socket, int op, char *buf, size_t length) -> ssize_t {
+        auto *sock = SOCK(socket);
+        switch (op) {
+        case 0:
+            return sock->get_socket()->send_sync(buf, length, 0);
+        case 1:
+            return sock->get_socket()->recv_sync(buf, length, 0);
+        case 2:
+            return sock->send_all(buf, length);
+        case 3:
+            return sock->send_once(buf, length);
+        case 4:
+            return sock->recv(buf, length);
+        case 5:
+            return sock->recv_once(buf, length);
+        case 6:
+            return sock->peek(buf, length);
+        default:
+            return sock->send(buf, length);
+        }
+    },
+    [](void *socket, char *buf, size_t length, sockaddr *addr, socklen_t *addrlen) {
+        return SOCK(socket)->recvfrom(buf, length, addr, addrlen);
+    },
+    [](void *socket, int level, int name, int value, bool logged) {
+        if (logged) {
+            SOCK(socket)->set_option(level, name, value);
+        } else {
+            SOCK(socket)->get_socket()->set_option(level, name, value);
+        }
+    },
+    [](void *socket, const char *host, int port) { return SOCK(socket)->bind(host, port); },
+    [](void *socket, const char *host, int port) { return SOCK(socket)->connect(host, port); },
+    [](void *socket, int backlog) { return SOCK(socket)->listen(backlog); },
+    [](void *socket) -> void * { return SOCK(socket)->accept(); },
+    [](void *socket) { return SOCK(socket)->ssl_is_enable(); },
+    [](void *socket) { SOCK(socket)->enable_ssl_encrypt(); },
+    [](void *socket) { return SOCK(socket)->ssl_handshake(); },
+    [](void *socket) { SOCK(socket)->ssl_close(); },
+    [](void *socket, bool chain, void (*each)(void *, const char *, size_t), void *arg) {
+        if (!chain) {
+            const std::string cert = SOCK(socket)->ssl_get_peer_cert();
+            each(arg, cert.c_str(), cert.length());
+            return;
+        }
+        for (auto &cert : SOCK(socket)->get_socket()->ssl_get_peer_cert_chain(INT_MAX)) {
+            each(arg, cert.c_str(), cert.length());
+        }
+    },
+    [](void *socket, bool write, double timeout) {
+        return SOCK(socket)->poll(write ? SW_EVENT_WRITE : SW_EVENT_READ, timeout);
+    },
+    [](const int *fds, const int *events, size_t count, double timeout, int *ready, int *revents, size_t *size) {
+        std::unordered_map<int, swoole::coroutine::PollSocket> polled;
+        for (size_t i = 0; i < count; i++) {
+            auto entry = polled.find(fds[i]);
+            if (entry == polled.end()) {
+                polled.emplace(fds[i], swoole::coroutine::PollSocket(events[i], nullptr));
+            } else {
+                entry->second.events |= events[i];
+            }
+        }
+        if (!swoole::coroutine::System::socket_poll(polled, timeout)) {
+            *size = 0;
+            return false;
+        }
+        size_t i = 0;
+        for (auto &entry : polled) {
+            ready[i] = entry.first;
+            revents[i++] = entry.second.revents;
+        }
+        *size = i;
+        return true;
+    },
+};
 #undef SOCK
