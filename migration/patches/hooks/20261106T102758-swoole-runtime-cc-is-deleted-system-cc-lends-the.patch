-bool swoole_runtime_poll(
-    const int *fds, const int *events, size_t count, double timeout, int *ready, int *revents, size_t *size) {
-    std::unordered_map<int, PollSocket> polled;
-    for (size_t i = 0; i < count; i++) {
-        auto entry = polled.find(fds[i]);
-        if (entry == polled.end()) {
-            polled.emplace(fds[i], PollSocket(events[i], nullptr));
-        } else {
-            entry->second.events |= events[i];
-        }
-    }
-    if (!System::socket_poll(polled, timeout)) {
-        *size = 0;
-        return false;
-    }
-    size_t i = 0;
-    for (auto &entry : polled) {
-        ready[i] = entry.first;
-        revents[i++] = entry.second.revents;
-    }
-    *size = i;
-    return true;
-}
