-        network::IOVector *io_vector;
-        TimerController *timer;
-        bool write;
-    } context{this, io_vector, timer, write};
-    const swr_v1_hook_vector_ops ops{
-        &context,
-        [](void *c, bool first) -> ssize_t {
-            auto *ctx = static_cast<Context *>(c);
-            ssize_t retval;
-            if (ctx->write) {
-                retval = ctx->socket->socket->writev(ctx->io_vector);
-                if (first) {
-                    swoole_trace_log(SW_TRACE_SOCKET, "writev %ld bytes, errno=%d", retval, errno);
-                }
-            } else {
-                retval = ctx->socket->socket->readv(ctx->io_vector);
-                if (first) {
-                    swoole_trace_log(SW_TRACE_SOCKET, "readv %ld bytes, errno=%d", retval, errno);
-                }
-            }
-            return retval;
-        },
-        [](void *c) -> bool {
-            auto *ctx = static_cast<Context *>(c);
-            auto *sock = ctx->socket->socket;
-            return (ctx->write ? sock->catch_write_error(errno) : sock->catch_read_error(errno)) == SW_WAIT;
-        },
-        [](void *c) -> size_t { return static_cast<Context *>(c)->io_vector->get_remain_count(); },
-        [](void *c) { static_cast<Context *>(c)->socket->set_err(errno); },
-        [](void *c, swr_v1_hook_barrier barrier, void *state) -> bool {
-            auto *ctx = static_cast<Context *>(c);
-            auto wait = ctx->write ? SW_EVENT_WRITE : SW_EVENT_READ;
-            return ctx->timer->start() && ctx->socket->wait_event(wait, barrier, state);
-        },
-        [](void *c, ssize_t retval) { static_cast<Context *>(c)->socket->check_return_value(retval); },
-    };
-    return swr_v1_hook_vector_all(&ops);
-}
