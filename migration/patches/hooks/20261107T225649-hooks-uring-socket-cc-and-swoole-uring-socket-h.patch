-// The sequence is Rust's (crates/hooks/src/connect.rs); each step runs the handshake through the ring.
-bool UringSocket::ssl_handshake() {
-    const swr_v1_hook_tls_ops ops{
-        this,
-        2,
-        ssl_handshaked,
-        ssl_context && ssl_context->context != nullptr,
-        ssl_context && ssl_context->verify_peer,
-        [](void *s) { return static_cast<UringSocket *>(s)->is_available(SW_EVENT_RDWR); },
-        [](void *s, int error) { static_cast<UringSocket *>(s)->set_err(error); },
-        [](void *s) { return static_cast<UringSocket *>(s)->ssl_context_create(); },
-        [](void *s) {
-            auto *sock = static_cast<UringSocket *>(s);
-            if (!sock->ssl_create(sock->get_ssl_context())) {
-                return false;
-            }
-            sock->rbio = BIO_new(BIO_s_mem());
-            sock->wbio = BIO_new(BIO_s_mem());
-            SSL_set_bio(sock->socket->ssl, sock->rbio, sock->wbio);
-            if (sock->ssl_is_server) {
-                SSL_set_accept_state(sock->socket->ssl);
-            } else {
-                SSL_set_connect_state(sock->socket->ssl);
-            }
-            return true;
-        },
-        [](void *s) -> int {
-            auto *sock = static_cast<UringSocket *>(s);
-            auto rs = SSL_do_handshake(sock->socket->ssl);
-            if (rs == 1) {
-                return 1;
-            }
-            return swr_v1_uring_tls_perform(sock->tls(), rs, sock->ssl_is_server ? "ssl_accept" : "ssl_connect") ? 0 : -1;
-        },
-        [](void *, bool) { return false; },
-        [](void *s) {
-            auto *sock = static_cast<UringSocket *>(s);
-            return sock->ssl_verify(sock->ssl_context->allow_self_signed);
-        },
-    };
-    if (!swr_v1_hook_ssl_handshake(&ops)) {
-        return false;
-    }
-    ssl_handshaked = true;
-    return true;
-}
-// The loop is Rust's (crates/hooks/src/sendfile.rs); the warnings stay here.
-static_assert(SW_CLOSE == 3 && SW_ERROR == 4 && SW_BUFFER_SIZE_BIG == 65536, "swr_v1_uring_tls_sendfile");
-ssize_t UringSocket::ssl_sendfile(const File &file, off_t *offset, size_t size) {
-    auto result = swr_v1_uring_tls_sendfile(tls(), file.get_fd(), offset, size, [](void *socket, int error) {
-        return static_cast<UringSocket *>(socket)->get_socket()->catch_write_error(error);
-    });
-    if (result.warn == 1) {
-        swoole_sys_warning("pread() failed");
-    } else if (result.warn == 2) {
-        swoole_sys_warning("write() failed");
-    }
-    return result.total;
-}
-
-// The TLS retry is Rust's (swr_v1_uring_tls_once); these are the network socket's attempts.
-static int want_bio(void *s) {
-    auto *sock = static_cast<UringSocket *>(s)->get_socket();
-    return (sock->ssl_want_read == 1 ? 1 : 0) | (sock->ssl_want_write == 1 ? 2 : 0);
-}
-
-ssize_t UringSocket::send_once(const void *buf, size_t count) {
-    return swr_v1_uring_tls_once(
-        tls(),
-        const_cast<void *>(buf),
-        count,
-        [](void *s, void *b, size_t n) { return static_cast<UringSocket *>(s)->get_socket()->send(b, n, 0); },
-        want_bio);
-}
-
-ssize_t UringSocket::recv_once(void *buf, size_t count) {
-    return swr_v1_uring_tls_once(
-        tls(),
-        buf,
-        count,
-        [](void *s, void *b, size_t n) { return static_cast<UringSocket *>(s)->get_socket()->recv(b, n, 0); },
-        want_bio);
-}
