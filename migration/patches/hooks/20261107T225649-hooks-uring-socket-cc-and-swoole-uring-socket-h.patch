-// Each operation is one Rust call (crates/hooks/src/uring_socket.rs); these are the socket's effects.
-swr_v1_hook_uring_socket UringSocket::io() {
-    return {this,
-            state_,
-            tls(),
-            socket->connect_timeout,
-            [](void *s, uint32_t event) { return static_cast<UringSocket *>(s)->is_available(static_cast<EventType>(event)); },
-            [](void *s, ssize_t retval) { static_cast<UringSocket *>(s)->check_return_value(retval); },
-            [](void *s, int error) { static_cast<UringSocket *>(s)->set_err(error); },
-            [](void *s) { static_cast<UringSocket *>(s)->socket->get_name(); }};
-}
-
-static swr_v1_hook_io_vector vector_ops(network::IOVector *vector) {
-    return {vector,
-            [](void *v, int *count) -> const iovec * {
-                auto *io = static_cast<network::IOVector *>(v);
-                *count = io->get_remain_count();
-                return io->get_iterator();
-            },
-            [](void *v, ssize_t n) { static_cast<network::IOVector *>(v)->update_iterator(n); }};
-}
-
-bool UringSocket::connect(const sockaddr *addr, socklen_t addrlen) {
-    auto ops = io();
-    return swr_v1_hook_uring_connect(&ops, addr, addrlen);
-}
-// The ring's accept is Rust's; as upstream, it waits for the read timeout, not `timeout`.
-UringSocket *UringSocket::accept(double) {
-    if (sw_unlikely(!is_available(SW_EVENT_READ))) {
-        return nullptr;
-    }
-    if (ssl_is_enable() && sw_unlikely(ssl_context->context == nullptr) && !ssl_context_create()) {
-        return nullptr;
-    }
-    auto *conn = new NetSocket();
-    auto ops = io();
-    int fd = swr_v1_hook_uring_accept(&ops, reinterpret_cast<sockaddr *>(&conn->info.addr), &conn->info.len);
-    if (fd < 0) {
-        delete conn;
-        return nullptr;
-    }
-    conn->fd = fd;
-    conn->removed = 1;
-    conn->info.type = socket->socket_type;
-    conn->nonblock = 1;
-    conn->cloexec = 1;
-
-    auto *client_sock = new UringSocket(conn, this);
-    if (sw_unlikely(client_sock->get_fd() < 0)) {
-        swoole_sys_warning("new Socket() failed");
-        set_err(errno);
-        delete client_sock;
-        return nullptr;
-    }
-
-    return client_sock;
-}
-
