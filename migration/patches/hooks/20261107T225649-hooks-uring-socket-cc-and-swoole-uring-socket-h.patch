-bool UringSocket::sendfile(const char *filename, off_t offset, size_t length) {
-    if (sw_unlikely(!is_available(SW_EVENT_WRITE))) {
-        return false;
-    }
-    File file(filename, O_RDONLY);
-    if (!sendfile_file(file, filename, offset, &length)) {
-        return false;
-    }
-    ssize_t retval;
-
-    bind_co(SW_EVENT_WRITE, Coroutine::get_current_safe());
-    if (is_ssl()) {
-        retval = ssl_sendfile(file, &offset, length);
-    } else {
-        retval = Iouring::sendfile(socket->get_fd(), file.get_fd(), &offset, length, socket->write_timeout);
-    }
-    bind_co(SW_EVENT_WRITE, nullptr);
-
-    return retval == (ssize_t) length;
-}
