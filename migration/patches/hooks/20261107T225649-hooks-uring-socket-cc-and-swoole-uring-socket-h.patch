-    &Iouring::host, tls_set_err, tls_check_failure, tls_buffer, ssl_bio_perform, SW_ERROR_SSL_BAD_PROTOCOL, SW_ERROR_SSL_RESET};
-
-void UringSocket::tls_set_err(void *socket, int code) {
