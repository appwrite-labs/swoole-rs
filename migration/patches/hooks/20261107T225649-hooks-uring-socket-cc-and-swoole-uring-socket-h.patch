-
-void UringSocket::ssl_bio_perform(void *_socket, const char *fn, int error, unsigned long err_code) {
-    auto self = static_cast<UringSocket *>(_socket);
-    char error_buf[512];
-    ERR_error_string_n(err_code, error_buf, sizeof(error_buf));
-    swoole_notice("%s(fd=%d) to server[%s:%d] failed. Error: %s[%d|%d]",
-                  fn,
-                  self->socket->get_fd(),
-                  self->socket->info.get_addr(),
-                  self->socket->info.get_port(),
-                  error_buf,
-                  error,
-                  ERR_GET_REASON(err_code));
-    self->set_err(SW_ERROR_SSL_BAD_PROTOCOL, error_buf);
-}
