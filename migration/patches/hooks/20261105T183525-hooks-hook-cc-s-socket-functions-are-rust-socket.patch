-}  // namespace swoole::coroutine
-using swoole::coroutine::async_job;
-
-static sw_inline bool is_no_coro() {
-    return swr_v1_hook_no_coro(SwooleTG.reactor != nullptr,
-                               SwooleTG.reactor != nullptr && Coroutine::get_current() != nullptr);
-}
-
-// The hooked file, sleep and resolver functions are Rust (crates/hooks/src/stdio.rs),
-// exported under their upstream names; this is what they need of native.
-static bool in_coroutine() {
-    return !is_no_coro();
-}
-
-static const swr_v1_hook_host hook_host = {
-    in_coroutine,
-    async_job,
-    System::sleep,
-#ifdef SW_USE_IOURING
-    &Iouring::host,
-#else
-    nullptr,
-#endif
-#ifdef HAVE_IOURING_STATX
-    true,
-#else
-    false,
-#endif
-#ifdef HAVE_IOURING_FTRUNCATE
-    true,
-#else
-    false,
-#endif
-    swoole_set_last_error,
-};
-
-[[maybe_unused]] static const bool hook_host_set = (swr_v1_hook_set_host(&hook_host), true);
-
-static sw_inline SocketImpl *get_socket(int sockfd) {
-    return static_cast<SocketImpl *>(swr_v1_hook_socket_get(sockfd));
-}
-
-static sw_inline SocketImpl *get_socket_ex(int sockfd) {
-    if (sw_unlikely(is_no_coro())) {
-        errno = EWOULDBLOCK;
-        return nullptr;
-    }
-    return get_socket(sockfd);
-}
-
-/* Delete the socket the map handed back, if any. */
-static void socket_release(void *socket) {
-    delete static_cast<SocketImpl *>(socket);
-}
-
-SocketImpl *swoole_coroutine_get_socket_object(int sockfd) {
-    return get_socket(sockfd);
-}
-
-SocketImpl *swoole_coroutine_get_socket_object_ex(int sockfd) {
-    return get_socket_ex(sockfd);
-}
-
-SW_EXTERN_C_BEGIN
-int swoole_coroutine_socket(int domain, int type, int protocol) {
-    if (sw_unlikely(is_no_coro())) {
-        return ::socket(domain, type, protocol);
-    }
-    auto *socket = new SocketImpl(domain, type, protocol);
-    int fd = socket->get_fd();
-    if (sw_unlikely(fd < 0)) {
-        delete socket;
-        return -1;
-    }
-    socket_release(swr_v1_hook_socket_insert(fd, socket, true));
-    return fd;
-}
-
-ssize_t swoole_coroutine_send(int sockfd, const void *buf, size_t len, int flags) {
-    auto *socket = get_socket_ex(sockfd);
-    if (sw_unlikely(socket == nullptr)) {
-        return ::send(sockfd, buf, len, flags);
-    }
-    return socket->send(buf, len);
-}
-
-ssize_t swoole_coroutine_sendmsg(int sockfd, const struct msghdr *msg, int flags) {
-    auto *socket = get_socket_ex(sockfd);
-    if (sw_unlikely(socket == nullptr)) {
-        return ::sendmsg(sockfd, msg, flags);
-    }
-    return socket->sendmsg(msg, flags);
-}
-
-ssize_t swoole_coroutine_recvmsg(int sockfd, struct msghdr *msg, int flags) {
-    auto *socket = get_socket_ex(sockfd);
-    if (sw_unlikely(socket == nullptr)) {
-        return ::recvmsg(sockfd, msg, flags);
-    }
-    return socket->recvmsg(msg, flags);
-}
-
-ssize_t swoole_coroutine_recv(int sockfd, void *buf, size_t len, int flags) {
-    auto *socket = get_socket_ex(sockfd);
-    if (sw_unlikely(socket == nullptr)) {
-        return ::recv(sockfd, buf, len, flags);
-    }
-    if (flags & MSG_PEEK) {
-        return socket->peek(buf, len);
-    } else {
-        return socket->recv(buf, len);
-    }
-}
-
-int swoole_coroutine_connect(int sockfd, const struct sockaddr *addr, socklen_t addrlen) {
-    auto *socket = get_socket_ex(sockfd);
-    if (sw_unlikely(socket == nullptr)) {
-        return ::connect(sockfd, addr, addrlen);
-    }
-    return socket->connect(addr, addrlen) ? 0 : -1;
-}
-
-int swoole_coroutine_accept(int sockfd, struct sockaddr *addr, socklen_t *addrlen) {
-    auto *socket = get_socket_ex(sockfd);
-    if (sw_unlikely(socket == nullptr)) {
-        return ::accept(sockfd, addr, addrlen);
-    }
-
-    auto conn = socket->accept(0);
-    if (!conn) {
-        return -1;
-    }
-
-    *addrlen = conn->get_socket()->info.len;
-    memcpy(addr, &conn->get_socket()->info.addr.ss, *addrlen);
-
-    int fd = conn->get_fd();
-    socket_release(swr_v1_hook_socket_insert(fd, conn, false));
-    return fd;
-}
-
-int swoole_coroutine_poll_fake(struct pollfd *fds, nfds_t nfds, int timeout) {
-    if (nfds != 1) {
-        swoole_set_last_error(SW_ERROR_INVALID_PARAMS);
-        swoole_warning("fake poll() implementation, only supports one fd");
-        return -1;
-    }
-    auto *socket = get_socket_ex(fds[0].fd);
-    const auto result = swr_v1_hook_fd_poll_fake(fds, timeout, socket);
-    return result == 2 ? ::poll(fds, nfds, timeout) : result;
-}
-
-int swoole_coroutine_poll(struct pollfd *fds, nfds_t nfds, int timeout) {
-    if (sw_unlikely(is_no_coro() || timeout == 0)) {
-        return poll(fds, nfds, timeout);
-    }
-
-#ifdef SW_USE_IOURING
-    if (nfds == 1) {
-        return Iouring::poll(fds, nfds, timeout);
-    }
-#endif
-
-    return swr_v1_hook_poll(fds, nfds, timeout, &swoole::coroutine::poll_ops);
-}
-
-int swoole_coroutine_socket_create(int fd) {
-    if (sw_unlikely(is_no_coro())) {
-        return -1;
-    }
-    auto *socket = new SocketImpl(fd, SW_SOCK_RAW);
-    int _fd = socket->get_fd();
-    if (sw_unlikely(_fd < 0)) {
-        delete socket;
-        return -1;
-    }
-    socket->get_socket()->set_nonblock();
-    socket_release(swr_v1_hook_socket_insert(fd, socket, true));
-    return 0;
-}
-
-int swoole_coroutine_socket_unwrap(int fd) {
-    if (sw_unlikely(is_no_coro())) {
-        return -1;
-    }
-    auto *socket = static_cast<SocketImpl *>(swr_v1_hook_socket_remove(fd));
-    if (socket == nullptr) {
-        return -1;
-    }
-    socket->move_fd();
-    delete socket;
-    return 0;
-}
-
-uint8_t swoole_coroutine_socket_exists(int fd) {
-    return swr_v1_hook_socket_exists(fd);
-}
-
-int swoole_coroutine_socket_set_timeout(int sockfd, int which, double timeout) {
-    auto *socket = get_socket_ex(sockfd);
-    return swr_v1_hook_fd_timeout(socket, which, timeout, false);
-}
-
-int swoole_coroutine_socket_set_connect_timeout(int sockfd, double timeout) {
-    auto *socket = get_socket_ex(sockfd);
-    return swr_v1_hook_fd_timeout(socket, 0, timeout, true);
-}
-
-int swoole_coroutine_socket_wait_event(int sockfd, int event, double timeout) {
-    auto *socket = get_socket_ex(sockfd);
-    if (sw_unlikely(socket == nullptr)) {
-        auto poll_ev = swr_v1_hook_fd_poll(sockfd, event);
-        return ::poll(&poll_ev, 1, (int) (timeout * 1000)) == 1 ? SW_OK : SW_ERR;
-    }
-    auto wait = swr_v1_hook_fd_wait(socket, event, timeout);
-    bool retval = socket->poll(static_cast<EventType>(event));
-    swr_v1_hook_fd_wait_restore(wait);
-    return retval ? SW_OK : SW_ERR;
-}
-
-int swoole_coroutine_close(int sockfd) {
-    if (sw_unlikely(is_no_coro())) {
-        return close(sockfd);
-    }
-
-    int result = swr_v1_hook_socket_close(
-        sockfd, [](void *socket) { return static_cast<SocketImpl *>(socket)->close(); }, socket_release);
-    if (result <= 0) {
-        return result;
-    }
-
-#ifdef SW_USE_ASYNC
-    return swr_v1_hook_close_fd(sockfd, async_job);
-#else
-    return Iouring::close(sockfd);
-#endif
-}
-
-ssize_t swoole_coroutine_read(int sockfd, void *buf, size_t count) {
-    if (sw_unlikely(is_no_coro())) {
-        return read(sockfd, buf, count);
-    }
-
-    auto *socket = get_socket(sockfd);
-    if (socket != nullptr) {
-        return socket->read(buf, count);
-    }
-
-#ifdef SW_USE_ASYNC
-    ssize_t ret = -1;
-    NetSocket sock = {};
-    sock.fd = sockfd;
-    sock.nonblock = 1;
-    sock.read_timeout = -1;
-    async([&]() { ret = sock.read_sync(buf, count); });
-    return ret;
-#else
-    return Iouring::read(sockfd, buf, count);
-#endif
-}
-
-ssize_t swoole_coroutine_write(int sockfd, const void *buf, size_t count) {
-    if (sw_unlikely(is_no_coro())) {
-        return write(sockfd, buf, count);
-    }
-
-    auto *socket = get_socket(sockfd);
-    if (socket != nullptr) {
-        return socket->write(buf, count);
-    }
-
-#ifdef SW_USE_ASYNC
-    ssize_t ret = -1;
-    NetSocket sock = {};
-    sock.fd = sockfd;
-    sock.nonblock = 1;
-    sock.write_timeout = -1;
-    async([&]() { ret = sock.write_sync(buf, count); });
-    return ret;
-#else
-    return Iouring::write(sockfd, buf, count);
-#endif
-}
-
-SW_EXTERN_C_END
diff --git a/src/coroutine/socket.cc b/src/coroutine/socket.cc
index a7d88e9..2e1c510 100644
--- a/src/coroutine/socket.cc
+++ b/src/coroutine/socket.cc
@@ -862 +862,52 @@ ssize_t Socket::send_once(const void *buf, size_t count) {
 }  // namespace swoole
+
+// hook.cc's socket functions are Rust (crates/hooks/src/hooked.rs), as are the hooked
+// file, sleep and resolver functions (stdio.rs); this is what they need of native.
+#include "swoole_socket_impl.h"
+#include "swoole_iouring.h"
+
+namespace swoole::coroutine {
+extern const swr_v1_hook_poll_ops poll_ops;            // system.cc
+bool async_job(void (*job)(void *), void *context);  // system.cc
+}  // namespace swoole::coroutine
+
+#define SOCK(socket) static_cast<SocketImpl *>(socket)
+static const swr_v1_hook_host hook_host = {
+    [] { return SwooleTG.reactor != nullptr && swoole::Coroutine::get_current() != nullptr; },
+    swoole::coroutine::async_job,
+    swoole::coroutine::System::sleep,
+#ifdef SW_USE_IOURING
+    &swoole::Iouring::host,
+#else
+    nullptr,
+#endif
+#ifdef HAVE_IOURING_STATX
+    true,
+#else
+    false,
+#endif
+#ifdef HAVE_IOURING_FTRUNCATE
+    true,
+#else
+    false,
+#endif
+    swoole_set_last_error,
+    &swoole::coroutine::poll_ops,
+    {
+        [](int domain, int type, int protocol) -> void * { return new SocketImpl(domain, type, protocol); },
+        [](int fd) -> void * { return new SocketImpl(fd, SW_SOCK_RAW); },
+        [](void *socket) { delete SOCK(socket); },
+        [](void *socket, const void *buf, size_t n) { return SOCK(socket)->send(buf, n); },
+        [](void *socket, void *buf, size_t n) { return SOCK(socket)->recv(buf, n); },
+        [](void *socket, void *buf, size_t n) { return SOCK(socket)->peek(buf, n); },
+        [](void *socket, const void *buf, size_t n) { return SOCK(socket)->write(buf, n); },
+        [](void *socket, void *buf, size_t n) { return SOCK(socket)->read(buf, n); },
+        [](void *socket, const msghdr *msg, int flags) { return SOCK(socket)->sendmsg(msg, flags); },
+        [](void *socket, msghdr *msg, int flags) { return SOCK(socket)->recvmsg(msg, flags); },
+        [](void *socket, const sockaddr *addr, socklen_t len) { return SOCK(socket)->connect(addr, len); },
+        [](void *socket) -> void * { return SOCK(socket)->accept(0); },
+        [](void *socket, uint32_t event) { return SOCK(socket)->poll(static_cast<swoole::EventType>(event)); },
+    },
+};
+#undef SOCK
+[[maybe_unused]] static const bool hook_host_set = (swr_v1_hook_set_host(&hook_host), true);
