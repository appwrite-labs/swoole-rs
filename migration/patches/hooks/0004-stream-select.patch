+void *swoole_runtime_fd_socket(int fd, void **holder) {
+    auto socket = swoole_coroutine_get_socket_object(fd);
+    if (!socket) {
+        return nullptr;
+    }
+    *holder = new std::shared_ptr<SocketImpl>(socket);
+    return socket.get();
+}
+
+void swoole_runtime_fd_socket_release(void *holder) {
+    delete static_cast<std::shared_ptr<SocketImpl> *>(holder);
+}
+
+bool swoole_runtime_socket_poll(void *socket, bool write, double timeout) {
+    return SOCK(socket)->poll(write ? SW_EVENT_WRITE : SW_EVENT_READ, timeout);
+}
+
+const char *swoole_runtime_strerror(int code) {
+    return swoole_strerror(code);
+}
+
+uint8_t swoole_runtime_coroutine_check(void) {
+    volatile uint8_t bailout = 1;
+    zend_try {
+        Coroutine::get_current_safe();
+        bailout = 0;
+    }
+    zend_end_try();
+    return bailout;
+}
+
+uint8_t swoole_runtime_convert_to_fd(zval *value, int *fd) {
+    volatile uint8_t bailout = 1;
+    zend_try {
+        *fd = php_swoole_convert_to_fd(value);
+        bailout = 0;
+    }
+    zend_end_try();
+    return bailout;
+}
+
+bool swoole_runtime_poll(
+    const int *fds, const int *events, size_t count, double timeout, int *ready, int *revents, size_t *size) {
+    std::unordered_map<int, PollSocket> polled;
+    for (size_t i = 0; i < count; i++) {
+        auto entry = polled.find(fds[i]);
+        if (entry == polled.end()) {
+            polled.emplace(fds[i], PollSocket(events[i], nullptr));
+        } else {
+            entry->second.events |= events[i];
+        }
+    }
+    if (!System::socket_poll(polled, timeout)) {
+        *size = 0;
+        return false;
+    }
+    size_t i = 0;
+    for (auto &entry : polled) {
+        ready[i] = entry.first;
+        revents[i++] = entry.second.revents;
+    }
+    *size = i;
+    return true;
+}
