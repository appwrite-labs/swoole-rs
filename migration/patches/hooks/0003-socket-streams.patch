+// The coroutine socket streams are Rust (crates/phpruntime/src/stream.rs): the
+// stream operations, the transport API, crypto, the "socket/coroutine" factory
+// and stream_socket_pair. The tables stay here; an operation that can run PHP
+// code reports a trapped bailout, which its entry re-raises.
+static php_stream_size_t socket_write(php_stream *stream, const char *buf, size_t count) {
+    uint8_t bailout = 0;
+    const auto result = swr_v1_phpruntime_socket_write(stream, buf, count, &bailout);
+    if (bailout) {
+        zend_bailout();
+    }
+    return result;
+}
+
+static php_stream_size_t socket_read(php_stream *stream, char *buf, size_t count) {
+    uint8_t bailout = 0;
+    const auto result = swr_v1_phpruntime_socket_read(stream, buf, count, &bailout);
+    if (bailout) {
+        zend_bailout();
+    }
+    return result;
+}
+
+static int socket_set_option(php_stream *stream, int option, int value, void *ptrparam) {
+    uint8_t bailout = 0;
+    const auto result = swr_v1_phpruntime_socket_set_option(stream, option, value, ptrparam, &bailout);
+    if (bailout) {
+        zend_bailout();
+    }
+    return result;
+}
 
