-// sendto's address: an available datagram socket, and host resolved as Rust decides
-// (crates/hooks/src/resolve.rs). UringSocket shares it.
-bool Socket::sendto_address(const std::string &host, int port, network::Address *addr) {
-    if (sw_unlikely(!is_available(SW_EVENT_WRITE))) {
-        return false;
-    }
-    if (!socket->is_dgram()) {
-        set_err(EPROTONOSUPPORT);
-        return false;
-    }
-    // Address::assign sets family, port and address only; a stale scope id
-    // misroutes an interface-local IPv6 destination (ff01::/16).
-    memset(addr, 0, sizeof(*addr));
-
-    auto ip_addr = host;
-    struct Context {
-        Socket *socket;
-        network::Address *address;
-        std::string *ip;
-        const std::string *host;
-        int port;
-    } context{this, addr, &ip_addr, &host, port};
-    const swr_v1_hook_resolve_ops resolve_ops{
-        &context,
-        [](void *c) {
-            auto *ctx = static_cast<Context *>(c);
-            return ctx->address->assign(ctx->socket->type, *ctx->ip, ctx->port, false);
-        },
-        [] { return swoole_get_last_error() == SW_ERROR_BAD_HOST_ADDR; },
-        [](void *c) {
-            auto *ctx = static_cast<Context *>(c);
-            *ctx->ip = System::gethostbyname(*ctx->host, ctx->socket->sock_domain, ctx->socket->socket->dns_timeout);
-            return !ctx->ip->empty();
-        },
-    };
-    if (swr_v1_hook_resolve(&resolve_ops) != 0) {
-        set_err();
-        return false;
-    }
-    return true;
-}
