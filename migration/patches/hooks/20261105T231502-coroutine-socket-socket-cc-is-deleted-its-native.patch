+// The sequence is Rust's (crates/hooks/src/connect.rs); these are the socket's effects.
+bool Socket::connect(const std::string &_host, int _port, int flags) {
+    NameResolver::Context _ctx{};
+    struct Context {
+        Socket *socket;
+        NameResolver::Context *resolve;
+        network::Address address;
+        bool resolved;
+        size_t request_length;
+    } context{this, resolve_context_ ? resolve_context_ : &_ctx, {}, false, 0};
+    const swr_v1_hook_connect_ops ops{
+        &context,
+        sock_domain,
+        socket && socket->is_inet6() ? AF_INET6 : (socket && socket->is_inet4() ? AF_INET : 0),
+        socks5_proxy ? 1 : (http_proxy ? 2 : 0),
+        http_proxy && !http_proxy->dont_handshake,
+        ssl_context != nullptr,
+        [](void *c) { return static_cast<Context *>(c)->socket->is_available(SW_EVENT_RDWR); },
+        [](void *c, int error) {
+            auto *sock = static_cast<Context *>(c)->socket;
+            error < 0 ? sock->set_err() : sock->set_err(error);
+        },
+        [](void *c, int error, const char *text, size_t length) {
+            auto *sock = static_cast<Context *>(c)->socket;
+            text ? sock->set_err(error, std::string(text, length)) : sock->set_err(error, swoole_strerror(error));
+        },
+        [] { return swoole_get_last_error(); },
+        [](void *c, int which, const char *text, size_t length, int port) {
+            auto *sock = static_cast<Context *>(c)->socket;
+            std::string host(text, length);
+            if (which == 2 && sock->socks5_proxy) {
+                sock->socks5_proxy->target_host = host;
+                sock->socks5_proxy->target_port = port;
+                host = sock->socks5_proxy->host;
+                port = sock->socks5_proxy->port;
+            } else if (which == 2) {
+                sock->http_proxy->target_host = host;
+                sock->http_proxy->target_port = port;
+                host = sock->http_proxy->host;
+                port = sock->http_proxy->port;
+            }
+            if (which == 1) {
+                sock->ssl_host_name = host;
+            } else {
+                sock->connect_host = host;
+                sock->connect_port = port;
+            }
+        },
+        [](void *c, size_t *length) {
+            auto *sock = static_cast<Context *>(c)->socket;
+            *length = sock->connect_host.length();
+            return sock->connect_host.c_str();
+        },
+        [](void *c, int type) { return static_cast<Context *>(c)->socket->reinit_sock(static_cast<SocketType>(type)); },
+        [](void *c) {
+            auto *ctx = static_cast<Context *>(c);
+            ctx->resolve->timeout = ctx->socket->socket->dns_timeout;
+            return ctx->address.assign(ctx->socket->type, ctx->socket->connect_host, ctx->socket->connect_port, false);
+        },
+        [] { return swoole_get_last_error() == SW_ERROR_BAD_HOST_ADDR; },
+        [](void *c) {
+            auto *ctx = static_cast<Context *>(c);
+            auto *sock = ctx->socket;
+            ctx->resolve->type = sock->sock_domain;
+            if (!ctx->resolved) {
+                ctx->resolved = true;
+                if (sock->ssl_context && !(sock->socks5_proxy || sock->http_proxy)) {
+                    sock->ssl_host_name = sock->connect_host;
+                }
+            }
+            /* locked like wait_event */
+            sock->bind_co(SW_EVENT_RDWR, Coroutine::get_current_safe());
+            ON_SCOPE_EXIT {
+                sock->bind_co(SW_EVENT_RDWR, nullptr);
+            };
+            std::string addr = swoole_name_resolver_lookup(sock->connect_host, ctx->resolve);
+            if (addr.empty()) {
+                sock->set_err(swoole_get_last_error());
+                return false;
+            }
+            if (ctx->resolve->with_port) {
+                char delimiter = sock->sock_domain == AF_INET6 ? '@' : ':';
+                auto port_pos = addr.find_first_of(delimiter);
+                if (port_pos != std::string::npos) {
+                    sock->connect_port = std::stoi(addr.substr(port_pos + 1));
+                    sock->connect_host = addr.substr(0, port_pos);
+                    return true;
+                }
+            }
+            sock->connect_host = addr;
+            return true;
+        },
+        [](void *c) {
+            auto *ctx = static_cast<Context *>(c);
+            return ctx->socket->connect(&ctx->address.addr.ss, ctx->address.len);
+        },
+        [](void *c, const char *buf, size_t n) { return static_cast<Context *>(c)->socket->send(buf, n); },
+        [](void *c, char *buf, size_t n) { return static_cast<Context *>(c)->socket->recv(buf, n); },
+        [](void *c, const char **buffer) -> ssize_t {
+            Socks5Proxy *proxy = static_cast<Context *>(c)->socket->socks5_proxy.get();
+            const auto len = proxy->pack_negotiate_request();
+            proxy->state = SW_SOCKS5_STATE_HANDSHAKE;
+            *buffer = proxy->buf;
+            return len;
+        },
+        [](void *c, const char *reply, size_t n) -> int {
+            auto *sock = static_cast<Context *>(c)->socket;
+            auto send_fn = [sock](const char *buf, size_t len) { return sock->send(buf, len); };
+            if (!sock->socks5_proxy->handshake(reply, n, send_fn)) {
+                return -1;
+            }
+            return sock->socks5_proxy->state == SW_SOCKS5_STATE_READY;
+        },
+        [](void *c, const char **buffer) -> size_t {
+            auto *ctx = static_cast<Context *>(c);
+            auto *sock = ctx->socket;
+            String *send_buffer = sock->get_write_buffer();
+            auto &ssl = sock->ssl_context;
+            size_t n = sock->http_proxy->pack(
+                send_buffer, ssl && !ssl->tls_host_name.empty() ? ssl->tls_host_name : sock->http_proxy->target_host);
+            send_buffer->length = n;
+            swoole_trace_log(SW_TRACE_HTTP_CLIENT, "proxy request: <<EOF\n%.*sEOF", (int) n, send_buffer->str);
+            ctx->request_length = n;
+            *buffer = send_buffer->str;
+            return n;
+        },
+        [](void *c, bool *accepted) -> ssize_t {
+            auto *ctx = static_cast<Context *>(c);
+            auto *sock = ctx->socket;
+            String *recv_buffer = sock->get_read_buffer();
+            ProtocolSwitch ps(sock);
+            sock->open_eof_check = true;
+            sock->open_length_check = false;
+            sock->protocol.package_eof_len = sizeof("\r\n\r\n") - 1;
+            memcpy(sock->protocol.package_eof, SW_STRS("\r\n\r\n"));
+            ssize_t n = sock->recv_packet();
+            if (n > 0) {
+                swoole_trace_log(
+                    SW_TRACE_HTTP_CLIENT, "proxy response: <<EOF\n%.*sEOF", (int) ctx->request_length, recv_buffer->str);
+                *accepted = sock->http_proxy->handshake(recv_buffer);
+            }
+            return n;
+        },
+        [](void *c, bool received) {
+            auto *sock = static_cast<Context *>(c)->socket;
+            if (received) {
+                sock->get_read_buffer()->clear();
+            }
+            sock->get_write_buffer()->clear();
+        },
+        [](void *c) { static_cast<Context *>(c)->socket->ssl_is_server = false; },
+        [](void *c) { return static_cast<Context *>(c)->socket->ssl_handshake(); },
+    };
+    return swr_v1_hook_connect_host(&ops, _host.c_str(), _host.length(), _port);
+}
+
+// Rust runs the transfer (crates/hooks/src/transfer.rs); `call` is its network::Socket call.
+// The transfers, peek and poll are Rust under their own symbols (socket_members.rs).
+template <class Call>
+ssize_t Socket::transfer(EventType event, const void *buf, size_t n, int flags, Call call) {
+    return swr_v1_hook_co_socket_transfer(
+        this,
+        event,
+        flags,
+        static_cast<char *>(const_cast<void *>(buf)),
+        n,
+        [](void *c, char *at, size_t len) noexcept -> ssize_t { return (*static_cast<Call *>(c))(at, len); },
+        &call);
+}
+
+ssize_t Socket::readv_all(network::IOVector *io_vector) {
+    if (sw_unlikely(!is_available(SW_EVENT_READ))) {
+        return -1;
+    }
+    TimerController timer(this, SW_EVENT_READ, socket->read_timeout);
+    return vector_all(io_vector, &timer, false);
+}
+
+ssize_t Socket::writev_all(network::IOVector *io_vector) {
+    if (sw_unlikely(!is_available(SW_EVENT_WRITE))) {
+        return -1;
+    }
+    TimerController timer(this, SW_EVENT_WRITE, socket->write_timeout);
+    return vector_all(io_vector, &timer, true);
+}
+
+// Rust runs the transfer loop; the barrier installed during the wait calls back into it.
+ssize_t Socket::vector_all(network::IOVector *io_vector, TimerController *timer, bool write) {
+    struct Context {
+        Socket *socket;
+        network::IOVector *io_vector;
+        TimerController *timer;
+        bool write;
+    } context{this, io_vector, timer, write};
+    const swr_v1_hook_vector_ops ops{
+        &context,
+        [](void *c, bool first) -> ssize_t {
+            auto *ctx = static_cast<Context *>(c);
+            ssize_t retval;
+            if (ctx->write) {
+                retval = ctx->socket->socket->writev(ctx->io_vector);
+                if (first) {
+                    swoole_trace_log(SW_TRACE_SOCKET, "writev %ld bytes, errno=%d", retval, errno);
+                }
+            } else {
+                retval = ctx->socket->socket->readv(ctx->io_vector);
+                if (first) {
+                    swoole_trace_log(SW_TRACE_SOCKET, "readv %ld bytes, errno=%d", retval, errno);
+                }
+            }
+            return retval;
+        },
+        [](void *c) -> bool {
+            auto *ctx = static_cast<Context *>(c);
+            auto *sock = ctx->socket->socket;
+            return (ctx->write ? sock->catch_write_error(errno) : sock->catch_read_error(errno)) == SW_WAIT;
+        },
+        [](void *c) -> size_t { return static_cast<Context *>(c)->io_vector->get_remain_count(); },
+        [](void *c) { static_cast<Context *>(c)->socket->set_err(errno); },
+        [](void *c, swr_v1_hook_barrier barrier, void *state) -> bool {
+            auto *ctx = static_cast<Context *>(c);
+            auto wait = ctx->write ? SW_EVENT_WRITE : SW_EVENT_READ;
+            return ctx->timer->start() && ctx->socket->wait_event(wait, barrier, state);
+        },
+        [](void *c, ssize_t retval) { static_cast<Context *>(c)->socket->check_return_value(retval); },
+    };
+    return swr_v1_hook_vector_all(&ops);
+}
+
+// Server setup's sequences, waits and error classification are Rust's
+// (crates/hooks/src/setup.rs). These are the socket's effects; `call` is the
+// operation's network::Socket call.
+template <class Call>
+struct Socket::Setup {
+    Socket *socket;
+    Call *call;
+    EventType timer;
+    double timeout;
+
+    swr_v1_hook_setup_ops ops() {
+        return {
+            this,
+            [](void *c, int event) { return static_cast<Setup *>(c)->socket->is_available(static_cast<EventType>(event)); },
+            [](void *c, int error) {
+                auto *socket = static_cast<Setup *>(c)->socket;
+                if (error < 0) {
+                    socket->set_err();
+                } else {
+                    socket->set_err(error);
+                }
+            },
+            [](void *c, int event) {
+                auto *setup = static_cast<Setup *>(c);
+                TimerController timer(setup->socket, setup->timer, setup->timeout);
+                return timer.start() && setup->socket->wait_event(static_cast<EventType>(event));
+            },
+            [](void *c) { return static_cast<Setup *>(c)->socket->socket->get_name(); },
+            [](void *c, int argument) { return (*static_cast<Setup *>(c)->call)(argument); },
+        };
+    }
+};
+
+bool Socket::bind(const std::string &address, const int port) {
+    auto call = [this, &address, port](int) {
+        swoole_clear_last_error();
+        if (socket->set_reuse_addr() < 0) {
+            swoole_sys_warning("setsockopt(%d, SO_REUSEADDR) failed", get_fd());
+        }
+        return socket->bind(address, port);
+    };
+    Setup<decltype(call)> setup{this, &call, SW_EVENT_NULL, 0};
+    auto ops = setup.ops();
+    return swr_v1_hook_bind(&ops);
+}
+
+Socket *Socket::accept(double timeout) {
+    if (sw_unlikely(!is_available(SW_EVENT_READ))) {
+        return nullptr;
+    }
+    if (ssl_is_enable() && sw_unlikely(ssl_context->context == nullptr) && !ssl_context_create()) {
+        return nullptr;
+    }
+    network::Socket *conn = nullptr;
+    auto call = [this, &conn](int) {
+        conn = socket->accept();
+        return conn ? 0 : -1;
+    };
+    Setup<decltype(call)> setup{this, &call, SW_EVENT_READ, timeout == 0 ? socket->read_timeout : timeout};
+    auto ops = setup.ops();
+    if (!swr_v1_hook_accept(&ops)) {
+        return nullptr;
+    }
+
+    auto *client_sock = new Socket(conn, this);
+    if (sw_unlikely(client_sock->get_fd() < 0)) {
+        swoole_sys_warning("new Socket() failed");
+        set_err(errno);
+        delete client_sock;
+        return nullptr;
+    }
+
+    return client_sock;
+}
+
+bool Socket::ssl_context_create() {
+    swoole_ssl_init();
+    switch (swr_v1_tls_owner_socket_context(ssl_context->handle(), socket, http2,
+#ifdef SW_SUPPORT_DTLS
+                                          true
+#else
+                                          false
+#endif
+                                          )) {
+    case 1: swoole_warning("DTLS support require openssl-1.1 or later"); return false;
+    case 2: set_err(SW_ERROR_SSL_CREATE_CONTEXT_FAILED); return false;
+    default: return true;
+    }
+}
+
+bool Socket::ssl_create(SSLContext *context) {
+    if (socket->ssl) return true;
+    auto result = swr_v1_tls_owner_socket_session(context->handle(), socket, extra_owner_.value.ssl_host_name,
+#ifdef OPENSSL_IS_BORINGSSL
+        [](SSL *ssl, bool grease) { SSL_set_enable_ech_grease(ssl, grease); }
+#else
+        nullptr
+#endif
+    );
+    switch (result.status) {
+    case 1: swoole_warning("SSL_new() failed"); break;
+    case 2: swoole_warning("SSL_set_fd() failed. Error: %s[%lu]", ERR_reason_error_string(result.error), result.error); break;
+    case 3: swoole_warning("SSL_set_ex_data() failed"); break;
+    default: return true;
+    }
+    set_err(SW_ERROR_SSL_CREATE_SESSION_FAILED);
+    return false;
+}
+
+// The sequence, its steps and waits are Rust's (crates/hooks/src/connect.rs).
+bool Socket::ssl_handshake() {
+    TimerController timer(this, SW_EVENT_READ, socket ? socket->read_timeout : 0);
+    struct Context {
+        Socket *socket;
+        TimerController *timer;
+    } context{this, &timer};
+    const swr_v1_hook_tls_ops ops{
+        &context,
+        ssl_is_server ? 1 : 0,
+        ssl_handshaked,
+        ssl_context && ssl_context->context != nullptr,
+        ssl_context && ssl_context->verify_peer,
+        [](void *c) { return static_cast<Context *>(c)->socket->is_available(SW_EVENT_RDWR); },
+        [](void *c, int error) {
+            auto *sock = static_cast<Context *>(c)->socket;
+            error < 0 ? sock->set_err() : sock->set_err(error);
+        },
+        [](void *c) { return static_cast<Context *>(c)->socket->ssl_context_create(); },
+        [](void *c) {
+            auto *sock = static_cast<Context *>(c)->socket;
+            return sock->ssl_create(sock->get_ssl_context());
+        },
+        [](void *c) -> int {
+            auto *sock = static_cast<Context *>(c)->socket->socket;
+            if (static_cast<Context *>(c)->socket->ssl_is_server) {
+                return sock->ssl_accept();
+            }
+            return sock->ssl_connect() < 0 ? -1 : sock->ssl_state;
+        },
+        [](void *c, bool fresh) {
+            auto *ctx = static_cast<Context *>(c);
+            auto *sock = ctx->socket;
+            if (fresh) {
+                TimerController timer(sock, SW_EVENT_READ, sock->socket->read_timeout);
+                return timer.start() && sock->wait_event(SW_EVENT_READ);
+            }
+            return ctx->timer->start() && sock->wait_event(SW_EVENT_READ);
+        },
+        [](void *c) {
+            auto *sock = static_cast<Context *>(c)->socket;
+            return sock->ssl_verify(sock->ssl_context->allow_self_signed);
+        },
+    };
+    if (!swr_v1_hook_ssl_handshake(&ops)) {
+        return false;
+    }
+    ssl_handshaked = true;
+    return true;
+}
+
+bool Socket::ssl_verify(bool allow_self_signed) {
+    if (!socket->ssl_verify(allow_self_signed)) {
+        set_err(SW_ERROR_SSL_VERIFY_FAILED);
+        return false;
+    }
+#ifdef SSL_CTRL_SET_TLSEXT_HOSTNAME
+    if (!ssl_context->tls_host_name.empty() && !socket->ssl_check_host(ssl_context->tls_host_name.c_str())) {
+        set_err(SW_ERROR_SSL_VERIFY_FAILED);
+        return false;
+    }
+#endif
+    return true;
+}
+
+std::string Socket::ssl_get_peer_cert() {
+    if (!socket->ssl_get_peer_certificate(sw_tg_buffer())) {
+        set_err(SW_ERROR_SSL_EMPTY_PEER_CERTIFICATE);
+        return "";
+    } else {
+        return sw_tg_buffer()->to_std_string();
+    }
+}
+
+// sendfile's file, opened after the availability check, and the offset it ends at.
+// UringSocket shares it.
+bool Socket::sendfile_file(File &file, const char *filename, off_t offset, size_t *end) {
+    if (!file.ready()) {
+        set_err(errno, std_string::format("open(%s) failed, %s", filename, strerror(errno)));
+        return false;
+    }
+
+    if (*end == 0) {
+        FileStatus file_stat;
+        if (!file.stat(&file_stat)) {
+            set_err(errno, std_string::format("fstat(%s) failed, %s", filename, strerror(errno)));
+            return false;
+        }
+        *end = file_stat.st_size;
+    } else {
+        *end += offset;
+    }
+    return true;
+}
+
+bool Socket::sendfile(const char *filename, off_t offset, size_t length) {
+    if (sw_unlikely(!is_available(SW_EVENT_WRITE))) {
+        return false;
+    }
+    File file(filename, O_RDONLY);
+    if (!sendfile_file(file, filename, offset, &length)) {
+        return false;
+    }
+
+    // The send loop is Rust's (crates/hooks/src/sendfile.rs); these are its effects.
+    TimerController timer(this, SW_EVENT_WRITE, socket->write_timeout);
+    struct Context {
+        Socket *socket;
+        File *file;
+        TimerController *timer;
+    } context{this, &file, &timer};
+    const swr_v1_hook_sendfile_ops ops{
+        &context,
+        [](void *c, off_t *offset, size_t length) -> ssize_t {
+            auto *ctx = static_cast<Context *>(c);
+            return ctx->socket->socket->sendfile(*ctx->file, offset, length);
+        },
+        [](void *c) {
+            auto *ctx = static_cast<Context *>(c);
+            return ctx->timer->start() && ctx->socket->wait_event(SW_EVENT_WRITE);
+        },
+    };
+    switch (swr_v1_hook_sendfile(&ops, &offset, length)) {
+    case 0:
+        return true;
+    case 1:
+        set_err(SW_ERROR_SYSTEM_CALL_FAIL, "sendfile return zero");
+        return false;
+    case 2:
+        set_err(errno, std_string::format("sendfile(%d, %s) failed, %s", sock_fd, filename, strerror(errno)));
+        return false;
+    default:
+        return false;
+    }
+}
+
+// sendto's address: an available datagram socket, and host resolved as Rust decides
+// (crates/hooks/src/resolve.rs). UringSocket shares it.
+bool Socket::sendto_address(const std::string &host, int port, network::Address *addr) {
+    if (sw_unlikely(!is_available(SW_EVENT_WRITE))) {
+        return false;
+    }
+    if (!socket->is_dgram()) {
+        set_err(EPROTONOSUPPORT);
+        return false;
+    }
+    // Address::assign sets family, port and address only; a stale scope id
+    // misroutes an interface-local IPv6 destination (ff01::/16).
+    memset(addr, 0, sizeof(*addr));
+
+    auto ip_addr = host;
+    struct Context {
+        Socket *socket;
+        network::Address *address;
+        std::string *ip;
+        const std::string *host;
+        int port;
+    } context{this, addr, &ip_addr, &host, port};
+    const swr_v1_hook_resolve_ops resolve_ops{
+        &context,
+        [](void *c) {
+            auto *ctx = static_cast<Context *>(c);
+            return ctx->address->assign(ctx->socket->type, *ctx->ip, ctx->port, false);
+        },
+        [] { return swoole_get_last_error() == SW_ERROR_BAD_HOST_ADDR; },
+        [](void *c) {
+            auto *ctx = static_cast<Context *>(c);
+            *ctx->ip = System::gethostbyname(*ctx->host, ctx->socket->sock_domain, ctx->socket->socket->dns_timeout);
+            return !ctx->ip->empty();
+        },
+    };
+    if (swr_v1_hook_resolve(&resolve_ops) != 0) {
+        set_err();
+        return false;
+    }
+    return true;
+}
+
+ssize_t Socket::sendto(const std::string &host, int port, const void *_buf, size_t _n) {
+    network::Address addr;
+    if (!sendto_address(host, port, &addr)) {
+        return -1;
+    }
+    return transfer(SW_EVENT_WRITE, _buf, _n, TRANSFER_EINTR | TRANSFER_CHECKED, [&](char *at, size_t len) {
+        ssize_t result = socket->sendto(addr, at, len, 0);
+        swoole_trace_log(SW_TRACE_SOCKET, "sendto %ld/%ld bytes, errno=%d", result, len, errno);
+        return result;
+    });
+}
+
+// Rust receives into the network::Socket's peer address (crates/hooks/src/transfer.rs).
+ssize_t Socket::recvfrom(void *_buf, size_t _n) {
+    return swr_v1_hook_co_socket_recvfrom(this, _buf, _n, [](swr_v1_co_socket *s, void *buf, size_t n, sockaddr *addr, socklen_t *len) {
+        return static_cast<Socket *>(s)->recvfrom(buf, n, addr, len);
+    });
+}
+
+ssize_t Socket::recvfrom(void *_buf, size_t _n, sockaddr *_addr, socklen_t *_socklen) {
+    return transfer(SW_EVENT_READ, _buf, _n, TRANSFER_EINTR, [&](char *at, size_t len) {
+        ssize_t result = ::recvfrom(sock_fd, at, len, 0, _addr, _socklen);
+        swoole_trace_log(SW_TRACE_SOCKET, "recvfrom %ld/%ld bytes, errno=%d", result, len, errno);
+        return result;
+    });
+}
+
+/**
+ * Warn:
+ * the destructor should only be called in following two cases:
+ * 1. construct failed
+ * 2. called close() and it returns true
+ * 3. called close() and it returns false, but it will not be accessed anywhere else
+ */
+Socket::~Socket() {
+#ifdef SW_DEBUG
+    if (SwooleG.running) {
+        SW_ASSERT(!has_bound() && socket->removed);
+    }
+#endif
+    if (dtor_ != nullptr) {
+        dtor_(this);
+    }
+    delete read_buffer;
+    delete write_buffer;
+    swr_v1_hook_co_socket_fini(this);
+    if (socket == nullptr) {
+        return;
+    }
+    /* {{{ release socket resources */
+    if (socket->ssl) {
+        ssl_close();
+    }
+    socket->free();
+}
 }  // namespace coroutine
 }  // namespace swoole
+
+// hook.cc's socket functions are Rust (crates/hooks/src/hooked.rs), as are the hooked
+// file, sleep and resolver functions (stdio.rs); this is what they need of native.
+
+#define SOCK(socket) static_cast<SocketImpl *>(socket)
+static const swr_v1_hook_host hook_host = {
+    [] { return SwooleTG.reactor != nullptr && swoole::Coroutine::get_current() != nullptr; },
+    swoole::coroutine::async_job,
+    swoole::coroutine::System::sleep,
+#ifdef SW_USE_IOURING
+    &swoole::Iouring::host,
+#else
+    nullptr,
+#endif
+#ifdef HAVE_IOURING_STATX
+    true,
+#else
+    false,
+#endif
+#ifdef HAVE_IOURING_FTRUNCATE
+    true,
+#else
+    false,
+#endif
+    swoole_set_last_error,
+    &swoole::coroutine::poll_ops,
+    {
+        [](int domain, int type, int protocol) -> void * { return new SocketImpl(domain, type, protocol); },
+        [](int fd) -> void * { return new SocketImpl(fd, SW_SOCK_RAW); },
+        [](void *socket) { delete SOCK(socket); },
+        [](void *socket, const void *buf, size_t n) { return SOCK(socket)->send(buf, n); },
+        [](void *socket, void *buf, size_t n) { return SOCK(socket)->recv(buf, n); },
+        [](void *socket, void *buf, size_t n) { return SOCK(socket)->peek(buf, n); },
+        [](void *socket, const void *buf, size_t n) { return SOCK(socket)->write(buf, n); },
+        [](void *socket, void *buf, size_t n) { return SOCK(socket)->read(buf, n); },
+        [](void *socket, const msghdr *msg, int flags) { return SOCK(socket)->sendmsg(msg, flags); },
+        [](void *socket, msghdr *msg, int flags) { return SOCK(socket)->recvmsg(msg, flags); },
+        [](void *socket, const sockaddr *addr, socklen_t len) { return SOCK(socket)->connect(addr, len); },
+        [](void *socket) -> void * { return SOCK(socket)->accept(0); },
+        [](void *socket, uint32_t event) { return SOCK(socket)->poll(static_cast<swoole::EventType>(event)); },
+    },
+};
+#undef SOCK
+[[maybe_unused]] static const bool hook_host_set = (swr_v1_hook_set_host(&hook_host), true);
