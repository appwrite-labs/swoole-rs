+    [](swr_v1_co_socket *s, swr_v1_hook_read_buffer *view, uint32_t action, size_t value) {
+        auto *sock = static_cast<Socket *>(s);
+        String *buffer = action == 0 ? sock->get_read_buffer() : sock->read_buffer;
+        if (action != 0) {
+            buffer->length = view->length;
