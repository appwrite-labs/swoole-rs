+                             s->socket->get_addr(), s->socket->get_port(), length);
+            sock->set_err(SW_ERROR_PACKAGE_LENGTH_TOO_LARGE, sw_error);
+        } else {
+            sock->set_err(SW_ERROR_PACKAGE_LENGTH_TOO_LARGE, "no package eof, package_max_length exceeded");
+        }
+    },
 };
