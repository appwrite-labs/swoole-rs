-#ifdef HAVE_MUTEX_TIMEDLOCK
-    capabilities |= 1;
-#endif
-#ifdef HAVE_RWLOCK_TIMEDRDLOCK
-    capabilities |= 2;
-#endif
-    return swr_v1_locks_lock((void *) impl, MUTEX, operation, timeout_msec, capabilities);
