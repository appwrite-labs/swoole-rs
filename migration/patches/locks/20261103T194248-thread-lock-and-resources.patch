-// Thread\Map, ArrayList and Queue test values against these classes.
-zend_class_entry *swoole_thread_atomic_ce;
-zend_class_entry *swoole_thread_atomic_long_ce;
-
-// The value lives in a ThreadResource so Thread\Map, ArrayList and Queue can
-// share it between threads; the classes, their method tables, objects and
-// methods are Rust (crates/phplocks), which keeps the resource and the address
-// of its value.
-struct AtomicResource : ThreadResource {
-    sw_atomic_t value;
-
-    explicit AtomicResource(zend_long _value) {
-        value = _value;
-    }
-
-    ~AtomicResource() override = default;
-};
-
-struct AtomicLongResource : ThreadResource {
-    sw_atomic_long_t value;
-
-    explicit AtomicLongResource(zend_long _value) {
-        value = _value;
-    }
-
-    ~AtomicLongResource() override = default;
-};
-
-static void *thread_atomic_resource_new(int32_t is_long, int64_t value, void **word) {
-    if (is_long) {
-        auto resource = new AtomicLongResource(value);
-        *word = (void *) &resource->value;
-        return static_cast<ThreadResource *>(resource);
-    }
-    auto resource = new AtomicResource(value);
-    *word = (void *) &resource->value;
-    return static_cast<ThreadResource *>(resource);
-}
-
-static void thread_atomic_resource_del_ref(void *resource) {
-    static_cast<ThreadResource *>(resource)->del_ref();
-}
-
-ThreadResource *php_swoole_thread_atomic_cast(const zval *zobject) {
-    return static_cast<ThreadResource *>(swr_v1_phplocks_thread_atomic_resource(zobject));
-}
-
-ThreadResource *php_swoole_thread_atomic_long_cast(const zval *zobject) {
-    return static_cast<ThreadResource *>(swr_v1_phplocks_thread_atomic_resource(zobject));
-}
-
-void php_swoole_thread_atomic_create(zval *return_value, ThreadResource *resource) {
-    auto atomic = dynamic_cast<AtomicResource *>(resource);
-    swr_v1_phplocks_thread_atomic_create(return_value, 0, resource, atomic ? (void *) &atomic->value : nullptr);
-}
-
-void php_swoole_thread_atomic_long_create(zval *return_value, ThreadResource *resource) {
-    auto atomic = dynamic_cast<AtomicLongResource *>(resource);
-    swr_v1_phplocks_thread_atomic_create(return_value, 1, resource, atomic ? (void *) &atomic->value : nullptr);
-}
-
+// The classes, their objects, methods and the reference-counted values that
+// Thread\Map, ArrayList and Queue share are Rust (crates/phplocks).
 void php_swoole_thread_atomic_minit(int module_number) {
-    swr_v1_phplocks_thread_atomic_minit(thread_atomic_resource_new,
