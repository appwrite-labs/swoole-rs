-
-#include "swoole_lock.h"
-#include "swoole_rs_locks.h"
-#include <cstddef>
-#ifdef HAVE_RWLOCK
-namespace swoole {
-RWLock::RWLock(bool shared) : Lock(RW_LOCK, shared) {
-    const size_t size = swr_v1_locks_size(RW_LOCK);
-    if (!size || swr_v1_locks_align(RW_LOCK) > alignof(std::max_align_t)) {
-        throw std::system_error(EINVAL, std::generic_category(), "unsupported Rust lock storage");
-    }
-    impl = reinterpret_cast<RWLockImpl *>(shared ? sw_mem_pool()->alloc(size) : ::operator new(size));
-    if (!impl) { throw std::bad_alloc(); }
-    if (swr_v1_locks_init((void *) impl, RW_LOCK, shared) != 0) {
-        const int error = errno;
-        if (shared) { sw_mem_pool()->free((void *) impl); } else { ::operator delete((void *) impl); }
-        throw std::system_error(error, std::generic_category(), "pthread_rwlock_init() failed");
-    }
-}
-int RWLock::lock(int operation, int timeout_msec) {
-    uint32_t capabilities = 0;
-#ifdef HAVE_MUTEX_TIMEDLOCK
-    capabilities |= 1;
-#endif
-#ifdef HAVE_RWLOCK_TIMEDRDLOCK
-    capabilities |= 2;
-#endif
-    return swr_v1_locks_lock((void *) impl, RW_LOCK, operation, timeout_msec, capabilities);
-}
-int RWLock::unlock() { return swr_v1_locks_unlock((void *) impl, RW_LOCK); }
-RWLock::~RWLock() {
-    swr_v1_locks_destroy((void *) impl, RW_LOCK);
-    if (shared_) { sw_mem_pool()->free((void *) impl); } else { ::operator delete((void *) impl); }
-}
-}  // namespace swoole
-#endif
