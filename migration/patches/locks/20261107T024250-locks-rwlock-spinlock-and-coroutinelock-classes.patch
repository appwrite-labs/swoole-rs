diff --git a/src/lock/coroutine_lock.cc b/src/lock/coroutine_lock.cc
index bb8d35c..e00c3ae 100644
--- a/src/lock/coroutine_lock.cc
+++ b/src/lock/coroutine_lock.cc
@@ -41,30 +41 @@ extern "C" const SwrCoroutineHost *swr_cpp_coroutine_lock_native_host() {
 }
-#ifdef ENABLE_PHP_SWOOLE
-extern "C" const SwrCoroutineHost *swr_cpp_coroutine_lock_php_host();
-extern "C" void swr_cpp_coroutine_lock_raise();
-#endif
-
-namespace swoole {
-CoroutineLock::CoroutineLock(bool shared) : Lock(COROUTINE_LOCK, shared) {
-#ifdef ENABLE_PHP_SWOOLE
-    state = swr_v1_locks_coroutine_new(shared, swr_cpp_coroutine_lock_php_host());
-#else
-    state = swr_v1_locks_coroutine_new(shared, swr_cpp_coroutine_lock_native_host());
-#endif
-}
-CoroutineLock::~CoroutineLock() { swr_v1_locks_coroutine_free(state); }
-int CoroutineLock::lock(int operation, int) {
-    auto result = swr_v1_locks_coroutine_lock(state, operation);
-#ifdef ENABLE_PHP_SWOOLE
-    if (result.bailed) swr_cpp_coroutine_lock_raise();
-#endif
-    return result.code;
-}
-int CoroutineLock::unlock() {
-    auto result = swr_v1_locks_coroutine_unlock(state);
-#ifdef ENABLE_PHP_SWOOLE
-    if (result.bailed) swr_cpp_coroutine_lock_raise();
-#endif
-    return result.code;
-}
-}  // namespace swoole
