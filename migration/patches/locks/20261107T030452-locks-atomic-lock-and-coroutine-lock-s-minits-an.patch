-extern "C" const SwrCoroutineHost *swr_cpp_coroutine_lock_native_host() {
-    static const SwrCoroutineHost host = {
-        []() -> void * { return swoole::Coroutine::get_current(); },
-        [](void *co) -> int64_t { return static_cast<swoole::Coroutine *>(co)->get_cid(); },
-        [] { return static_cast<uint32_t *>(sw_mem_pool()->alloc(sizeof(uint32_t))); },
-        [](uint32_t *word) { sw_mem_pool()->free(word); },
-#ifdef HAVE_IOURING_FUTEX
-        nullptr,
-        [](uint32_t *word) -> SwrCoroutineOutcome { return {swoole::Iouring::futex_wait(word), 0}; },
-        [](uint32_t *word) -> SwrCoroutineOutcome { return {swoole::Iouring::futex_wakeup(word), 0}; },
-#else
-        [](double seconds) -> SwrCoroutineOutcome { return {swoole::coroutine::System::sleep(seconds), 0}; },
-        nullptr, nullptr,
-#endif
-        []() -> uint8_t { swoole_warning("The coroutine lock can only be used in a coroutine environment"); return 0; },
-    };
-    return &host;
-}
