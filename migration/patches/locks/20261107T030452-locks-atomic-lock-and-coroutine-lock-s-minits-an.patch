index baa2e9e..0000000
--- a/ext-src/swoole_coroutine_lock.cc
+++ /dev/null
@@ -1,56 +0,0 @@
-/*
-  +----------------------------------------------------------------------+
-  | Swoole                                                               |
-  +----------------------------------------------------------------------+
-  | This source file is subject to version 2.0 of the Apache license,    |
-  | that is bundled with this package in the file LICENSE, and is        |
-  | available through the world-wide-web at the following url:           |
-  | http://www.apache.org/licenses/LICENSE-2.0.html                      |
-  | If you did not receive a copy of the Apache2.0 license and are unable|
-  | to obtain it through the world-wide-web, please send a note to       |
-  | license@swoole.com so we can mail you a copy immediately.            |
-  +----------------------------------------------------------------------+
-  | Author: Tianfeng Han  <rango@swoole.com>                             |
-  +----------------------------------------------------------------------+
-*/
-
-#include "php_swoole_private.h"
-#include "swoole_rs_locks.h"
-
-/* These leaves sit below Rust's scheduler loop, so PHP never longjmps over it. */
-extern "C" const SwrCoroutineHost *swr_cpp_coroutine_lock_php_host() {
-    static const SwrCoroutineHost host = [] {
-        auto guarded = *swr_cpp_coroutine_lock_native_host();
-        if (guarded.sleep) guarded.sleep = [](double seconds) -> SwrCoroutineOutcome {
-            SwrCoroutineOutcome result = {0, 0};
-            zend_try { result = swr_cpp_coroutine_lock_native_host()->sleep(seconds); }
-            zend_catch { result.bailed = 1; } zend_end_try();
-            return result;
-        };
-        if (guarded.wait) guarded.wait = [](uint32_t *word) -> SwrCoroutineOutcome {
-            SwrCoroutineOutcome result = {0, 0};
-            zend_try { result = swr_cpp_coroutine_lock_native_host()->wait(word); }
-            zend_catch { result.bailed = 1; } zend_end_try();
-            return result;
-        };
-        if (guarded.wake) guarded.wake = [](uint32_t *word) -> SwrCoroutineOutcome {
-            SwrCoroutineOutcome result = {0, 0};
-            zend_try { result = swr_cpp_coroutine_lock_native_host()->wake(word); }
-            zend_catch { result.bailed = 1; } zend_end_try();
-            return result;
-        };
-        guarded.warning = []() -> uint8_t {
-            uint8_t bailed = 0;
-            zend_try { swr_cpp_coroutine_lock_native_host()->warning(); }
-            zend_catch { bailed = 1; } zend_end_try();
-            return bailed;
-        };
-        return guarded;
-    }();
-    return &host;
-}
-void php_swoole_coroutine_lock_minit(int) {
-    swr_v1_phplocks_coroutine_minit(swr_cpp_coroutine_lock_php_host(), [](void *) {
-        swoole_fatal_error(SW_ERROR_WRONG_OPERATION, "must call constructor first");
-    });
-}
diff --git a/ext-src/swoole_lock.cc b/ext-src/swoole_lock.cc
deleted file mode 100644
index 6ab218b..0000000
--- a/ext-src/swoole_lock.cc
+++ /dev/null
@@ -1,50 +0,0 @@
-/*
-  +----------------------------------------------------------------------+
-  | Swoole                                                               |
-  +----------------------------------------------------------------------+
-  | This source file is subject to version 2.0 of the Apache license,    |
-  | that is bundled with this package in the file LICENSE, and is        |
-  | available through the world-wide-web at the following url:           |
-  | http://www.apache.org/licenses/LICENSE-2.0.html                      |
-  | If you did not receive a copy of the Apache2.0 license and are unable|
-  | to obtain it through the world-wide-web, please send a note to       |
-  | license@swoole.com so we can mail you a copy immediately.            |
-  +----------------------------------------------------------------------+
-  | Author: Tianfeng Han  <rango@swoole.com>                             |
-  +----------------------------------------------------------------------+
-*/
-
-#include "php_swoole_private.h"
-#include "swoole_memory.h"
-#include "swoole_lock.h"
-#include "swoole_rs_locks.h"
-
-// The class, its method table (from the stub's arginfo, crates/phpstubs), its
-// objects and every method are Rust (crates/phplocks). Locks live in the global
-// pool, so forked workers share them.
-static void *lock_alloc(uint32_t size) {
-    return sw_mem_pool()->alloc(size);
-}
-
-static void lock_unconstructed() {
-    swoole_fatal_error(SW_ERROR_WRONG_OPERATION, "must call constructor first");
-}
-
-void php_swoole_lock_minit(int module_number) {
-    uint32_t kinds = 1u << swoole::Lock::MUTEX;
-#ifdef HAVE_RWLOCK
-    kinds |= 1u << swoole::Lock::RW_LOCK;
-#endif
-#ifdef HAVE_SPINLOCK
-    kinds |= 1u << swoole::Lock::SPIN_LOCK;
-#endif
-    uint32_t capabilities = 0;
-#ifdef HAVE_MUTEX_TIMEDLOCK
-    capabilities |= 1;
-#endif
-#ifdef HAVE_RWLOCK_TIMEDRDLOCK
-    capabilities |= 2;
-#endif
-    swr_v1_phplocks_lock_minit(
-        module_number, kinds, capabilities, swoole_exception_ce, lock_alloc, lock_unconstructed);
-}
