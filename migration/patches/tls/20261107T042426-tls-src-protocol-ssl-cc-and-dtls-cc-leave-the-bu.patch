-
-int BIO_write(BIO *b, const char *data, int dlen) {
-    swoole_trace_log(SW_TRACE_SSL, "BIO_write(%d)", dlen);
-
-    auto *session = (Session *) BIO_get_data(b);
-    return session->socket->write(data, dlen);
-}
-
-int BIO_read(BIO *b, char *data, int len) {
-    auto *session = (Session *) BIO_get_data(b);
-    BIO_clear_retry_flags(b);
-
-    const auto view = swr_v1_tls_dtls_view(session->handle());
-    if (!view.empty) {
-        swoole_trace("BIO_read(%d, peek=%d)=%d", len, view.peek, view.length);
-    }
-    const auto plan = swr_v1_tls_dtls_read(session->handle(), reinterpret_cast<uint8_t *>(data), len);
-    if (plan.retry) BIO_set_retry_read(b);
-    return plan.length;
-}
-
-long BIO_ctrl(BIO *b, int cmd, long lval, void *ptrval) {
-    auto *session = (Session *) BIO_get_data(b);
-    swoole_trace_log(SW_TRACE_SSL, "BIO_ctrl(BIO[%p], cmd[%d], lval[%ld], ptrval[%p])", b, cmd, lval, ptrval);
-    uint32_t tag;
-    long observed = 0;
-    switch (cmd) {
-    case BIO_CTRL_EOF: tag = 0; break;
-    case BIO_CTRL_GET_CLOSE: tag = 1; observed = BIO_get_shutdown(b); break;
-    case BIO_CTRL_PENDING: tag = 2; break;
-    case BIO_CTRL_SET_CLOSE: tag = 3; break;
-    case BIO_CTRL_FLUSH:
-    case BIO_CTRL_DGRAM_SET_CONNECTED:
-    case BIO_CTRL_DGRAM_SET_PEER: tag = 4; break;
-    case BIO_CTRL_DGRAM_GET_PEER: tag = 5; break;
-    case BIO_CTRL_DGRAM_QUERY_MTU:
-    case BIO_CTRL_DGRAM_GET_FALLBACK_MTU: tag = 6; break;
-#ifdef BIO_CTRL_DGRAM_GET_MTU_OVERHEAD
-    case BIO_CTRL_DGRAM_GET_MTU_OVERHEAD: tag = 7; break;
-#endif
-#ifdef BIO_CTRL_DGRAM_SET_PEEK_MODE
-    case BIO_CTRL_DGRAM_SET_PEEK_MODE: tag = 8; break;
-#endif
-    case BIO_CTRL_WPENDING:
-    case BIO_CTRL_PUSH:
-    case BIO_CTRL_POP:
-    case BIO_CTRL_DGRAM_SET_NEXT_TIMEOUT: tag = 9; break;
-#if OPENSSL_VERSION_NUMBER >= 0x30000000L
-    case BIO_CTRL_GET_KTLS_SEND:
-    case BIO_CTRL_GET_KTLS_RECV: tag = 9; break;
-#endif
-    default: tag = UINT32_MAX; break;
-    }
-    const auto plan = swr_v1_tls_dtls_control(session->handle(), tag, observed, lval, ptrval);
-    switch (plan.effect) {
-    case 1: BIO_set_shutdown(b, (int) lval); break;
-    case 4: swoole_warning("unknown cmd: %d", cmd); break;
-    }
-    return plan.result;
-}
-
-int BIO_create(BIO *b) {
-    return 1;
-}
-
-int BIO_destroy(BIO *b) {
-    swoole_trace_log(SW_TRACE_SSL, "BIO_destroy(BIO[%p])\n", b);
-    return 1;
-}
-
-
-BIO_METHOD *BIO_get_methods() {
-    if (auto *methods = swr_v1_tls_dtls_methods()) return methods;
-    const int index = BIO_get_new_index();
-    auto *methods = BIO_meth_new(index | BIO_TYPE_SOURCE_SINK, "swoole_dtls_bio");
-    BIO_meth_set_write(methods, BIO_write);
-    BIO_meth_set_read(methods, BIO_read);
-    BIO_meth_set_ctrl(methods, BIO_ctrl);
-    BIO_meth_set_create(methods, BIO_create);
-    BIO_meth_set_destroy(methods, BIO_destroy);
-#ifdef OPENSSL_IS_BORINGSSL
-    BIO_meth_set_ctrl(methods, (long (*)(BIO *, int, long, void *)) BIO_ctrl);
-#endif
-    auto *published = swr_v1_tls_dtls_methods_publish(methods);
-    if (published != methods) ::BIO_meth_free(methods);
-    return published;
-}
-
-void BIO_meth_free() {
-    if (auto *methods = swr_v1_tls_dtls_methods_take()) ::BIO_meth_free(methods);
-}
-
-bool Session::init() {
-    if (socket->ssl) {
-        return false;
-    }
-
-    if (socket->ssl_create(ctx.get(), SW_SSL_SERVER) < 0) {
-        swoole_set_last_error(SW_ERROR_SSL_CREATE_SESSION_FAILED);
-        return false;
-    }
-
-    socket->set_buffer_size(Socket::default_buffer_size);
-    socket->dtls = 1;
-
-    BIO *bio = BIO_new(BIO_get_methods());
-    BIO_set_data(bio, (void *) this);
-    BIO_set_init(bio, 1);
-    SSL_set_bio(socket->ssl, bio, bio);
-
-    return true;
-}
-
-bool Session::listen() {
-#ifdef OPENSSL_IS_BORINGSSL
-    return SSL_is_dtls(socket->ssl);
-#else
-
-    if (listened) {
-        return false;
-    }
-
-    ERR_clear_error();
-
-    int retval = DTLSv1_listen(socket->ssl, nullptr);
-    const auto plan = swr_v1_tls_dtls_listen(handle(), retval);
-    if (plan == 1) {
-        return true;
-    } else if (plan == 0) {
-        int reason = ERR_GET_REASON(ERR_peek_error());
-        swoole_warning("DTLSv1_listen() failed, client[%s:%d], reason=%d, error_string=%s",
-                       socket->get_addr(),
-                       socket->get_port(),
-                       reason,
-                       swoole_ssl_get_error());
-        return false;
-    }
-    return true;
-#endif
-}
